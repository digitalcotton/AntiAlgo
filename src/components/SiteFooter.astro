---
import { INDEX, routeFor } from '../data/nav';
import { SITE } from '../data/site';

/**
 * The footer, from the Anti Algo home canvas. Two rows: the story pages with
 * the action opposite them, then the product pages with the tagline opposite.
 * All in the machine face, uppercase, quiet.
 */
const STORY = [
  { label: 'Home', href: routeFor('start') },
  { label: 'How it works', href: routeFor('how-it-works') },
  { label: 'Evidence', href: routeFor('evidence') },
  { label: 'Your key', href: routeFor('your-key') }
];
const PRODUCT = [
  { label: 'The Index', href: INDEX.board },
  { label: 'Kill list', href: INDEX.kills },
  { label: 'The Report', href: INDEX.report },
  { label: 'Not here, on purpose', href: INDEX.notHere },
  { label: 'Methodology', href: INDEX.methodology }
];
---

<footer class="ftr">
  <div class="shell ftr-inner">
    <div class="ftr-row">
      <nav class="ftr-nav" aria-label="The story">
        {STORY.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
      <a class="ftr-action" href={`${routeFor('sign-up')}?from=footer`}>Save my spot</a>
    </div>
    <div class="ftr-row">
      <nav class="ftr-nav" aria-label="The product">
        {PRODUCT.map((l) => <a href={l.href}>{l.label}</a>)}
        <span class="ftr-soon">The Desk · soon</span>
      </nav>
      <span class="ftr-tag">{SITE.domain} · {SITE.byline}</span>
    </div>
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--color-line);
    margin-top: auto;
  }
  .ftr-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px;
  }
  .ftr-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .ftr-nav {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .ftr-nav a {
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .ftr-nav a:hover {
    color: var(--color-foreground);
  }
  .ftr-soon {
    color: var(--color-muted);
    white-space: nowrap;
  }
  .ftr-action {
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid var(--color-foreground);
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ftr-tag {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 820px) {
    .ftr-row {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
