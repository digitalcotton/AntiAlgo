---
import { INDEX, routeFor } from '../data/nav';
import { SITE } from '../data/site';
import { isOn } from '../lib/flags';

/**
 * The footer, from the Anti Algo home canvas. Two rows: the story pages with
 * the action opposite them, then the product pages with the tagline opposite.
 * All in the machine face, uppercase, quiet.
 */
const STORY = [
  { label: 'Home', href: routeFor('start') },
  { label: 'How it works', href: routeFor('how-it-works') },
  { label: 'Evidence', href: routeFor('evidence') },
  { label: 'Your key', href: routeFor('your-key') }
];
// The footer carries no sign-up action in either state (owner decision,
// 2026-09-20): the header's Save my spot is the one.
const signedIn = Boolean(Astro.locals.viewer);
// Signed in, the footer is the member's own surfaces (the same four the
// signed-in header shows, plus the two account pages) and nothing from the
// marketing site (owner decision, 2026-09-20). Same order as the header.
const MEMBER = [
  { label: 'The Board', href: routeFor('board') },
  { label: 'The Desk', href: routeFor('desk') },
  { label: 'Opportunities', href: routeFor('opportunities') },
  { label: 'Jobs Data', href: routeFor('jobs-data') },
  { label: 'Profile', href: routeFor('profile') },
  { label: 'Settings', href: routeFor('settings') }
];
// The kill list link exists only while the list does (kill_list flag), the
// same rule the tiles, the report and the not-here coda follow.
// No link to the board: a signed-out reader has the header's "The board" for
// that (owner decision, 2026-09-20). The report link follows its own flag.
const PRODUCT = [
  ...(isOn('kill_list') ? [{ label: 'Kill list', href: INDEX.kills }] : []),
  ...(isOn('report') ? [{ label: 'The Report', href: INDEX.report }] : []),
  { label: 'Not here, on purpose', href: INDEX.notHere },
  { label: 'Methodology', href: INDEX.methodology }
];
---

<footer class="ftr">
  <div class:list={['shell', 'ftr-inner', { 'ftr-member': signedIn }]}>
    {signedIn ? (
      <div class="ftr-row">
        <nav class="ftr-nav" aria-label="Your surfaces">
          {MEMBER.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
        <span class="ftr-tag">{SITE.domain} · {SITE.byline}</span>
      </div>
    ) : (
      <>
        <div class="ftr-row">
          <nav class="ftr-nav" aria-label="The story">
            {STORY.map((l) => <a href={l.href}>{l.label}</a>)}
          </nav>
        </div>
        <div class="ftr-row">
          <nav class="ftr-nav" aria-label="The product">
            {PRODUCT.map((l) => <a href={l.href}>{l.label}</a>)}
            <span class="ftr-soon">The Desk · soon</span>
          </nav>
          <span class="ftr-tag">{SITE.domain} · {SITE.byline}</span>
        </div>
      </>
    )}
  </div>
</footer>

<style>
  .ftr {
    border-top: 1px solid var(--color-line);
    margin-top: auto;
  }
  .ftr-inner {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-block: 24px;
  }
  /* Signed in, the same frame as the signed-in header (SiteHeader.astro
     .hdr-member) and the member pages, so the footer's edges meet theirs. */
  .ftr-member {
    max-width: 86rem;
    padding-inline: clamp(16px, 2.5vw, 36px);
  }
  .ftr-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
    flex-wrap: wrap;
  }
  .ftr-nav {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .ftr-nav a {
    color: var(--color-muted);
    text-decoration: none;
    white-space: nowrap;
  }
  .ftr-nav a:hover {
    color: var(--color-foreground);
  }
  .ftr-soon {
    color: var(--color-muted);
    white-space: nowrap;
  }
  .ftr-action {
    color: var(--color-foreground);
    text-decoration: none;
    border-bottom: 1px solid var(--color-foreground);
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ftr-tag {
    font-family: var(--font-family-mono);
    font-size: 11px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  @media (max-width: 820px) {
    .ftr-row {
      flex-direction: column;
      gap: 12px;
    }
  }
</style>
