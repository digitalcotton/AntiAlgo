---
import { formatDate } from '../../lib/data';

/**
 * The "LAST NIGHT'S SWEEP" panel. The design shows a per-second timeline
 * (07:30:01 ...); the sweep does not log one, so this renders the SAME steps with
 * their REAL counts and the one real swept date, and no fabricated clock. Every
 * number is passed in from the live sweep stats and the member's own lane.
 */
interface Props {
  boardsSwept: number | null;
  verifiedLive: number | null;
  liveUnderTitles: number;
  newCoreCount: number;
  diedCount: number;
  sweptAt: string | null;
  /** The sweep's per-stage instants (db/205), keyed read / verify / kill /
      save, or null until the sweep logs them. With any present the panel draws
      the design's time column; the two member lines (live under your titles,
      new under core) are counted here at page time and carry no sweep time. */
  stages?: Record<string, string> | null;
}
const { boardsSwept, verifiedLive, liveUnderTitles, newCoreCount, diedCount, sweptAt, stages = null } = Astro.props;
const n = (v: number | null) => (typeof v === 'number' ? v.toLocaleString() : 'not counted');
/** The one real clock, as the design's footer prints it: "07:30:44, 2026-09-16"
    in UTC. Falls back to the plain date if the stamp does not parse. */
function finishedStamp(iso: string): string {
  const ms = Date.parse(iso);
  // formatDate answers null for a stamp it cannot read either. Printing the raw
  // value is the honest fallback: it shows what the sweep actually recorded
  // rather than an empty space that reads as "no sweep".
  if (Number.isNaN(ms)) return formatDate(iso) ?? iso;
  const d = new Date(ms);
  const two = (v: number) => String(v).padStart(2, '0');
  return `${two(d.getUTCHours())}:${two(d.getUTCMinutes())}:${two(d.getUTCSeconds())}, ${d.getUTCFullYear()}-${two(d.getUTCMonth() + 1)}-${two(d.getUTCDate())}`;
}

/** A stage's clock as HH:MM:SS UTC, or null when the sweep did not log it. */
function stageTime(key: string): string | null {
  const iso = stages?.[key];
  if (typeof iso !== 'string') return null;
  const ms = Date.parse(iso);
  if (Number.isNaN(ms)) return null;
  const d = new Date(ms);
  const two = (v: number) => String(v).padStart(2, '0');
  return `${two(d.getUTCHours())}:${two(d.getUTCMinutes())}:${two(d.getUTCSeconds())}`;
}

const steps = [
  { text: `read ${n(boardsSwept)} company sources`, accent: false, at: stageTime('read') },
  { text: `verified ${n(verifiedLive)} postings live`, accent: false, at: stageTime('verify') },
  { text: `${liveUnderTitles.toLocaleString()} live under your titles`, accent: false, at: null },
  { text: `${newCoreCount} new under core`, accent: true, at: null },
  { text: `${diedCount} came down by rule`, accent: false, at: stageTime('kill') },
  { text: `saved tonight's snapshot`, accent: false, at: stageTime('save') }
];
const hasClock = steps.some((s) => s.at !== null);
---

<aside class="sp">
  <div class="sp-head">
    <span class="sp-title mono-label">Last night's sweep</span>
    <span class="sp-utc mono-label">UTC</span>
  </div>
  <ol class:list={['sp-steps', { 'sp-steps-clock': hasClock }]}>
    {steps.map((s) => (
      <li class={`sp-step${s.accent ? ' sp-step-accent' : ''}`}>
        {hasClock && <span class="sp-time">{s.at ?? ''}</span>}
        <span class="sp-text">{s.text}</span>
      </li>
    ))}
  </ol>
  {/* The finish is the save stage when the sweep wrote its stage instants
      (2026-09-20): the generation stamp is the crawl's START, and a footer
      that called it finished read fifteen minutes early. Without stages the
      stamp is the only instant there is. */}
  <p class="sp-foot">{(stages?.save ?? sweptAt) ? `finished ${finishedStamp(stages?.save ?? sweptAt!)}` : 'sweep pending'}</p>
</aside>

<style>
  .sp {
    border: var(--border-hairline) solid var(--color-line-strong);
    background: var(--color-surface-raised);
    padding: var(--space-400) var(--space-500);
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    font-family: var(--font-family-mono);
  }
  /* Dashed rules above and below the log, as the design draws them. */
  .sp-head { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: var(--space-300); border-bottom: var(--border-hairline) dashed var(--color-line-strong); }
  .sp-title { color: var(--color-foreground); }
  .sp-utc { color: var(--color-muted); }
  .sp-steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-200); }
  .sp-step { font-size: var(--size-075); color: var(--color-foreground); }
  .sp-step-accent { color: var(--color-stat-loss); }
  /* The time column, only when the sweep logged a clock (design: 76px grid). */
  .sp-steps-clock .sp-step { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 12px; align-items: baseline; }
  /* Muted, not the rule colour the design drew: it is text and must clear AA. */
  .sp-time { font-size: 0.72rem; color: var(--color-muted); }
  .sp-foot { margin: var(--space-200) 0 0; padding-top: var(--space-300); border-top: var(--border-hairline) dashed var(--color-line-strong); color: var(--color-muted); font-size: 0.68rem; }
</style>
