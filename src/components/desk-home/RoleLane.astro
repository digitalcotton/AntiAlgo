---
import { boardDetailPath } from '../../data/nav';
import { formatDate } from '../../lib/data';
import type { DeskRoleVM } from '../../lib/desk-home';

/**
 * One lane of new roles on The Desk (New in Core, New in Stretch). Each card
 * links straight to the posting's board page, where the working track action
 * lives; there are no draft buttons (owner's call). The "head start" line is a
 * plain reading of the role's own age against the arrival curve, never a
 * fabricated percentile.
 */
interface Props {
  title: string;
  roles: DeskRoleVM[];
}
const { title, roles } = Astro.props;

/** A plain head-start phrase from the role's age. The arrival curve (NBER WP
    32320) has most applications land in the first 96 hours, so a fresh role is
    a real head start; this only names where the role sits, it does not claim a
    percentile. */
function headStart(ageDays: number | null): string | null {
  if (ageDays === null || ageDays < 0) return null;
  if (ageDays <= 2) return 'inside the first 48 hours';
  if (ageDays <= 4) return 'inside the first 96 hours';
  if (ageDays <= 7) return 'in its first week';
  return `${ageDays} days on the board`;
}
---

<section class="dh-section" aria-label={title}>
  <div class="dh-section-head">
    <h2 class="dh-h2">{title}</h2>
    <p class="dh-section-note">
      {roles.length === 0
        ? 'Nothing new here since you last looked.'
        : `${roles.length} first seen since your last visit, ranked by fit.`}
    </p>
  </div>
  {roles.length > 0 && (
    <ul class="dh-lane-list">
      {roles.map((r) => {
        const head = headStart(r.ageDays);
        return (
          <li class="dh-role">
            <span class="dh-role-main">
              {r.slug ? (
                <a class="dh-role-title" href={boardDetailPath(r.slug)}>{r.title}</a>
              ) : (
                <span class="dh-role-title">{r.title}</span>
              )}
              <span class="dh-role-sub">
                {r.company}
                {r.pay && ` · ${r.pay}`}
                {(r.remote || r.location) && ` · ${r.remote ? 'Remote' : r.location}`}
              </span>
              <span class="dh-role-matched">
                matched {r.matched.join(', ')}
                {r.firstSeen && ` · first seen ${formatDate(r.firstSeen)}`}
                {head && ` · ${head}`}
              </span>
            </span>
            <span class="dh-role-fit">
              <span class="dh-role-fit-score">{r.fit}</span>
              <span class="dh-role-fit-label">/100 your fit</span>
            </span>
          </li>
        );
      })}
    </ul>
  )}
</section>
