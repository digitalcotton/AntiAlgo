---
/**
 * The sign-out control. Better Auth's sign-out is a JSON POST answered with
 * JSON, so the button posts by fetch and then sends the reader home.
 */
---

<form class="signout" data-signout action="/auth/sign-out" method="POST">
  <button class="signout-button" type="submit">Sign out</button>
</form>

<style>
  .signout {
    margin-top: var(--space-700);
  }
  .signout-button {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-100);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid var(--color-muted);
    border-radius: 0;
  }
  .signout-button:hover {
    color: var(--color-foreground);
    border-bottom-color: var(--color-foreground);
  }
</style>

<script>
  // Bind every sign-out form on the page: the header renders one and a page
  // (e.g. /account) may render its own, so a single querySelector would leave
  // the second unbound and it would do a native POST that shows raw JSON.
  document.querySelectorAll<HTMLFormElement>('[data-signout]').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      try {
        await fetch(form.action, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' });
      } catch {}
      window.location.href = '/';
    });
  });
</script>
