---
// The site's icon glyphs used to be Unicode characters set in N27. N27 doesn't
// cover those code points, so browsers silently fell back to the platform's
// system font for just that one character, visible as Apple's San Francisco on
// iOS Safari. Inline SVG has no font dependency, so it renders identically on
// every OS and browser.
//
// Paths are copied verbatim from Lucide (lucide.dev, ISC licensed), verified
// against lucide-icons/lucide on GitHub rather than hand-drawn, so the shape is
// exactly the maintained original: arrow-right, arrow-left, arrow-up-right,
// arrow-down, undo (Lucide's "undo-2"), replay (Lucide's "rotate-cw").
//
// Default size is 1em, so an icon dropped inline with text inherits that
// text's font-size and color (including inverted, dark-panel text) with no
// extra markup, the same way the glyph it replaces behaved. Pass `size` to
// break out of text flow at a fixed, token-driven size instead, for example a
// standalone icon in a reference swatch.
export type IconName = 'arrow-right' | 'arrow-left' | 'arrow-up-right' | 'arrow-down' | 'chevron-down' | 'undo' | 'replay';
export type IconSize = 'sm' | 'md' | 'lg' | 'xl';

const SIZES: Record<IconSize, string> = {
  sm: 'var(--size-200)',
  md: 'var(--size-300)',
  lg: 'var(--size-500)',
  xl: 'var(--size-700)'
};

interface Props {
  name: IconName;
  size?: IconSize;
  class?: string;
  [attr: string]: unknown;
}
const { name, size, class: className, style, ...rest } = Astro.props;

const sizeVar = size ? SIZES[size] : null;
// Lucide's undo-2 hooks upward. The readback layer's motion reads downward
// instead, so it is mirrored top to bottom (left and right unchanged) from
// the source glyph.
const flip = name === 'undo' ? 'transform:scaleY(-1)' : '';
const styleAttr = [sizeVar ? `width:${sizeVar};height:${sizeVar}` : '', flip, style ?? ''].filter(Boolean).join(';');

// Verbatim from lucide-icons/lucide, viewBox 0 0 24 24, stroke-width 2.
const PATHS: Record<IconName, string> = {
  'arrow-right': '<path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path>',
  'arrow-left': '<path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path>',
  'arrow-up-right': '<path d="M7 7h10v10"></path><path d="M7 17 17 7"></path>',
  'arrow-down': '<path d="M12 5v14"></path><path d="m19 12-7 7-7-7"></path>',
  'chevron-down': '<path d="m6 9 6 6 6-6"></path>',
  undo: '<path d="M9 14 4 9l5-5"></path><path d="M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"></path>',
  replay: '<path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"></path><path d="M21 3v5h-5"></path>'
};
---

<svg
  class={className}
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  style={styleAttr || undefined}
  {...rest}
  set:html={PATHS[name]}
/>

<style>
  svg {
    width: 1em;
    height: 1em;
    display: inline-block;
    vertical-align: -0.125em;
    flex: none;
  }
</style>
