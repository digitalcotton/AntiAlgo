---
/**
 * DraftRoomV2.astro: the pixel-perfect "Your documents" draft room (design:
 * resumecoverletterdetails.html), the ready-state screen a person sees after the
 * one-click draft finishes. It renders the resume and cover letter that were
 * drafted for one posting, read back from storage, with a tab per document, the
 * download and apply actions, the earlier versions kept (db/202), and the honest
 * change record (tailor.ts ChangeRecord: KEPT vs REWROTE, derived by
 * byte-comparison, never narrated).
 *
 * WHAT IS REAL HERE, AND WHAT IS DEFERRED. Everything shown is the render's own
 * data: the document text, the per-line highlight (a line a connected model
 * rephrased inside its locked slot, from changeRecord), the versions, and the
 * PDF and DOCX downloads (src/pages/desk/job-draft/[slug]/[doc].ts). The "Steer
 * it" chips are shown but not yet wired to steered regeneration; the plain
 * Regenerate re-drafts on the key now, and the panel says so rather than
 * pretending the chips work. A cost line is left out until token capture lands,
 * because a number we cannot measure is one we do not print.
 *
 * The drafting, failed and empty states are NOT here: the page keeps those, and
 * this component renders only once at least one document is ready.
 */
import { groupResumeSection, type ResumeGroup } from '../../lib/resume-grouping';
import type { EntryDate } from '../../lib/record';
import { DESCRIPTION_KINDS, SUMMARY_LINE_ID } from '../../lib/tailor';
import type { ResumeRender, CoverRender, RenderEntry, RenderHeader } from '../../lib/tailor';
import type { RenderVersionRow } from '../../lib/generated-render-store';
import { jobDraftPath, jobDraftPdfPath, jobDraftRestorePath, routeFor } from '../../data/nav';

interface Props {
  slug: string;
  jobTitle: string | null;
  company: string;
  postingHref: string;
  resume: ResumeRender | null;
  cover: CoverRender | null;
  resumeVersions: RenderVersionRow[];
  coverVersions: RenderVersionRow[];
  resumeUpdatedAt: string | null;
  coverUpdatedAt: string | null;
  resumeDownloadable: boolean;
  coverDownloadable: boolean;
  provider: string | null;
  model: string | null;
  fallback: boolean;
  regenerateAction: string;
  applyUrl: string | null;
  applyLabel: string;
  applyTrack: { action: string; title: string; company: string } | null;
  resumeCost?: DraftCost | null;
  coverCost?: DraftCost | null;
  /** Which documents are still being written. Defaults to neither, so the
      apply-flow room at /desk/draft/[id] is untouched until it opts in.
      A drafting document renders its styled lines blurred under a shimmer
      (docs/draft-loading-spec.md); its text is the deterministic placeholder
      from draft-placeholder.ts, not a model's. */
  drafting?: { resume: boolean; cover: boolean };
}

/** What one document's draft cost to run, all real: the render duration and the
    tokens the provider billed, plus the dollar estimate from the dated price
    table (null when the model is unpriced), or a plain "no model cost" for the
    deterministic built-in writer. */
interface DraftCost {
  costText: string | null;
  asOf: string | null;
  renderMs: number | null;
  inputTokens: number | null;
  outputTokens: number | null;
  deterministic: boolean;
}
const {
  slug,
  jobTitle,
  company,
  postingHref,
  resume,
  cover,
  resumeVersions,
  coverVersions,
  resumeUpdatedAt,
  coverUpdatedAt,
  resumeDownloadable,
  coverDownloadable,
  provider,
  model,
  fallback,
  regenerateAction,
  applyUrl,
  applyLabel,
  applyTrack,
  resumeCost = null,
  coverCost = null,
  drafting = { resume: false, cover: false }
} = Astro.props;

const anyDrafting = drafting.resume || drafting.cover;

function fmtTok(n: number): string {
  return n >= 1000 ? `${Math.round(n / 100) / 10}k` : String(n);
}
/** The cost/usage line under Regenerate: real duration and tokens, then the
    dated dollar estimate when the model is priced, or "no model cost" for the
    built-in writer. Null when there is nothing measured to say. */
function costLine(c: DraftCost | null): string | null {
  if (!c) return null;
  if (c.deterministic) return 'Built-in writer. No model cost.';
  const parts: string[] = [];
  if (c.renderMs && c.renderMs > 0) parts.push(`${Math.max(1, Math.round(c.renderMs / 1000))}s`);
  if (c.inputTokens != null && c.outputTokens != null) parts.push(`${fmtTok(c.inputTokens)} in / ${fmtTok(c.outputTokens)} out`);
  if (parts.length === 0 && !c.costText) return null;
  const base = parts.length > 0 ? `Drafted on your key: ${parts.join(', ')}.` : 'Drafted on your key.';
  return c.costText ? `${base} ${c.costText}${c.asOf ? ` (est., prices as of ${c.asOf})` : ''}` : base;
}

const targetLine = jobTitle ? `${jobTitle} at ${company}` : company;
const bothReady = Boolean(resume) && Boolean(cover);
const readyCount = (resume ? 1 : 0) + (cover ? 1 : 0);
const restoreAction = jobDraftRestorePath(slug);
const profilePath = routeFor('profile');
const PROVIDER_LABELS: Record<string, string> = { anthropic: 'Anthropic', openai: 'OpenAI', kimi: 'Kimi', deepseek: 'DeepSeek' };
const providerLabel = provider ? PROVIDER_LABELS[provider] ?? provider : null;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function md(year: number, month: number | null): string {
  return month === null ? String(year) : `${MONTHS[month - 1]} ${year}`;
}
/** null for an undated entry or fold (db/204): no dates are drawn for it. */
function range(start: EntryDate | null, end: EntryDate | null): string | null {
  if (start === null) return null;
  return `${md(start.year, start.month)} to ${end === null ? 'Present' : md(end.year, end.month)}`;
}
function entryRange(entry: RenderEntry): string | null {
  return range(entry.core.start, entry.core.end);
}
function groupRange(group: ResumeGroup): string | null {
  return range(group.start, group.end);
}
/** A stored instant as a short, honest "N units ago", never a fake clock. */
function timeAgo(iso: string | null): string | null {
  if (!iso) return null;
  const then = Date.parse(iso);
  if (Number.isNaN(then)) return null;
  const secs = Math.max(0, Math.round((Date.now() - then) / 1000));
  if (secs < 60) return 'just now';
  const mins = Math.round(secs / 60);
  if (mins < 60) return `${mins} ${mins === 1 ? 'minute' : 'minutes'} ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs} ${hrs === 1 ? 'hour' : 'hours'} ago`;
  const days = Math.round(hrs / 24);
  return `${days} ${days === 1 ? 'day' : 'days'} ago`;
}
function hasHeader(header: RenderHeader | null | undefined): header is RenderHeader {
  return !!header && (header.name !== null || header.links.length > 0 || !!header.email);
}
/** The prfIds a connected model rephrased, from the change record: the honest
    set of "tailored" lines to highlight. Empty for a deterministic draft. */
function rewroteSet(render: ResumeRender | CoverRender | null): Set<string> {
  const out = new Set<string>();
  for (const e of render?.changeRecord?.perEntry ?? []) if (e.verdict === 'REWROTE') out.add(e.prfId);
  return out;
}
const resumeRewrote = rewroteSet(resume);

/**
 * The attributes that put one styled line into the focus-pull state machine
 * (docs/draft-loading-spec.md; design: ani.html's [data-para]).
 *
 * Two states reach the browser. `drafting` is blurred under a travelling
 * shimmer. `settled` is the finished document, and it is INERT by default: it
 * renders sharp, instantly, with no animation at all.
 *
 * THE ANIMATION IS TIED TO THE WORK, NOT TO THE RENDER. Owner's rule,
 * 2026-09-27: a draft being written animates; a plain refresh of a finished
 * draft does not, because a refresh is not work; pressing Regenerate animates
 * again, because a resume is genuinely being written again. Motion here means
 * "this is being made right now", and a reveal that replayed on every page load
 * would be decoration — re-blurring text the person already read, and telling
 * them nothing about whether anything is happening.
 *
 * So the server never renders the reveal. It is switched on for exactly one
 * paint by the marker below, which only the poll sets, and only after it has
 * watched a run finish. The design reference (ani.html) animates on mount, but
 * that is a prototype showing the motion, not a spec for when it fires.
 *
 * `--shim` is this line's place in the cascade. It offsets the shimmer while
 * drafting and the focus pull on arrival, which is what makes the document
 * settle top-to-bottom instead of flashing all at once. The counter is per
 * document, so the cover letter starts its own cascade at zero.
 */
function paraAttrs(isDrafting: boolean, index: number) {
  return {
    'data-para': '',
    'data-state': isDrafting ? 'drafting' : 'settled',
    style: `--shim:${index * 120}ms`
  };
}
let resumeShim = 0;
let coverShim = 0;

// The steer chips: ids match draft-steer.ts's allowlist (the endpoint drops
// anything else), labels are the UI's own. A checked chip posts its id as a
// `steer` value; the note posts as `steerNote`.
const STEER_CHIPS: readonly { id: string; label: string }[] = [
  { id: 'shorter', label: 'Shorter' },
  { id: 'lead-agent', label: 'Lead with agent work' },
  { id: 'plainer', label: 'Plainer voice' },
  { id: 'technical', label: 'More technical' }
];
---

{/* Runs BEFORE the document below is parsed, which is the whole point: it
    decides whether this paint starts blurred, so there is never a flash of
    sharp text that then re-blurs. is:inline keeps it unbundled and synchronous.

    The flag is a one-shot, written by the poll only after it watched a run
    finish, and consumed here. A refresh finds nothing and the document renders
    sharp — the owner's rule: the animation reports work, not page loads. */}
<script is:inline define:vars={{ revealKey: `dr-revealed:${slug}` }}>
  try {
    if (sessionStorage.getItem(revealKey)) {
      sessionStorage.removeItem(revealKey);
      document.documentElement.setAttribute('data-dr-revealed', '');
    }
  } catch {
    // Private browsing, blocked site data: no marker, no reveal, sharp
    // document. The degraded state is the calm one, which is the right way
    // round for a decoration.
  }
</script>

<article class="dr" data-slug={slug}>
  <nav class="dr-crumbs" aria-label="Breadcrumb">
    <a href={postingHref}>&larr; Back to the posting</a>
    <span class="dr-crumb-sep" aria-hidden="true">/</span>
    <span class="dr-crumb-role">{targetLine}</span>
    <span class="dr-crumb-sep" aria-hidden="true">/</span>
    <span class="dr-crumb-here">Your documents</span>
  </nav>

  {/* The status line carries the wait (design: ani.html's headline block): a
      dot that pulses while a document is still being written, the plain
      sentence saying which, and the escape hatch demoted to muted text beside
      it. aria-live announces the flip to a screen reader, which is the only
      way the focus pull reaches someone who cannot see it. */}
  <p class="dr-status" data-drafting={anyDrafting ? '' : null} aria-live="polite">
    <span class="dr-dot" data-pulse={anyDrafting ? '' : null} aria-hidden="true"></span>
    <strong>
      {anyDrafting
        ? (drafting.resume && drafting.cover
            ? 'Drafting your resumé and cover letter'
            : (drafting.resume ? 'Drafting your resumé' : 'Drafting your cover letter'))
        : (bothReady ? 'Both documents drafted' : (resume ? 'Resumé drafted' : 'Cover letter drafted'))}
    </strong>
    {!anyDrafting && resumeUpdatedAt && <span class="dr-status-sub mono-label">drafted {timeAgo(resumeUpdatedAt)}</span>}
  </p>
  {anyDrafting && (
    <form class="dr-restart no-print" method="POST" action={regenerateAction}>
      <input type="hidden" name="slug" value={slug} />
      <p class="dr-restart-line">Taking too long? <button type="submit" class="dr-restart-button">Start the draft over</button>.</p>
    </form>
  )}
  <h1 class="dr-title">Read them before you send them</h1>
  <p class="dr-lede">Written for {targetLine}, from your profile and the posting as published. Nothing is submitted for you. When they read right, download and apply.</p>
  {provider && !fallback && <p class="dr-provider mono-label">Drafted on your connected {providerLabel}{model ? ` (${model})` : ''} key.</p>}
  {fallback && <p class="dr-provider dr-provider-fallback mono-label">Your connected {providerLabel ?? 'AI provider'} key could not be used, so the built-in writer wrote it.</p>}

  <input type="radio" name="dr-tab" id="dr-tab-resume" class="dr-tab-input" checked />
  <input type="radio" name="dr-tab" id="dr-tab-cover" class="dr-tab-input" />
  <div class="dr-tabs" role="tablist">
    <div class="dr-tab-group">
      <label class="dr-tab" for="dr-tab-resume">Resumé</label>
      <label class="dr-tab" for="dr-tab-cover">Cover letter</label>
    </div>
    <span class="dr-page-meta dr-page-meta-resume mono">resumé{resumeUpdatedAt ? `, drafted ${timeAgo(resumeUpdatedAt)}` : ''}</span>
    <span class="dr-page-meta dr-page-meta-cover mono">cover letter{coverUpdatedAt ? `, drafted ${timeAgo(coverUpdatedAt)}` : ''}</span>
  </div>

  {/* Two columns (design: resumecoverletterdetails.html data-cols): the paper
      and its actions on the left, the rail on the right. The tab inputs above
      switch both columns at once: a panel is display: contents when its tab is
      checked, so its children sit in the column's own flow. */}
  <div class="dr-cols">
    <section class="dr-main">
      <div class="dr-panel dr-panel-resume">
        {resume ? (
          <>
            <article class="dr-doc" aria-label="Resumé">
              {hasHeader(resume.header) && (
                <header class="dr-doc-contact">
                  {resume.header.name && <p class="dr-doc-name">{resume.header.name}</p>}
                  <p class="dr-doc-lines mono">
                    {resume.header.email}
                    {resume.header.links.map((l) => <><span class="dr-doc-sep"> · </span><a href={l.url} rel="noopener nofollow" target="_blank">{l.label}</a></>)}
                  </p>
                </header>
              )}
              {/* The summary block (tailor.ts summarySlotFor): the record's own
                  facts a skim reads first, before the first experience entry.
                  Marked like a bullet when the model rephrased it on your key. */}
              {resume.summary && (
                <section class="dr-doc-section">
                  <h3 class="dr-doc-heading mono-label">Summary</h3>
                  <p class="dr-doc-line" {...paraAttrs(drafting.resume, resumeShim++)}><span class:list={[{ 'is-tailored': resumeRewrote.has(SUMMARY_LINE_ID) }]}>{resume.summary.text}</span></p>
                </section>
              )}
              {resume.sections.map((section) => (
                <section class="dr-doc-section">
                  <h3 class="dr-doc-heading mono-label">{section.heading}</h3>
                  {groupResumeSection(section).map((row) => (
                    row.kind === 'entry' ? (
                      <div class="dr-doc-entry">
                        <p class="dr-doc-entry-head">
                          <span class="dr-doc-entry-title">{row.entry.core.officialTitle}</span>
                          {entryRange(row.entry) && <span class="dr-doc-entry-dates mono">{entryRange(row.entry)}</span>}
                        </p>
                        {row.entry.core.employerOrInstitution && <p class="dr-doc-entry-org">{row.entry.core.employerOrInstitution}</p>}
                        {row.entry.bullets.length === 0
                          ? DESCRIPTION_KINDS.has(row.entry.kind) && <p class="dr-doc-empty">No description on record.</p>
                          : (
                            <ul class="dr-doc-bullets">
                              {row.entry.bullets.map((b) => <li {...paraAttrs(drafting.resume, resumeShim++)}><span class:list={[{ 'is-tailored': resumeRewrote.has(row.entry.prfId) }]}>{b.text}</span></li>)}
                            </ul>
                          )}
                      </div>
                    ) : (
                      <div class="dr-doc-entry">
                        <p class="dr-doc-entry-head">
                          <span class="dr-doc-entry-title">{row.group.issuer}</span>
                          {groupRange(row.group) && <span class="dr-doc-entry-dates mono">{groupRange(row.group)}</span>}
                        </p>
                        <p class="dr-doc-line">{row.group.titles.join(', ')}</p>
                      </div>
                    )
                  ))}
                </section>
              ))}
            </article>

            <div class="dr-doc-actions">
              {resumeDownloadable && <a class="dr-btn" href={jobDraftPdfPath(slug, 'resume')} download>Download PDF</a>}
              {resumeDownloadable && <a class="dr-btn" href={`${jobDraftPdfPath(slug, 'resume')}?format=docx`} download>Download DOCX</a>}
              {!drafting.resume && <button type="button" class="dr-btn dr-copy">Copy as text</button>}
            </div>
            <p class="dr-highlight-note">Highlighted lines are ones your connected model rephrased for this posting. Everything else is your record's own words, unchanged, so you can tell at a glance what the model touched.</p>
          </>
        ) : (
          <p class="dr-doc-empty">The resumé is still drafting.</p>
        )}
      </div>

      <div class="dr-panel dr-panel-cover">
        {cover ? (
          <>
            <article class="dr-doc" aria-label="Cover letter">
              {hasHeader(cover.header) && (
                <header class="dr-doc-contact">
                  {cover.header.name && <p class="dr-doc-name">{cover.header.name}</p>}
                  <p class="dr-doc-lines mono">
                    {cover.header.email}
                    {cover.header.links.map((l) => <><span class="dr-doc-sep"> · </span><a href={l.url} rel="noopener nofollow" target="_blank">{l.label}</a></>)}
                  </p>
                </header>
              )}
              <p class="dr-doc-salutation">{cover.salutation}</p>
              {cover.paragraphs
                ? cover.paragraphs.map((p) => <p class="dr-doc-para" {...paraAttrs(drafting.cover, coverShim++)}><span class:list={[{ 'is-tailored': p.role === 'proof' || p.role === 'fit' }]}>{p.text}</span></p>)
                : cover.sections.map((section) => section.entries.map((e) => e.bullets.map((b) => <p class="dr-doc-para">{b.text}</p>)))}
              {cover.closing && <p class="dr-doc-closing">{cover.closing}</p>}
            </article>

            <div class="dr-doc-actions">
              {coverDownloadable && <a class="dr-btn" href={jobDraftPdfPath(slug, 'cover')} download>Download PDF</a>}
              {coverDownloadable && <a class="dr-btn" href={`${jobDraftPdfPath(slug, 'cover')}?format=docx`} download>Download DOCX</a>}
              {!drafting.cover && <button type="button" class="dr-btn dr-copy">Copy as text</button>}
            </div>
            <p class="dr-highlight-note">Highlighted paragraphs answer the posting's own requirements. The rest is drawn straight from your record.</p>
          </>
        ) : (
          <p class="dr-doc-empty">The cover letter is still drafting.</p>
        )}
      </div>
    </section>

    <aside class="dr-rail">
      <div class="dr-panel dr-panel-resume">
        {resume && (
          <section class="dr-steer">
            <h2 class="dr-box-title">Not right yet? Steer it</h2>
            <div class:list={['dr-box-body', { 'dr-locked': anyDrafting }]}>
              <form method="POST" action={regenerateAction} class="dr-steer-form" inert={drafting.resume ? true : undefined}>
                <input type="hidden" name="slug" value={slug} />
                <input type="hidden" name="kind" value="resume" />
                <div class="dr-chips">
                  {STEER_CHIPS.map((c) => (
                    <label class="dr-chip"><input type="checkbox" name="steer" value={c.id} /><span>{c.label}</span></label>
                  ))}
                </div>
                <textarea class="dr-steer-note" name="steerNote" rows="3" maxlength="400" placeholder="Or say it in your own words. Example: cut the utility background to one line and open with the agent work."></textarea>
                <button type="submit" class="dr-btn dr-btn-regenerate">Regenerate the resumé</button>
              </form>
              <p class="dr-steer-soon mono">A steer shapes the draft your connected model writes; the built-in writer re-drafts unchanged.</p>
              {costLine(resumeCost) && <p class="dr-cost mono">{costLine(resumeCost)}</p>}
            </div>
            {resumeVersions.length > 1 && (
              <div class="dr-versions">
                <p class="dr-versions-title">Earlier drafts are kept</p>
                <ul class="dr-version-list">
                  {resumeVersions.map((v) => (
                    <li class="dr-version">
                      <span class="dr-version-label">Draft {v.version}{v.isCurrent ? ', current' : ''}</span>
                      {v.isCurrent
                        ? <span class="dr-version-state">Viewing</span>
                        : (v.status === 'ready' || v.status === 'fallback')
                          ? <form method="POST" action={restoreAction}><input type="hidden" name="kind" value="resume" /><input type="hidden" name="versionId" value={v.id} /><button type="submit" class="dr-restore">Restore</button></form>
                          : <span class="dr-version-state">{v.status}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}
      </div>

      <div class="dr-panel dr-panel-cover">
        {cover && (
          <section class="dr-steer">
            <h2 class="dr-box-title">Not right yet? Steer it</h2>
            <div class:list={['dr-box-body', { 'dr-locked': anyDrafting }]}>
              <form method="POST" action={regenerateAction} class="dr-steer-form" inert={drafting.cover ? true : undefined}>
                <input type="hidden" name="slug" value={slug} />
                <input type="hidden" name="kind" value="cover" />
                <div class="dr-chips">
                  {STEER_CHIPS.map((c) => (
                    <label class="dr-chip"><input type="checkbox" name="steer" value={c.id} /><span>{c.label}</span></label>
                  ))}
                </div>
                <textarea class="dr-steer-note" name="steerNote" rows="3" maxlength="400" placeholder="Or say it in your own words. Example: open on why this company, then lead with the platform work."></textarea>
                <button type="submit" class="dr-btn dr-btn-regenerate">Regenerate the cover letter</button>
              </form>
              <p class="dr-steer-soon mono">A steer shapes the draft your connected model writes; the built-in writer re-drafts unchanged.</p>
              {costLine(coverCost) && <p class="dr-cost mono">{costLine(coverCost)}</p>}
            </div>
            {coverVersions.length > 1 && (
              <div class="dr-versions">
                <p class="dr-versions-title">Earlier drafts are kept</p>
                <ul class="dr-version-list">
                  {coverVersions.map((v) => (
                    <li class="dr-version">
                      <span class="dr-version-label">Draft {v.version}{v.isCurrent ? ', current' : ''}</span>
                      {v.isCurrent
                        ? <span class="dr-version-state">Viewing</span>
                        : (v.status === 'ready' || v.status === 'fallback')
                          ? <form method="POST" action={restoreAction}><input type="hidden" name="kind" value="cover" /><input type="hidden" name="versionId" value={v.id} /><button type="submit" class="dr-restore">Restore</button></form>
                          : <span class="dr-version-state">{v.status}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}
      </div>

      <section class="dr-send">
        <h2 class="dr-box-title">Send it</h2>
        <div class:list={['dr-box-body', { 'dr-locked': anyDrafting }]}>
          {applyUrl && (applyTrack ? (
            <form method="POST" action={applyTrack.action} target="_blank">
              <input type="hidden" name="intent" value="click" />
              <input type="hidden" name="url" value={applyUrl} />
              <input type="hidden" name="then" value="posting" />
              <input type="hidden" name="titleOverride" value={applyTrack.title} />
              <input type="hidden" name="companyOverride" value={applyTrack.company} />
              <button type="submit" class="dr-btn dr-send-apply">{applyLabel} &#8599;</button>
            </form>
          ) : (
            <a class="dr-btn dr-send-apply" href={applyUrl} target="_blank" rel="noopener nofollow">{applyLabel} &#8599;</a>
          ))}
          {anyDrafting
            ? <p class="dr-lock-note">Apply opens when the draft lands.</p>
            : <p class="dr-send-note">Opens the posting in a new tab and moves this role to Applied on your desk. You still paste and submit there.</p>}
        </div>
      </section>

      <div class="dr-panel dr-panel-resume">
        {resume?.changeRecord && (
          <section class="dr-changed">
            <h2 class="dr-changed-title">What it changed for this posting</h2>
            <dl class="dr-changed-list">
              {resume.changeRecord.counts.rewrote > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">Rewrote</dt><dd {...paraAttrs(drafting.resume, resumeShim++)}>{resume.changeRecord.counts.rewrote} {resume.changeRecord.counts.rewrote === 1 ? 'line' : 'lines'} rephrased on your key, inside their locked facts.</dd></div>
              )}
              {resume.changeRecord.mirroredTerms.length > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">Added</dt><dd {...paraAttrs(drafting.resume, resumeShim++)}>The posting's own terms ({resume.changeRecord.mirroredTerms.join(', ')}) paired onto skills you already hold.</dd></div>
              )}
              <div class="dr-changed-row"><dt class="dr-changed-verb">Kept</dt><dd {...paraAttrs(drafting.resume, resumeShim++)}>Every date, title, and number exactly as your profile has them.{resume.changeRecord.counts.kept > 0 ? ` ${resume.changeRecord.counts.kept} ${resume.changeRecord.counts.kept === 1 ? 'line is' : 'lines are'} your own words, unchanged.` : ''}</dd></div>
              {/* The gap note (tailor.ts computeGaps, RESUME-RULES.md layer 1:
                  "if the record is thin, ask, do not pad"): what the record is
                  missing, named, with the way to add it. */}
              {resume.gaps && (
                <div class="dr-changed-row"><dt class="dr-changed-verb dr-changed-verb-check">Check</dt><dd {...paraAttrs(drafting.resume, resumeShim++)}>{resume.gaps.missing.join(' ')} <a class="dr-changed-link" href={profilePath}>Add to your Profile Record</a></dd></div>
              )}
            </dl>
            <p class="dr-footer-note mono">Drafted on your own key. Your profile and the posting text only. No other applicant's data was read.</p>
          </section>
        )}
      </div>

      <div class="dr-panel dr-panel-cover">
        {cover?.changeRecord && (cover.changeRecord.counts.rewrote > 0 || cover.changeRecord.counts.kept > 0) && (
          <section class="dr-changed">
            <h2 class="dr-changed-title">What it changed for this posting</h2>
            <dl class="dr-changed-list">
              {cover.changeRecord.counts.rewrote > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">Rewrote</dt><dd {...paraAttrs(drafting.cover, coverShim++)}>{cover.changeRecord.counts.rewrote} {cover.changeRecord.counts.rewrote === 1 ? 'paragraph' : 'paragraphs'} rephrased on your key, from your record's own evidence.</dd></div>
              )}
              <div class="dr-changed-row"><dt class="dr-changed-verb">Kept</dt><dd {...paraAttrs(drafting.cover, coverShim++)}>Every claim traces to a role, date, or fact in your profile. Nothing was invented for this letter.</dd></div>
            </dl>
            <p class="dr-footer-note mono">Drafted on your own key. Your profile and the posting text only. No other applicant's data was read.</p>
          </section>
        )}
      </div>
    </aside>
  </div>
</article>

<script>
  for (const btn of document.querySelectorAll('.dr-copy')) {
    btn.addEventListener('click', async () => {
      const doc = (btn as HTMLElement).closest('.dr-panel')?.querySelector('.dr-doc');
      const text = (doc as HTMLElement | null)?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const was = btn.textContent;
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = was; }, 1500);
      } catch {
        // Clipboard blocked: leave the label as-is rather than claim success.
      }
    });
  }
</script>

