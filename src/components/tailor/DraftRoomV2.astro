---
/**
 * DraftRoomV2.astro: the pixel-perfect "Your documents" draft room (design:
 * resumecoverletterdetails.html), the ready-state screen a person sees after the
 * one-click draft finishes. It renders the resume and cover letter that were
 * drafted for one posting, read back from storage, with a tab per document, the
 * download and apply actions, the earlier versions kept (db/202), and the honest
 * change record (tailor.ts ChangeRecord: KEPT vs REWROTE, derived by
 * byte-comparison, never narrated).
 *
 * WHAT IS REAL HERE, AND WHAT IS DEFERRED. Everything shown is the render's own
 * data: the document text, the per-line highlight (a line a connected model
 * rephrased inside its locked slot, from changeRecord), the versions, and the
 * PDF and DOCX downloads (src/pages/desk/job-draft/[slug]/[doc].ts). The "Steer
 * it" chips are shown but not yet wired to steered regeneration; the plain
 * Regenerate re-drafts on the key now, and the panel says so rather than
 * pretending the chips work. A cost line is left out until token capture lands,
 * because a number we cannot measure is one we do not print.
 *
 * The drafting, failed and empty states are NOT here: the page keeps those, and
 * this component renders only once at least one document is ready.
 */
import { groupResumeSection, type ResumeGroup } from '../../lib/resume-grouping';
import { DESCRIPTION_KINDS } from '../../lib/tailor';
import type { ResumeRender, CoverRender, RenderEntry, RenderHeader } from '../../lib/tailor';
import type { RenderVersionRow, DocumentState } from '../../lib/generated-render-store';
import { jobDraftPath, jobDraftPdfPath } from '../../data/nav';

interface Props {
  slug: string;
  jobTitle: string | null;
  company: string;
  postingHref: string;
  resume: ResumeRender | null;
  cover: CoverRender | null;
  resumeState: DocumentState;
  coverState: DocumentState;
  resumeFailureReason: string | null;
  coverFailureReason: string | null;
  resumeVersions: RenderVersionRow[];
  coverVersions: RenderVersionRow[];
  resumeUpdatedAt: string | null;
  coverUpdatedAt: string | null;
  resumeDownloadable: boolean;
  coverDownloadable: boolean;
  provider: string | null;
  model: string | null;
  fallback: boolean;
  regenerateAction: string;
  applyUrl: string | null;
  applyLabel: string;
  applyTrack: { action: string; title: string; company: string } | null;
  resumeCost?: DraftCost | null;
  coverCost?: DraftCost | null;
}

/** What one document's draft cost to run, all real: the render duration and the
    tokens the provider billed, plus the dollar estimate from the dated price
    table (null when the model is unpriced), or a plain "no model cost" for the
    deterministic built-in writer. */
interface DraftCost {
  costText: string | null;
  asOf: string | null;
  renderMs: number | null;
  inputTokens: number | null;
  outputTokens: number | null;
  deterministic: boolean;
}
const {
  slug,
  jobTitle,
  company,
  postingHref,
  resume,
  cover,
  resumeState,
  coverState,
  resumeFailureReason,
  coverFailureReason,
  resumeVersions,
  coverVersions,
  resumeUpdatedAt,
  coverUpdatedAt,
  resumeDownloadable,
  coverDownloadable,
  provider,
  model,
  fallback,
  regenerateAction,
  applyUrl,
  applyLabel,
  applyTrack,
  resumeCost = null,
  coverCost = null
} = Astro.props;

function fmtTok(n: number): string {
  return n >= 1000 ? `${Math.round(n / 100) / 10}k` : String(n);
}
/** The cost/usage line under Regenerate: real duration and tokens, then the
    dated dollar estimate when the model is priced, or "no model cost" for the
    built-in writer. Null when there is nothing measured to say. */
function costLine(c: DraftCost | null): string | null {
  if (!c) return null;
  if (c.deterministic) return 'Built-in writer. No model cost.';
  const parts: string[] = [];
  if (c.renderMs && c.renderMs > 0) parts.push(`${Math.max(1, Math.round(c.renderMs / 1000))}s`);
  if (c.inputTokens != null && c.outputTokens != null) parts.push(`${fmtTok(c.inputTokens)} in / ${fmtTok(c.outputTokens)} out`);
  if (parts.length === 0 && !c.costText) return null;
  const base = parts.length > 0 ? `Drafted on your key: ${parts.join(', ')}.` : 'Drafted on your key.';
  return c.costText ? `${base} ${c.costText}${c.asOf ? ` (est., prices as of ${c.asOf})` : ''}` : base;
}

const targetLine = jobTitle ? `${jobTitle} at ${company}` : company;
const bothReady = Boolean(resume) && Boolean(cover);
const readyCount = (resume ? 1 : 0) + (cover ? 1 : 0);
const restoreAction = `${jobDraftPath(slug)}/restore`;
const PROVIDER_LABELS: Record<string, string> = { anthropic: 'Anthropic', openai: 'OpenAI', kimi: 'Kimi', deepseek: 'DeepSeek' };
const providerLabel = provider ? PROVIDER_LABELS[provider] ?? provider : null;

const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
function md(year: number, month: number | null): string {
  return month === null ? String(year) : `${MONTHS[month - 1]} ${year}`;
}
function entryRange(entry: RenderEntry): string {
  return `${md(entry.core.start.year, entry.core.start.month)} to ${entry.core.end === null ? 'Present' : md(entry.core.end.year, entry.core.end.month)}`;
}
function groupRange(group: ResumeGroup): string {
  return `${md(group.start.year, group.start.month)} to ${group.end === null ? 'Present' : md(group.end.year, group.end.month)}`;
}
/** A stored instant as a short, honest "N units ago", never a fake clock. */
function timeAgo(iso: string | null): string | null {
  if (!iso) return null;
  const then = Date.parse(iso);
  if (Number.isNaN(then)) return null;
  const secs = Math.max(0, Math.round((Date.now() - then) / 1000));
  if (secs < 60) return 'just now';
  const mins = Math.round(secs / 60);
  if (mins < 60) return `${mins} ${mins === 1 ? 'minute' : 'minutes'} ago`;
  const hrs = Math.round(mins / 60);
  if (hrs < 24) return `${hrs} ${hrs === 1 ? 'hour' : 'hours'} ago`;
  const days = Math.round(hrs / 24);
  return `${days} ${days === 1 ? 'day' : 'days'} ago`;
}
function hasHeader(header: RenderHeader | null | undefined): header is RenderHeader {
  return !!header && (header.name !== null || header.links.length > 0 || !!header.email);
}
/** The prfIds a connected model rephrased, from the change record: the honest
    set of "tailored" lines to highlight. Empty for a deterministic draft. */
function rewroteSet(render: ResumeRender | CoverRender | null): Set<string> {
  const out = new Set<string>();
  for (const e of render?.changeRecord?.perEntry ?? []) if (e.verdict === 'REWROTE') out.add(e.prfId);
  return out;
}
const resumeRewrote = rewroteSet(resume);

// The steer chips: ids match draft-steer.ts's allowlist (the endpoint drops
// anything else), labels are the UI's own. A checked chip posts its id as a
// `steer` value; the note posts as `steerNote`.
const STEER_CHIPS: readonly { id: string; label: string }[] = [
  { id: 'shorter', label: 'Shorter' },
  { id: 'lead-agent', label: 'Lead with agent work' },
  { id: 'plainer', label: 'Plainer voice' },
  { id: 'technical', label: 'More technical' }
];
---

<article
  class="dr"
  data-slug={slug}
  data-status-url={`${jobDraftPath(slug)}/status`}
  data-self-url={jobDraftPath(slug)}
  data-resume-state={resumeState}
  data-cover-state={coverState}
>
  <nav class="dr-crumbs" aria-label="Breadcrumb">
    <a href={postingHref}>&larr; Back to the posting</a>
    <span class="dr-crumb-sep" aria-hidden="true">/</span>
    <span class="dr-crumb-role">{targetLine}</span>
    <span class="dr-crumb-sep" aria-hidden="true">/</span>
    <span class="dr-crumb-here">Your documents</span>
  </nav>

  <p class="dr-status">
    <span class="dr-dot" aria-hidden="true"></span>
    <strong>{bothReady ? 'Both documents drafted' : (resume ? 'Resume drafted' : 'Cover letter drafted')}</strong>
    {resumeUpdatedAt && <span class="dr-status-sub mono-label">drafted {timeAgo(resumeUpdatedAt)}</span>}
  </p>
  <h1 class="dr-title">Read them before you send them</h1>
  <p class="dr-lede">Written for {targetLine}, from your profile and the posting as published. Nothing is submitted for you. When they read right, download and apply.</p>
  {provider && !fallback && <p class="dr-provider mono-label">Drafted on your connected {providerLabel}{model ? ` (${model})` : ''} key.</p>}
  {fallback && <p class="dr-provider dr-provider-fallback mono-label">Your connected {providerLabel ?? 'AI provider'} key could not be used, so the built-in writer wrote it.</p>}

  <input type="radio" name="dr-tab" id="dr-tab-resume" class="dr-tab-input" checked />
  <input type="radio" name="dr-tab" id="dr-tab-cover" class="dr-tab-input" />
  <div class="dr-tabs" role="tablist">
    <label class="dr-tab" for="dr-tab-resume">Resume</label>
    <label class="dr-tab" for="dr-tab-cover">Cover letter</label>
  </div>

  <section class="dr-panel dr-panel-resume" aria-label="Resume">
    {resume ? (
      <>
        <p class="dr-doc-meta mono-label">resume{resumeUpdatedAt ? `, drafted ${timeAgo(resumeUpdatedAt)}` : ''}</p>
        <article class="dr-doc dr-preprint" data-print-key={`resume:${resumeUpdatedAt ?? ''}`}>
          {hasHeader(resume.header) && (
            <header class="dr-doc-contact">
              {resume.header.name && <p class="dr-doc-name">{resume.header.name}</p>}
              <p class="dr-doc-lines mono">
                {resume.header.email}
                {resume.header.links.map((l) => <><span class="dr-doc-sep"> · </span><a href={l.url} rel="noopener nofollow" target="_blank">{l.label}</a></>)}
              </p>
            </header>
          )}
          {resume.sections.map((section) => (
            <section class="dr-doc-section">
              <h3 class="dr-doc-heading mono-label">{section.heading}</h3>
              {groupResumeSection(section).map((row) => (
                row.kind === 'entry' ? (
                  <div class="dr-doc-entry">
                    <p class="dr-doc-entry-head">
                      <span class="dr-doc-entry-title">{row.entry.core.officialTitle}</span>
                      <span class="dr-doc-entry-dates mono">{entryRange(row.entry)}</span>
                    </p>
                    {row.entry.core.employerOrInstitution && <p class="dr-doc-entry-org mono">{row.entry.core.employerOrInstitution}</p>}
                    {row.entry.bullets.length === 0
                      ? DESCRIPTION_KINDS.has(row.entry.kind) && <p class="dr-doc-empty">No description on record.</p>
                      : row.entry.bullets.map((b) => <p class:list={['dr-doc-line', { 'is-tailored': resumeRewrote.has(row.entry.prfId) }]}>{b.text}</p>)}
                  </div>
                ) : (
                  <div class="dr-doc-entry">
                    <p class="dr-doc-entry-head">
                      <span class="dr-doc-entry-title">{row.group.issuer}</span>
                      <span class="dr-doc-entry-dates mono">{groupRange(row.group)}</span>
                    </p>
                    <p class="dr-doc-line">{row.group.titles.join(', ')}</p>
                  </div>
                )
              ))}
            </section>
          ))}
        </article>

        <div class="dr-doc-actions">
          {resumeDownloadable && <a class="dr-btn" href={jobDraftPdfPath(slug, 'resume')} download>Download PDF</a>}
          {resumeDownloadable && <a class="dr-btn" href={`${jobDraftPdfPath(slug, 'resume')}?format=docx`} download>Download DOCX</a>}
          <button type="button" class="dr-btn dr-copy">Copy as text</button>
        </div>
        <p class="dr-highlight-note">Highlighted lines are ones your connected model rephrased for this posting. Everything else is your record's own words, unchanged, so you can tell at a glance what the model touched.</p>

        <section class="dr-steer">
          <h2 class="dr-steer-title">Not right yet? Steer it</h2>
          <form method="POST" action={regenerateAction} class="dr-steer-form">
            <input type="hidden" name="slug" value={slug} />
            <input type="hidden" name="kind" value="resume" />
            <div class="dr-chips">
              {STEER_CHIPS.map((c) => (
                <label class="dr-chip"><input type="checkbox" name="steer" value={c.id} /><span>{c.label}</span></label>
              ))}
            </div>
            <textarea class="dr-steer-note" name="steerNote" rows="2" maxlength="400" placeholder="Or say it in your own words. Example: cut the utility background to one line and open with the agent work."></textarea>
            <button type="submit" class="dr-btn dr-btn-primary">Regenerate the resume</button>
          </form>
          <p class="dr-steer-soon mono-label">A steer shapes the draft your connected model writes; the built-in writer re-drafts unchanged.</p>
          {costLine(resumeCost) && <p class="dr-cost mono-label">{costLine(resumeCost)}</p>}
        </section>

        {resumeVersions.length > 1 && (
          <section class="dr-versions">
            <h2 class="dr-versions-title mono-label">Earlier drafts are kept</h2>
            <ul class="dr-version-list">
              {resumeVersions.map((v) => (
                <li class="dr-version">
                  <span class="dr-version-label">Draft {v.version}{v.isCurrent ? ', current' : ''}</span>
                  {v.isCurrent
                    ? <span class="dr-version-state mono-label">Viewing</span>
                    : (v.status === 'ready' || v.status === 'fallback')
                      ? <form method="POST" action={restoreAction}><input type="hidden" name="kind" value="resume" /><input type="hidden" name="versionId" value={v.id} /><button type="submit" class="dr-restore">Restore</button></form>
                      : <span class="dr-version-state mono-label">{v.status}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {resume.changeRecord && (
          <section class="dr-changed">
            <h2 class="dr-changed-title">What it changed for this posting</h2>
            <dl class="dr-changed-list">
              {resume.changeRecord.counts.rewrote > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">REWROTE</dt><dd>{resume.changeRecord.counts.rewrote} {resume.changeRecord.counts.rewrote === 1 ? 'line' : 'lines'} rephrased on your key, inside their locked facts.</dd></div>
              )}
              {resume.changeRecord.mirroredTerms.length > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">ADDED</dt><dd>The posting's own terms ({resume.changeRecord.mirroredTerms.join(', ')}) paired onto skills you already hold.</dd></div>
              )}
              <div class="dr-changed-row"><dt class="dr-changed-verb">KEPT</dt><dd>Every date, title, and number exactly as your profile has them.{resume.changeRecord.counts.kept > 0 ? ` ${resume.changeRecord.counts.kept} ${resume.changeRecord.counts.kept === 1 ? 'line is' : 'lines are'} your own words, unchanged.` : ''}</dd></div>
            </dl>
          </section>
        )}
      </>
    ) : resumeState === 'failed' ? (
      <div class="dr-doc-failed" role="alert">
        <p class="dr-doc-failed-title">The resume did not finish</p>
        <p class="dr-doc-failed-detail">The reason: {resumeFailureReason ?? 'it did not finish in time'}. Nothing partial was kept.</p>
        <form method="POST" action={regenerateAction} class="dr-doc-failed-form">
          <input type="hidden" name="slug" value={slug} />
          <input type="hidden" name="kind" value="resume" />
          <button type="submit" class="dr-btn dr-btn-primary">Draft the resume again</button>
        </form>
      </div>
    ) : (
      <div class="dr-writing" role="status" aria-live="polite">
        <p class="dr-writing-label">Writing your resume<span class="dr-writing-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span><span class="dr-caret dr-caret-idle" aria-hidden="true"></span></p>
        <p class="dr-writing-sub mono-label">Reading your record and the posting, line by line. It prints here the moment it is verified.</p>
        <div class="dr-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    )}
  </section>

  <section class="dr-panel dr-panel-cover" aria-label="Cover letter">
    {cover ? (
      <>
        <p class="dr-doc-meta mono-label">cover letter{coverUpdatedAt ? `, drafted ${timeAgo(coverUpdatedAt)}` : ''}</p>
        <article class="dr-doc dr-preprint" data-print-key={`cover:${coverUpdatedAt ?? ''}`}>
          {hasHeader(cover.header) && (
            <header class="dr-doc-contact">
              {cover.header.name && <p class="dr-doc-name">{cover.header.name}</p>}
              <p class="dr-doc-lines mono">
                {cover.header.email}
                {cover.header.links.map((l) => <><span class="dr-doc-sep"> · </span><a href={l.url} rel="noopener nofollow" target="_blank">{l.label}</a></>)}
              </p>
            </header>
          )}
          <p class="dr-doc-salutation">{cover.salutation}</p>
          {cover.paragraphs
            ? cover.paragraphs.map((p) => <p class:list={['dr-doc-para', { 'is-tailored': p.role === 'proof' || p.role === 'fit' }]}>{p.text}</p>)
            : cover.sections.map((section) => section.entries.map((e) => e.bullets.map((b) => <p class="dr-doc-para">{b.text}</p>)))}
          {cover.closing && <p class="dr-doc-closing">{cover.closing}</p>}
        </article>

        <div class="dr-doc-actions">
          {coverDownloadable && <a class="dr-btn" href={jobDraftPdfPath(slug, 'cover')} download>Download PDF</a>}
          {coverDownloadable && <a class="dr-btn" href={`${jobDraftPdfPath(slug, 'cover')}?format=docx`} download>Download DOCX</a>}
          <button type="button" class="dr-btn dr-copy">Copy as text</button>
        </div>
        <p class="dr-highlight-note">Highlighted paragraphs answer the posting's own requirements. The rest is drawn straight from your record.</p>

        <section class="dr-steer">
          <h2 class="dr-steer-title">Not right yet? Steer it</h2>
          <form method="POST" action={regenerateAction} class="dr-steer-form">
            <input type="hidden" name="slug" value={slug} />
            <input type="hidden" name="kind" value="cover" />
            <div class="dr-chips">
              {STEER_CHIPS.map((c) => (
                <label class="dr-chip"><input type="checkbox" name="steer" value={c.id} /><span>{c.label}</span></label>
              ))}
            </div>
            <textarea class="dr-steer-note" name="steerNote" rows="2" maxlength="400" placeholder="Or say it in your own words. Example: open on why this company, then lead with the platform work."></textarea>
            <button type="submit" class="dr-btn dr-btn-primary">Regenerate the cover letter</button>
          </form>
          <p class="dr-steer-soon mono-label">A steer shapes the draft your connected model writes; the built-in writer re-drafts unchanged.</p>
          {costLine(coverCost) && <p class="dr-cost mono-label">{costLine(coverCost)}</p>}
        </section>

        {coverVersions.length > 1 && (
          <section class="dr-versions">
            <h2 class="dr-versions-title mono-label">Earlier drafts are kept</h2>
            <ul class="dr-version-list">
              {coverVersions.map((v) => (
                <li class="dr-version">
                  <span class="dr-version-label">Draft {v.version}{v.isCurrent ? ', current' : ''}</span>
                  {v.isCurrent
                    ? <span class="dr-version-state mono-label">Viewing</span>
                    : (v.status === 'ready' || v.status === 'fallback')
                      ? <form method="POST" action={restoreAction}><input type="hidden" name="kind" value="cover" /><input type="hidden" name="versionId" value={v.id} /><button type="submit" class="dr-restore">Restore</button></form>
                      : <span class="dr-version-state mono-label">{v.status}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
        {cover.changeRecord && (cover.changeRecord.counts.rewrote > 0 || cover.changeRecord.counts.kept > 0) && (
          <section class="dr-changed">
            <h2 class="dr-changed-title">What it changed for this posting</h2>
            <dl class="dr-changed-list">
              {cover.changeRecord.counts.rewrote > 0 && (
                <div class="dr-changed-row"><dt class="dr-changed-verb">REWROTE</dt><dd>{cover.changeRecord.counts.rewrote} {cover.changeRecord.counts.rewrote === 1 ? 'paragraph' : 'paragraphs'} rephrased on your key, from your record's own evidence.</dd></div>
              )}
              <div class="dr-changed-row"><dt class="dr-changed-verb">KEPT</dt><dd>Every claim traces to a role, date, or fact in your profile. Nothing was invented for this letter.</dd></div>
            </dl>
          </section>
        )}
      </>
    ) : coverState === 'failed' ? (
      <div class="dr-doc-failed" role="alert">
        <p class="dr-doc-failed-title">The cover letter did not finish</p>
        <p class="dr-doc-failed-detail">The reason: {coverFailureReason ?? 'it did not finish in time'}. Nothing partial was kept.</p>
        <form method="POST" action={regenerateAction} class="dr-doc-failed-form">
          <input type="hidden" name="slug" value={slug} />
          <input type="hidden" name="kind" value="cover" />
          <button type="submit" class="dr-btn dr-btn-primary">Draft the cover letter again</button>
        </form>
      </div>
    ) : (
      <div class="dr-writing" role="status" aria-live="polite">
        <p class="dr-writing-label">Writing your cover letter<span class="dr-writing-dots" aria-hidden="true"><span>.</span><span>.</span><span>.</span></span><span class="dr-caret dr-caret-idle" aria-hidden="true"></span></p>
        <p class="dr-writing-sub mono-label">Drawing the letter from your record's own evidence. It prints here the moment it is verified.</p>
        <div class="dr-skeleton" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      </div>
    )}
  </section>

  <section class="dr-send">
    <h2 class="dr-send-title mono-label">Send it</h2>
    {applyUrl && (applyTrack ? (
      <form method="POST" action={applyTrack.action} target="_blank">
        <input type="hidden" name="intent" value="click" />
        <input type="hidden" name="url" value={applyUrl} />
        <input type="hidden" name="then" value="posting" />
        <input type="hidden" name="titleOverride" value={applyTrack.title} />
        <input type="hidden" name="companyOverride" value={applyTrack.company} />
        <button type="submit" class="dr-btn dr-btn-primary dr-send-apply">{applyLabel} &#8599;</button>
      </form>
    ) : (
      <a class="dr-btn dr-btn-primary dr-send-apply" href={applyUrl} target="_blank" rel="noopener nofollow">{applyLabel} &#8599;</a>
    ))}
    <p class="dr-send-note">Opens the posting in a new tab and moves this role to Applied on your desk. You still paste and submit there.</p>
    <p class="dr-footer-note mono-label">Drafted on your own key. Your profile and the posting text only. No other applicant's data was read.</p>
  </section>
</article>

<noscript><style>.dr-doc.dr-preprint { visibility: visible; }</style></noscript>

<script>
  // The draft room's client behaviour: copy-as-text, the live typewriter reveal
  // of each verified document, and an in-place poller that prints the second
  // document the moment it lands. Everything here is presentation over text the
  // server already verified; nothing unverified is ever shown (a document only
  // reaches this component once its row is 'ready'/'fallback').

  function bindCopy(scope: ParentNode) {
    for (const btn of scope.querySelectorAll('.dr-copy')) {
      btn.addEventListener('click', async () => {
        const doc = (btn as HTMLElement).closest('.dr-panel')?.querySelector('.dr-doc');
        const text = (doc as HTMLElement | null)?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(text);
          const was = btn.textContent;
          btn.textContent = 'Copied';
          setTimeout(() => { btn.textContent = was; }, 1500);
        } catch {
          // Clipboard blocked: leave the label as-is rather than claim success.
        }
      });
    }
  }

  const REVEAL_BUDGET_MS = 2600;
  const prefersReduced = typeof window.matchMedia === 'function'
    && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function markSeen(key: string) {
    try { sessionStorage.setItem('drprint:' + key, '1'); } catch { /* private mode: fine */ }
  }
  function wasSeen(key: string): boolean {
    try { return sessionStorage.getItem('drprint:' + key) === '1'; } catch { return false; }
  }

  // Reveal one document with a word-by-word print and a trailing caret. The text
  // is already in the DOM (verified server-side); we only stage its appearance.
  // Words are wrapped so we can raise them one at a time; the wrapping targets
  // the class the CSS hides ONLY under .dr-armed, so a document that never gets
  // armed (no JS, reduced motion, or a revisit) stays fully visible.
  function revealDoc(doc: HTMLElement) {
    if (!doc || doc.dataset.printed === '1') return;
    doc.dataset.printed = '1';
    const key = doc.dataset.printKey || '';

    if (prefersReduced || wasSeen(key)) {
      doc.classList.remove('dr-preprint');
      markSeen(key);
      return;
    }

    const walker = document.createTreeWalker(doc, NodeFilter.SHOW_TEXT, {
      acceptNode: (n) => (n.nodeValue && n.nodeValue.trim()) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT
    });
    const textNodes: Text[] = [];
    let tn: Node | null;
    while ((tn = walker.nextNode())) textNodes.push(tn as Text);

    const words: HTMLElement[] = [];
    for (const node of textNodes) {
      const frag = document.createDocumentFragment();
      for (const part of (node.nodeValue || '').split(/(\s+)/)) {
        if (part === '') continue;
        if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); continue; }
        const span = document.createElement('span');
        span.className = 'dr-w';
        span.textContent = part;
        frag.appendChild(span);
        words.push(span);
      }
      node.parentNode && node.parentNode.replaceChild(frag, node);
    }

    doc.classList.remove('dr-preprint');
    if (words.length === 0) { markSeen(key); return; }
    doc.classList.add('dr-armed');

    const caret = document.createElement('span');
    caret.className = 'dr-caret';
    caret.setAttribute('aria-hidden', 'true');
    const per = Math.min(40, Math.max(8, Math.round(REVEAL_BUDGET_MS / words.length)));
    let i = 0;
    function step() {
      if (i >= words.length) {
        caret.remove();
        doc.classList.remove('dr-armed');
        doc.classList.add('dr-printed');
        markSeen(key);
        return;
      }
      const w = words[i++];
      w.classList.add('dr-w-on');
      w.insertAdjacentElement('afterend', caret);
      window.setTimeout(step, per);
    }
    step();
  }

  function revealAll(scope: ParentNode) {
    for (const doc of scope.querySelectorAll('.dr-doc[data-print-key]')) revealDoc(doc as HTMLElement);
  }

  // Initial pass: bind and print whatever is already on the page.
  bindCopy(document);
  revealAll(document);

  // The poller: while a document is still drafting, ask the status endpoint (the
  // same pure state the room reads), and when a pending kind settles, fetch the
  // room's own HTML, lift that one panel in, and print it. A settled document is
  // never re-fetched, and a full reload is never issued, so a print in flight in
  // the other panel is never torn down.
  const article = document.querySelector('.dr') as HTMLElement | null;
  const statusUrl = article?.dataset.statusUrl || '';
  const selfUrl = article?.dataset.selfUrl || '';
  const state: Record<'resume' | 'cover', string> = {
    resume: article?.dataset.resumeState || 'none',
    cover: article?.dataset.coverState || 'none'
  };
  const stillPending = () => state.resume === 'pending' || state.cover === 'pending';

  async function injectKind(kind: 'resume' | 'cover') {
    try {
      const res = await fetch(selfUrl, { headers: { accept: 'text/html' } });
      if (!res.ok) return;
      const parsed = new DOMParser().parseFromString(await res.text(), 'text/html');
      const fresh = parsed.querySelector('.dr-panel-' + kind);
      const live = document.querySelector('.dr-panel-' + kind);
      if (!fresh || !live) return;
      live.innerHTML = fresh.innerHTML;
      const pairs: [string, string][] = [['.dr-status', '.dr-status']];
      for (const [sel] of pairs) {
        const f = parsed.querySelector(sel);
        const l = document.querySelector(sel);
        if (f && l) l.innerHTML = f.innerHTML;
      }
      bindCopy(live);
      revealAll(live);
    } catch {
      // Network hiccup: the next tick tries again.
    }
  }

  async function tick() {
    try {
      const res = await fetch(statusUrl, { headers: { accept: 'application/json' } });
      if (res.ok) {
        const j = await res.json();
        for (const kind of ['resume', 'cover'] as const) {
          const next = j[kind]?.status;
          if (state[kind] === 'pending' && next && next !== 'pending') {
            state[kind] = next;
            await injectKind(kind);
          }
        }
      }
    } catch {
      // Ignore and keep polling until both kinds are terminal.
    }
    if (stillPending()) window.setTimeout(tick, 1300);
  }

  if (statusUrl && stillPending()) window.setTimeout(tick, 1300);
</script>

