  /* A line the connected model rephrased: marked inline, wrapping with the
     text (design: --color-mark with box-decoration-break: clone).

     THE COLOUR IS A TOKEN NOW, AND THE TEXT INHERITS. This rule used to carry a
     raw rgb(239, 231, 200) with a raw #0b0b0d on top. --color-tailor-highlight
     did not exist, so the fallback won in BOTH themes: on ink it painted a cream
     slab with near-black text on a gray.900 card, and since box-decoration-break
     gives every wrapped line its own box, the right edge came out ragged. It
     read as a broken image on /how-it-works, which is how it was found — nobody
     had looked at a real draft in dark mode. The var() had a fallback, so the
     tokens gate could not see it either: valid CSS, no missing variable, wrong
     picture. `color: inherit` rather than a second token, because the right
     answer in both themes is the page's own foreground on its own highlight. */
  .is-tailored { background: var(--color-tailor-highlight); box-decoration-break: clone; -webkit-box-decoration-break: clone; padding: 2px 0; color: inherit; }

  /* ---- The focus-pull reveal (design: ani.html; docs/draft-loading-spec.md).
     Keyframes, durations and easings are the example's, unchanged. State lives
     on data-state; --shim is the line's place in the cascade.

     WHAT THE MOTION CLAIMS. The shimmer says "this document is being written",
     which is true for as long as the draft row is pending. It does NOT claim
     per-line progress: the backend hands back one payload, so the cascade on
     arrival is motion, not measurement. No line says it was written at the
     moment it unblurs. */
  @keyframes dr-shimmer { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
  @keyframes dr-focus-in { from { filter: blur(6px); opacity: 0.45; } to { filter: blur(0); opacity: 1; } }
  @keyframes dr-sweep { from { background-size: 0% 100%; } to { background-size: 100% 100%; } }
  @keyframes dr-pulse { 0%, 100% { opacity: 1; transform: scale(1); } 50% { opacity: 0.4; transform: scale(0.78); } }

  [data-para] { position: relative; }

  [data-para][data-state="drafting"] {
    display: block;
    overflow: hidden;
    filter: blur(6px);
    opacity: 0.45;
    user-select: none;
    -webkit-user-select: none;
    pointer-events: none;
  }
  /* The travelling sheen. It sits above the blurred text, inherits the line's
     own --shim so the sweep walks down the page, and is pointer-transparent so
     it never eats a click on a line that has already landed. */
  [data-para][data-state="drafting"]::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, transparent 25%, var(--color-shimmer) 50%, transparent 75%);
    transform: translateX(-100%);
    animation: dr-shimmer 1.6s ease-in-out infinite;
    animation-delay: var(--shim, 0ms);
  }

  /* A finished document is inert. No animation, no delay, nothing to wait for:
     this is what a refresh and a bookmark get. */

  /* Arrival, and ONLY arrival. The whole cascade hangs off one marker that the
     poll sets on <html> before it reloads, having watched a run finish; the
     inline script below reads it before this markup is parsed, so the first
     paint is already blurred and there is no flash of sharp text. Without the
     marker every selector here fails and the document is simply sharp. */
  :root[data-dr-revealed] [data-para][data-state="settled"] {
    animation: dr-focus-in 260ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
    animation-delay: var(--shim, 0ms);
  }
  /* The highlight sweeps in after the line is already sharp, so the eye reads
     the words first and the mark second. Only lines the model actually
     rephrased carry .is-tailored, so this marks real rewrites. */
  :root[data-dr-revealed] [data-para][data-state="settled"] .is-tailored {
    background-image: linear-gradient(var(--color-tailor-highlight), var(--color-tailor-highlight));
    background-color: transparent;
    background-repeat: no-repeat;
    animation: dr-sweep 350ms ease-out both;
    animation-delay: calc(var(--shim, 0ms) + 260ms);
  }

