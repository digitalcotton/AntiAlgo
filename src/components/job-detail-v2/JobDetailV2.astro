            <input type="hidden" name="url" value={applyUrl} />
            <input type="hidden" name="then" value="posting" />
            {applyTrack.title && <input type="hidden" name="titleOverride" value={applyTrack.title} />}
            <input type="hidden" name="companyOverride" value={applyTrack.company} />
            <button type="submit" class:list={applyClass}>Apply on {ats} &#8599;</button>
          </form>
        ) : (
          <a class:list={applyClass} href={applyUrl} target="_blank" rel="noopener nofollow">Apply on {ats} &#8599;</a>
