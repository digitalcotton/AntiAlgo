        {!isClosed && (signedIn ? (
          <form class="jd-save-form" method="POST" action={routeFor('desk-save')}>
            <input type="hidden" name="intent" value="save" />
            <input type="hidden" name="url" value={applyUrl ?? ''} />
            <button type="submit" class="jd-link jd-link-save">Save to the desk</button>
          </form>
        ) : (
          <a class="jd-link jd-link-save" href={signInHref}>Save to the desk</a>
        ))}
      </div>
    </div>
  </div>

  <!-- row 2: description (left) and fit card / sign-in prompt (right) -->
  <div class="jd-body-row">
    <div class="jd-body-main">
      <!-- description, verbatim -->
      <DescriptionSlot job={job} class="jd-desc" />

      {!isClosed && (
        <p class="jd-fresh">
          {/* "still live as of this morning's sweep" was the third copy, and the
              worst of the three: "this morning" is a claim about the reader's
              day that the server cannot make at all, and it sat directly under
              the description a reader has just finished reading. What the record
              supports is the date it was last seen live, which is what this says
              until the reader's clock can say more. */}
          <span data-jd-fresh>
            {ageDays !== null
              ? `${ageDays} ${ageDays === 1 ? 'day' : 'days'} old, and live when we last read it on ${formatDate(lastVerifiedIso) ?? lastVerifiedIso}.`
              : `Live when we last read it on ${formatDate(lastVerifiedIso) ?? lastVerifiedIso}.`}
          </span>{' '}
          Most applications land in the first 96 hours.
        </p>
      )}
    </div>

  </div>
</article>

<!--
  THE READER'S CLOCK, FOR THE THREE SENTENCES THAT USED TO BE CONSTANTS.

  Everything the server rendered above is a floor: true when it was sent, and
  phrased so it stays true however long the page sits. This raises it. It reads
  the posting's own last-verified instant and the age's start date off the
  article, subtracts them from the device's clock, and writes the four places
  that talk about age or freshness.

  It upgrades as well as downgrades, and the asymmetry is the point. The server
  never claims the posting is current, because it cannot know; inside the window
  this says "this sweep", and past it this says how long it has actually been.
  So the optimistic reading only ever exists where a clock has backed it.

  A clock skewed backwards reads negative, which is not freshness and not
  staleness, so a negative age is left entirely alone rather than used to make a
  claim about an employer's posting on the strength of a wrong device clock.
  A closed posting is skipped: it makes no freshness claim to decay, and its
  wording was already honest.
-->
<script is:inline>
  (function () {
    var root = document.querySelector('[data-jd-age]');
    if (!root || root.getAttribute('data-closed') === 'true') return;

    var hours = parseFloat(root.getAttribute('data-fresh-hours'));
    if (!(hours > 0)) hours = 36;

    var set = function (sel, text) {
      var el = root.querySelector(sel);
      if (el) el.textContent = text;
    };
    var plural = function (n, word) {
      return n + ' ' + word + (n === 1 ? '' : 's');
    };

    // How long since this posting was last read at the source. Drives the two
    // "verified" sentences and the freshness line.
    var verified = Date.parse(root.getAttribute('data-swept') || '');
    if (!isNaN(verified)) {
      var since = (Date.now() - verified) / 3600000;
      if (since >= 0) {
        var stale = since >= hours;
        var whole = Math.floor(since);
        var ago = whole >= 48 ? plural(Math.floor(whole / 24), 'day') : plural(whole, 'hour');

        set('[data-jd-verified-strong]', stale
          ? 'Last verified ' + ago + ' ago at the source'
          : 'Verified this sweep at the source');
        set('[data-jd-verified-short]', stale ? 'Last verified ' + ago + ' ago' : 'Verified this sweep');
        if (stale) root.setAttribute('data-stale', '');
      }
    }

    // The age of the posting itself, measured from the day we first saw it to
    // now rather than to the sweep that happened to build this page.
    var from = Date.parse(root.getAttribute('data-age-from') || '');
    if (!isNaN(from)) {
      var days = Math.floor((Date.now() - from) / 86400000);
      if (days >= 0) {
        set('[data-jd-age-days]', plural(days, 'day'));
        var freshLine = plural(days, 'day') + ' old';
        if (!isNaN(verified)) {
          var vSince = (Date.now() - verified) / 3600000;
          if (vSince >= 0) {
            freshLine += vSince >= hours
              ? ', and not re-checked for ' +
                (Math.floor(vSince) >= 48
                  ? plural(Math.floor(Math.floor(vSince) / 24), 'day')
                  : plural(Math.floor(vSince), 'hour')) +
                '.'
              : ', and live as of this sweep.';
          } else {
            freshLine += '.';
          }
        } else {
          freshLine += '.';
        }
        set('[data-jd-fresh]', freshLine);
      }
    }
  })();
</script>

<script>
  // Reveal the sticky bar once the header card has scrolled out of view.
  const top = document.querySelector('[data-jd-top]');
  const sticky = document.querySelector('[data-jd-sticky]');
  if (top && sticky) {
    const io = new IntersectionObserver(
      ([e]) => { (sticky as HTMLElement).hidden = e.isIntersecting; },
      { rootMargin: '-72px 0px 0px 0px' }
    );
    io.observe(top);
  }
</script>


{/* The click IS the work starting, so it is what earns the reveal.

    A draft that finishes before the room first renders — the built-in writer is
    effectively instant — is never seen as pending, so the poll never runs and
    never sets the flag. The reveal would then be skipped for exactly the
    journey it was built for: press the button, watch it draft, watch it land.
    Marking on submit makes the animation independent of how long the work took,
    which is the owner's rule (2026-09-27): motion reports work, not page loads,
    and a fast draft is still work. */}
<script is:inline define:vars={{ revealKey: `dr-revealed:${job.slug}` }}>
  document.addEventListener('submit', (e) => {
    const form = e.target;
    if (!(form instanceof HTMLFormElement)) return;
    if (!form.matches('[data-draft-start]')) return;
    try {
      sessionStorage.setItem(revealKey, '1');
    } catch {
      // No session storage: the draft still runs, just without the focus pull.
    }
  }, true);
</script>

