---
/**
 * JobDetailV2.astro: the pixel-perfect job detail page (design: Job Detail v2),
 * the one presentation both detail routes render. It takes the shared Job model,
 * so /role/[slug] (static, SEO, always signed-out presentation) and
 * /board/[slug] (dynamic, member) render the same page, differing only in the
 * fit slot.
 *
 * LAYOUT: two rows, each a two-column grid on wide screens, stacking to one
 * column below --breakpoint-lap.
 * - Row 1 is one bordered white frame: the posting card (left, ~64%) and the
 *   action rail (right, ~36%) sitting on a shaded paper fill inside the frame.
 * - Row 2 is the description (left) beside the fit card / sign-in prompt (right).
 *
 * HONESTY, decided with the owner 2026-09-18:
 * - Fit is a signed-in reading. Signed-out visitors get a sign-in prompt where
 *   the "Fit for you" stat and the fit card would be, never a personalised fit
 *   without a viewer.
 *
 *   STILL TRUE AS A RULE, FALSE AS A DESCRIPTION OF THIS NUMBER, and the gap is
 *   an open owner decision (2026-09-27). The rubric reads nothing about the
 *   viewer: scoreJob() in scripts/ingest-jobs.mjs scores the posting's own
 *   title, location, pay, age and apply link, and no userId reaches it, so the
 *   number is identical for every member. There is therefore nothing personal
 *   for the sign-in gate to protect. The gate is LEFT STANDING here rather than
 *   quietly reversed, because removing it changes what a signed-out visitor
 *   sees and that is the owner's call, not this file's. The card's own title
 *   and its per-component notes, which asserted checks against the reader that
 *   never ran, are fixed below. See docs/fit-score-architecture.md.
 * - The design's role-family category tabs and its cross-company "More <family>"
 *   related-roles row need role_family tags that do not exist upstream yet, so
 *   both are omitted (not stubbed with invented counts) until the tags land.
 * - Every fit component score is real: job.fit carries title_scope (max 30),
 *   remote_geo (25), comp (20), freshness (15), apply_friction (10), summing to
 *   fit_total. The one-line notes under each are derived from the record, not
 *   invented personalisation.
 * - The subtitle carries no "team" (the Job model holds none) and the stats row
 *   names the real apply destination rather than an unmeasured "~10 min" figure.
 *
 * THE ACTION RAIL (replaces the inline DraftRail form). The primary control is
 * a single "Draft resume and cover letter" button, the site's signal-orange
 * primary CTA. It carries no inline reason field: the reason is optional and
 * defaults to null, and the draft opens in the draft room. Behaviour by viewer,
 * mirroring DraftRail: a signed-in reader with a provider key POSTs the slug to
 * desk-job-draft (which drafts and redirects to the draft room); a signed-in
 * reader with no key is routed to key setup; a signed-out reader is sent to
 * sign-in with next set to this posting. "Save to the desk" is a de-emphasised
 * ghost control: a crawled live posting is already tracked on the desk by the
 * apply action, so there is no separate save, and the control says so rather
 * than linking somewhere it cannot go.
 */
import { keylessDraftAllowed } from '../../lib/dev-keyless-draft';
import DescriptionSlot from '../job-detail/DescriptionSlot.astro';
import { expiryOf } from '../job-detail/detail';
import { compShort, formatDate, daysBetween, sweepDate, sweptAt, sourceLabel } from '../../lib/data';
import { FRESH_WINDOW_HOURS } from '../../lib/data-contract';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';
import { familyLabel } from '../../lib/job-family.mjs';
import type { Job } from '../../lib/data';

interface Props {
  job: Job;
  signedIn: boolean;
  /** Where a draft/apply action returns to (this posting's own path). */
  selfPath: string;
  hasKey?: boolean;
  /** Drafting is paid, with no partial state (owner, 2026-09-20), so nobody
      but a paid reader is offered it: not a member who is not paying, and not
      a signed-out reader either. Defaults to false so a caller that forgets to
      pass it hides the action rather than leaking it. */
  paid?: boolean;
  /** When set, the Apply button posts the outbound click so it lands on the
      reader's Desk (the board_actions track control), instead of a plain link.
      Null for the static /role page and signed-out readers. */
  /** `title` is nullable because an added posting reaches this component before
      its title is resolved (addedPostingToJob). The Apply form already omits the
      titleOverride field when it is absent; the type says so now. */
  applyTrack?: { action: string; title: string | null; company: string } | null;
  /** Where the breadcrumb goes. A reader who reached this posting from the
      board was somewhere specific on it (page 4, remote only, sorted by age),
      and the caller works that out from the request (src/lib/board-return.ts).
      Defaults to the plain board, which is the right answer for the static
      /role page: nobody arrives there from a table they were reading. */
  backHref?: string | null;
  /** What that breadcrumb is called. Travels with backHref, never apart from
      it: a link to Opportunities labelled "The board" is a worse lie than the
      bare crumb this replaced. */
  backLabel?: string | null;
}
const {
  job,
  signedIn,
  selfPath,
  hasKey = false,
  paid = false,
  applyTrack = null,
  backHref = null,
  backLabel = null
} = Astro.props;

/**
 * THE FIELD THE BOARD FILED THIS UNDER. The page showed no field at all, while
 * the board's own Field control narrows by it and /board/[slug]'s closed-record
 * variant printed the raw crawled department under the label "Team" — the same
 * 3,335-value column that holds FLZR and SSAs. So a reader could filter to
 * Design, open a posting, and find nothing on the page telling them why it was
 * in Design.
 *
 * It is the site's own classification, not the employer's words, so it says so.
 * A posting the classifier could not place shows no cell rather than an
 * invented one; that is 12.3% of the board and it is a gap, not an "Other".
 */
const fieldLabel = familyLabel(job.role_family ?? null);
const fieldFrom = job.role_family_source === 'department' ? 'read from the posted department' : job.role_family_source === 'title' ? 'read from the title' : null;

const isClosed = job.status === 'closed';
const ats = sourceLabel(job);
/**
 * "Read direct from {company}'s {ats} board" reads correctly for a named
 * board ("Alectrona Llc's Breezy HR board") but breaks its own possessive for
 * 'custom' and 'founder_post', whose labels ("the company site", "the founder
 * posting") already carry their own article: "Alectrona Llc's the company
 * site board". Pre-existing, not introduced by widening SourceSystem (any
 * unlabelled board flattened to 'custom' before this file learned new
 * systems), so this sentence alone is worded around it rather than reused
 * as a pattern anywhere else.
 */
const sourceSub =
  job.source_system === 'custom'
    ? `Read direct from ${job.company}'s own site`
    : job.source_system === 'founder_post'
      ? `Read direct from ${job.company}'s own posting`
      : `Read direct from ${job.company}'s ${ats} board`;

// --- comp: full numbers for the stats row ("$245,000 - $310,000"), short form
// for the sticky bar ("$245K-$310K"). ---
function compFull(): string | null {
  const r = job.comp_range;
  if (r && typeof r.min === 'number' && r.min > 0) {
    const sym = r.currency === 'USD' || !r.currency ? '$' : `${r.currency} `;
    const n = (v: number) => `${sym}${v.toLocaleString('en-US')}`;
    const max = typeof r.max === 'number' && r.max > r.min ? r.max : null;
    return max ? `${n(r.min)} - ${n(r.max)}` : n(r.min);
  }
  return job.comp_posted;
}
const compFullText = compFull();
const compShortText = compShort(job);

// --- dates and age (all real record fields) ---
const sweepIso = sweepDate();
const firstSeenIso = job.first_observed;
const publishedIso = job.published_date;
const lastVerifiedIso = job.last_verified;
const verifiedTime = sweptAt(); // the "07:30 UTC" verified-at stamp, one clock
const verifiedTimeShort = /T(\d{2}:\d{2})/.exec(verifiedTime)?.[1] ?? null;

/**
 * THE FRESHNESS CLAIM ON THIS PAGE USED TO BE A CONSTANT, on the page with the
 * Apply button on it.
 *
 * Three strings said so: "Verified today at the source", "Verified today", and
 * "still live as of this morning's sweep". The only branch in any of them was
 * `isClosed`. Nothing read a clock, nothing read the freshness window, and the
 * page carried no instant a machine could check — so on a morning when the
 * sweep had not run for three days, the page still said "today" and "this
 * morning", in the live colour, above a button that sends someone off to apply.
 *
 * The site already had the mechanism: an instant in the markup, a window beside
 * it, and the reader's own clock deciding whether the sentence still holds.
 * That is what the band below is. The wording is derived now, in all three
 * places, from the two instants this record actually carries.
 *
 * WHY THE READER'S CLOCK AND NOT THE SERVER'S. src/lib/data.ts states the rule
 * in its own header: there is no Date.now() in this repository, because every
 * rendered value is an artifact of a fixed sweep, and "now" is a value the
 * machine recorded rather than one the renderer looks up. data-contract.ts owns
 * the single exception and is explicit that nothing its clock reads ever
 * reaches a page. So the age cannot be settled on the server without breaking
 * one of those two rules, and it does not need to be: a build knows how old the
 * data was when it was built, which is the wrong question. Only the device
 * reading the page can answer the right one.
 *
 * What the server renders is therefore a FLOOR — the age as of the last sweep,
 * which is the oldest thing the record can prove — and every sentence is
 * phrased so the floor is true on its own. The script below raises it to the
 * reader's clock and downgrades the wording past the window. A reader with
 * JavaScript off gets the floor and a real date beside it, never a promise.
 */
const ageFromIso = firstSeenIso ?? publishedIso;
const ageDays = daysBetween(ageFromIso, sweepIso);

/**
 * The instant this posting was last read at the source, as something
 * Date.parse() can take.
 *
 * `last_verified` reaches here two ways. Through the crawl it is a calendar
 * date; through the static export (data.ts builds one row as
 * `String(statsDoc.swept_at_utc)`) it is a full instant. A date-only value is
 * read as midnight UTC, which makes the page report itself as slightly OLDER
 * than it is — up to one sweep's worth. That is the safe direction and the
 * reason it is not patched up with the sweep's time-of-day: pinning 07:30 onto
 * a date the sweep did not produce would be inventing precision, and the whole
 * defect being fixed here is a freshness figure that was more confident than
 * its evidence.
 */
const verifiedAt = lastVerifiedIso
  ? /T\d{2}:\d{2}/.test(lastVerifiedIso)
    ? lastVerifiedIso
    : `${lastVerifiedIso.slice(0, 10)}T00:00:00Z`
  : null;

// --- provenance (the expanded "full history") ---
const expiry = expiryOf(job);
const recordRows: { label: string; value: string; accent?: boolean }[] = [];
if (publishedIso) recordRows.push({ label: 'Published date', value: `${formatDate(publishedIso)}, as printed at source` });
if (firstSeenIso) recordRows.push({ label: 'First seen', value: `${formatDate(firstSeenIso)}, nightly sweep` });
if (lastVerifiedIso) recordRows.push({ label: 'Last verified', value: `${formatDate(lastVerifiedIso)}${verifiedTimeShort ? `, ${verifiedTimeShort} UTC` : ''}` });
recordRows.push({ label: 'Source', value: `${ats}, read direct` });
recordRows.push({ label: 'Status', value: isClosed ? 'Closed' : 'Live', accent: !isClosed });
if (expiry && !isClosed) recordRows.push({ label: 'Good until', value: formatDate(expiry.date) ?? expiry.date });

// The sweep timeline: only endpoints the record actually holds, and the span
// between them stated as a span, never fabricated per-night rows.
const sweeps: { when: string; note: string; current?: boolean }[] = [];
if (firstSeenIso) {
  const samePublish = publishedIso && publishedIso === firstSeenIso;
  sweeps.push({ when: formatDate(firstSeenIso)!, note: samePublish ? 'First read in the feed, the same day the company printed it.' : 'First read in the feed.' });
}
if (firstSeenIso && lastVerifiedIso && lastVerifiedIso > firstSeenIso) {
  const span = daysBetween(firstSeenIso, lastVerifiedIso);
  if (span && span > 1) sweeps.push({ when: `Through ${formatDate(lastVerifiedIso)}`, note: `Still there on every sweep since. ${span} nights, no change to the posting.` });
}
if (lastVerifiedIso) sweeps.push({ when: `${formatDate(lastVerifiedIso)}${verifiedTimeShort ? `, ${verifiedTimeShort} UTC` : ''}`, note: isClosed ? 'Last seen live at source, this sweep.' : 'Verified at source, this sweep.', current: true });

// --- fit (signed-in only) ---
const FIT_ROWS: { key: keyof typeof job.fit; label: string; max: number }[] = [
  { key: 'title_scope', label: 'Title and scope', max: 30 },
  { key: 'remote_geo', label: 'Location', max: 25 },
  { key: 'comp', label: 'Compensation', max: 20 },
  { key: 'freshness', label: 'Freshness', max: 15 },
  { key: 'apply_friction', label: 'Apply friction', max: 10 }
];
/**
 * What each component actually measured, and nothing more.
 *
 * THESE SENTENCES USED TO DESCRIBE THE READER, AND NONE OF THEM COULD. Until
 * 2026-09-27 this function was commented "read off the record, never invented"
 * and then invented in every branch: `title_scope` full printed "Title and
 * scope match a lane you saved", `comp` full printed "Full range printed, floor
 * above your number", `remote_geo` full printed "inside the metros you allow".
 *
 * Nobody saved a lane. There is no "your number". No metros were allowed. Read
 * scoreJob() in scripts/ingest-jobs.mjs: `title_scope` is 30 when
 * `title.trim().length > 2`, `comp` is 20 when the posted pay contains a digit,
 * `remote_geo` is 25 when a location string exists. Every component is a
 * property of the POSTING; not one of them reads the person. No userId reaches
 * that function, so the number is identical for every member.
 *
 * The rubric is a COMPLETENESS score for the crawled record — how much the
 * sweep captured — and it is useful as that. It was only ever wrong as a claim
 * about fit. docs/fit-score-architecture.md carries the rename and
 * docs/fit-score-design.md what replaces it on screen; this function is the
 * part that could not wait for either, because a vague number is a smaller
 * wrong than a sentence asserting a check that never ran.
 */
function fitNote(key: string, score: number, max: number): string {
  const full = score >= max;
  switch (key) {
    case 'title_scope': return full ? 'A specific title is posted.' : 'No usable title posted.';
    case 'remote_geo': return job.remote ? 'Posted as remote.' : job.location ? `Posted in ${job.location}.` : 'No location posted.';
    case 'comp': return compFullText ? (full ? 'Pay range printed.' : 'Pay mentioned, no figure printed.') : 'No pay printed.';
    /* "verified this sweep" was a fourth copy of the page's freshness claim,
       hiding inside a score explanation. This note has to describe what the
       rubric MEASURED, and what it measured is the age at the sweep that scored
       it — a fixed historical fact, correctly stated in the past tense. It is
       deliberately not updated by the script above: the score was computed from
       this number and would stop agreeing with its own explanation. */
    case 'freshness': return ageDays !== null ? `${ageDays} ${ageDays === 1 ? 'day' : 'days'} old when it was last scored.` : 'Age unknown.';
    case 'apply_friction': return `Applies on ${ats}.`;
    default: return '';
  }
}
const fitRows = FIT_ROWS.map((r) => {
  const score = (job.fit[r.key] as number) ?? 0;
  return { ...r, score, note: fitNote(r.key as string, score, r.max) };
});
const fitTotal = job.fit.total;

const applyUrl = job.apply_url;
/** Apply is a quiet text control while the paid draft rail owns the primary
    above it, and becomes the primary itself when that rail is not there. */
const applyClass = paid ? ['jd-link', 'jd-link-apply'] : ['jd-btn', 'jd-btn-primary'];
const draftAction = routeFor('desk-job-draft');
const subtitleParts = [job.company, job.location, `via ${ats}`].filter(Boolean);
const boardHref = backHref ?? routeFor('board');
const boardLabel = (backHref && backLabel) || 'The board';
const methodHref = routeFor('evidence');
const signInHref = `${withBase('/sign-in')}?next=${encodeURIComponent(selfPath)}`;
// Signed in but no key: the draft cannot run in the reader's voice, so the
// primary button routes to key setup, exactly as DraftRail's needsKey does.
const settingsHref = routeFor('settings');
const keySetupHref = `${settingsHref}#keys`;
const saveNote = applyTrack
  ? 'Tracking this role already lands it on your desk'
  : 'Sign in to save roles to your desk';
---

{/* The staleness pair's server half, for this one posting.

    data-swept is this posting's own last-verified instant rather than the
    sweep's or the crawl's: a reader on this page is asking about THIS row, and
    the row carries its own answer. data-age-from is where the age is counted
    from, so the script can recompute it instead of being handed a number that
    was already old when it was rendered. data-fresh-hours is read off the
    markup for the same reason JobTable.astro reads it off its own band — two
    copies of a threshold is how a page ends up looking fresh while the alarm
    rings. */}
<article
  class="jd"
  data-slug={job.slug}
  data-jd-age
  data-swept={verifiedAt}
  data-fresh-hours={FRESH_WINDOW_HOURS}
  data-age-from={ageFromIso}
  data-closed={isClosed ? 'true' : 'false'}
>
  <!-- breadcrumb (the role-family tabs are omitted until tags land) -->
  <nav class="jd-crumbs" aria-label="Breadcrumb">
    <a href={boardHref}>&larr; {boardLabel}</a>
  </nav>

  <!-- sticky mini action bar, revealed on scroll past the header -->
  <div class="jd-sticky" data-jd-sticky hidden>
    <div class="jd-sticky-inner">
      <p class="jd-sticky-title"><strong>{job.title}</strong> <span>{job.company}{compShortText ? ` · ${compShortText}` : ''}</span></p>
      <div class="jd-sticky-actions">
        {applyUrl && <a class="jd-sticky-apply" href={applyUrl} target="_blank" rel="noopener nofollow">Apply on {ats}</a>}
        <a class="jd-sticky-draft" href={`#jd-actions`}>Draft documents</a>
      </div>
    </div>
  </div>

  <!-- row 1: posting card (left) and action rail (right), one bordered frame -->
  <div class="jd-top-row">
    <div class="jd-card" data-jd-top>
      <p class="jd-verified">
        <span class={`jd-dot ${isClosed ? 'is-closed' : 'is-live'}`} aria-hidden="true"></span>
        {/* "Verified today at the source" lived here as a constant. The server
            can only say WHEN it was last read, which is what the date beside
            this says; whether that still counts as "this sweep" is the reader's
            clock's to decide, and the script does it. The closed wording is
            untouched: a closed posting makes no freshness claim to decay. */}
        <strong class={`jd-verified-strong ${isClosed ? 'is-closed' : ''}`} data-jd-verified-strong>{isClosed ? 'Closed, last read at the source' : 'Last verified at the source'}</strong>
        <span class="jd-verified-sub">{sourceSub}{verifiedTimeShort ? `, ${verifiedTimeShort} UTC` : ''}</span>
      </p>

      <h1 class="jd-title">{job.title}</h1>
      <p class="jd-subtitle">{subtitleParts.join('  ·  ')}</p>

      <dl class="jd-stats">
        <div class="jd-stat">
          <dt>Compensation, as posted</dt>
          <dd>{compFullText ?? 'Not stated'}</dd>
        </div>
        <div class="jd-stat">
          <dt>Age of posting</dt>
          {/* The floor, as of the last sweep. The script raises it to the
              reader's clock, which is the whole point: this number used to be
              measured to the build-time sweep day, so a posting first seen on
              the last sweep read "0 days" for as long as the machine stayed
              down. Three days stale, still "0 days old". */}
          <dd data-jd-age-days>{ageDays !== null ? `${ageDays} ${ageDays === 1 ? 'day' : 'days'}` : 'Unknown'}</dd>
        </div>
        {signedIn ? (
          <div class="jd-stat">
            <dt>Deets</dt>
            <dd class="jd-stat-fit">{fitTotal}<span>/100</span></dd>
          </div>
        ) : (
          <div class="jd-stat">
            <dt>Deets</dt>
            <dd class="jd-stat-muted"><a href={signInHref}>Sign in</a></dd>
          </div>
        )}
        {fieldLabel && (
          <div class="jd-stat">
            <dt>Field</dt>
            <dd class="jd-stat-field" title={fieldFrom ?? undefined}>{fieldLabel}</dd>
          </div>
        )}
        <div class="jd-stat">
          <dt>Apply on</dt>
          <dd>{ats}, direct</dd>
        </div>
      </dl>

      <div class="jd-dates">
        <p class="jd-dates-line">
          {publishedIso && <>Posted {formatDate(publishedIso)}</>}
          {publishedIso && firstSeenIso && <span class="jd-sep">·</span>}
          {firstSeenIso && <>First seen {formatDate(firstSeenIso)}</>}
          <span class="jd-sep">·</span>
          {/* The second copy of the same constant ("Verified today"), in the
              dates line, where it sat beside two real dates and read as though
              it were a third. It is one now. */}
          <span class={isClosed ? '' : 'jd-verified-word'} data-jd-verified-short>{isClosed ? 'Closed' : `Verified ${formatDate(lastVerifiedIso) ?? lastVerifiedIso}`}</span>
        </p>
        <p class="jd-dates-note">Posted is the date the company printed. First seen is the night our sweep first read it. When those two dates drift apart, the posting sat somewhere before it reached you.</p>
        <details class="jd-history">
          <summary><span class="jd-history-show">Show the full history</span><span class="jd-history-hide">Hide the full history</span></summary>
          <div class="jd-history-body">
            <div class="jd-history-cols">
              <section class="jd-record" aria-label="The record we hold">
                <h2 class="jd-h">The record we hold</h2>
                <dl class="jd-record-list">
                  {recordRows.map((r) => (
                    <div class="jd-record-row">
                      <dt>{r.label}</dt>
                      <dd class={r.accent ? 'jd-record-live' : ''}>{r.value}</dd>
                    </div>
                  ))}
                </dl>
              </section>
              <section class="jd-sweeps" aria-label="What the sweeps saw">
                <h2 class="jd-h">What the sweeps saw</h2>
                <ol class="jd-sweeps-list">
                  {sweeps.map((s) => (
                    <li class={`jd-sweep ${s.current ? 'is-current' : ''}`}>
                      <span class="jd-sweep-dot" aria-hidden="true"></span>
                      <span class="jd-sweep-when">{s.when}</span>
                      <span class="jd-sweep-note">{s.note}</span>
                    </li>
                  ))}
                </ol>
              </section>
            </div>
            <div class="jd-howto">
              <h2 class="jd-h">How to read this</h2>
              <p>Every line is a machine observation, stamped at the sweep that made it. Nothing here is inferred.</p>
              <p>Good until is ours, not the employer's: the date we stop standing behind this reading unless a later sweep refreshes it.</p>
              <p><a href={methodHref}>Read the method</a></p>
            </div>
          </div>
        </details>
      </div>
    </div>

    <!-- action rail (design: "Job Detail upgrade, rail as the page (1c)",
         2026-09-20): the reader's own note first, then the draft button, then
         Apply and Save as a row of text controls under a hairline. The note
         posts as `reason`, which desk/job-draft.ts already reads (600 char
         cap, same as its own backstop) and the cover letter uses verbatim as
         its anchor. The textarea exists only with the real draft form; a
         signed-out reader or one without a key keeps the link button. -->
    <div class="jd-actions" id="jd-actions">
      {/* Drafting is paid, period (owner, 2026-09-20), so this block belongs
          to a paid reader alone. A member who is not paying does not get it,
          and neither does a signed-out reader: the sign-in link that used to
          stand here advertised a feature the account it leads to does not
          carry. The entitlement policy refuses every draft route besides. */}
      {!isClosed && paid && (
        <>
          {signedIn && (hasKey || keylessDraftAllowed()) ? (
            <form class="jd-draft-form" method="POST" action={draftAction} data-draft-start>
              <input type="hidden" name="slug" value={job.slug} />
              <label class="jd-reason-label" for="jd-reason">Tell the model why you want this role and what to lead with.</label>
              <div class="jd-reason-lines">
                <textarea
                  id="jd-reason"
                  class="jd-reason"
                  name="reason"
                  rows="6"
                  maxlength="600"
                  placeholder="Why this role, in your own words. Then the one piece of your record to lead with, and anything the drafts must say."
                ></textarea>
              </div>
              <button type="submit" class="jd-btn jd-btn-primary">Draft resumé and cover letter</button>
            </form>
          ) : (
            <a class="jd-btn jd-btn-primary" href={signedIn ? keySetupHref : signInHref}>Draft resumé and cover letter</a>
          )}
          <p class="jd-draft-note">Written in your voice on your own provider key. You read both drafts before anything leaves your hands.</p>
        </>
      )}

      {/* Without the draft rail above, this row is the whole action area, so
          Apply carries the page's one primary (owner, 2026-09-20): the filled
          signal button, stacked, with Save beneath it. A paid reader already
          has a primary in the rail, so Apply stays the text control it was
          and the row stays a row. */}
      <div class:list={['jd-actions-row', !paid && 'jd-actions-stacked']}>
        {applyUrl && (applyTrack ? (
          <form class="jd-apply-form" method="POST" action={applyTrack.action} target="_blank" data-apply-url={applyUrl}>
