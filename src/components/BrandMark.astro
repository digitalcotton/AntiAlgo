---
/**
 * The Anti Algo mark: the verification ring and core, with the signal-orange
 * core that names the one thing this site does. The product's logo is the
 * shape that means "verified at source". Always decorative: the wordmark
 * carries the accessible name.
 */
---

<svg viewBox="0 0 48 48" class="brand-mark" aria-hidden="true" focusable="false">
  <circle cx="24" cy="24" r="19" fill="none" stroke="var(--color-foreground)" stroke-width="3.5" />
  <rect x="17" y="17" width="14" height="14" fill="var(--color-signal)" />
</svg>

<style>
  .brand-mark {
    width: var(--mark-brand);
    height: var(--mark-brand);
    flex: none;
    align-self: center;
  }
</style>
