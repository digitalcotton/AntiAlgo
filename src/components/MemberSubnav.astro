---
import { WORKSPACE_NAV } from '../data/member-nav';

/**
 * The secondary nav row under the main header: a switcher for the signed-in
 * reader's working surfaces (The Desk, Opportunities, The Ledger, Pre-List, all
 * from WORKSPACE_NAV in src/data/member-nav.ts). It renders ONLY when the reader is
 * signed in AND standing inside the cluster, so the header carries one row
 * everywhere else and grows a second one exactly when you are "at your desk".
 * That is what gives the paid Ledger a home in the chrome without adding a
 * sixth link to the always-on main nav or mixing it in with the public board.
 *
 * SiteHeader.astro renders this once, INSIDE the sticky <header>, right after
 * the main row, so both rows stick and scroll together under the one heavy
 * bottom border the header already draws.
 *
 * Current-surface highlight is by path PREFIX, not exact match, so a detail
 * page under a surface (/desk/draft/<id>, /prelist while following) still lights
 * its parent tab. The board and /role pages are deliberately not in the cluster,
 * so the subnav is absent there.
 */
const viewer = Astro.locals.viewer;
const signedIn = Boolean(viewer);

// Base-included pathname, trailing slash trimmed, matching SiteHeader's own here.
const here = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
// "On" a surface when the path is it, or sits directly beneath it.
const onSurface = (href: string) => here === href || here.startsWith(href + '/');
const inCluster = WORKSPACE_NAV.some((item) => onSurface(item.href));
const show = signedIn && inCluster;
---

{
  show && (
    <nav class="subnav" aria-label="Your desk">
      <div class="shell subnav-inner">
        <span class="subnav-label mono-label">Your desk</span>
        <div class="subnav-links kicker">
          {WORKSPACE_NAV.map((item) =>
            item.built ? (
              <a
                class="subnav-link"
                href={item.href}
                aria-current={onSurface(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            ) : (
              <span class="subnav-link subnav-soon">{item.label}</span>
            )
          )}
        </div>
      </div>
    </nav>
  )
}

<style>
  /* A hairline rule separates the sub-row from the main nav above it; the
     header's own heavy border still closes the whole block from below. The
     background is the page surface token so the sticky header stays opaque as
     content scrolls under it. */
  .subnav {
    background: var(--color-surface);
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .subnav-inner {
    display: flex;
    align-items: baseline;
    gap: var(--space-500);
    padding-block: var(--space-300);
    flex-wrap: wrap;
  }
  /* The eyebrow: names the row without competing with the links. Hidden on
     narrow screens so the links keep the full width. */
  .subnav-label {
    color: var(--color-muted);
    white-space: nowrap;
  }
  .subnav-links {
    display: flex;
    align-items: baseline;
    gap: var(--space-500);
    flex-wrap: wrap;
    /* Normal case here, not the eyebrow's uppercase: these are destinations. */
    text-transform: none;
  }
  .subnav-link {
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid transparent;
    padding-bottom: 2px;
    white-space: nowrap;
    text-decoration: none;
  }
  .subnav-link:hover,
  .subnav-link[aria-current='page'] {
    color: var(--color-foreground);
    border-bottom-color: var(--color-signal);
  }
  /* A surface announced before its page ships: plain text, never an anchor. */
  .subnav-soon {
    color: var(--color-muted);
    opacity: 0.6;
    cursor: default;
  }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    .subnav-label {
      display: none;
    }
    .subnav-inner,
    .subnav-links {
      gap: var(--space-400);
    }
  }
</style>
