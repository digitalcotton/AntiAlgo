---
import Panel from '../Panel.astro';

/**
 * The guided first run, behind the `onboarding` flag (checked by the caller,
 * src/pages/profile.astro, which renders this only when the flag is on and the
 * required steps are not all done). This component draws no data of its own: it
 * takes the steps already decided from state the profile page computes, so it
 * stays a pure view and the flag gates one render, not a second data path.
 *
 * WHY THE VERIFIED STEP IS PASSED IN ALREADY DONE. /profile shows its record
 * only to a verified reader (an unverified one gets the resend branch instead),
 * so by the time this checklist renders, email verification is behind the
 * reader. It is listed anyway, checked, because a checklist that starts at step
 * two reads as if a step went missing; showing the first as already done is how
 * the sequence stays legible.
 *
 * DONE IS NOT DISMISSED. When every required step is done the caller stops
 * rendering this rather than showing an empty "all set" card forever; there is
 * no per-reader dismissed flag to store, because completing the steps is the
 * dismissal.
 */
import type { OnboardingStep } from '../../lib/onboarding';
export type { OnboardingStep };

interface Props {
  steps: OnboardingStep[];
}

const { steps } = Astro.props;
const doneCount = steps.filter((step) => step.done && !step.optional).length;
const requiredCount = steps.filter((step) => !step.optional).length;
---

<Panel title="Getting started" class="onboarding">
  <p class="onboarding-lede">
    A few steps to a profile that drafts for you. <span class="onboarding-count mono-label">{doneCount} of {requiredCount} done</span>
  </p>

  <ol class="onboarding-steps">
    {
      steps.map((step) => (
        <li class:list={['onboarding-step', { 'is-done': step.done }]}>
          <span class="onboarding-mark" aria-hidden="true"></span>
          <div class="onboarding-body">
            <p class="onboarding-label">
              {step.label}
              {step.badge && <span class="onboarding-optional mono-label">{step.badge}</span>}
            </p>
            <p class="onboarding-hint">{step.hint}</p>
            {!step.done && step.href && step.action && (
              <a class="onboarding-action" href={step.href}>{step.action}</a>
            )}
          </div>
          <span class="visually-hidden">{step.done ? 'Done' : 'Not done yet'}</span>
        </li>
      ))
    }
  </ol>
</Panel>

<style>
  .onboarding-lede {
    margin: 0 0 var(--space-400);
    color: var(--color-muted);
    font-size: var(--size-200);
    line-height: var(--leading-snug);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-300);
  }

  .onboarding-count {
    color: var(--color-muted);
  }

  .onboarding-steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-300);
  }

  .onboarding-step {
    display: grid;
    grid-template-columns: var(--space-600) minmax(0, 1fr);
    column-gap: var(--space-400);
    align-items: start;
    border-top: var(--border-hairline) solid var(--color-line);
    padding-top: var(--space-300);
  }

  .onboarding-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--space-600);
    height: var(--space-600);
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius-round);
    font-weight: var(--weight-bold);
    font-size: var(--size-100);
    color: var(--color-foreground);
  }

  .onboarding-step.is-done .onboarding-mark {
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
    border-color: var(--color-surface-inverse);
  }

  /* The check glyph as a CSS escape rather than a literal in the markup, so the
     copy gate sees only ASCII source; it appears only on a done step's mark. */
  .onboarding-step.is-done .onboarding-mark::before {
    content: '\2713';
  }

  .onboarding-body {
    display: grid;
    gap: var(--space-100);
  }

  .onboarding-label {
    margin: 0;
    font-weight: var(--weight-medium);
    font-size: var(--size-200);
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-200);
  }

  .onboarding-step.is-done .onboarding-label {
    color: var(--color-muted);
  }

  .onboarding-optional {
    color: var(--color-muted);
  }

  .onboarding-hint {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--size-100);
    line-height: var(--leading-snug);
  }

  .onboarding-action {
    display: inline-block;
    margin-top: var(--space-100);
    font-size: var(--size-100);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
    text-decoration-color: var(--color-line-strong);
  }

  .onboarding-action:hover {
    text-decoration-color: var(--color-foreground);
  }

  @media (prefers-reduced-motion: no-preference) {
    .onboarding-action {
      transition: text-decoration-color var(--motion-duration-instant) var(--motion-easing-standard);
    }
  }
</style>
