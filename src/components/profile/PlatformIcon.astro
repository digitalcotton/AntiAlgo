---
// The monochrome brand mark for one profile link. A person's job-related links
// (LinkedIn, GitHub, and the rest of profile-links.ts's platforms) each render
// beside a recognizable logo rather than a generic dot, so the links table
// reads at a glance. Inline SVG has no font dependency, so every mark renders
// identically on every OS and browser, the same reason Icon.astro left Unicode
// glyphs behind.
//
// FILLED, not stroked. Icon.astro is a stroked Lucide set (fill: none, stroke:
// currentColor). Brand logos are solid marks, so this component is the
// opposite: fill: currentColor, no stroke. The one exception is the neutral
// fallback glyph (website, portfolio, other), a stroked Lucide globe whose
// stroke attributes ride on its own path element so the single filled <svg>
// wrapper still hosts it.
//
// Default size is 1em, so a mark dropped inline with text inherits that text's
// font-size and color (including inverted, dark-panel text) with no extra
// markup, matching Icon.astro's inline behavior.
//
// SOURCE AND PROVENANCE. The seven brand paths (linkedin, github, twitter as
// the X logo, bluesky, dribbble, behance, mastodon) are copied verbatim from
// Simple Icons (simpleicons.org), verified against simple-icons/simple-icons on
// GitHub rather than hand-drawn, so each shape is exactly the maintained
// original at viewBox 0 0 24 24. Simple Icons releases its icon artwork under
// CC0 1.0 (public domain). The brand marks themselves remain trademarks of
// their respective owners; they appear here only to identify the platform a
// person chose to link (nominative use), the same provenance discipline
// Icon.astro keeps for its Lucide source. The neutral globe is from Lucide
// (lucide.dev, ISC licensed).
import type { LinkPlatform } from '../../lib/profile-links';

interface Props {
  platform: LinkPlatform;
  class?: string;
  [attr: string]: unknown;
}
const { platform, class: className, ...rest } = Astro.props;

// One shared neutral glyph for the platforms that are not a named brand:
// website, portfolio, other. Lucide's "globe", stroked, with its presentation
// attributes on the <g> so the filled <svg> wrapper does not paint it solid.
const NEUTRAL =
  '<g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></g>';

// Verbatim from simple-icons/simple-icons, viewBox 0 0 24 24, filled. twitter
// intentionally carries the current X logo (simple-icons slug "x"), not the
// retired bird.
