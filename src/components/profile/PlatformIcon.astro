---

<svg
  class={className}
  aria-hidden="true"
  focusable="false"
  viewBox="0 0 24 24"
  fill="currentColor"
  {...rest}
  set:html={PATHS[platform]}
/>

<style>
  svg {
    width: 1em;
    height: 1em;
    display: inline-block;
    vertical-align: -0.125em;
    flex: none;
  }
</style>
