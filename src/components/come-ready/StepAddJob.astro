---
/**
 * Add a job by link: step 5 of the free flow. Posts to the Desk's own
 * add-a-posting endpoint, which lands on the posting's own page while the
 * machine reads it; this step shows the most recent one added with its
 * read state in the posting card's own words. No fit is claimed: the site
 * computes none for a member-added posting.
 */
import StepCard from './StepCard.astro';
import RingMark from './RingMark.astro';
import type { StoredPostingFetch } from '../../lib/posting-fetch-store';
import { fetchDisplayState } from '../../lib/posting-fetch-store';
import { addedSlugFor } from '../../lib/added-posting';
import { hostOf } from '../../lib/come-ready-store';
import { boardDetailPath, routeFor } from '../../data/nav';
import { dayStamp } from '../../lib/stats';
import { withBase } from '../../../site.config.mjs';

interface Props {
  added: StoredPostingFetch | null;
  enabled: boolean;
  doorPath: string;
}
const { added, enabled, doorPath } = Astro.props;
const postingAction = routeFor('desk-posting');
const host = added ? hostOf(added.url) : '';
const state = added ? fetchDisplayState(added, Date.now()) : null;
const stateLine =
  state === 'ready'
    ? `Read from ${host}.`
    : state === 'pasted'
      ? 'From text you pasted. Unverified.'
      : state === 'reading'
        ? `Reading the posting from ${host}.`
        : state === 'queued'
          ? 'Still queued for the machine.'
          : state === 'slow'
            ? `Reading ${host} is taking longer than usual.`
            : state === 'unreadable'
              ? 'We could not read that page.'
              : '';
const addedTitle = added ? (added.title ?? `A posting from ${host}`) : '';
---

<StepCard n={5} title="Add a job by link" time="Under a minute">
  <p class="cr-intro">Unlocks a job page of your own for any posting, ours or anyone's: the fit score, the math behind it, and a nightly check that it is still live at the company's page.</p>
  {enabled ? (
    <form method="POST" action={postingAction} class="cr-job-form">
      <input type="hidden" name="intent" value="add" />
      <input type="hidden" name="view" value="board" />
      <input id="cr-job" class="cr-input cr-mono cr-job-input" type="url" name="url" required pattern="https://.*" maxlength="2000" placeholder="Paste a job link, ours or anyone's" aria-label="Job link" autocomplete="off" autofocus={!added} />
      <button type="submit" class="cr-btn">Add a job</button>
    </form>
  ) : (
    <p class="cr-note cr-note-gap">Adding a job by link is switched off in this build.</p>
  )}
  <p class="cr-note cr-note-small">We read what it is from the address. Nothing else is asked.</p>

  {added && (
    <>
      <div class="cr-box" data-tone="live">
        <RingMark tone="done" />
        <div>
          <p class="cr-box-line">{addedTitle}{added.company && `, ${added.company}`}. Added.</p>
          <p class="cr-box-meta">{stateLine}{stateLine && ' · '}added {dayStamp(added.createdAt)}</p>
          <a class="cr-link" href={boardDetailPath(addedSlugFor(added.applicationId))}>Open its job page</a>
        </div>
      </div>
      <div class="cr-actions cr-next">
        <a class="cr-btn" href={withBase(doorPath)}>Done. What paid opens</a>
        <span class="cr-ok">A draft for this role is one key away.</span>
      </div>
    </>
  )}
</StepCard>

<style>
  .cr-job-form {
    margin-top: 18px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: stretch;
  }
  .cr-job-input {
    font-size: 0.95rem;
  }
  .cr-note-small {
    margin-top: 8px;
  }
  .cr-note-gap {
    margin-top: 18px;
  }
  .cr-next {
    margin-top: 18px;
  }
</style>
