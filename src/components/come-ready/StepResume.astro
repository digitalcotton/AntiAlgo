---
/**
 * Bring your resumé: step 5 of the paid flow. Four states, one on screen:
 * locked (the reader skipped the key; the Profile's own reason, one way
 * back), reading (a read is in flight on the member's key), done (what the
 * record now holds, counted from the record itself), open (the upload, to
 * the same endpoint the Profile posts to).
 *
 * THE WAITING LOG PRINTS ONLY WHAT IT KNOWS (owner ruling 2026-09-01, the
 * same rule ImportBand.astro states): what was sent, whose key it went to,
 * how long it has waited, and the read's own notes when it lands. The
 * design's four staged lines are not stages the status endpoint reports, so
 * they are not printed.
 */
import StepCard from './StepCard.astro';
import RingMark from './RingMark.astro';
import type { StoredParse } from '../../lib/resume-parse-store';
import type { AppliedProposals } from '../../lib/resume-parse-apply';
import { ENTRY_KINDS } from '../../lib/record';
import { KIND_LABELS } from '../profile/entry-presentation';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';

interface Props {
  locked: boolean;
  reading: boolean;
  done: boolean;
  parse: StoredParse | null;
  landed: AppliedProposals | null;
  entriesByKind: Record<string, number>;
  entries: number;
  links: number;
  nameSet: boolean;
  keyLabel: string | null;
  keyPath: string;
  nextPath: string;
  selfPath: string;
}
const { locked, reading, done, parse, landed, entriesByKind, entries, links, nameSet, keyLabel, keyPath, nextPath, selfPath } = Astro.props;

const parseAction = routeFor('profile-import-parse');
const statusUrl = routeFor('profile-import-status');
const profilePath = routeFor('profile');

const kindLine = ENTRY_KINDS.filter((k) => (entriesByKind[k] ?? 0) > 0)
  .map((k) => `${entriesByKind[k]} ${KIND_LABELS[k].toLowerCase()}${entriesByKind[k] === 1 ? '' : k === 'role_held' ? ' held' : 's'}`)
  .join(', ');
const droppedLine = landed && landed.failed > 0
  ? `${landed.failed} could not be added and ${landed.failed === 1 ? 'was' : 'were'} left out.`
  : null;
const ACCEPT = '.md,.markdown,.txt,.pdf,.docx,text/markdown,text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document';
---

<StepCard n={5} title="Bring your resumé" time="1 to 2 min">
  <p class="cr-intro">Unlocks drafting. Your own model reads it on your key. Every value it proposes is checked to occur in the file; nothing is saved until you review. Employer, official title and dates print exactly as typed.</p>

  {locked && (
    <div class="cr-hatch">
      <span class="cr-label">Locked until a key is connected</span>
      <p class="cr-intro">Without a key, the reader "matches one strict shape and misses anything written differently, and a half-read resumé is worse than one you fill in by hand."</p>
      <a class="cr-btn cr-btn-gap" href={withBase(keyPath)}>Back to step 4</a>
    </div>
  )}

  {reading && (
    <div class="cr-reading" data-cr-reading data-status-url={statusUrl} data-return={withBase(selfPath)} role="status" aria-live="polite">
      <div class="cr-between cr-reading-head">
        <span class="cr-reading-title">Reading your resumé</span>
        <span class="cr-reading-meta">{parse?.sourceName ?? 'pasted text'} &#183; on your key</span>
      </div>
      <ol class="cr-log" data-cr-log>
        <li class="cr-log-line" data-tone="done"><RingMark tone="done" /><span>sent {parse?.sourceName ?? 'pasted text'}</span></li>
        {keyLabel && <li class="cr-log-line" data-tone="done"><RingMark tone="done" /><span>to your {keyLabel} key, held in memory for this one read</span></li>}
        <li class="cr-log-line"><RingMark /><span data-cr-wait>waiting</span></li>
      </ol>
    </div>
  )}

  {done && (
    <>
      <div class="cr-box" data-tone="live">
        <RingMark tone="done" />
        <div>
          <p class="cr-box-line">
            <span class="cr-mono">{entries}</span> {entries === 1 ? 'entry' : 'entries'} on your record{links > 0 && <>, <span class="cr-mono">{links}</span> {links === 1 ? 'link' : 'links'}</>}{nameSet && ', your name set'}.
          </p>
          <p class="cr-box-sub">{kindLine}{kindLine && '.'}{droppedLine && ` ${droppedLine}`}</p>
          <a class="cr-link" href={profilePath}>Open your Profile Record</a>
        </div>
      </div>
      <div class="cr-actions cr-next">
        <a class="cr-btn" href={withBase(nextPath)}>Next: cover letter and links</a>
        <span class="cr-ok">Drafting is on.</span>
      </div>
    </>
  )}

  {!locked && !reading && !done && (
    <>
      <form method="POST" action={parseAction} enctype="multipart/form-data" class="cr-drop" data-cr-read>
        <label class="cr-drop-label" for="cr-file">
          <span class="cr-drop-line">Drop a file here, or choose one.</span>
          <span class="cr-drop-hint">PDF, Word (.docx), Markdown or plain text, up to 4 MB. Or paste the text.</span>
        </label>
        <input id="cr-file" class="cr-file visually-hidden" type="file" name="file" accept={ACCEPT} required data-cr-file />
        <label class="cr-btn cr-btn-gap" for="cr-file">Choose a file</label>
        <button type="submit" class="cr-btn cr-btn-gap cr-nojs" data-cr-nojs>Read my documents</button>
      </form>
      <details class="cr-paste-details">
        <summary class="cr-link-quiet">Paste the text instead</summary>
        <form method="POST" action={parseAction} class="cr-paste-form" data-cr-read>
          <label class="cr-label" for="cr-pasted">Pasted resumé text</label>
          <textarea id="cr-pasted" class="cr-textarea" name="pasted" rows="12" required></textarea>
          <button type="submit" class="cr-btn cr-btn-gap">Read the text</button>
        </form>
      </details>
      <p class="cr-note cr-note-gap">An old .doc file is refused: export it as .docx or PDF first.</p>
      <div class="cr-reading" data-cr-reading data-status-url={statusUrl} data-return={withBase(selfPath)} data-key-label={keyLabel ?? ''} role="status" aria-live="polite" hidden>
        <div class="cr-between cr-reading-head">
          <span class="cr-reading-title">Reading your resumé</span>
          <span class="cr-reading-meta" data-cr-reading-meta>on your key</span>
        </div>
        <ol class="cr-log" data-cr-log></ol>
      </div>
      <p class="cr-loss" data-cr-note hidden></p>
    </>
  )}
</StepCard>

<script>
  // The read, enhanced: a chosen file submits itself, the submit goes by
  // fetch so this page keeps its place, and the status endpoint is polled
  // until the read lands, when the page reloads on this step and the record's
  // counts show. With no script the same forms post and land on the review
  // page, exactly as the Profile's do. Every printed line is true: what was
  // sent, which key, how long, then the read's own notes.
  const POLL_MS = 3000;
  const POLL_LIMIT = 40;

  const panel = document.querySelector<HTMLElement>('[data-cr-reading]');
  const log = panel?.querySelector<HTMLElement>('[data-cr-log]') ?? null;
  const meta = panel?.querySelector<HTMLElement>('[data-cr-reading-meta]') ?? null;
  const note = document.querySelector<HTMLElement>('[data-cr-note]');
  const forms = Array.from(document.querySelectorAll<HTMLFormElement>('[data-cr-read]'));
  const fileInput = document.querySelector<HTMLInputElement>('[data-cr-file]');
  const statusUrl = panel?.dataset.statusUrl ?? '';
  const returnTo = panel?.dataset.return ?? '';
  const keyLabel = panel?.dataset.keyLabel ?? '';

  function line(text: string, done: boolean): HTMLElement {
    const li = document.createElement('li');
    li.className = 'cr-log-line';
    if (done) li.dataset.tone = 'done';
    const mark = document.createElement('span');
    mark.className = 'cr-mark';
    mark.dataset.tone = done ? 'done' : 'later';
    mark.setAttribute('aria-hidden', 'true');
    const span = document.createElement('span');
    span.textContent = text;
    li.append(mark, span);
    log?.append(li);
    return span;
  }
  const formatSize = (bytes: number) => (bytes < 1024 * 1024 ? `${Math.max(1, Math.round(bytes / 1024))} KB` : `${(bytes / (1024 * 1024)).toFixed(1)} MB`);

  async function readStatus(): Promise<Record<string, unknown> | null> {
    try {
      const response = await fetch(statusUrl, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
      if (!response.ok) return null;
      return (await response.json()) as Record<string, unknown>;
    } catch {
      return null;
    }
  }

  async function watch(wait: HTMLElement, startedAt: number): Promise<void> {
    for (let n = 0; n < POLL_LIMIT; n++) {
      await new Promise((r) => setTimeout(r, POLL_MS));
      wait.textContent = `waiting, ${Math.round((Date.now() - startedAt) / 1000)}s`;
      const body = await readStatus();
      if (body && body.status === 'ready') {
        const notes = Array.isArray(body.notes) ? (body.notes as unknown[]) : [];
        for (const n2 of notes) if (typeof n2 === 'string') line(n2, true);
        window.location.assign(returnTo);
        return;
      }
    }
    line('The read is taking longer than it should. Reload this page to check on it, or try the upload again.', false);
  }

  // A read already in flight when the page loaded: pick up the wait line.
  const pendingWait = panel && !panel.hidden ? panel.querySelector<HTMLElement>('[data-cr-wait]') : null;
  if (pendingWait) void watch(pendingWait, Date.now());

  // With script, a chosen file submits itself; the plain submit button is
  // for a browser running none of this.
  document.querySelector<HTMLElement>('[data-cr-nojs]')?.setAttribute('hidden', '');
  if (fileInput) {
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) fileInput.form?.requestSubmit();
    });
  }

  if (panel && log && forms.length > 0) {
    for (const form of forms) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (note) note.hidden = true;
        log.replaceChildren();
        const chosen = fileInput?.files?.[0];
        const sent = form.querySelector('[name="pasted"]') ? 'pasted text' : chosen ? `${chosen.name}, ${formatSize(chosen.size)}` : 'your file';
        if (meta) meta.textContent = `${chosen ? chosen.name : 'pasted text'} · on your key`;
        line(`sent ${sent}`, true);
        if (keyLabel) line(`to your ${keyLabel} key, held in memory for this one read`, true);
        const wait = line('waiting, 0s', false);
        panel.hidden = false;
        const startedAt = Date.now();

        let body: Record<string, unknown> | null = null;
        try {
          const response = await fetch(form.action, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { Accept: 'application/json' },
            body: new FormData(form)
          });
          // Signed out mid-session or walled (the endpoint answered with a
          // page, not JSON): the plain navigation knows where to send them.
          if (!response.ok || response.redirected || !(response.headers.get('content-type') ?? '').includes('application/json')) {
            form.submit();
            return;
          }
          body = (await response.json()) as Record<string, unknown>;
        } catch {
          panel.hidden = true;
          if (note) {
            note.textContent = 'The upload could not be sent. Check your connection and try again.';
            note.hidden = false;
          }
          return;
        }
        if (body && body.status === 'ready') {
          // Finished at once: a refused file or an empty paste hands its message back.
          panel.hidden = true;
          if (typeof body.note === 'string' && note) {
            note.textContent = body.note;
            note.hidden = false;
          } else {
            window.location.assign(returnTo);
          }
          return;
        }
        void watch(wait, startedAt);
      });
    }
  }
</script>

<style>
  .cr-btn-gap {
    margin-top: 16px;
  }
  .cr-note-gap {
    margin-top: 12px;
  }
  .cr-next {
    margin-top: 18px;
  }
  .cr-hatch .cr-intro {
    margin-top: 10px;
  }
  .cr-drop {
    margin-top: 18px;
    padding: 26px 22px;
    border: var(--border-hairline) dashed var(--color-line-strong);
    border-radius: var(--radius);
    text-align: center;
  }
  .cr-drop-label {
    display: block;
    cursor: pointer;
  }
  .cr-drop-line {
    display: block;
    font-weight: 500;
  }
  .cr-drop-hint {
    display: block;
    margin-top: 6px;
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .cr-drop .cr-btn-gap {
    margin-top: 14px;
  }
  .cr-nojs {
    margin-left: 12px;
  }
  /* The class sets display, so the hidden attribute the script adds needs
     its own rule to win. */
  .cr-nojs[hidden] {
    display: none;
  }
  .cr-file:focus-visible + .cr-btn {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }
  .cr-paste-details {
    margin-top: 12px;
  }
  .cr-paste-details summary {
    list-style: none;
    display: inline;
  }
  .cr-paste-details summary::-webkit-details-marker {
    display: none;
  }
  .cr-paste-form {
    margin-top: 12px;
  }
  .cr-reading {
    margin-top: 18px;
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius);
  }
  .cr-reading-head {
    padding: 14px 16px;
    border-bottom: var(--border-hairline) solid var(--color-line);
  }
  .cr-reading-title {
    font-weight: 500;
  }
  .cr-reading-meta {
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  .cr-log {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cr-log-line {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    padding: 10px 16px;
    border-bottom: var(--border-hairline) solid var(--color-line);
    font-size: 0.95rem;
    color: var(--color-muted);
  }
  .cr-log-line[data-tone='done'] {
    color: var(--color-foreground);
  }
</style>
