---
/**
 * Add your cover letter and links: step 6 of the paid flow, optional. The
 * letter on file is shown as it is kept; without one, a paste form to the
 * Profile's own endpoint. Links post to the Profile's link endpoint. Both
 * return here.
 */
import StepCard from './StepCard.astro';
import type { CoverLetterOnFile } from '../../lib/record-store';
import type { StoredLink } from '../../lib/profile-links';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';

interface Props {
  letter: CoverLetterOnFile | null;
  links: StoredLink[];
  selfPath: string;
  doorPath: string;
}
const { letter, links, selfPath, doorPath } = Astro.props;
const coverAction = routeFor('profile-import-cover');
/** The types the cover endpoint's own extractor accepts, the same list the
    resumé band offers. */
const ACCEPT = '.md,.markdown,.txt,.pdf,.docx,text/markdown,text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document';
const linkAction = routeFor('profile-link');
---

<StepCard n={6} title="Add your cover letter and links" time="Optional, 1 min">
  <p class="cr-intro">Unlocks better drafts. Both optional; done when the letter is on file.</p>

  <div class="cr-letter">
    <label class="cr-between cr-field-label" for="cr-letter">
      <span>Cover letter on file</span>
      <span class="cr-tag" data-tone={letter ? 'live' : undefined}>{letter ? 'Added' : 'Optional'}</span>
    </label>
    {letter ? (
      <textarea id="cr-letter" class="cr-textarea" rows="7" readonly aria-label="Cover letter">{letter.text}</textarea>
    ) : (
      <>
        {/* The same band the resumé step draws, on the same endpoint's file
            half. Its own form, because a file and a pasted body are two
            different requests. */}
        <form method="POST" action={coverAction} enctype="multipart/form-data" class="cr-drop cr-dropzone" data-cr-letter-drop>
          <input type="hidden" name="return" value={selfPath} />
          <label class="cr-drop-label" for="cr-letter-file">
            <span class="cr-drop-line">Drop your letter here, or choose a file.</span>
            <span class="cr-drop-hint">PDF, Word (.docx), Markdown or plain text. Or paste it below.</span>
          </label>
          <input id="cr-letter-file" class="cr-file visually-hidden" type="file" name="file" accept={ACCEPT} required data-cr-letter-file />
          <label class="cr-btn" for="cr-letter-file">Choose a file</label>
          <button type="submit" class="cr-btn cr-nojs" data-cr-letter-nojs>Save that file</button>
        </form>
        <form method="POST" action={coverAction} class="cr-letter-form">
          <input type="hidden" name="return" value={selfPath} />
          <textarea id="cr-letter" class="cr-textarea cr-letter-paste" name="pasted" rows="7" placeholder="Or paste the cover letter you reuse." aria-label="Cover letter" required></textarea>
          <button type="submit" class="cr-btn cr-btn-gap">Save cover letter</button>
        </form>
      </>
    )}
    <p class="cr-note cr-note-gap cr-note-wide">Kept as a writing sample only. The cover letter draft takes its voice from it; the resumé draft never sees it. Any dated role it names is proposed into your record for review.</p>
  </div>

  <div class="cr-rule-loose">
    <label class="cr-between cr-field-label" for="cr-link">
      <span>Links</span>
      <span class="cr-tag">Optional</span>
    </label>
    {links.length > 0 && (
      <ul class="cr-links">
        {links.map((l) => (
          <li class="cr-link-row"><span class="cr-mono cr-link-url">{l.url}</span></li>
        ))}
      </ul>
    )}
    <form method="POST" action={linkAction} class="cr-link-form">
      <input type="hidden" name="intent" value="add" />
      <input type="hidden" name="return" value={selfPath} />
      <input id="cr-link" class="cr-input" type="url" name="url" inputmode="url" autocomplete="off" placeholder="Paste any link. We read what it is from the address." aria-label="Add a link" />
      <button type="submit" class="cr-btn">Add</button>
    </form>
    <p class="cr-note cr-note-small">Links sit at the top of every draft.</p>
  </div>

  <div class="cr-actions cr-next">
    <a class="cr-btn" href={withBase(doorPath)}>Done. Show my first draft</a>
  </div>
</StepCard>

<script>
  import { wireDropZone } from '../../lib/drop-zone';

  // The same band the resumé step has, on the letter. With no script the
  // file form still posts through its own button; with script, the box takes
  // a drop and a chosen file submits itself.
  const band = document.querySelector<HTMLElement>('[data-cr-letter-drop]');
  const input = document.querySelector<HTMLInputElement>('[data-cr-letter-file]');
  if (band && input) {
    document.querySelector<HTMLElement>('[data-cr-letter-nojs]')?.setAttribute('hidden', '');
    input.addEventListener('change', () => {
      if (input.files && input.files.length > 0) input.form?.requestSubmit();
    });
    wireDropZone(band, input);
  }
</script>

<style>
  /* A border that is there all along and only takes a colour on a drag, so
     the box does not grow by a pixel under the pointer. */
  .cr-letter-paste {
    margin-top: 12px;
  }
  .cr-letter {
    margin-top: 18px;
  }
  .cr-field-label {
    font-weight: 500;
    margin-bottom: 6px;
  }
  .cr-tag {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cr-tag[data-tone='live'] {
    color: var(--color-mark-live);
  }
  .cr-btn-gap {
    margin-top: 12px;
  }
  .cr-note-gap {
    margin-top: 8px;
  }
  .cr-note-wide {
    max-width: 60ch;
  }
  .cr-note-small {
    margin-top: 8px;
  }
  .cr-links {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }
  .cr-link-row {
    padding: 8px 0;
    border-top: var(--border-hairline) solid var(--color-line);
    font-size: 0.95rem;
  }
  .cr-link-url {
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }
  .cr-link-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: stretch;
  }
  .cr-link-form .cr-input {
    font-size: 1.0625rem;
  }
  .cr-next {
    margin-top: 22px;
  }
</style>
