---
/**
 * Add your cover letter and links: step 6 of the paid flow, optional. The
 * letter on file is shown as it is kept; without one, a paste form to the
 * Profile's own endpoint. Links post to the Profile's link endpoint. Both
 * return here.
 */
import StepCard from './StepCard.astro';
import RingMark from './RingMark.astro';
import type { CoverLetterOnFile } from '../../lib/record-store';
import type { StoredLink } from '../../lib/profile-links';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';

interface Props {
  /** A read of this letter (or a resumé) is running right now. */
  parsePending?: boolean;
  letter: CoverLetterOnFile | null;
  links: StoredLink[];
  selfPath: string;
  doorPath: string;
}
const { letter, links, parsePending = false, selfPath, doorPath } = Astro.props;
const coverAction = routeFor('profile-import-cover');
/** The types the cover endpoint's own extractor accepts, the same list the
    resumé band offers. */
const ACCEPT = '.md,.markdown,.txt,.pdf,.docx,text/markdown,text/plain,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document';
const linkAction = routeFor('profile-link');
const statusUrl = routeFor('profile-import-status');
/** Where the last step's primary goes (owner, 2026-09-20): the Desk, not the
    door. The run's last act puts the reader in the application rather than on
    one more page of this flow. */
const deskHref = routeFor('desk');
---

<StepCard n={6} title="Add your cover letter and links" time="Optional, 1 min">
  <p class="cr-intro">Unlocks better drafts. Both optional; done when the letter is on file.</p>

  <div class="cr-letter">
    <label class="cr-between cr-field-label" for="cr-letter">
      <span>Cover letter on file</span>
      <span class="cr-tag" data-tone={letter ? 'live' : undefined}>{letter ? 'Added' : 'Optional'}</span>
    </label>
    {/* The band is here in both states. A letter already on file is not a
        reason to take the way of putting a different one up: dropping a file
        replaces what is stored, which is the only way to change it from this
        step. Its own form, because a file and a pasted body are two
        different requests to the same endpoint. */}
    <form method="POST" action={coverAction} enctype="multipart/form-data" class="cr-drop cr-dropzone" data-cr-letter-drop>
      <input type="hidden" name="return" value={selfPath} />
      <label class="cr-drop-label" for="cr-letter-file">
        <span class="cr-drop-line">{letter ? 'Drop a different letter here, or choose a file.' : 'Drop your letter here, or choose a file.'}</span>
        <span class="cr-drop-hint">PDF, Word (.docx), Markdown or plain text. {letter ? 'It replaces the one on file.' : 'Or paste it below.'}</span>
      </label>
      <input id="cr-letter-file" class="cr-file visually-hidden" type="file" name="file" accept={ACCEPT} required data-cr-letter-file />
      <label class="cr-link cr-letter-choose" for="cr-letter-file">Choose a file</label>
      <button type="submit" class="cr-link cr-letter-choose cr-nojs" data-cr-letter-nojs>Save that file</button>
    </form>
    {letter ? (
      <textarea id="cr-letter" class="cr-textarea cr-letter-paste" rows="7" readonly aria-label="Cover letter">{letter.text}</textarea>
    ) : (
      <form method="POST" action={coverAction} class="cr-letter-form">
        <input type="hidden" name="return" value={selfPath} />
        <textarea id="cr-letter" class="cr-textarea cr-letter-paste" name="pasted" rows="7" placeholder="Or paste the cover letter you reuse." aria-label="Cover letter" required></textarea>
        <button type="submit" class="cr-link cr-letter-save">Save cover letter</button>
      </form>
    )}
    {parsePending && (
      <div class="cr-reading-line" data-cr-letter-reading data-status-url={statusUrl} data-return={withBase(selfPath)} role="status" aria-live="polite">
        <RingMark />
        <span>Reading your letter on your key. Any link and any dated role it names lands below when it finishes.</span>
      </div>
    )}
    <p class="cr-note cr-note-gap cr-note-wide">Kept as a writing sample only. The cover letter draft takes its voice from it; the resumé draft never sees it. Any link it names is added below, and any dated role is proposed into your record.</p>
  </div>

  <div class="cr-rule-loose">
    <label class="cr-between cr-field-label" for="cr-link">
      <span>Links</span>
      <span class="cr-tag">Optional</span>
    </label>
    {links.length > 0 && (
      <ul class="cr-links">
        {links.map((l) => (
          <li class="cr-link-row"><span class="cr-mono cr-link-url">{l.url}</span></li>
        ))}
      </ul>
    )}
    <form method="POST" action={linkAction} class="cr-link-form">
      <input type="hidden" name="intent" value="add" />
      <input type="hidden" name="return" value={selfPath} />
      <input id="cr-link" class="cr-input" type="url" name="url" inputmode="url" autocomplete="off" placeholder="Paste any link. We read what it is from the address." aria-label="Add a link" />
      <button type="submit" class="cr-btn">Add</button>
    </form>
    <p class="cr-note cr-note-small">Links sit at the top of every draft.</p>
  </div>

  <div class="cr-actions cr-next">
    <a class="cr-btn" href={deskHref}>Done. Open the Desk</a>
  </div>
</StepCard>

<script>
  import { wireDropZone } from '../../lib/drop-zone';

  // A saved letter is read in the background on the member's key, and the
  // links and roles it names only reach this page once that read lands. The
  // page used to say nothing and change nothing, so the reader was left
  // looking at a letter that appeared to have done nothing. This waits for
  // the read and loads the step again when it finishes.
  const reading = document.querySelector<HTMLElement>('[data-cr-letter-reading]');
  if (reading) {
    const statusUrl = reading.dataset.statusUrl ?? '';
    const back = reading.dataset.return ?? '';
    const POLL_MS = 3000;
    const POLL_LIMIT = 40;
    void (async () => {
      for (let n = 0; n < POLL_LIMIT; n += 1) {
        await new Promise((r) => setTimeout(r, POLL_MS));
        try {
          const response = await fetch(statusUrl, { credentials: 'same-origin', headers: { Accept: 'application/json' } });
          // A session that expired mid-wait does not answer with an error: the
          // gate redirects to sign-in and this reads a 200 of HTML. Anything
          // that is not the JSON this endpoint speaks ends the wait and hands
          // the reader back to the page, which knows where to send them.
          const isJson = (response.headers.get('content-type') ?? '').includes('application/json');
          if (!response.ok || response.redirected || !isJson) {
            window.location.assign(back);
            return;
          }
          const body = (await response.json()) as { status?: string };
          if (body.status === 'ready' || body.status === 'none') {
            window.location.assign(back);
            return;
          }
        } catch {
          // A blip is not an answer; the next tick asks again.
        }
      }
    })();
  }

  // The same band the resumé step has, on the letter. With no script the
  // file form still posts through its own button; with script, the box takes
  // a drop and a chosen file submits itself.
  const band = document.querySelector<HTMLElement>('[data-cr-letter-drop]');
  const input = document.querySelector<HTMLInputElement>('[data-cr-letter-file]');
  if (band && input) {
    document.querySelector<HTMLElement>('[data-cr-letter-nojs]')?.setAttribute('hidden', '');
    input.addEventListener('change', () => {
      if (input.files && input.files.length > 0) input.form?.requestSubmit();
    });
    wireDropZone(band, input);
  }
</script>

<style>
  /* A border that is there all along and only takes a colour on a drag, so
     the box does not grow by a pixel under the pointer. */
  .cr-letter-paste {
    margin-top: 12px;
  }
  /* This step's one primary is Done, at its foot. Choosing a file and saving
     the letter are the step's supporting moves, so they take the site's
     secondary treatment: text with a hairline underline. The resumé step's
     band keeps its filled button, because there the choice IS the step. */
  .cr-letter-choose {
    display: inline-block;
    margin-top: 14px;
  }
  .cr-letter-save {
    display: inline-block;
    margin-top: 12px;
  }
  .cr-reading-line {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 14px;
    align-items: center;
    margin-top: 14px;
    padding: 12px 14px;
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius);
    font-size: 0.95rem;
    line-height: 1.45;
  }
  .cr-letter {
    margin-top: 18px;
  }
  .cr-field-label {
    font-weight: 500;
    margin-bottom: 6px;
  }
  .cr-tag {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .cr-tag[data-tone='live'] {
    color: var(--color-mark-live);
  }
  .cr-btn-gap {
    margin-top: 12px;
  }
  .cr-note-gap {
    margin-top: 8px;
  }
  .cr-note-wide {
    max-width: 60ch;
  }
  .cr-note-small {
    margin-top: 8px;
  }
  .cr-links {
    margin: 0 0 10px;
    padding: 0;
    list-style: none;
  }
  .cr-link-row {
    padding: 8px 0;
    border-top: var(--border-hairline) solid var(--color-line);
    font-size: 0.95rem;
  }
  .cr-link-url {
    font-size: 0.82rem;
    overflow-wrap: anywhere;
  }
  .cr-link-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: stretch;
  }
  .cr-link-form .cr-input {
    font-size: 1.0625rem;
  }
  .cr-next {
    margin-top: 22px;
  }
</style>
