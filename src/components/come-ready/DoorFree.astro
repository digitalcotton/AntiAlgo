---
/**
 * The door of the free flow: what the paid account opens. Not a step, a
 * choice, and the one place the free run asks for the upgrade.
 *
 * THE BUTTON IS ALWAYS THE BUTTON (owner, 2026-09-20). It posts to checkout
 * while the stripe flag is on. While the flag is off there is nothing that can
 * take a card (billing/checkout is 404 behind the flag, see FLAGGED_ROUTES),
 * so the same button renders disabled with the reason under it rather than
 * linking somewhere that answers 404 or pretending a press did something. The
 * day the flag flips it is live with no other change here.
 */
import StepCard from './StepCard.astro';
import RingMark from './RingMark.astro';
import { withBase } from '../../../site.config.mjs';
import { routeFor } from '../../data/nav';

interface Props {
  billingOpen: boolean;
}
const { billingOpen } = Astro.props;
const checkoutAction = routeFor('billing-checkout');

const PAID_OPENS = [
  { name: 'The Desk', def: 'the sweep narrowed to your titles, new and died nightly' },
  { name: 'Bring your own key', def: 'drafting in your voice, on your bill' },
  { name: 'The Profile Record', def: 'your facts, kept exact, private' },
  { name: 'Tailored resumé and cover letter', def: 'one of each, per posting' },
  { name: 'Opportunities, the Pre-List, the Drop', def: 'what you told us, who raised, the week at source' },
  { name: 'Jobs Data, the whole thing', def: 're-cut to your titles' }
];
---

<StepCard title="What the paid account opens" time="Not a step. Your choice.">
  <div class="cr-price">
    <span class="cr-price-figure">$7.25</span>
    <span class="cr-price-line">a month. The federal minimum wage has not moved since 2009, and neither will this.</span>
  </div>
  <div class="cr-opens">
    {PAID_OPENS.map((o) => (
      <div class="cr-open">
        <RingMark tone="done" />
        <span>
          <span class="cr-open-name">{o.name}</span>
          <span class="cr-open-def">{o.def}</span>
        </span>
      </div>
    ))}
  </div>
  <p class="cr-note cr-note-gap cr-note-wide">Your titles and the job you added come with you. Your AI runs on your key, so we never pay for it and never charge for it.</p>
  <div class="cr-next">
    {billingOpen ? (
      <form method="POST" action={checkoutAction}>
        <button type="submit" class="cr-btn">Open the paid account, $7.25 a month</button>
      </form>
    ) : (
      <button type="button" class="cr-btn cr-btn-shut" disabled aria-describedby="cr-billing-note">
        Open the paid account, $7.25 a month
      </button>
    )}
    <p class="cr-note cr-note-wide" id="cr-billing-note">
      {billingOpen
        ? "Card details are entered on Stripe's page, never here."
        : "Billing is not open yet, so this cannot be pressed. The price does not move when it opens, and card details will be entered on Stripe's page, never here."}
    </p>
  </div>
</StepCard>

<style>
  .cr-price {
    display: flex;
    align-items: baseline;
    gap: 14px;
    flex-wrap: wrap;
  }
  .cr-price-figure {
    font-family: var(--font-family-sans);
    font-weight: 700;
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .cr-price-line {
    font-size: 1.0625rem;
    line-height: 1.3;
  }
  .cr-opens {
    margin-top: 18px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0 24px;
  }
  .cr-open {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    padding: 10px 0;
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .cr-open .cr-mark {
    margin-top: 5px;
  }
  .cr-open-name {
    display: block;
    font-weight: 500;
    line-height: 1.4;
  }
  .cr-open-def {
    display: block;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .cr-note-gap {
    margin-top: 16px;
  }
  .cr-note-wide {
    max-width: 60ch;
  }
  .cr-next {
    margin-top: 20px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  /* Billing is shut: the button keeps its shape and place so the reader can
     see exactly what will open, and gives up the signal fill so it cannot be
     mistaken for something that will answer a press. */
  .cr-btn-shut {
    background: var(--color-surface-raised);
    color: var(--color-muted);
    border: var(--border-hairline) solid var(--color-line-strong);
    cursor: not-allowed;
    /* WebKit dims a disabled control on its own, on top of the colour set
       here, which took the label under the contrast floor on ink. These two
       lines hold the colour that was asked for: muted on the raised surface
       is 7.6:1 on ink and 5.5:1 on paper, so the label stays readable while
       still reading as unavailable. */
    opacity: 1;
    -webkit-text-fill-color: var(--color-muted);
  }
  /* A control that cannot be pressed does not answer a pointer. Without this
     the shared .cr-btn:hover rule reaches it and repaints the label: that rule
     sets the fixed dark ink the orange button needs, which is not defined in
     this scope, so the colour fell back to inherit and the label changed on
     hover for no reason and with no promise behind it. */
  .cr-btn-shut:hover,
  .cr-btn-shut:focus-visible {
    background: var(--color-surface-raised);
    color: var(--color-muted);
    -webkit-text-fill-color: var(--color-muted);
    filter: none;
  }
</style>
