---
/**
 * Name your titles: step 3 of the paid flow, step 4 of the free one. The
 * watch list's own machinery (POST /ledger/watch, the live title index as a
 * datalist) with the first-run changes the design asks for: the input is
 * focused, the five most live titles are offered before the reader types,
 * an added title shows its live count, stretch is a quieter second add, and
 * the Desk's controls sit collapsed on the same card (paid only; the Desk
 * is paid).
 */
import StepCard from './StepCard.astro';
import type { ComeReadyTitle } from '../../lib/come-ready-store';
import type { LedgerSelection } from '../../lib/ledger-prefs-store';
import type { TitleCount } from '../../lib/ledger-titles';
import { DESK_TITLE_HEAD } from '../../lib/desk-home';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';

interface Props {
  edition: 'paid' | 'free';
  n: number;
  coreTitles: ComeReadyTitle[];
  stretchTitles: string[];
  /** The HEAD of the live title index, most common first (desk-home.ts's
      DESK_TITLE_HEAD rows at most); empty when the sweep could not be read. */
  titleIndex: TitleCount[];
  /** How many distinct live titles the board carries in all, so the panel can
      say how much of the index is behind the rows. */
  titleCount: number;
  prefs: LedgerSelection | null;
  /** This step's own address, base-free (the forms return here). */
  selfPath: string;
  /** The paid flow's next step. The free flow has none: naming titles is the
      last thing it asks for, so its action opens the Desk instead. */
  nextPath: string;
  /** Whether the reader had the controls open when they pressed one, so the
      reload lands with them open rather than collapsing under the press. */
  controlsOpen?: boolean;
}
const { edition, n, coreTitles, stretchTitles, titleIndex, titleCount, prefs, selfPath, nextPath, controlsOpen = false } = Astro.props;
/** Where a control returns: this step, with the controls still open. */
const controlsPath = `${selfPath}&controls=1`;

const watchAction = routeFor('ledger-watch');
const prefsAction = routeFor('ledger-prefs');
/** The free flow's last act: into the application, not on to another step. */
const deskHref = routeFor('desk');
const hasTitle = coreTitles.length > 0;
/** The rows the dropdown holds, most live first. Rendered whole and narrowed
    in place, so the panel needs no request of its own and the top of the list
    is already there before a key is pressed. The board carries thousands of
    distinct live titles and all of them as markup is megabytes, so this is the
    head of that list; the field takes any title either way, and what is here
    is what can be browsed.
    Raised from 500 to 1,500 on 2026-09-25: the owner typed "design", saw four
    rows and read the list as thin. Most of that was the window (see the panel's
    max-height, and the count line below, which now says how many matched), but
    the head was also narrower than it needed to be. 1,500 rows of markup is
    tens of kilobytes over the wire, which this page can carry; the whole index
    is not, and the honest fix for the tail is a search that asks the server.
    THE LIST IS STILL A HEAD, NOT THE WHOLE INDEX.
    The number is DESK_TITLE_HEAD, imported rather than restated: since
    2026-09-25 the database applies it as a LIMIT, so a number typed here that
    was larger than that one would silently show fewer rows than it asked for. */
const TITLE_ROWS = DESK_TITLE_HEAD;
const options = titleIndex.slice(0, TITLE_ROWS);
/** How much of the index is behind the rows, so the panel can say so rather
    than letting the reader assume the head is all of it. */
const titlesNotShown = Math.max(0, titleCount - options.length);

const PAY_FLOORS = [
  { label: 'any', value: 0 },
  { label: '65k+', value: 65_000 },
  { label: '150k+', value: 150_000 },
  { label: '200k+', value: 200_000 },
  { label: '250k+', value: 250_000 },
  { label: '300k+', value: 300_000 },
  { label: '400k+', value: 400_000 },
  { label: '500k+', value: 500_000 },
  { label: '700k+', value: 700_000 }
];
const remoteOnly = Boolean(prefs?.remoteOnly);
const floor = prefs?.compFloor ?? 0;
const controlsLine = `Remote only: ${remoteOnly ? 'on' : 'off'}. Pay floor: ${floor > 0 ? `$${Math.round(floor / 1000)}k+` : 'none set'}.`;
---

<StepCard n={n} title="Name your titles" time="1 to 2 min">
  {edition === 'paid' ? (
    <p class="cr-intro">Unlocks the Desk, narrowed to your titles tonight, and a title menu in the board's search cell. The board itself is never pre-filtered.</p>
  ) : (
    <p class="cr-intro">Unlocks a title menu in the board's search cell, with tonight's live count beside each. The board itself is never pre-filtered. The Desk, the sweep narrowed to your titles nightly, is on the paid account.</p>
  )}

  <div class="cr-titles">
    <span class="cr-label">Core, apply today</span>
    {coreTitles.map((t) => (
      <div class="cr-title-row">
        <span class="cr-title-name">{t.title}</span>
        {t.liveCount !== null ? (
          <span class="cr-title-live">{t.liveCount} live{t.titlesLive !== null && t.titlesTotal !== null && <span class="cr-title-of">, {t.titlesLive} of {t.titlesTotal} titles</span>}</span>
        ) : (
          <span class="cr-title-of cr-mono">not counted</span>
        )}
        <form method="POST" action={watchAction} class="cr-title-remove">
          <input type="hidden" name="intent" value="remove" />
          <input type="hidden" name="title" value={t.title} />
          <input type="hidden" name="return" value={selfPath} />
          <button type="submit" class="cr-remove" aria-label={`Remove ${t.title}`}>&#215;</button>
        </form>
      </div>
    ))}
    <form method="POST" action={watchAction} data-cr-combo data-cr-have={JSON.stringify(coreTitles.map((t) => t.title))}>
      <input type="hidden" name="intent" value="add" />
      <input type="hidden" name="shelf" value="core" />
      <input type="hidden" name="return" value={selfPath} />
      <div class="cr-add">
        <input
          class="cr-input"
          type="text"
          name="title"
          minlength="2"
          maxlength="120"
          placeholder="Pick one below, or type your own and press Enter"
          aria-label="Add a core title"
          autofocus={!hasTitle}
          autocomplete="off"
          role="combobox"
          aria-expanded={!hasTitle && options.length > 0 ? 'true' : 'false'}
          aria-controls="cr-titles-core"
          aria-autocomplete="list"
          data-cr-combo-input
        />
      </div>
      <p class="cr-add-note" data-cr-combo-note role="status" hidden></p>
      {options.length > 0 && (
        <div class="cr-suggest" id="cr-titles-core" role="listbox" aria-label="Live titles" data-cr-combo-panel hidden={hasTitle}>
          <p class="cr-suggest-head" data-cr-combo-head data-default="Most live tonight">Most live tonight</p>
          {options.map((o) => (
            <button type="button" class="cr-suggest-row" role="option" data-cr-combo-row data-title={o.title}>
              <span>{o.title}</span>
              <span class="cr-suggest-live">{o.count.toLocaleString()} live</span>
            </button>
          ))}
          {titlesNotShown > 0 && (
            <p class="cr-suggest-foot">
              The {options.length.toLocaleString()} most live of {titleCount.toLocaleString()} titles on the board. Type any other and press Enter; it does not have to be on this list.
            </p>
          )}
        </div>
      )}
    </form>
  </div>

  {hasTitle && (
    <details class="cr-stretch">
      <summary class="cr-between cr-rule">
        <span class="cr-label cr-label-inline">Stretch, working toward</span>
        <span class="cr-btn cr-btn-secondary cr-btn-small">{stretchTitles.length > 0 ? 'Add another' : 'Add a stretch title'}</span>
      </summary>
      {stretchTitles.map((title) => (
        <div class="cr-title-row">
          <span class="cr-title-name">{title}</span>
          <span></span>
          <form method="POST" action={watchAction} class="cr-title-remove">
            <input type="hidden" name="intent" value="remove" />
            <input type="hidden" name="title" value={title} />
            <input type="hidden" name="return" value={selfPath} />
            <button type="submit" class="cr-remove" aria-label={`Remove ${title}`}>&#215;</button>
          </form>
        </div>
      ))}
      <form method="POST" action={watchAction} class="cr-add-stretch" data-cr-combo data-cr-have={JSON.stringify(stretchTitles)}>
        <input type="hidden" name="intent" value="add" />
        <input type="hidden" name="shelf" value="stretch" />
        <input type="hidden" name="return" value={selfPath} />
        <div class="cr-add">
          <input
            class="cr-input"
            type="text"
            name="title"
            minlength="2"
            maxlength="120"
            placeholder="Pick one below, or type your own and press Enter"
            aria-label="Add a stretch title"
            autocomplete="off"
            role="combobox"
            aria-expanded="false"
            aria-controls="cr-titles-stretch"
            aria-autocomplete="list"
            data-cr-combo-input
          />
        </div>
        <p class="cr-add-note" data-cr-combo-note role="status" hidden></p>
        {options.length > 0 && (
          <div class="cr-suggest" id="cr-titles-stretch" role="listbox" aria-label="Live titles" data-cr-combo-panel hidden>
            <p class="cr-suggest-head" data-cr-combo-head data-default="Most live tonight">Most live tonight</p>
            {options.map((o) => (
              <button type="button" class="cr-suggest-row" role="option" data-cr-combo-row data-title={o.title}>
                <span>{o.title}</span>
                <span class="cr-suggest-live">{o.count.toLocaleString()} live</span>
              </button>
            ))}
          </div>
        )}
      </form>
    </details>
  )}

  {edition === 'paid' && (
    <details class="cr-controls" open={controlsOpen}>
      <summary class="cr-between cr-rule-tight">
        <span class="cr-note">{controlsLine}</span>
        <span class="cr-btn cr-btn-secondary cr-btn-small">Open controls</span>
      </summary>
      <div class="cr-controls-body">
        <div class="cr-control-row">
          <span class="cr-label cr-label-inline">where</span>
          <div class="cr-actions">
            <form method="POST" action={prefsAction}>
              <input type="hidden" name="field" value="remote" />
              <input type="hidden" name="value" value="1" />
              <input type="hidden" name="return" value={controlsPath} />
              <button type="submit" class="cr-chip" aria-pressed={remoteOnly}>remote only</button>
            </form>
            <form method="POST" action={prefsAction}>
              <input type="hidden" name="field" value="remote" />
              <input type="hidden" name="value" value="0" />
              <input type="hidden" name="return" value={controlsPath} />
              <button type="submit" class="cr-chip" aria-pressed={!remoteOnly}>anywhere</button>
            </form>
          </div>
        </div>
        <div class="cr-control-row">
          <span class="cr-label cr-label-inline">pay floor</span>
          <div class="cr-actions cr-actions-tight">
            {PAY_FLOORS.map((f) => (
              <form method="POST" action={prefsAction}>
                <input type="hidden" name="field" value="floor" />
                <input type="hidden" name="value" value={String(f.value)} />
                <input type="hidden" name="return" value={controlsPath} />
                <button type="submit" class="cr-chip" aria-pressed={floor === f.value}>{f.label}</button>
              </form>
            ))}
          </div>
        </div>
      </div>
    </details>
  )}

  {hasTitle && (
    <div class="cr-actions cr-next">
      {edition === 'paid' ? (
        <a class="cr-btn" href={withBase(nextPath)}>Next: connect your key</a>
      ) : (
        <>
          <a class="cr-btn" href={deskHref}>Done. Open the Desk</a>
          <span class="cr-ok">Your titles are in the board's menu now.</span>
        </>
      )}
    </div>
  )}
</StepCard>

<script>
  // The title dropdown, drawn by this site rather than by the browser. A
  // native <datalist> renders in the platform's own chrome (rounded, system
  // font) and cannot be styled, so the rows are ours: the whole list is in
  // the page and typing narrows it in place, which also means no request per
  // keystroke.
  //
  // THERE IS NO ADD BUTTON (owner, 2026-09-25). Choosing a row already commits
  // the title on click, which made a button beside it a control with nothing
  // left to do. A form whose only text field is this one submits on Enter by
  // itself (implicit submission), so a title nobody has posted yet still goes
  // in, and the placeholder says so. With no script at all the panel stays as
  // the server left it and Enter is the way in.
  document.querySelectorAll<HTMLFormElement>('[data-cr-combo]').forEach((form) => {
    const input = form.querySelector<HTMLInputElement>('[data-cr-combo-input]');
    const panel = form.querySelector<HTMLElement>('[data-cr-combo-panel]');
    if (!input || !panel) return;
    const rows = Array.from(form.querySelectorAll<HTMLButtonElement>('[data-cr-combo-row]'));

    // The titles already on THIS shelf, as the server spelled them. The add is
    // an upsert on (user_id, title), so posting one of these writes the row it
    // already wrote and the page comes back identical: the press looks broken
    // because nothing on the page can have changed. The answer is given here,
    // before the trip, since the page already knows the list.
    const note = form.querySelector<HTMLElement>('[data-cr-combo-note]');
    let have: string[] = [];
    try {
      const parsed = JSON.parse(form.dataset.crHave ?? '[]');
      if (Array.isArray(parsed)) have = parsed.filter((t): t is string => typeof t === 'string');
    } catch {
      have = [];
    }
    /** The stored spelling of a title already on the shelf, else null. Matched
        without case, because two rows differing only in case is a worse answer
        than being told the title is already there. */
    const already = (value: string): string | null =>
      have.find((t) => t.toLowerCase() === value.toLowerCase()) ?? null;
    const say = (message: string | null) => {
      if (!note) return;
      note.textContent = message ?? '';
      note.hidden = message === null;
    };

    // Set by Escape and cleared by the next keystroke, so returning focus to
    // the field after a dismissal does not immediately reopen the list.
    let dismissed = false;

    const open = (on: boolean) => {
      panel.hidden = !on;
      input.setAttribute('aria-expanded', String(on));
    };
    const visible = () => rows.filter((row) => !row.hidden);

    // The panel is a short scrolling window, so a narrow that leaves forty
    // matches looks exactly like one that leaves four (owner, 2026-09-25: typed
    // "design", saw four rows, read the list as thin). The head says the count,
    // so the window's height stops being the reader's only evidence.
    const head = form.querySelector<HTMLElement>('[data-cr-combo-head]');
    const headDefault = head?.dataset.default ?? 'Most live tonight';

    function narrow(): void {
      const query = input!.value.trim().toLowerCase();
      let shown = 0;
      for (const row of rows) {
        const hit = query.length === 0 || (row.dataset.title ?? '').toLowerCase().includes(query);
        row.hidden = !hit;
        if (hit) shown += 1;
      }
      if (head) {
        head.textContent =
          query.length === 0
            ? headDefault
            : `${shown.toLocaleString()} ${shown === 1 ? 'title matches' : 'titles match'} "${input!.value.trim()}"`;
      }
      // Back to the head of the list: after narrowing, the best match is the
      // first row, and a panel left scrolled down would hide it.
      panel!.scrollTop = 0;
      open(shown > 0);
    }

    // Both ways of adding end here: Enter in the field submits, and choosing
    // a row calls requestSubmit(). So one guard covers both.
    form.addEventListener('submit', (event) => {
      const value = input.value.trim();
      if (value.length < 2) {
        event.preventDefault();
        open(false);
        say('Type a title, two letters or more.');
        input.focus();
        return;
      }
      const onFile = already(value);
      if (onFile !== null) {
        event.preventDefault();
        open(false);
        say(`${onFile} is already on your list.`);
        input.focus();
      }
    });

    input.addEventListener('input', () => {
      dismissed = false;
      say(null);
      narrow();
    });
    input.addEventListener('focus', () => {
      if (!dismissed) narrow();
    });

    // Down from the field walks into the list, the way the native control
    // behaved; Escape closes it and gives the field back.
    input.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowDown') {
        const first = visible()[0];
        if (first) {
          event.preventDefault();
          first.focus();
        }
      } else if (event.key === 'Escape' && !panel.hidden) {
        event.preventDefault();
        dismissed = true;
        open(false);
      }
    });

    for (const row of rows) {
      // Choosing a row adds that title, the same act the row beneath the
      // field performed before: one press, not a fill and a second press.
      row.addEventListener('click', () => {
        input.value = row.dataset.title ?? '';
        form.requestSubmit();
      });
      row.addEventListener('keydown', (event) => {
        const list = visible();
        const at = list.indexOf(row);
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const next = list[at + (event.key === 'ArrowDown' ? 1 : -1)];
          if (next) next.focus();
          else if (event.key === 'ArrowUp') input.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          dismissed = true;
          open(false);
          input.focus();
        }
      });
    }

    // A press on a row must not take focus off the field. Chromium focuses a
    // button on mousedown, so the focusout below arrives with the row as its
    // relatedTarget and the panel survives the press. Safari and Firefox on
    // macOS do not focus a button, so focusout arrives with no relatedTarget,
    // the panel hides, and the row is gone before mouseup can complete the
    // click: the press produces no click event at all and choosing a title
    // does nothing. Refusing the default on the press keeps focus in the field
    // in every browser, so the click always lands. Scoped to the rows, so the
    // panel's own scrollbar still drags.
    panel.addEventListener('mousedown', (event) => {
      const target = event.target as Element | null;
      if (target?.closest('[data-cr-combo-row]')) event.preventDefault();
    });

    // Leaving the field and the list together closes it; moving between them
    // does not.
    form.addEventListener('focusout', (event) => {
      const to = event.relatedTarget as Node | null;
      if (!to || !form.contains(to)) open(false);
    });
  });
</script>

<style>
  .cr-titles {
    margin-top: 18px;
  }
  /* Name, count, and the remove control as its own track, so the counts line
     up down the list whether or not a row carries one. */
  .cr-title-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 2ch;
    gap: 16px;
    align-items: baseline;
    padding: 10px 0;
    border-top: var(--border-hairline) solid var(--color-line);
  }
  .cr-title-remove {
    display: flex;
    justify-content: flex-end;
  }
  .cr-remove {
    border: 0;
    background: none;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family-mono);
    font-size: 1.25rem;
    line-height: 1;
    color: var(--color-muted);
  }
  .cr-remove:hover,
  .cr-remove:focus-visible {
    color: var(--color-stat-loss);
  }
  .cr-title-name {
    font-weight: 500;
  }
  .cr-title-live {
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--color-mark-live);
    white-space: nowrap;
  }
  .cr-title-of {
    color: var(--color-muted);
    font-size: 0.82rem;
  }
  .cr-add {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
    align-items: stretch;
    margin-top: 6px;
  }
  .cr-add .cr-input {
    font-size: 1.0625rem;
  }
  .cr-add-stretch .cr-add {
    margin-top: 12px;
  }
  /* The add's answer, under the field. Muted rather than the loss red of
     .cr-alert: a title already watched is the list working, not a refusal.
     It never shows at the same time as the panel, which is closed when this
     is said, so the panel keeps its flush join to the field. */
  .cr-add-note {
    margin: 8px 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  /* The rule above deliberately sets no display, so the hidden attribute works
     on its own. This line is the guard for the next edit: the moment a display
     lands above, hidden loses to it silently. */
  .cr-add-note[hidden] {
    display: none;
  }
  /* The whole list is here, so the panel is a scroller: about six rows tall,
     which is enough to read as a list with more below without pushing the
     step's own actions off the card. */
  .cr-suggest {
    border: var(--border-hairline) solid var(--color-line-strong);
    border-top: 0;
    border-radius: 0 0 var(--radius) var(--radius);
    /* Was 246px, about five rows, which made every narrowed list look like a
       short one. Nine rows is enough to read as a list you scroll. */
    max-height: 430px;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  /* The heading stays put while the rows move under it, so what the list is
     ordered by is still on screen at row two hundred. */
  .cr-suggest-head {
    position: sticky;
    top: 0;
    z-index: 1;
    margin: 0;
    padding: 8px 12px;
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-surface-raised);
    border-bottom: var(--border-hairline) solid var(--color-line);
  }
  .cr-suggest-foot {
    position: sticky;
    bottom: 0;
    margin: 0;
    padding: 8px 12px;
    background: var(--color-surface-raised);
    border-top: var(--border-hairline) solid var(--color-line);
    font-family: var(--font-family-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--color-muted);
  }
  .cr-suggest-row {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 9px 12px;
    border: 0;
    border-bottom: var(--border-hairline) solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    font: inherit;
    text-align: left;
    cursor: pointer;
  }
  /* The rule above sets display, so a narrowed-out row needs its own line to
     beat it: the hidden attribute's own display:none loses to any author
     rule that sets display. */
  .cr-suggest-row[hidden] {
    display: none;
  }
  .cr-suggest-row:hover,
  .cr-suggest-row:focus-visible {
    background: var(--color-hover-surface);
  }
  .cr-suggest-live {
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
  }
  summary {
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .cr-label-inline {
    display: inline;
    margin: 0;
  }
  .cr-controls-body {
    display: grid;
    gap: 12px;
    padding-top: 14px;
  }
  .cr-control-row {
    display: grid;
    gap: 6px;
  }
  .cr-actions-tight {
    gap: 8px;
  }
  .cr-chip {
    min-height: 36px;
    padding: 0 12px;
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius);
    background: var(--color-surface-raised);
    color: var(--color-foreground);
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    cursor: pointer;
  }
  .cr-chip[aria-pressed='true'] {
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
    border-color: var(--color-surface-inverse);
  }
  .cr-next {
    margin-top: 22px;
  }
</style>
