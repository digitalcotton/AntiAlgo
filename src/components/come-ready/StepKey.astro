---
/**
 * Connect your key: step 4 of the paid flow, designed as a round trip. Pick
 * a console, read the trip, open it in a new tab, paste the key here on
 * return. The paste field checks the key's shape as you type with the same
 * rules and the same reason strings src/lib/keychain.ts applies on save (the
 * server is still the decision: the form posts to /settings/keys/save, which
 * returns here with saved=1 when the key is stored). The connected state
 * slides in once, the site's one 320ms moment, and only on that return.
 */
import StepCard from './StepCard.astro';
import RingMark from './RingMark.astro';
import type { ConnectedKey } from '../../lib/come-ready-store';
import { PROVIDERS, type Provider } from '../../lib/keychain';
import { PROVIDER_REGISTRY } from '../../lib/generation-providers';
import { dayStamp } from '../../lib/stats';
import { routeFor } from '../../data/nav';
import { withBase } from '../../../site.config.mjs';

interface Props {
  key: ConnectedKey | null;
  keysConfigured: boolean;
  /** The provider chosen on this visit (?provider=), or null. */
  chosen: Provider | null;
  /** True on the return from a save: the connected state plays its moment. */
  justSaved: boolean;
  /** The save endpoint's reason for refusing a key, relayed back to this
      step so a refusal is answered where it happened. */
  saveError?: string | null;
  selfPath: string;
  nextPath: string;
  skipPath: string;
  /** Step 3, so the run can be walked backwards as well as forwards. */
  backPath: string;
}
const { key, keysConfigured, chosen, justSaved, saveError = null, selfPath, nextPath, skipPath, backPath } = Astro.props;

/** The consoles, in the site's provider order. Addresses as the Your key
    page lists them; the one-line reasons are the design's. */
const CONSOLES: Record<Provider, { host: string; url: string; reason: string; placeholder: string }> = {
  anthropic: { host: 'console.anthropic.com', url: 'https://console.anthropic.com/settings/keys', reason: 'Keys start with sk-ant-. Writes and reads with Claude.', placeholder: 'sk-ant-...' },
  openai: { host: 'platform.openai.com', url: 'https://platform.openai.com/api-keys', reason: 'The console most readers have seen once already.', placeholder: 'sk-...' },
  kimi: { host: 'platform.moonshot.ai', url: 'https://platform.moonshot.ai/console/api-keys', reason: 'Long documents at low cost.', placeholder: 'sk-...' },
  deepseek: { host: 'platform.deepseek.com', url: 'https://platform.deepseek.com/api_keys', reason: 'The cheapest draft of the four.', placeholder: 'sk-...' }
};

/** The trip, as the Your key page words it. The fifth step there is "Paste
    it into Settings"; here the paste field below is that step. */
const TRIP = ['Sign in, or make the account.', 'Open the API keys page.', 'Create a key.', 'Set a monthly spend cap.'];

const saveAction = routeFor('settings-keys-save');
const removeAction = routeFor('settings-keys-remove');
const provider: Provider = chosen ?? 'anthropic';
const console = CONSOLES[provider];
const returnPath = `${selfPath}&saved=1`;
---

<StepCard n={4} title="Connect your key" time="3 to 5 min, off site" back={{ href: withBase(backPath), label: 'Back to step 3' }}>
  <p class="cr-intro">Unlocks the resumé reader and drafting. Your model, your bill, cents per draft. The key is encrypted for you alone and read only at the instant a draft is written.</p>

  {key ? (
    <div class:list={['cr-connected', { 'cr-motion': justSaved }]}>
      <div class="cr-box" data-tone="live">
        <RingMark tone="done" />
        <div>
          <p class="cr-box-line">{key.label}. Connected, key ends in <span class="cr-mono">{key.last4}</span>.</p>
          <p class="cr-box-meta">added {dayStamp(key.addedAt)} &#183; writes with {key.writesWith} &#183; reads with {key.readsWith}</p>
        </div>
      </div>
      <p class="cr-note cr-note-gap">Your provider answered this key when it was saved.</p>

      {/* One row, the two directions opposite each other (owner, 2026-09-25):
          the step forward on the left where every other step keeps it, the way
          back out pushed to the far right so it is never the thing a reader
          hits on the way through. Picking again is also how a wrong key is
          replaced, which is why removing and re-picking is one action. */}
      <div class="cr-actions cr-next cr-split">
        <a class="cr-btn" href={withBase(nextPath)}>Next: bring your resumé</a>
        <form method="POST" action={removeAction}>
          <input type="hidden" name="provider" value={key.provider} />
          <input type="hidden" name="return" value={selfPath} />
          <button type="submit" class="cr-link-quiet">Remove and pick again</button>
        </form>
      </div>
    </div>
  ) : (
    <>
      <span class="cr-label cr-pick">Pick one console</span>
      <script type="application/json" data-cr-consoles set:html={JSON.stringify(CONSOLES)} is:inline></script>
      <div class="cr-providers">
        {PROVIDERS.map((id) => (
          <a class="cr-provider" href={withBase(`${selfPath}&provider=${id}`)} aria-current={chosen === id ? 'true' : undefined} data-cr-provider={id}>
            <span class="cr-between cr-provider-head">
              <span class="cr-provider-name">{PROVIDER_REGISTRY[id].label}</span>
              <span class="cr-provider-host">{CONSOLES[id].host}</span>
            </span>
            <span class="cr-provider-reason">{CONSOLES[id].reason}</span>
          </a>
        ))}
      </div>

      {chosen && (
        <div class="cr-rule-loose">
          <span class="cr-label">The trip, at <span data-cr-console-host>{console.host}</span></span>
          <ol class="cr-trip">
            {TRIP.map((text, i) => (
              <li>
                <span class="cr-trip-n">{i + 1}</span>
                <span>{text}</span>
              </li>
            ))}
          </ol>
          <p class="cr-intro cr-intro-gap">Set a monthly spend cap in their console. Drafting costs cents; the cap is your ceiling.</p>
          <div class="cr-actions cr-actions-gap">
            <a class="cr-btn cr-btn-secondary" href={console.url} target="_blank" rel="noopener" data-cr-console-link>Open <span data-cr-console-host>{console.host}</span></a>
            <span class="cr-note">Opens in a new tab. This one waits here.</span>
          </div>
        </div>
      )}

      <div class="cr-rule">
        {keysConfigured ? (
          <form method="POST" action={saveAction} class="cr-paste" data-cr-key-form data-provider={provider}>
            <input type="hidden" name="provider" value={provider} />
            <input type="hidden" name="return" value={returnPath} />
            <label class="cr-paste-label" for="cr-key">Paste it here when you are back.</label>
            <input
              id="cr-key"
              class="cr-input cr-mono"
              type="password"
              name="key"
              placeholder={console.placeholder}
              aria-label="Your API key"
              autocomplete="off"
              spellcheck="false"
              autofocus={chosen !== null}
              data-cr-key
              required
            />
            <p class="cr-alert" role="alert" data-cr-key-reason hidden={!saveError}>{saveError}</p>
            <p class="cr-note cr-note-gap">Checked with your provider when you save, by reading their model list, which costs nothing. A key they do not recognise is not stored.</p>
            <div class="cr-actions cr-actions-gap">
              <button type="submit" class="cr-btn">Save key</button>
              <a class="cr-link-quiet" href={withBase(skipPath)}>Skip for now</a>
            </div>
          </form>
        ) : (
          <div class="cr-paste">
            <p class="cr-note">Key storage is not configured on this deployment right now. Nothing can be stored.</p>
            <div class="cr-actions cr-actions-gap">
              <a class="cr-link-quiet" href={withBase(skipPath)}>Skip for now</a>
            </div>
          </div>
        )}
      </div>
    </>
  )}
</StepCard>

<script>
  // The key's shape, checked as it is typed, with the exact rules and reason
  // strings of src/lib/keychain.ts validateKeyShape() (20 to 512 characters,
  // no whitespace, no control characters, the Anthropic prefix). Nothing is
  // sent anywhere here; the server runs the same check again on save.
  const MIN = 20;
  const MAX = 512;
  const ANTHROPIC_PREFIX = 'sk-ant-';
  function reasonFor(provider: string, value: string): string | null {
    if (value.length === 0) return 'key is empty';
    if (value.length < MIN || value.length > MAX) return `key length must be between ${MIN} and ${MAX} characters`;
    if (/\s/.test(value)) return 'key contains whitespace';
    if (/[\x00-\x1f\x7f]/.test(value)) return 'key contains control characters';
    if (provider === 'anthropic' && !value.startsWith(ANTHROPIC_PREFIX)) return `anthropic keys start with '${ANTHROPIC_PREFIX}'`;
    if (provider !== 'anthropic' && value.startsWith(ANTHROPIC_PREFIX)) {
      return `a key starting with '${ANTHROPIC_PREFIX}' is an anthropic key, not a ${provider} key`;
    }
    return null;
  }
  const form = document.querySelector<HTMLFormElement>('[data-cr-key-form]');
  const field = form?.querySelector<HTMLInputElement>('[data-cr-key]') ?? null;
  const line = form?.querySelector<HTMLElement>('[data-cr-key-reason]') ?? null;
  if (form && field && line) {
    const show = (reason: string | null) => {
      line.textContent = reason ?? '';
      line.hidden = reason === null;
      field.setAttribute('aria-invalid', reason === null ? 'false' : 'true');
    };
    /** Read fresh every time: switching console below rewrites it. */
    const providerNow = () => form.dataset.provider ?? 'anthropic';
    const revalidate = () => show(field.value.length === 0 ? null : reasonFor(providerNow(), field.value));

    field.addEventListener('input', revalidate);
    form.addEventListener('submit', (event) => {
      const reason = reasonFor(providerNow(), field.value);
      if (reason !== null) {
        event.preventDefault();
        show(reason);
        field.focus();
      }
    });

    /*
     * SWITCHING CONSOLE DOES NOT RELOAD THE PAGE, and that is the whole point.
     *
     * Each console is a link to ?provider=<id>, so picking a second one was a
     * full navigation and anything already pasted went with it: a reader who
     * typed their Anthropic key, looked at OpenAI, then came back found an
     * empty box (owner, 2026-09-25). Nothing is stored to fix that — putting a
     * secret in sessionStorage to survive a reload would be a worse answer than
     * not reloading. The four consoles differ by four strings, all of them
     * already on the page, so the panel is rewritten in place and the field is
     * never destroyed in the first place.
     *
     * The first pick still navigates: the trip panel does not exist until a
     * console is chosen, there is nothing typed yet, and the server rendering
     * it is the no-script path anyway.
     */
    const blob = document.querySelector('[data-cr-consoles]')?.textContent;
    const trip = document.querySelector<HTMLElement>('[data-cr-console-link]');
    const hidden = form.querySelector<HTMLInputElement>('input[name="provider"]');
    if (blob && trip && hidden) {
      let consoles: Record<string, { host: string; url: string; placeholder: string }> = {};
      try {
        consoles = JSON.parse(blob);
      } catch {
        consoles = {};
      }
      for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-cr-provider]')) {
        link.addEventListener('click', (event) => {
          const id = link.dataset.crProvider ?? '';
          const next = consoles[id];
          if (!next) return; // Unknown: let the link do what it says.
          // A modified click is the reader asking for a new tab. Leave it.
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();

          for (const other of document.querySelectorAll<HTMLAnchorElement>('[data-cr-provider]')) {
            if (other === link) other.setAttribute('aria-current', 'true');
            else other.removeAttribute('aria-current');
          }
          for (const host of document.querySelectorAll('[data-cr-console-host]')) host.textContent = next.host;
          trip.setAttribute('href', next.url);
          field.placeholder = next.placeholder;
          hidden.value = id;
          form.dataset.provider = id;
          // The reason is provider-specific ("sk-ant- is an anthropic key"), so
          // what is already typed is judged again against the console just
          // picked rather than the one before it.
          revalidate();
          // The address keeps up, so a reload lands on the same console. replace,
          // not push: flipping between two consoles is one decision, not four
          // steps to press Back through.
          history.replaceState(null, '', link.getAttribute('href') ?? location.href);
        });
      }
    }
  }
</script>

<style>
  .cr-pick {
    margin: 18px 0 6px;
  }
  .cr-providers {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .cr-provider {
    display: block;
    padding: 12px 14px;
    border: var(--border-hairline) solid var(--color-line);
    border-radius: var(--radius);
    color: var(--color-foreground);
    text-decoration: none;
  }
  .cr-provider:hover {
    background: var(--color-hover-surface);
    color: var(--color-foreground);
  }
  .cr-provider[aria-current='true'] {
    border: var(--border-heavy) solid var(--color-foreground);
    padding: 11px 13px;
  }
  .cr-provider-head {
    gap: 10px;
    flex-wrap: nowrap;
  }
  .cr-provider-name {
    font-weight: 500;
  }
  .cr-provider-host {
    font-family: var(--font-family-mono);
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  .cr-provider-reason {
    display: block;
    margin-top: 2px;
    font-size: 0.875rem;
    line-height: 1.45;
    color: var(--color-muted);
  }
  .cr-trip {
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
  }
  .cr-trip li {
    display: grid;
    grid-template-columns: 24px minmax(0, 1fr);
    gap: 12px;
    padding: 8px 0;
    border-bottom: var(--border-hairline) solid var(--color-line);
    line-height: 1.5;
  }
  .cr-trip-n {
    font-family: var(--font-family-mono);
    font-size: 0.82rem;
    color: var(--color-muted);
    padding-top: 3px;
  }
  .cr-intro-gap {
    margin-top: 12px;
  }
  .cr-actions-gap {
    margin-top: 16px;
  }
  .cr-note-gap {
    margin-top: 10px;
  }
  .cr-paste-label {
    display: block;
    font-weight: 500;
    margin-bottom: 8px;
  }
  .cr-paste .cr-input {
    font-size: 0.95rem;
  }
  .cr-connected {
    margin-top: 18px;
  }
  .cr-connected .cr-box {
    margin-top: 0;
  }
  .cr-connected .cr-note-gap {
    margin-top: 12px;
  }
  .cr-undo {
    margin-top: 14px;
    gap: 12px 20px;
  }
  .cr-next {
    margin-top: 18px;
  }
</style>
