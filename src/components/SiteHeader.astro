---
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import SignOut from './SignOut.astro';
import { routeFor } from '../data/nav';
import { SITE } from '../data/site';
import { isOn } from '../lib/flags';

// The Sign in button is hidden while the `signin` flag is off (the pre-launch
// waitlist phase). It comes back when sign-in reopens with the first admissions.
const signinOpen = isOn('signin');

/**
 * The header has two states. SIGNED OUT: the marketing nav (Home, The board,
 * How it works, Evidence, Your key), the theme toggle, and Save my spot. SIGNED
 * IN: the member surfaces (The board, The Desk, Pre-List, The Drop), the theme
 * toggle, and an account menu (Profile, Settings, Sign out) labelled with the
 * reader's first name — no Save my spot, no Sign in. The viewer is resolved by
 * middleware on every route when a session cookie is present (src/middleware.ts).
 */
const viewer = Astro.locals.viewer;
const signedIn = Boolean(viewer);
const accountLabel = (viewer?.firstName ?? '').trim() || 'Account';

const here = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
const isHere = (p: string) => here === p;

const MARKETING = [
  { label: 'Home', href: routeFor('start') },
  { label: 'The board', href: routeFor('board') },
  { label: 'How it works', href: routeFor('how-it-works') },
  { label: 'Evidence', href: routeFor('evidence') },
  { label: 'Your key', href: routeFor('your-key') }
];

// The signed-in surfaces. "The board" points at /board (the full board), not the
// marketing home; the rest mirror src/data/member-nav.ts's MEMBER_NAV routes.
const MEMBER = [
  { label: 'The board', href: routeFor('board') },
  { label: 'The Desk', href: routeFor('desk') },
  { label: 'Pre-List', href: routeFor('prelist') },
  { label: 'The Drop', href: routeFor('drop') }
];
---

<header class="hdr">
  <div class="shell hdr-main">
    <a class="brand" href={routeFor('start')} aria-label={`${SITE.name}, home`}>
      <BrandMark />
      <span class="wordmark">anti algo</span>
    </a>
    <nav class="nav kicker" aria-label="Site">
      {signedIn ? (
        <Fragment>
          {MEMBER.map((item) => (
            <a class="nav-link" href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <ThemeToggle />
          <details class="account">
            <summary class="account-trigger">{accountLabel} <span class="account-caret" aria-hidden="true">▾</span></summary>
            <div class="account-panel">
              <a class="nav-link account-item" href={routeFor('profile')} aria-current={isHere(routeFor('profile')) ? 'page' : undefined}>Profile</a>
              <a class="nav-link account-item" href={routeFor('settings')} aria-current={isHere(routeFor('settings')) ? 'page' : undefined}>Settings</a>
              <SignOut />
            </div>
          </details>
        </Fragment>
      ) : (
        <Fragment>
          {MARKETING.map((item) => (
            <a class="nav-link" href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <ThemeToggle />
          {signinOpen && <a class="signin" href={routeFor('sign-in')}>Sign in</a>}
          <a class="cta cta-header" href={`${routeFor('sign-up')}?from=header`}>Save my spot</a>
        </Fragment>
      )}
    </nav>
  </div>
</header>

<style>
  /* Locked to the top: the header stays put and every page scrolls under it.
     An opaque page-surface background is required so content passing beneath is
     hidden, and it must be a theme token so it tracks light and dark. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: var(--border-heavy) solid var(--color-foreground);
  }
  .hdr-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-500);
    padding-block: var(--space-400);
    flex-wrap: wrap;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-300);
  }
  .wordmark {
    font-weight: var(--weight-bold);
    font-size: var(--size-300);
    letter-spacing: var(--tracking-tight);
  }
  .nav {
    display: flex;
    align-items: center;
    gap: var(--space-500);
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid transparent;
    padding-bottom: 2px;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-foreground);
    border-bottom-color: var(--color-foreground);
  }
  .cta-header {
    padding: var(--space-300) var(--space-500);
  }
  /* The secondary action: the signal-orange outline with no fill, sized to sit
     beside the primary button. Its label is the theme foreground (dark ink on
     paper, warm paper on ink) rather than the fixed dark ink the filled button
     carries, so a no-fill button stays legible in both themes. */
  .signin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-foreground);
    border: var(--border-hairline) solid var(--color-signal);
    border-radius: var(--radius);
    padding: var(--space-300) var(--space-500);
    font-family: var(--font-family-sans);
    font-weight: var(--weight-bold);
    font-size: var(--size-100);
    letter-spacing: var(--tracking-snug);
    white-space: nowrap;
    text-decoration: none;
  }
  .signin:hover,
  .signin:focus-visible {
    background: var(--color-signal);
    color: var(--gray-950);
  }
  @media (prefers-reduced-motion: no-preference) {
    .signin {
      transition:
        background-color var(--motion-duration-instant) var(--motion-easing-standard),
        color var(--motion-duration-instant) var(--motion-easing-standard);
    }
  }

  /* The account menu: a native <details> disclosure, styled sharp to match the
     header. The panel is absolutely positioned so opening it never reflows the
     nav. */
  .account {
    position: relative;
  }
  .account-trigger {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-200);
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid transparent;
    padding-bottom: 2px;
  }
  .account-trigger::-webkit-details-marker { display: none; }
  .account[open] .account-trigger,
  .account-trigger:hover {
    color: var(--color-foreground);
  }
  .account-caret { font-size: 0.7em; }
  .account-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-300));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-300);
    min-width: 14ch;
    padding: var(--space-400);
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-foreground);
    border-radius: var(--radius);
    z-index: 200;
  }
  .account-item { white-space: nowrap; }
  /* SignOut.astro is a child component (its own style scope), so :global reaches
     its form to trim the standalone-page margin inside this compact menu. */
  .account-panel :global(.signout) { margin-top: var(--space-200); }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    .nav {
      gap: var(--space-400);
    }
  }
</style>

<script>
  // Close the account menu on Escape or an outside click. The native <details>
  // already toggles on its summary and is keyboard-focusable; this only adds the
  // dismiss behaviours a menu is expected to have.
  const menu = document.querySelector<HTMLDetailsElement>('details.account');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>
