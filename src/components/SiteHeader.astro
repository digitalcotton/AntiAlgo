---
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import SignOut from './SignOut.astro';
import { routeFor } from '../data/nav';
import { SITE } from '../data/site';
import { isOn } from '../lib/flags';
import { isConfigured } from '../lib/db';
import { comeReadyPending } from '../lib/come-ready-store';

// The Sign in button is hidden while the `signin` flag is off (the pre-launch
// waitlist phase). It comes back when sign-in reopens with the first admissions.
const signinOpen = isOn('signin');

/**
 * The header has two states. SIGNED OUT: the marketing nav (Home, The board,
 * How it works, Evidence, Your key), the theme toggle, and Save my spot. SIGNED
 * IN: the member surfaces (The board, The Desk, Pre-List, The Drop), the theme
 * toggle, and an account menu (Profile, Settings, Sign out) labelled with the
 * reader's first name — no Save my spot, no Sign in. The viewer is resolved by
 * middleware on every route when a session cookie is present (src/middleware.ts).
 */
const viewer = Astro.locals.viewer;
const signedIn = Boolean(viewer);
const accountLabel = (viewer?.firstName ?? '').trim() || 'Account';

const here = new URL(Astro.request.url).pathname.replace(/\/$/, '') || '/';
const isHere = (p: string) => here === p;

const MARKETING = [
  { label: 'Home', href: routeFor('start') },
  { label: 'The board', href: routeFor('board') },
  { label: 'How it works', href: routeFor('how-it-works') },
  { label: 'Evidence', href: routeFor('evidence') },
  { label: 'Methodology', href: routeFor('methodology') },
  { label: 'Not here!', href: routeFor('not-here') },
  { label: 'The account', href: routeFor('the-account') },
  { label: 'Your key', href: routeFor('your-key') }
];

// The signed-in surfaces. "The Board" points at /board (the full board), not the
// marketing home; the Pre-List is reached from the board's own view switch, not
// from here. Since 2026-09-19 this one row is the whole member nav: the second
// row (MemberSubnav) is gone.
const MEMBER = [
  { label: 'The Board', href: routeFor('board') },
  { label: 'The Desk', href: routeFor('desk') },
  { label: 'Opportunities', href: routeFor('opportunities') },
  { label: 'Jobs Data', href: routeFor('jobs-data') }
];

// Come ready (owner's designs, 2026-09-20): the first run's link, last in the
// member nav until the run is complete, then gone. One query per signed-in
// render; a failure hides the link and never takes the header with it.
let comeReadyShown = false;
if (viewer && isOn('onboarding') && isConfigured()) {
  try {
    comeReadyShown = await comeReadyPending(viewer);
  } catch (error) {
    console.error('header: come-ready check failed (link hidden).', error);
  }
}
const comeReadyHref = routeFor('come-ready');
---

<header class="hdr">
  <div class="shell hdr-main">
    <a class="brand" href={routeFor('start')} aria-label={`${SITE.name}, home`}>
      <BrandMark />
      <span class="wordmark">anti algo</span>
    </a>
    {/* The mobile menu is a checkbox and its label, no script: on a phone the
        label is the hamburger and its checked state (a pure CSS ~ selector,
        below) drops the same nav as a panel. The nav stays a plain flex child,
        so the desktop row is unchanged. The checkbox is the control (named
        Menu, kept focusable and off screen on phones, display:none on desktop);
        the label is its decorative icon. The script only adds dismissal. */}
    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Menu" />
    <label for="nav-toggle" class="nav-burger" aria-hidden="true">
      <svg class="nav-burger-icon" width="24" height="24" viewBox="0 0 24 24">
        <path class="nav-burger-bars" d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        <path class="nav-burger-x" d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>
    </label>
    <nav class="nav kicker" aria-label="Site">
      {signedIn ? (
        <Fragment>
          {MEMBER.map((item) => (
            <a class="nav-link" href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          {comeReadyShown && (
            <a class="nav-link" href={comeReadyHref} aria-current={isHere(comeReadyHref) ? 'page' : undefined}>Come ready</a>
          )}
          <ThemeToggle />
          <details class="account">
            <summary class="account-trigger">{accountLabel} <span class="account-caret" aria-hidden="true">▾</span></summary>
            <div class="account-panel">
              <a class="nav-link account-item" href={routeFor('profile')} aria-current={isHere(routeFor('profile')) ? 'page' : undefined}>Profile</a>
              <a class="nav-link account-item" href={routeFor('settings')} aria-current={isHere(routeFor('settings')) ? 'page' : undefined}>Settings</a>
              <SignOut />
            </div>
          </details>
        </Fragment>
      ) : (
        <Fragment>
          {MARKETING.map((item) => (
            <a class="nav-link" href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
          <ThemeToggle />
          {signinOpen && <a class="signin" href={routeFor('sign-in')}>Sign in</a>}
          <a class="cta cta-header" href={`${routeFor('sign-up')}?from=header`}>Save my spot</a>
        </Fragment>
      )}
    </nav>
  </div>
</header>

<style>
  /* Locked to the top: the header stays put and every page scrolls under it.
     An opaque page-surface background is required so content passing beneath is
     hidden, and it must be a theme token so it tracks light and dark. */
  .hdr {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--color-surface);
    border-bottom: var(--border-heavy) solid var(--color-foreground);
  }
  .hdr-main {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-500);
    padding-block: var(--space-400);
    flex-wrap: wrap;
    /* The anchor the phone menu drops from; inert on desktop where nothing is
       absolutely positioned. */
    position: relative;
  }
  /* The mobile-menu control is invisible until the phone breakpoint. */
  .nav-toggle,
  .nav-burger {
    display: none;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-300);
  }
  .wordmark {
    font-weight: var(--weight-bold);
    font-size: var(--size-300);
    letter-spacing: var(--tracking-tight);
  }
  .nav {
    display: flex;
    /* Baseline, not centre: the sans links, the mono theme toggle and the
       padded Save my spot button have different box heights, and centring
       their boxes put their text on three different baselines. */
    align-items: baseline;
    gap: var(--space-500);
    flex-wrap: wrap;
  }
  .nav-link {
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid transparent;
    padding-bottom: 2px;
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-foreground);
    border-bottom-color: var(--color-foreground);
  }
  .cta-header {
    padding: var(--space-300) var(--space-500);
  }
  /* The secondary action: the signal-orange outline with no fill, sized to sit
     beside the primary button. Its label is the theme foreground (dark ink on
     paper, warm paper on ink) rather than the fixed dark ink the filled button
     carries, so a no-fill button stays legible in both themes. */
  .signin {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-foreground);
    border: var(--border-hairline) solid var(--color-signal);
    border-radius: var(--radius);
    padding: var(--space-300) var(--space-500);
    font-family: var(--font-family-sans);
    font-weight: var(--weight-bold);
    font-size: var(--size-100);
    letter-spacing: var(--tracking-snug);
    white-space: nowrap;
    text-decoration: none;
  }
  .signin:hover,
  .signin:focus-visible {
    background: var(--color-signal);
    color: var(--gray-950);
  }
  @media (prefers-reduced-motion: no-preference) {
    .signin {
      transition:
        background-color var(--motion-duration-instant) var(--motion-easing-standard),
        color var(--motion-duration-instant) var(--motion-easing-standard);
    }
  }

  /* The account menu: a native <details> disclosure, styled sharp to match the
     header. The panel is absolutely positioned so opening it never reflows the
     nav. */
  .account {
    position: relative;
  }
  .account-trigger {
    cursor: pointer;
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: var(--space-200);
    color: var(--color-muted);
    border-bottom: var(--border-hairline) solid transparent;
    padding-bottom: 2px;
  }
  .account-trigger::-webkit-details-marker { display: none; }
  .account[open] .account-trigger,
  .account-trigger:hover {
    color: var(--color-foreground);
  }
  .account-caret { font-size: 0.7em; }
  .account-panel {
    position: absolute;
    right: 0;
    top: calc(100% + var(--space-300));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-300);
    min-width: 14ch;
    padding: var(--space-400);
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-foreground);
    border-radius: var(--radius);
    z-index: 200;
  }
  .account-item { white-space: nowrap; }
  /* The account menu is a dropdown, not the main nav, so its current page is not
     marked with the underline the top-level links carry. */
  .account-item[aria-current='page'] {
    border-bottom-color: transparent;
  }
  /* SignOut.astro is a child component (its own style scope), so :global reaches
     its form to trim the standalone-page margin inside this compact menu. */
  .account-panel :global(.signout) { margin-top: var(--space-200); }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    /* The checkbox stays in the page, off screen, so it is still focusable and
       named for a screen reader; the label is the hamburger. */
    .nav-toggle {
      display: block;
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
      border: 0;
    }
    .nav-burger {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--color-foreground);
      /* Apple HIG: a control is at least 44x44pt. The icon is 32px and the pad
         carries the box past 44; the negative margin cancels the pad so the
         icon still sits flush with the shell edge. */
      min-width: 44px;
      min-height: 44px;
      padding: var(--space-200);
      margin: calc(var(--space-200) * -1);
      /* Above the open overlay (z 1, below) so the close X keeps its place in
         the header row and stays tappable while the menu covers the page. */
      position: relative;
      z-index: 2;
    }
    /* The bars/X icon, larger than its 24px markup default so the control reads
       at a glance. */
    .nav-burger-icon {
      width: 2rem;
      height: 2rem;
    }
    /* The wordmark rides above the overlay for the same reason: the logo does
       not move or vanish when the menu opens, it shows through on top. */
    .brand {
      position: relative;
      z-index: 2;
    }
    .nav-burger-x {
      display: none;
    }
    /* Bars to an X while open. */
    .nav-toggle:checked ~ .nav-burger .nav-burger-bars {
      display: none;
    }
    .nav-toggle:checked ~ .nav-burger .nav-burger-x {
      display: inline;
    }
    /* A focus ring on the icon when the hidden checkbox has focus. */
    .nav-toggle:focus-visible ~ .nav-burger {
      outline: var(--border-heavy) solid var(--color-signal);
      outline-offset: var(--space-100);
      border-radius: var(--radius);
    }

    /* Collapsed: the nav is hidden until the checkbox is checked, then it takes
       the whole screen. It is fixed to the viewport and painted UNDER the header
       (z 1, and the header is z 100), so the same surface colour runs seamlessly
       from behind the logo down over the page, with no divider: the logo and the
       close X (both z 2) show through on top and stay put. The page beneath is
       fully covered, so there is nothing to scroll to. Selecting a link is a real
       navigation, which lands on a fresh page with the menu closed. The top pad
       clears the ~68px sticky header (space-400 block padding x2 + brand + rule)
       with room to spare; the side pad matches the shell so items line up under
       the logo. */
    .nav {
      display: none;
    }
    .nav-toggle:checked ~ .nav {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-300);
      position: fixed;
      inset: 0;
      z-index: 1;
      padding: calc(var(--space-700) * 2) var(--space-400) var(--space-700);
      background: var(--color-surface);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    /* In the takeover the items ARE the page, so they read large. Every row is
       a full-width, 44pt-tall hit target (Apple HIG); the top-level items and
       the account name grow the most, the nested account links a step down for
       hierarchy. The closed nav and every desktop size are untouched. */
    .nav-toggle:checked ~ .nav > .nav-link,
    .nav-toggle:checked ~ .nav .account-trigger,
    .nav-toggle:checked ~ .nav .account-item {
      display: flex;
      align-items: center;
      min-height: 44px;
      width: 100%;
    }
    .nav-toggle:checked ~ .nav > .nav-link,
    .nav-toggle:checked ~ .nav .account-trigger {
      font-size: var(--size-400);
    }
    .nav-toggle:checked ~ .nav .account-item {
      font-size: var(--size-300);
    }
    /* The current page reads by colour here (the foreground weight the link
       already switches to), not the hairline underline, which would run the
       full row width now that the rows are full-width. */
    .nav-toggle:checked ~ .nav > .nav-link {
      border-bottom: 0;
      padding-bottom: 0;
    }

    /* Signed in, the account is not a dropdown on a phone: it sits open inside
       the full-screen menu so Profile, Settings and Sign out are on the screen
       with no second tap. The script forces the disclosure open at this width
       and keeps a tap on the name from collapsing it; the caret would imply a
       toggle that is not there, so it goes. (With no JS the native <details>
       still opens on a tap of the name, so the items are never unreachable.) */
    .account {
      width: 100%;
    }
    .account-caret {
      display: none;
    }
    .account-panel {
      position: static;
      border: 0;
      border-radius: 0;
      padding: var(--space-200) 0 0 var(--space-300);
      min-width: 0;
    }
  }
</style>

<script>
  // Dismissal, plus the phone account behaviour. The account menu is a native
  // <details>; the mobile nav is a checkbox (#nav-toggle) toggled by its label,
  // so "close" is unchecking it. Each closes on Escape or a click outside it.
  const menu = document.querySelector<HTMLDetailsElement>('details.account');
  const navToggle = document.querySelector<HTMLInputElement>('#nav-toggle');
  const nav = document.querySelector<HTMLElement>('header.hdr .nav');
  const burger = document.querySelector<HTMLElement>('.nav-burger');

  // On a phone the account is not a dropdown: it sits open in the full-screen
  // menu so Profile, Settings and Sign out are on the screen with no extra tap.
  // Force it open at that width and keep a tap on the name from collapsing it.
  // (With no JS the native <details> still opens on a tap, so nothing is lost.)
  const phone = window.matchMedia('(max-width: 48rem)');
  const openAccountOnPhone = () => {
    if (menu && phone.matches) menu.open = true;
  };
  openAccountOnPhone();
  phone.addEventListener('change', openAccountOnPhone);
  menu?.querySelector('summary')?.addEventListener('click', (event) => {
    if (phone.matches) event.preventDefault();
  });

  document.addEventListener('click', (event) => {
    const target = event.target as Node;
    // The account only collapses on outside-click where it IS a dropdown, i.e.
    // on desktop; on a phone it stays open as part of the flat menu.
    if (!phone.matches && menu?.open && !menu.contains(target)) menu.open = false;
    if (
      navToggle?.checked &&
      target !== navToggle &&
      !burger?.contains(target) &&
      !nav?.contains(target)
    ) {
      navToggle.checked = false;
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    // Desktop: Escape closes the account dropdown. Phone: it closes the whole
    // menu (below) and the account stays open for next time.
    if (!phone.matches && menu?.open) {
      menu.open = false;
      menu.querySelector('summary')?.focus();
    }
    if (navToggle?.checked) {
      navToggle.checked = false;
      navToggle.focus();
    }
  });
</script>
