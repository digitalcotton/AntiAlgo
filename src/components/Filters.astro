  .filter-select:focus-visible {
    outline: none;
  }

  /* THE ELEMENTS THE SCRIPT CREATES (.filter-value, .menu, .menu-option,
     .menu-count) carry no Astro scope attribute, so every rule that reaches
     them below goes through :global under an ancestor this component did
     render. Without that the menu shipped unstyled once. */

  /* Under script the select steps out of sight (it is still the form's
     field and still hears the change event) and the button takes its cell. */
  [data-filters][data-js] .filter-sizer {
    display: none;
  }

  [data-filters][data-js] .filter-select {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    opacity: 0;
    pointer-events: none;
  }

  .filter-field > :global(.filter-value) {
    grid-area: 1 / 1;
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-300);
    font-size: var(--size-100);
    padding: 0;
    border: none;
    background: transparent;
    color: var(--color-foreground);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }

  /* The chevron is its own element so the open state can turn it upward. */
  .filter-field > :global(.filter-value)::after {
    content: '';
    flex: none;
    width: var(--space-300);
    height: var(--space-300);
    background: var(--select-chevron) no-repeat center;
    background-size: contain;
  }

  .filter-field > :global(.filter-value):focus-visible {
    outline: none;
  }

  /* The open cell: a heavy outline drawn inward so the strip does not move,
     and the chevron turned to point up. */
  .filter {
    position: relative;
  }

  .filter[data-open] {
    outline: var(--border-heavy) solid var(--color-foreground);
    outline-offset: calc(-1 * var(--border-heavy));
  }

  .filter[data-open] .filter-field > :global(.filter-value)::after {
    transform: rotate(180deg);
  }

  /* The list: label on the left, the count on the right, the chosen row and
     the hovered row on the hover surface, a dead option in the muted voice. */
  .filters > :global(.menu) {
    position: absolute;
    z-index: 2;
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-line-strong);
  }

  .filters > :global(.menu[hidden]) {
    display: none;
  }

  .filters :global(.menu-option) {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-600);
    align-items: baseline;
    padding: var(--space-300) var(--space-400);
    border: none;
    border-top: var(--border-hairline) solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    font-family: var(--font-family-mono);
    font-size: var(--size-100);
    text-align: left;
    white-space: nowrap;
    cursor: pointer;
  }

  .filters :global(.menu-option:first-child) {
    border-top: none;
  }

  .filters :global(.menu-option:hover),
  .filters :global(.menu-option:focus-visible),
  .filters :global(.menu-option[aria-selected='true']) {
    background: var(--color-hover-surface);
    outline: none;
  }

  .filters :global(.menu-option:disabled) {
    color: var(--color-muted);
    cursor: default;
    background: transparent;
  }

  .filters :global(.menu-count) {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    font-feature-settings: var(--feature-tabular);
  }

  /* Focus and hover are shown on the cell, in the foreground colour, since
     the controls inside carry no box of their own any more. */
  .filter:hover,
  .filter:focus-within {
    color: var(--color-foreground);
  }

  .filter:focus-within .filter-label {
    color: var(--color-foreground);
  }

  /* The no-script Apply. Hidden the moment script marks the root. */
  .filter-apply {
    flex: none;
    padding: var(--space-300) var(--space-500);
    border: none;
    border-left: var(--border-hairline) solid var(--color-line);
    background: transparent;
    color: var(--color-foreground);
    cursor: pointer;
  }

  .filter-apply:hover {
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
