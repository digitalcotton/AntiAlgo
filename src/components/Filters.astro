  @media (min-width: 60rem) { /* --breakpoint-lap */
    .filters-row:has(.filter-titles[open]) {
      overflow-x: visible;
    }
  }

  /* The sizer and the select share one grid cell, so the cell takes the width
     of the widest option and the control never shifts as the choice changes. */
  .filter-field {
    display: inline-grid;
  }

  .filter-sizer,
  .filter-select {
    grid-area: 1 / 1;
    font-size: var(--size-100);
    padding: 0 var(--space-500) 0 0;
    white-space: nowrap;
