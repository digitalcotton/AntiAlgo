---
import SearchBox from './SearchBox.astro';
import type { FilterGroup, FilterOption } from '../lib/data';
import { chipsToParams, type Chip } from '../lib/search-parse';
import { PLACE_UNSTATED } from '../lib/place-key';
import { withBase } from '../../site.config.mjs';

/**
 * The filter row: one control per group, each a native select, plus the seen
 * dimmer (MASTER-SPEC F10) beside it. Applied rows are tagged, never hidden
 * (owner decision, 2026-09-19; see the script's applied-tag section).
 *
 * THE CANVAS'S FOURTH GROUP SHIPS NOW, AS "FIELD". This said the data carried
 * no role family, and that deriving one by reading job titles would mean this
 * repository inventing a classification and presenting it as the machine's
 * finding. That objection held the filter back until the answer was built
 * rather than asserted: src/lib/job-family.mjs is an ordered table of word
 * tests a reader can read, reproduce and argue with — no model, nothing in the
 * nightly ingest path — and db/212 stores the verdict in derived_fam next to
 * the department word it was read from. A posting it cannot place is null and
 * shows as "Not placed", never as an invented bucket.
 *
 * Freshness went the other way and no longer ships (2026-09-28): the board
 * already said a posting's age three other ways. So the strip was Field,
 * Location and Comp. See DECISIONS.md.
 *
 * THE STRIP IS LOCATION, REMOTE AND COMP NOW (2026-10-02,
 * docs/search-engine-design.md §2). Field left it: 44% of rows are ambiguous
 * between two families, so it was the only control filtering on an inference,
 * and it returns as navigation under the results (Board.astro). The control
 * that was called Location filtered how the work is done, so it is Remote, and
 * Location is geography for the first time: a single choice among the countries
 * the board holds, whose value is the same `place=` key the search box's chip
 * writes, so the dropdown and the chip are one state. Remote is a checkbox list
 * (several arrangements at once). Comp is a floor ($150k+), not a band. Which
 * groups there are, and every count on them, come from facetGroupsFromCounts
 * (src/lib/data.ts); this component draws whatever groups it is handed.
 *
 * WHY NATIVE SELECTS RATHER THAN THE CANVAS'S DROPDOWN BUTTONS. A custom
 * dropdown is a listbox, a focus trap, a set of arrow key handlers and a
 * typeahead, all of which the platform already ships and none of which this
 * product is in the business of rewriting. The control keeps the canvas's shape
 * (a bordered chip reading "Location: Remote"), and on a phone it opens the
 * operating system's own picker, which is better than anything drawn here.
 *
 * NO LAYOUT SHIFT ON CHANGE. A native select is as wide as whatever option is
 * showing, so switching from "On-site or hybrid" to "All" would shrink the
 * control and slide every control after it along the row. Each field is
 * therefore sized by a hidden sizer holding its widest option, and the select
 * is stacked in the same grid cell at full width. The row is then a fixed
 * shape: choosing an option changes the table and moves nothing.
 *
 * The group counts come from filterGroups() and are recomputed from the rows,
 * so an option that would return nothing says so before it is chosen rather
 * than after.
 *
 * MASTER-SPEC F10, BOTH BULLETS, LIVE HERE. This component is the one place
 * on the index a signed-in visitor is ever asked "who are you" (a fetch to
 * /settings/filters; see the script below), so both of F10's bullets are
 * built from it rather than from src/pages/index.astro, src/components/
 * JobRow.astro or src/components/JobTable.astro, none of which this task can
 * write. See this task's own report for the precise, small edits those three
 * files would need to remove the one limitation that split creates: without
 * them, suppression and the restored filter selection apply a beat after
 * first paint (a fetch, not a flash of the wrong content) rather than being
 * baked into the server-rendered HTML, and a page suppressing rows can show
 * fewer than a full page of them if the suppressed rows and the page break
 * land together, disclosed honestly in the banner's own count rather than
 * hidden.
 *
 * DETERMINISTIC, NEVER A GUESS. Every value a saved selection holds that the
 * address's own parsers will not vouch for falls back to 'all'
 * (src/lib/filters-store.ts's normalizeSavedSelection()), and
 * suppressApplied() suppresses by id membership alone. Nothing here ranks,
 * scores or reorders a row; MASTER-SPEC F10's own ban on that is the same
 * ban whether the row is being filtered, suppressed or dimmed.
 */

interface Props {
  groups: FilterGroup[];
  /** Which value each group starts on, keyed by group key. */
  selected?: Record<string, string>;
  /**
   * client (default): the selects announce index:filter events and a table
   * controller in the page filters rows it already holds (/prelist).
   * server (the board since 2026-09-11): the row is a GET form that submits
   * to `action`; the address is the state and the server sends one page.
   */
  mode?: 'client' | 'server';
  action?: string;
  /** Server mode: the other settings the form carries so it keeps them. */
  hidden?: readonly [string, string][];
  /** Server mode: the values each checkbox group has ticked, by group key. A
      group without an entry has none ticked, which reads "All". */
  checked?: Record<string, readonly string[]>;
  /** Server mode: the search box's current text. */
  query?: string;
  /** Server mode, signed in: the member's Desk titles by shelf. When either
      shelf has one, the search cell grows a chevron that opens a checkbox
      list of them (`title=` fields, several allowed). Undefined or both
      empty: no chevron, no list. */
  titleChoices?: { core: readonly string[]; stretch: readonly string[] };
  /** Server mode: the titles the address already has checked. */
  selectedTitles?: readonly string[];
  /** Server mode: the facts the search box has already turned into chips, with
      the address that removes each one (parallel arrays). Absent: no chips. */
  chips?: Chip[];
  chipRemoveHrefs?: string[];
  /** Server mode: the suggestion endpoint, the sweep instant its counts are for,
      and the board's current parameters, sent with every request. */
  suggestPath?: string;
  sweepV?: string;
  baseParams?: Record<string, string>;
  class?: string;
}

const {
  groups,
  selected = {},
  mode = 'client',
  action = '',
  hidden = [],
  checked = {},
  query = '',
  titleChoices,
  selectedTitles = [],
  chips = [],
  chipRemoveHrefs = [],
  suggestPath = withBase('/board/suggest'),
  sweepV = '',
  baseParams = {},
  class: className
} = Astro.props;
const titleShelves: { key: 'core' | 'stretch'; label: string; titles: readonly string[] }[] = titleChoices
  ? [
      { key: 'core' as const, label: 'Core', titles: titleChoices.core },
      { key: 'stretch' as const, label: 'Stretch', titles: titleChoices.stretch }
    ].filter((shelf) => shelf.titles.length > 0)
  : [];
const hasTitleMenu = serverModeOf(mode) && titleShelves.length > 0;
const selectedTitleSet = new Set(selectedTitles);
function serverModeOf(m: 'client' | 'server'): boolean {
  return m === 'server';
}
const accountFiltersUrl = withBase('/settings/filters');
const serverMode = mode === 'server';
// In server mode the control row IS the form: one element, so a select's
// change submits it and a no-script reader's Apply button does the same.
const Row = serverMode ? 'form' : 'div';
// The search box writes a hidden field for every chip it draws (SearchBox.astro),
// so a hidden field of the same name handed in by the page is dropped here: a
// parameter is submitted once, and by the thing the reader can see.
const chipNames = new Set(Object.keys(chipsToParams(chips)));
const carried = hidden.filter(([name]) => !chipNames.has(name));

// THE CELLS THE STRIP DRAWS. A group placed under the results (the Field) rides
// in the same list because that list is what a page hands the board, and is
// Board.astro's to draw, not this row's.
const stripGroups = groups.filter((group) => group.placement !== 'results');
// A strip control OWNS the parameter its group is keyed by (`place`, `remote`,
// `pay_min`): its own fields submit it. A search-box chip that writes the same
// parameter into a hidden field would be a second, stale answer to one question
// (unticking Remote in the strip while a Remote chip's hidden field re-sent it),
// so the box is told which names are not its to carry.
const ownedNames = stripGroups.map((group) => group.key);

// THE PLACE THE ADDRESS CHOSE, BY THE CHIP'S OWN NAME. facetGroupsFromCounts holds
// a city or region the address names as an option and labels it from its key
// (place-key.ts); the chip beside it carries the lexicon's label, and the two
// must read alike. A bare country keeps the country list's own name, and so does
// Not stated: its chip says "Location not stated" because the box has no cell
// label beside it, and the cell already has one.
const placeChip = chips.find((chip): chip is Extract<Chip, { kind: 'place' }> => chip.kind === 'place');
const cells: FilterGroup[] = stripGroups.map((group) =>
  group.key === 'place' && placeChip !== undefined && placeChip.key.length > 2 && placeChip.key !== PLACE_UNSTATED
    ? { ...group, options: group.options.map((option) => (option.value === placeChip.key ? { ...option, label: placeChip.label } : option)) }
    : group
);

/**
 * What one option reads as: its label alone (2026-09-11). The count used to
 * ride in the text ("Remote (412)"), which made the closed control read
 * "LOCATION All (1,913)" where the strip wants "LOCATION All". The rule the
 * count served, that an option which would empty the table looks dead before
 * it is chosen, is kept by disabling that option instead: the platform greys
 * it out in the open list and refuses the choice.
 */
const optionText = (label: string): string => label;
/** A zero is dead unless the address already names it (the select must be able to
    say what it holds); an option flagged `disabled` is dead whatever it holds. */
const dead = (option: FilterOption, current: string | undefined): boolean =>
  option.disabled === true || (option.count === 0 && option.value !== 'all' && option.value !== current);
/** The same rule for a checkbox: a zero that is ticked stays live, so it can be unticked. */
const deadBox = (option: FilterOption, on: boolean): boolean => option.disabled === true || (option.count === 0 && !on);
/** A count the way the menu prints it, fixed to one locale so the server's markup
    and the script's rows never differ by where the server runs. */
const countText = (n: number): string => n.toLocaleString('en-US');

/** The widest option text in a group, which is what sizes the control. A checkbox
    group's value can also read as two names ("Remote + Hybrid"), so its widest
    is at least that. */
const widest = (group: FilterGroup): string => {
  const longest = group.options.reduce((found, option) => {
    const text = optionText(option.label);
    return text.length > found.length ? text : found;
  }, '');
  if (!group.multi) return longest;
  const pair = group.options
    .filter((option) => option.value !== 'all')
    .slice(0, 2)
    .map((option) => option.label)
    .join(' + ');
  return pair.length > longest.length ? pair : longest;
};
// The two controls whose values are names a reader needs whole (a country, two
// arrangements) get a wider ceiling than the 14ch the rest cap at.
const wide = (group: FilterGroup): boolean => group.key === 'place' || group.multi === true;
// A select whose list is only what the board holds right now, while the address
// accepts more: any place key (a city, a region, a country with nothing under the
// other filters) and any pay floor in the search box's bounds. A saved value of
// one of these may name an option the bare board does not draw, and the restore
// must carry it to the address all the same (see applySelection).
const openValues = (group: FilterGroup): boolean => group.key === 'place' || group.key === 'pay_min';
---

<div
  class:list={['filters', className]}
  data-filters
  data-filters-mode={mode}
  data-board-path={serverMode ? action : undefined}
  data-account-filters-url={accountFiltersUrl}
>
  {/*
    THE CONTROL STRIP. One row of cells divided by hairlines, edge to edge:
    search, the group selects, the sort (passed in through the `sort` slot so
    it sits inside the same strip), and the seen dimmer as the inverted cell
    at the end. Each label is the machine's uppercase mono voice and its
    value sits beside it, so the row reads "LOCATION All", "SORT Fit Comp
    Age", "DIM SEEN on".
  */}
  <Row class="filters-row" method={serverMode ? 'get' : undefined} action={serverMode ? action : undefined}>
    {serverMode && carried.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    {/*
      SEARCH. In server mode it is the search box (SearchBox.astro): the form's
      q field, the facts already stated drawn as chips inside it, and a grouped,
      counted suggestion panel under it. Enter submits the words; nothing is
      converted silently. In client mode (/prelist) it stays the plain box that
      announces as you type, because the table controller there filters rows it
      already holds and listens for exactly that event. The glyph is decoration;
      the label is the visible placeholder, which type=search keeps until text
      lands.

      THE NATIVE DATALIST THIS REPLACED IS GONE (2026-10-02). It listed field
      names beside titles, so a field name typed into the box was converted to a
      Field filter by a silent 302; it could not group, count or be ordered
      across groups either. scripts/build-search-suggestions.mjs, which wrote its
      list, is left in place; only src/lib/job-family.test.ts still reads its
      output (src/data/search-suggestions.json).
    */}
    {
      serverMode ? (
        <SearchBox
          q={query}
          chips={chips}
          chipRemoveHrefs={chipRemoveHrefs}
          ownedFields={ownedNames}
          suggestPath={suggestPath}
          sweepV={sweepV}
          baseParams={baseParams}
        />
      ) : (
        <label class="filter filter-search">
          <span class="search-glyph mono" aria-hidden="true">&#9906;</span>
          <span class="visually-hidden">Search</span>
          <input
            type="search"
            class="search-input mono"
            data-job-search
            placeholder="Title, company or field"
            autocomplete="off"
            spellcheck="false"
            enterkeyhint="search"
          />
        </label>
      )
    }
    {/*
      THE TITLE MENU (owner decision, 2026-09-19). The board is never
      pre-filtered; instead a member who named titles on The Desk gets a
      chevron at the end of the search cell that opens their own list, core
      then stretch, as checkboxes. Each checked box is a `title=` field of the
      same form, so with script a tick submits at once and without it the
      Apply button does. Rendered only when there is at least one title.
    */}
    {hasTitleMenu && (
      <details class="filter-titles" data-title-menu>
        <summary class="filter filter-titles-summary">
          <span class="filter-label mono-label">Titles</span>
          {selectedTitles.length > 0 && <span class="filter-titles-count mono">{selectedTitles.length}</span>}
          <span class="filter-titles-chevron" aria-hidden="true">&#9662;</span>
          <span class="visually-hidden">Choose which of your titles to show</span>
        </summary>
        <div class="title-menu">
          {titleShelves.map((shelf) => (
            <div class="title-menu-group">
              <span class="title-menu-shelf mono-label">{shelf.label}</span>
              {shelf.titles.map((title) => (
                <label class="title-option">
                  <input type="checkbox" name="title" value={title} data-title-option checked={selectedTitleSet.has(title)} />
                  <span>{title}</span>
                </label>
              ))}
            </div>
          ))}
        </div>
      </details>
    )}
    {
      cells.map((group) => {
        const ticked = new Set(checked[group.key] ?? []);
        const everything = group.options.find((option) => option.value === 'all');
        return group.multi && serverMode ? (
          <div class="filter filter-multi" role="group" aria-label={group.label} data-filter-multi={group.key} data-all-label={everything?.label} data-all-count={everything?.count}>
            <span class="filter-label mono-label">{group.label}</span>
            <span class="filter-field filter-field-wide">
              {/* The sizer is what the script's trigger will say at its widest, laid
                  out and invisible, as it is for a select. */}
              <span class="filter-sizer mono" aria-hidden="true">{widest(group)}</span>
              {/* REAL CHECKBOXES, NAMED FOR THE PARAMETER. Each ticked box submits one
                  `remote=<kind>` field, which parseBoardQuery reads the same as the
                  comma list a link writes. Without script they are the control and the
                  Apply button submits them; with script they stand aside (they stay
                  in the form and still hear the change) and the trigger and menu the
                  script builds take their cell. None ticked is "All". */}
              <span class="multi-options">
                {group.options
                  .filter((option) => option.value !== 'all')
                  .map((option) => (
                    <label class="multi-option mono">
                      <input
                        type="checkbox"
                        class="multi-box"
                        name={group.key}
                        value={option.value}
                        autocomplete="off"
                        checked={ticked.has(option.value)}
                        disabled={deadBox(option, ticked.has(option.value))}
                        data-multi-option
                        data-count={option.count}
                      />
                      <span class="multi-name">{optionText(option.label)}</span>
                      <span class="multi-count">{countText(option.count)}</span>
                    </label>
                  ))}
              </span>
            </span>
          </div>
        ) : (
          <label class="filter">
            <span class="filter-label mono-label">{group.label}</span>
            <span class:list={['filter-field', { 'filter-field-wide': wide(group) }]}>
              {/*
                The sizer is the widest option, laid out and invisible. It gives the
                control a width that does not depend on which option is chosen,
                which is the whole no-layout-shift guarantee in one element.
              */}
              <span class="filter-sizer mono" aria-hidden="true">{widest(group)}</span>
              <select
                class="filter-select mono"
                data-filter-group={group.key}
                data-open-values={openValues(group) ? '' : undefined}
                autocomplete="off"
                name={serverMode ? group.key : undefined}
                data-autosubmit={serverMode ? '' : undefined}
              >
                {group.options.map((option) => (
                  <option
                    value={option.value}
                    selected={selected[group.key] === option.value}
                    disabled={dead(option, selected[group.key])}
                    data-count={option.count}
                  >
                    {optionText(option.label)}
                  </option>
                ))}
              </select>
            </span>
          </label>
        );
      })
    }

    {serverMode && (
      /* The no-script way to apply what was set. With script every select
         submits on change and Enter submits the search, so the script hides
         this the moment it runs; without script it is the only way through. */
      <button class="filter-apply mono-label" type="submit">Apply</button>
    )}

    <slot name="sort" />

    {/*
      THE SEEN DIMMER (MASTER-SPEC F10's first bullet). A real checkbox, not a
      styled button, so it has a working label, a working default state and
      working keyboard behaviour with no script at all; script only ever adds
      the dimming itself. DEFAULT ON, PER THE SPEC'S OWN WORDING: `checked`
      with no client-side branching (DEFAULT_SEEN_DIMMER_ENABLED in
      src/lib/filters.ts is the same `true`). The cell inverts while it is on
      and says so in a word, so the state is read, not inferred from a tick.
    */}
    <label class="filter filter-toggle">
      <input type="checkbox" class="filter-toggle-input" data-seen-dimmer-toggle checked />
      <span class="filter-label mono-label">Dim seen</span>
      <span class="toggle-state mono" data-toggle-on aria-hidden="true">on</span>
      <span class="toggle-state mono" data-toggle-off aria-hidden="true">off</span>
      <span class="visually-hidden">Dim roles I have seen</span>
    </label>
  </Row>

</div>

<script>
  import { claimMenu, onMenuClaimed } from '../lib/menu-claim';

  /**
   * Three things, one script: the existing filter-change announcer, and
   * MASTER-SPEC F10's two bullets layered onto the same event contract
   * JobTable.astro already reads (index:filter) and already sends
   * (index:rows). See this component's own header for why both bullets are
   * built from here rather than from index.astro or JobTable.astro.
   */

  const FILTERS_KEY = 'ti-index-filters:v1';
  const SEEN_KEY = 'ti-index-seen:v1';
  const SEEN_DIMMER_KEY = 'ti-index-seen-dimmer:v1';

  const root = document.querySelector<HTMLElement>('[data-filters]');
  const selects = Array.from(document.querySelectorAll<HTMLSelectElement>('[data-filter-group]'));
  // Server mode: the address is the state. The selects submit their form on
  // change, a saved selection is restored by one navigation (below), and no
  // table controller is listening for events.
  const serverMode = root?.dataset.filtersMode === 'server';
  const boardPath = root?.dataset.boardPath || '';
  // Script is running, so the selects submit themselves and the Apply
  // button is a duplicate; the stylesheet hides it on this attribute.
  if (root) root.dataset.js = '';

  /* -------------------------------------------------------------------------
     THE MENU. A native <select> cannot draw the list the strip wants (label
     on the left, the count on the right, the open cell outlined), so with
     script each select gets a button and a listbox built from its own
     options. The select stays the source of truth and the form's field:
     choosing a row sets its value and fires its change event, so server mode
     submits and client mode announces exactly as a native choice would.
     Without script there is no menu and the select is what you see.

     A CHECKBOX GROUP (Remote) IS BUILT THE SAME WAY over its real checkboxes:
     a row toggles its box and fires the box's change, the "All" row unticks
     them, and without script the boxes are drawn in the cell as they are.
     ------------------------------------------------------------------------- */
  const menus: { cell: HTMLElement; menu: HTMLElement; trigger: HTMLButtonElement }[] = [];
  /** A strip control with several answers at once: its cell, the checkboxes in
      the form that hold the answer, and the group's name. */
  const multis = Array.from(document.querySelectorAll<HTMLElement>('[data-filter-multi]'));
  /** Every control's repaint of its own trigger, so a page restored from memory
      can put them all back (see the pageshow listener below). */
  const repaints: (() => void)[] = [];

  function closeMenus(except?: HTMLElement): void {
    for (const entry of menus) {
      if (entry.cell === except) continue;
      entry.menu.hidden = true;
      entry.cell.removeAttribute('data-open');
      entry.trigger.setAttribute('aria-expanded', 'false');
    }
  }

  /**
   * The trigger and the listbox every strip control shares, whatever it picks:
   * the button in the cell, the list hung off .filters, opening, closing, the
   * one-menu claim and the arrow keys. What a ROW is and what choosing it does is
   * the caller's, since a select's rows set one value and a checkbox group's
   * toggle one box each.
   */
  function mountMenu(cell: HTMLElement, field: HTMLElement, name: string, multiselectable: boolean) {
    const trigger = document.createElement('button');
    trigger.type = 'button';
    trigger.className = 'filter-value mono';
    trigger.setAttribute('aria-haspopup', 'listbox');
    trigger.setAttribute('aria-expanded', 'false');
    trigger.setAttribute('aria-label', `${name}: choose`);

    const menu = document.createElement('div');
    menu.className = 'menu';
    menu.setAttribute('role', 'listbox');
    if (multiselectable) menu.setAttribute('aria-multiselectable', 'true');
    menu.setAttribute('aria-label', name);
    menu.hidden = true;

    // The label goes in its own span so it can be truncated. As a bare text
    // node it was an anonymous flex item, which cannot take text-overflow, so a
    // long option ("Administration & Business Support") painted straight out of
    // the cell and over the control beside it.
    const triggerText = document.createElement('span');
    triggerText.className = 'filter-value-text';
    trigger.append(triggerText);

    trigger.addEventListener('click', () => {
      const open = menu.hidden;
      closeMenus(cell);
      if (open && root) {
        // The menu hangs off .filters (the column wrapper, position: relative)
        // and is placed under its cell each time it opens, in the wrapper's own
        // coordinates: a menu inside the row would be clipped by it.
        const rootBox = root.getBoundingClientRect();
        const cellBox = cell.getBoundingClientRect();
        menu.style.left = `${Math.max(0, cellBox.left - rootBox.left)}px`;
        menu.style.top = `${cellBox.bottom - rootBox.top}px`;
        menu.style.minWidth = `${cellBox.width}px`;
      }
      menu.hidden = !open;
      cell.toggleAttribute('data-open', open);
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
      // One menu open at a time: the search box's suggestions close when a strip
      // menu opens (src/lib/menu-claim.ts).
      if (open) claimMenu('strip');
      if (open) {
        const chosen = menu.querySelector<HTMLElement>('[aria-selected="true"]:not(:disabled)') ?? menu.querySelector<HTMLElement>('[role="option"]:not(:disabled)');
        chosen?.focus({ preventScroll: true });
        // A list longer than its panel scrolls, and focus alone would leave the
        // chosen row below the fold.
        chosen?.scrollIntoView({ block: 'nearest' });
      }
    });

    menu.addEventListener('keydown', (event) => {
      const rows = Array.from(menu.querySelectorAll<HTMLButtonElement>('[role="option"]:not(:disabled)'));
      const at = rows.indexOf(document.activeElement as HTMLButtonElement);
      if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
        event.preventDefault();
        const next = event.key === 'ArrowDown' ? Math.min(rows.length - 1, at + 1) : Math.max(0, at - 1);
        rows[next]?.focus({ preventScroll: true });
        rows[next]?.scrollIntoView({ block: 'nearest' });
      } else if (event.key === 'Escape') {
        closeMenus();
        trigger.focus();
      }
    });

    field.append(trigger);
    (root ?? cell).append(menu);
    menus.push({ cell, menu, trigger });
    return { trigger, menu, triggerText };
  }

  /** A menu row. A press on it must not move focus (.claude/rules/dropdown-focus.md):
      the click that follows is what chooses, and a press that blurred first would
      lose it in Safari and Firefox on macOS. */
  function menuRow(label: string, count: number, disabled: boolean): HTMLButtonElement {
    const row = document.createElement('button');
    row.type = 'button';
    row.className = 'menu-option';
    row.setAttribute('role', 'option');
    if (disabled) {
      row.disabled = true;
      row.setAttribute('aria-disabled', 'true');
    }
    const name = document.createElement('span');
    name.className = 'menu-label';
    name.textContent = label;
    const tally = document.createElement('span');
    tally.className = 'menu-count mono';
    tally.textContent = Number.isFinite(count) ? count.toLocaleString() : '';
    row.append(name, tally);
    row.addEventListener('mousedown', (event) => event.preventDefault());
    return row;
  }

  for (const select of selects) {
    const cell = select.closest<HTMLElement>('.filter');
    const field = select.closest<HTMLElement>('.filter-field');
    if (!cell || !field) continue;
    const group = select.getAttribute('data-filter-group') || 'filter';
    // Named for what the reader reads (Location, Comp), not for the parameter.
    const name = cell.querySelector('.filter-label')?.textContent?.trim() || group;
    const { trigger, menu, triggerText } = mountMenu(cell, field, name, false);

    const paintValue = () => {
      triggerText.textContent = select.options[select.selectedIndex]?.text ?? '';
      for (const row of Array.from(menu.querySelectorAll<HTMLElement>('[role="option"]'))) {
        row.setAttribute('aria-selected', row.dataset.value === select.value ? 'true' : 'false');
      }
    };

    for (const option of Array.from(select.options)) {
      const row = menuRow(option.text, Number(option.dataset.count), option.disabled);
      row.dataset.value = option.value;
      row.addEventListener('click', () => {
        // A refused row is a disabled button and gets no click from the browser;
        // this is for the click something else dispatched at it.
        if (option.disabled) return;
        if (select.value !== option.value) {
          select.value = option.value;
          select.dispatchEvent(new Event('change', { bubbles: true }));
        }
        closeMenus();
        paintValue();
        trigger.focus();
      });
      menu.append(row);
    }

    select.addEventListener('change', paintValue);
    repaints.push(paintValue);
    paintValue();
  }

  /** The words a checkbox group's cell reads, from the boxes ticked: "All", the
      one name, or the names joined ("Remote + Hybrid"). Past two it says how
      many, so the cell stays one short line; CSS truncates anything still long. */
  function multiValue(names: readonly string[], all: string): string {
    if (names.length === 0) return all;
    if (names.length <= 2) return names.join(' + ');
    return `${names.slice(0, 2).join(' + ')} + ${names.length - 2}`;
  }

  for (const cell of multis) {
    const field = cell.querySelector<HTMLElement>('.filter-field');
    const boxes = Array.from(cell.querySelectorAll<HTMLInputElement>('input[data-multi-option]'));
    if (!field || boxes.length === 0) continue;
    const group = cell.getAttribute('data-filter-multi') || 'filter';
    const name = cell.querySelector('.filter-label')?.textContent?.trim() || group;
    const allLabel = cell.getAttribute('data-all-label') || 'All';
    const { trigger, menu, triggerText } = mountMenu(cell, field, name, true);
    const nameOf = (box: HTMLInputElement) => box.closest('label')?.querySelector('.multi-name')?.textContent ?? box.value;

    // A row's mark: a hollow square, filled while its box is ticked.
    const markRow = (row: HTMLButtonElement) => {
      row.classList.add('menu-option-multi');
      const mark = document.createElement('span');
      mark.className = 'menu-mark';
      mark.setAttribute('aria-hidden', 'true');
      row.prepend(mark);
    };
    // The "All" row clears: it is the answer when nothing is ticked, so its mark
    // is filled then, and the names under it line up with it.
    const clearRow = menuRow(allLabel, Number(cell.getAttribute('data-all-count')), false);
    clearRow.dataset.value = 'all';
    markRow(clearRow);
    menu.append(clearRow);
    const rows = new Map<HTMLInputElement, HTMLButtonElement>();
    for (const box of boxes) {
      const row = menuRow(nameOf(box), Number(box.dataset.count), box.disabled);
      row.dataset.value = box.value;
      markRow(row);
      rows.set(box, row);
      menu.append(row);
    }

    const paintValue = () => {
      const on = boxes.filter((box) => box.checked);
      const text = multiValue(on.map(nameOf), allLabel);
      triggerText.textContent = text;
      trigger.title = on.length > 2 ? on.map(nameOf).join(' + ') : '';
      clearRow.setAttribute('aria-selected', on.length === 0 ? 'true' : 'false');
      for (const [box, row] of rows) row.setAttribute('aria-selected', box.checked ? 'true' : 'false');
    };

    for (const [box, row] of rows) {
      // A press toggles the real checkbox and says so the way a click on it
      // would, so the form submits (or, signed in, the choice is saved) through
      // the one path a native tick takes. The menu stays open until the page
      // answers, with the box ticked, rather than flashing shut over a request.
      row.addEventListener('click', () => {
        if (box.disabled) return;
        box.checked = !box.checked;
        box.dispatchEvent(new Event('change', { bubbles: true }));
        paintValue();
      });
    }
    clearRow.addEventListener('click', () => {
      const ticked = boxes.filter((box) => box.checked);
      for (const box of ticked) box.checked = false;
      paintValue();
      if (ticked.length === 0) {
        closeMenus();
        trigger.focus();
        return;
      }
      // One submit for the whole clear, not one per box that was ticked.
      if (serverMode) boxes[0].form?.requestSubmit();
      else boxes[0].dispatchEvent(new Event('change', { bubbles: true }));
    });
    for (const box of boxes) box.addEventListener('change', paintValue);
    repaints.push(paintValue);
    paintValue();
  }

  const titleMenu = document.querySelector<HTMLDetailsElement>('[data-title-menu]');
  // The search box's suggestions opened, or its field took focus: every menu in
  // the strip closes, the Desk titles list included. And the other way round,
  // the titles list opening closes the suggestions.
  onMenuClaimed('strip', () => {
    closeMenus();
    if (titleMenu) titleMenu.open = false;
  });
  titleMenu?.addEventListener('toggle', () => {
    if (titleMenu.open) claimMenu('strip');
  });
  document.addEventListener('click', (event) => {
    const target = event.target;
    // The title list closes on any click outside it, like the facet menus.
    if (titleMenu && titleMenu.open && !(target instanceof Element && target.closest('[data-title-menu]'))) {
      titleMenu.open = false;
    }
    if (target instanceof Element && (target.closest('.filter') || target.closest('.menu'))) return;
    closeMenus();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenus();
  });
  // BACK, OR FORWARD, CAN BRING THIS PAGE BACK FROM MEMORY EXACTLY AS IT WAS
  // LEFT: a menu open, and whatever was ticked or chosen at the moment the form
  // went. The address is the state, and it is the earlier one, so a strip that
  // still showed the choice that took the reader away would claim a filter the
  // rows under it do not have. Every control goes back to what the server drew.
  window.addEventListener('pageshow', (event) => {
    if (!event.persisted) return;
    closeMenus();
    for (const select of selects) {
      const drawn = Array.from(select.options).find((option) => option.defaultSelected);
      if (drawn) select.value = drawn.value;
    }
    for (const box of document.querySelectorAll<HTMLInputElement>('input[data-multi-option]')) box.checked = box.defaultChecked;
    for (const repaint of repaints) repaint();
  });
  if (serverMode) {
    for (const select of document.querySelectorAll<HTMLSelectElement>('[data-filters] select[data-autosubmit]')) {
      select.addEventListener('change', () => select.form?.requestSubmit());
    }
    // A ticked title submits the same way a chosen facet does, and so does a
    // ticked arrangement.
    for (const box of document.querySelectorAll<HTMLInputElement>('[data-filters] input[data-title-option], [data-filters] input[data-multi-option]')) {
      box.addEventListener('change', () => box.form?.requestSubmit());
    }
  }

  /**
   * Announces intent. The table owns the rows.
   *
   * A change event rather than input, because a select fires change once the
   * choice is made and input on every keyboard arrow through the list, and
   * re-filtering a table on every arrow press is work nobody asked for.
   */
  for (const select of selects) {
    if (serverMode) break;
    select.addEventListener('change', () => {
      document.dispatchEvent(
        new CustomEvent('index:filter', {
          detail: { group: select.getAttribute('data-filter-group'), value: select.value }
        })
      );
    });
  }

  /**
   * The search box announces the same way: intent on the document, the table
   * owns the rows. `input` rather than `change` here, unlike the selects,
   * because a search box that only narrowed the table when it lost focus would
   * feel broken; a person expects the list to react as they type. It is still
   * cheap: the controller does one substring pass per keystroke over rows it
   * already holds, no network and no re-render of anything but visibility.
   */
  const searchBox = document.querySelector<HTMLInputElement>('[data-job-search]');
  if (searchBox && !serverMode) {
    searchBox.addEventListener('input', () => {
      document.dispatchEvent(
        new CustomEvent('index:search', { detail: { query: searchBox.value } })
      );
    });
  }

  /* -------------------------------------------------------------------------
     Storage helpers. A browser's own storage never gets to throw here: a
     private-mode quota error or a malformed prior value both degrade to "act
     as if nothing was ever stored", the same restraint src/lib/filters.ts's
     parseStoredJSON() states for the pure half of this same read.
     ------------------------------------------------------------------------- */

  function readJSON(storage: Storage, key: string): unknown {
    try {
      const raw = storage.getItem(key);
      return raw ? JSON.parse(raw) : null;
    } catch {
      return null;
    }
  }

  function writeJSON(storage: Storage, key: string, value: unknown): void {
    try {
      storage.setItem(key, JSON.stringify(value));
    } catch {
      /* Storage unavailable (private mode, quota). The control still works
         for this page view; it just does not persist past it. */
    }
  }

  /* -------------------------------------------------------------------------
     MASTER-SPEC F10, second bullet: deterministic, stateful filters.
     ------------------------------------------------------------------------- */

  /** The kinds a checkbox group has ticked, as the comma list the address reads. */
  function tickedOf(cell: HTMLElement): string[] {
    return Array.from(cell.querySelectorAll<HTMLInputElement>('input[data-multi-option]:checked')).map((box) => box.value);
  }

  /**
   * WHO MAY WRITE THE SAVED SELECTION. It is the board's strip, Location (place),
   * Remote (remote) and Comp (pay_min), one record per person. The Pre-List draws
   * a Comp select of its own (`comp`, a list of bands), and on any visit with a
   * query string it wrote `{comp: 'all'}` over that record: measured on
   * 2026-10-02, a paid member's saved place, arrangements and floor read back as
   * nothing after one /prelist?sort=age. A strip with none of the saved controls
   * reads the record and never writes it, here or in the browser's copy.
   */
  const savesTheStrip = !serverMode || multis.length > 0 || selects.some((select) => select.hasAttribute('data-open-values'));

  function currentSelection(): Record<string, string> {
    const selection: Record<string, string> = {};
    for (const select of selects) {
      const group = select.getAttribute('data-filter-group');
      if (group) selection[group] = select.value;
    }
    for (const cell of multis) {
      const group = cell.getAttribute('data-filter-multi');
      if (group) selection[group] = tickedOf(cell).join(',') || 'all';
    }
    return selection;
  }

  /**
   * THE READER EMPTIED THE BOARD, AND IS NOT ARRIVING AT IT. The "x" on the last
   * chip and "Clear the filters" both lead to the board's bare address, and a bare
   * address restores the saved selection, which is the very thing the reader just
   * took off: the last filter could never be removed. They are told apart by where
   * the reader came from. The board's own address as the referrer means they were
   * looking at it a moment ago; anything else (the home page, the nav, a bookmark,
   * a typed address, which sends none) is an arrival, and arrivals restore.
   */
  function clearedOnTheBoard(): boolean {
    if (!serverMode || !boardPath || window.location.search !== '') return false;
    const boardHere = boardPath.replace(/\/$/, '');
    if (window.location.pathname.replace(/\/$/, '') !== boardHere) return false;
    try {
      const from = new URL(document.referrer);
      return from.origin === window.location.origin && from.pathname.replace(/\/$/, '') === boardHere;
    } catch {
      return false;
    }
  }

  /** Sets every select to a stored value and announces each change through
      the same index:filter event a click would, so JobTable.astro applies a
      restored selection through the one path it already trusts rather than
      through a second, script-only entry point into its state. Values a
      closed select does not offer (a stale save, a retired band) are
      skipped rather than forced: the same "unknown falls back to what is
      already showing" restraint the server-side half applies when it reads a
      saved selection through the address's own parsers (filters-store.ts). */
  function applySelection(selection: unknown): void {
    if (!selection || typeof selection !== 'object') return;
    const source = selection as Record<string, unknown>;
    if (serverMode) {
      // ONE NAVIGATION, AND ONLY FROM THE BOARD'S OWN BARE ADDRESS. A saved
      // selection means "start me where I left off", so it applies only when
      // the reader has stated nothing in the address. Any search string at
      // all, including an explicit location=all, is the reader's own word and
      // wins. The forms always submit every facet, so a restore can never loop.
      //
      // And only on the board page itself. This component is also embedded in
      // the home page's board section, where a restore sent every visitor with
      // a saved filter from / to /board?..., so the home page "flipped" and its
      // sections vanished (reported twice; the second time on 2026-09-22). A
      // page that is not the board keeps its own address; the saved selection
      // waits for the reader to open the board.
      if (window.location.search !== '' || !boardPath) return;
      const here = window.location.pathname.replace(/\/$/, '');
      if (here !== boardPath.replace(/\/$/, '')) return;
      const params = new URLSearchParams();
      let any = false;
      for (const select of selects) {
        const group = select.getAttribute('data-filter-group');
        const value = group ? source[group] : undefined;
        if (typeof value !== 'string' || value === 'all') continue;
        // A select the page lists exhaustively keeps only what it still offers.
        // An open one (Location, Comp) takes the saved value to the address as
        // it is: the list holds what the board has under no filters, and a saved
        // city, region or typed floor is on no such list, but the address reads
        // all of them. The server has already vouched for an account's copy
        // (filters-store.ts) and drops anything the browser's copy got wrong.
        if (!select.hasAttribute('data-open-values') && !Array.from(select.options).some((option) => option.value === value)) continue;
        params.set(group as string, value);
        any = true;
      }
      // A checkbox group was saved as the comma list the address reads; only
      // the kinds this page still offers are kept.
      for (const cell of multis) {
        const group = cell.getAttribute('data-filter-multi');
        const value = group ? source[group] : undefined;
        if (!group || typeof value !== 'string' || value === 'all') continue;
        const offered = new Set(Array.from(cell.querySelectorAll<HTMLInputElement>('input[data-multi-option]')).map((box) => box.value));
        const kept = value.split(',').filter((part) => offered.has(part));
        if (kept.length === 0) continue;
        params.set(group, kept.join(','));
        any = true;
      }
      if (any) window.location.replace(`${boardPath}?${params.toString()}`);
      return;
    }
    for (const select of selects) {
      const group = select.getAttribute('data-filter-group');
      const value = group ? source[group] : undefined;
      if (typeof value !== 'string' || value === select.value) continue;
      const hasOption = Array.from(select.options).some((option) => option.value === value);
      if (!hasOption) continue;
      select.value = value;
      document.dispatchEvent(new CustomEvent('index:filter', { detail: { group, value } }));
    }
  }

  function persistSelection(): void {
    if (!savesTheStrip) return;
    const selection = currentSelection();
    writeJSON(window.localStorage, FILTERS_KEY, selection);
    if (signedIn && accountFiltersUrl) {
      // Fire-and-forget: a failed save leaves localStorage as the record of
      // intent for this browser, and the next successful save (this one or
      // any later one) catches the account back up. Nothing on this page
      // blocks on the network for a control this small.
      fetch(accountFiltersUrl, {
        method: 'POST',
        credentials: 'same-origin',
        // keepalive: in server mode a change submits the form at once, and a
        // save the navigation would otherwise cancel is a save that never
        // happened.
        keepalive: true,
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ selection })
      }).catch(() => {
        /* See above: localStorage already holds the intent. */
      });
    }
  }

  for (const select of selects) {
    select.addEventListener('change', persistSelection);
  }
  for (const box of document.querySelectorAll<HTMLInputElement>('input[data-multi-option]')) {
    box.addEventListener('change', persistSelection);
  }

  /* -------------------------------------------------------------------------
     MASTER-SPEC F10, first bullet, browser half: the seen dimmer.

     THE SEEN SET NEVER LEAVES THIS BROWSER. There is no fetch anywhere in
     this block, on purpose: which postings a person has looked at is named
     in this repository's own constraints canon as among the most sensitive
     facts this product could hold, and the honest way to guarantee it never
     reaches a server this task did not build a table for is to write no code
     that could send it to one. Signed out, the set lives in sessionStorage,
     cleared at the end of the browsing session, exactly as MASTER-SPEC F10
     states ("Anonymous users get session-level dimming only"). Signed in, it
     lives in localStorage instead, in the same browser, persisting across a
     visit the way the rest of a signed-in reader's local state does, but
     still never account-backed and still never sent anywhere: F10 asks for
     account-backed FILTERS, not an account-backed record of every posting a
     person opened, and this file does not build the second thing merely
     because it was asked to build the first.
     ------------------------------------------------------------------------- */

  const dimmerToggle = document.querySelector<HTMLInputElement>('[data-seen-dimmer-toggle]');

  function seenStorage(): Storage {
    return signedIn ? window.localStorage : window.sessionStorage;
  }

  function readSeenSlugs(): string[] {
    const raw = readJSON(seenStorage(), SEEN_KEY);
    return Array.isArray(raw) ? raw.filter((value): value is string => typeof value === 'string') : [];
  }

  function markSeen(slug: string): void {
    const seen = new Set(readSeenSlugs());
    if (seen.has(slug)) return;
    seen.add(slug);
    writeJSON(seenStorage(), SEEN_KEY, Array.from(seen));
  }

  /** Applies (or lifts) the dimmed attribute on every row already marked
      seen. Re-run after every JobTable update (index:rows), because
      JobTable.astro's own controller reorders and reveals rows on every
      filter, sort and page change, and an attribute this script set before
      that reorder is still on the same DOM node afterwards, but a newly
      revealed row needs the same pass run against it too. */
  function applySeenDimming(): void {
    const enabled = dimmerToggle ? dimmerToggle.checked : true;
    const seen = new Set(readSeenSlugs());
    for (const row of document.querySelectorAll<HTMLElement>('[data-job-row][data-slug]')) {
      const slug = row.getAttribute('data-slug');
      const shouldDim = enabled && slug !== null && seen.has(slug);
      row.toggleAttribute('data-seen-dimmed', shouldDim);
    }
  }

  if (dimmerToggle) {
    const storedEnabled = readJSON(window.localStorage, SEEN_DIMMER_KEY);
    dimmerToggle.checked = typeof storedEnabled === 'boolean' ? storedEnabled : true;

    dimmerToggle.addEventListener('change', () => {
      // The on/off preference itself is a UI setting, not a record of what
      // was viewed, so it is kept in localStorage for every visitor rather
      // than split by sign-in state the way the seen set above is: turning
      // this off on a shared or signed-out browser is not a sensitive fact.
      writeJSON(window.localStorage, SEEN_DIMMER_KEY, dimmerToggle.checked);
      applySeenDimming();
    });
  }

  // A row is marked seen when its own title link is opened, the same
  // "actually looked at it" signal src/pages/desk/application.ts's click
  // capture uses for an application: a click on the row's link, not a mere
  // hover or an intersection observer guessing at reading time either of
  // which would mark a row seen for scrolling past it.
  document.addEventListener(
    'click',
    (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;
      const row = target.closest<HTMLElement>('[data-job-row][data-slug]');
      const link = target.closest('a[href]');
      if (!row || !link) return;
      const slug = row.getAttribute('data-slug');
      if (!slug) return;
      markSeen(slug);
      applySeenDimming();
    },
    { capture: true }
  );

  document.addEventListener('index:rows', applySeenDimming);

  /* -------------------------------------------------------------------------
     THE APPLIED TAG (owner decision, 2026-09-19: no row is ever hidden for
     having been applied to; the old suppression and its banner are gone).
     The account probe below returns suppressedSlugs, which IS "postings this
     reader applied to", and each such row gets `data-applied`, a boolean fact
     a CSS rule elsewhere reacts to. Re-applied after every index:rows, since
     JobTable's controller re-renders rows on every change.
     ------------------------------------------------------------------------- */

  // The endpoint comes off the strip's own data attribute; the frontmatter
  // constant of the same name is not visible in this script.
  const accountFiltersUrl = root?.getAttribute('data-account-filters-url') || '';
  let signedIn = false;
  let suppressedSlugs: string[] = [];

  function applyAppliedTag(): void {
    if (suppressedSlugs.length === 0) return;
    const appliedSet = new Set(suppressedSlugs);
    for (const row of document.querySelectorAll<HTMLElement>('[data-job-row][data-slug]')) {
      const slug = row.getAttribute('data-slug');
      row.toggleAttribute('data-applied', slug !== null && appliedSet.has(slug));
    }
  }

  document.addEventListener('index:rows', applyAppliedTag);

  /* -------------------------------------------------------------------------
     The one account probe both account-backed behaviours above wait on. A
     401 here is read as "signed out", not as a failure: everything above
     already has a complete, correct, browser-only behaviour that needs
     nothing from this call, and this call only ever adds to it.
     ------------------------------------------------------------------------- */

  (async () => {
    // A board the reader just emptied states its selection (none) as surely as an
    // address with parameters does, and that empty selection is the one to keep.
    const cleared = clearedOnTheBoard();
    // Signed-out baseline first, unconditionally, so a slow or failed
    // network never leaves the page showing the un-restored default select
    // state for longer than a local read requires.
    if (serverMode && (window.location.search !== '' || cleared)) {
      // The address states the selection; that is now the saved one.
      if (savesTheStrip) writeJSON(window.localStorage, FILTERS_KEY, currentSelection());
    } else {
      applySelection(readJSON(window.localStorage, FILTERS_KEY));
    }
    applySeenDimming();

    if (!accountFiltersUrl) return;

    try {
      const response = await fetch(accountFiltersUrl, {
        credentials: 'same-origin',
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) return; // 401: signed out. The browser-only state above already stands.

      const body = await response.json();
      signedIn = true;

      // The account's own selection wins over localStorage's once we know
      // there is one: it is the more recently authoritative copy for a
      // reader who has used this account on another device. A person with
      // no saved selection yet (`selection: null`) keeps whatever the
      // localStorage pass above already applied.
      if (serverMode && (window.location.search !== '' || cleared)) persistSelection();
      else if (body && body.selection) applySelection(body.selection);

      // The seen set moves from sessionStorage to localStorage the instant
      // we learn this visitor is signed in, so a dimmer state built up
      // earlier in this same page view before the probe answered is not
      // lost, only relocated to the tier a signed-in visitor actually gets.
      const sessionSeen = readJSON(window.sessionStorage, SEEN_KEY);
      if (Array.isArray(sessionSeen) && sessionSeen.length > 0) {
        writeJSON(window.localStorage, SEEN_KEY, sessionSeen);
      }
      applySeenDimming();

      suppressedSlugs =
        body && Array.isArray(body.suppressedSlugs)
          ? body.suppressedSlugs.filter((value: unknown): value is string => typeof value === 'string')
          : [];

      applyAppliedTag();
    } catch {
      // A network failure reads exactly like signed-out: the browser-only
      // state already applied above is the honest, complete answer.
    }
  })();
</script>

<style>
  /* THE STRIP. .filters stacks the row; the row is
     the strip itself: cells edge to edge, divided by hairlines, no gaps and
     no chips. Board.astro's .controls draws the strip's outer edges. */
  .filters {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1 1 auto;
    /* The open menu is positioned against this box (see the script). */
    position: relative;
  }

  .filters-row {
    display: flex;
    align-items: stretch;
    flex-wrap: wrap;
    min-width: 0;
  }

  /* THE ROW WRAPS. IT DOES NOT SCROLL.
     It used to go `flex-wrap: nowrap; overflow-x: auto` at lap width and above,
     which fit while there were six controls and started scrolling the moment
     the Field select became the seventh. A filter strip that scrolls sideways
     hides its own controls behind an edge with nothing to say they are there —
     the reader cannot see what they can filter by, which is the one job the
     strip has. Owner, 2026-09-28: it should not scroll. So it wraps at every
     width, and a cell too narrow for its value truncates (see .filter-field). */

  /* One cell: label, then value, with the hairline on its left edge. The
     first cell has no left edge because the strip's border draws it. */
  .filter {
    display: flex;
