---
import KeyValueList from '../KeyValueList.astro';
import Panel from '../Panel.astro';
import { AGE_BASIS_LABEL, ageOf, firstSeen, firstSeenShowable, formatDate, sourceLabel, sweptStamp, type Job } from '../../lib/data';
import { isOn } from '../../lib/flags';
import type { KeyValueRow } from '../../lib/ui';

/**
 * The posting's own history, from the published files: MASTER-SPEC F10,
 * "posting biography on the detail page: first seen, published date with
 * basis, lifecycle to date."
 *
 * WHY THIS SITS BESIDE PROVENANCEPANEL RATHER THAN INSIDE IT. ProvenancePanel
 * is the receipt: where the record came from and when we last looked, one
 * fact per row, built for checking. This panel reuses the same two dates
 * (ageOf() and firstSeen(), never a second derivation) but reads them as a
 * story rather than a receipt: what this posting's own record shows about
 * itself, oldest fact first. A closed posting already gets that story in full
 * from ClosedHistory and ClosureRecord; this panel exists mainly so a LIVE
 * posting, which had no such narrative anywhere on the page, gets one too, in
 * the same shape. It renders on both variants so the two pages say the same
 * kind of thing about a posting's life, closed or not.
 *
 * NEVER A SECOND CLOCK OR A SECOND AGE. Every date below comes from
 * firstSeen()/firstSeenShowable()/ageOf()/sweptStamp(), the exact helpers
 * ProvenancePanel and the markdown twin already read, so a reader who checks
 * this panel against that one finds the same dates, never a close-but-not-
 * quite second answer computed by hand here.
 *
 * THE REPOST ROW IS THE ONE THING THIS FILE DELIBERATELY DOES NOT COMPUTE.
 * MASTER-SPEC F10: "Repost count renders ONLY when the machine exports it;
 * until then the slot ships dark behind a flag. The site never computes
 * repost claims from data it does not hold." The Job record already carries
 * first-observed dates and status changes, and it would be easy to write
 * "closed, then reappeared under the same title" as a repost. That is
 * exactly the speculative computation the site refuses: `repost_count` and
 * `repost_history` are not in the published files, the machine is frozen and
 * the site asks it for nothing (owner ruling, 2026-08-31), and the Job type
 * carries no field for either one. So the row
 * below is gated on the `repost_biography` flag (flags.config.mjs, locked
 * false in both editions this run) and pushed only when it is lit, which
 * means it renders zero DOM trace today, per RUN-MASTER's flag-off rule, and
 * does not reference a field that does not exist on Job yet. When the fields
 * land, this row is where they render, read the same way every other row
 * here is: through src/lib/data.ts, never typed here.
 */

interface Props {
  job: Job;
  class?: string;
}

const { job, class: className } = Astro.props;

const isClosed = job.status === 'closed';
const age = ageOf(job);
const observed = firstSeen(job);
const showObserved = firstSeenShowable(job);

const lifecycle = isClosed
  ? [
      job.closed_on ? `Closed ${formatDate(job.closed_on)}` : 'Closed, no date shown at source',
      job.closed_reason ?? 'No reason recorded at source',
      `confirmed archived ${sweptStamp()}`
    ].join(', ')
  : `${job.status === 're_verified' ? 'Live, re-verified' : 'Live, verified'} against ${sourceLabel(job)} at this sweep, ${sweptStamp()}`;

const rows: KeyValueRow[] = [
  {
    key: 'First seen',
    value: showObserved ? formatDate(observed) : null,
    absence: observed
      ? 'Held back while most rows were first seen on this sweep'
      : 'Not recorded for this posting'
  },
  {
    key: 'Published date',
    value: job.published_date ? `${formatDate(job.published_date)}, as posted at source` : null,
    absence: age
      ? `Not shown at source. Dated from ${AGE_BASIS_LABEL[age.basis]} ${formatDate(age.from)} instead`
      : 'Not shown at source, and no other date to measure from'
  },
  {
    key: 'Lifecycle to date',
    value: lifecycle
  }
];

// Dark, and staying dark: the machine is frozen and no export is pending.
// See the file header: no field on Job exists to read, so this pushes a stub
// absence rather than a number, and only when the flag is lit, which it is
// not in either edition.
if (isOn('repost_biography')) {
  rows.push({
    key: 'Repost history',
    value: null,
    absence: 'Not yet available.'
  });
}
---

<Panel
  title="Posting biography"
  footnote="Every entry is a date or status this record already holds. Nothing here is inferred."
  class={className}
>
  <KeyValueList rows={rows} />
</Panel>
