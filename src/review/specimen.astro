  { state: 'closed', token: 'mark-closed', context: 'Closed' }
] as const;

// Panel background token -> the Mark component's surface prop. The knockout on
// the re-verified mark has to be filled with the actual background or the notch
// shows the wrong colour, so the mapping is explicit rather than assumed.
const MARK_SURFACE = {
  surface: 'page',
  'surface-raised': 'raised',
  'hover-surface': 'hover'
} as const;

/**
 * The specimen's own labelling chrome, per panel background.
 *
 * This matters more than it looks. The audit trusts `data-token` to name the
 * colour it measures, so a label that declares `dim` while inheriting
 * `foreground` would put a wrong token name in a conformance report. Worse, the
 * inverted panel would contribute muted-on-ink and dim-on-ink pairings that the
 * product never uses, and the audit would report failures for combinations
 * nobody can reach.
 *
 * So the chrome tokens are chosen per surface, and the same value drives both
 * the rendered colour and the declared attribute. They cannot disagree because
 * they come from one place.
 */
const chromeFor = (bg: string) =>
  bg === 'surface-inverse'
    ? { fg: 'foreground-inverse', muted: 'muted-inverse', quiet: 'muted-inverse' }
    : { fg: 'foreground', muted: 'muted', quiet: 'muted' };

