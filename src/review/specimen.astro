/* ---------------------------------------------------------------------------
   Everything that is not a colour and not a size.

   WHY THESE SECTIONS EXIST. BUILD.md phase 1 asks for "the /_specimen dev route
   rendering every token in every documented context at real sizes on both
   themes", and this page's own lede promises the same thing in stronger words.
   Neither was true: an audit diffed the 82 custom properties in
   src/styles/tokens.css against the rendered page and found 38 of them nowhere
   on it, including the whole space ramp, every tracking and leading step, the
   primitive gray ramp, the status pairs, the motion tokens and the layout
   measures. What shipped was the semantic colour set and the type scale, which
   is the half a contrast audit needs and about half of what the system defines.

   Every row below names its token and renders the value doing its job: a space
   step is a rule of that width, a tracking step is the same string set at it, a
   leading step is a wrapped paragraph, a motion duration is a number beside the
   curve it is spent on. Nothing here is a swatch of a value nobody uses, because
   the promise is contexts rather than an inventory.

   THE CONTEXT STRINGS COME FROM THE TOKEN DESCRIPTIONS. Each token's $description
   in tokens/ is where its job is written down, and repeating it here in a
   shortened form keeps this page a reading of the token file rather than a
   second opinion about it. Where a token is deliberately unused, the row says so
   rather than inventing a use for it.
   --------------------------------------------------------------------------- */

/**
 * The compiled values, read out of the artifact the browser actually resolves.
 *
 * Not retyped, and not read out of the DTCG JSON either. The same argument
 * emails/lib/tokens.mjs already makes: a value typed beside a token name is a
 * second copy that drifts silently, and the compiled CSS is one step further
 * down the same pipeline than the source JSON, so a token that failed to compile
 * shows here as a missing value rather than as a confident number. A name this
 * page asks for and the build did not emit throws, because a specimen printing a
 * value for a token that does not exist is worse than no specimen.
 */
const TOKENS_CSS: string = tokensCss;
const TOKEN_VALUES = new Map<string, string>(
  [...TOKENS_CSS.matchAll(/^\s*--([a-z0-9-]+):\s*([^;]+);/gim)].map((match) => [`--${match[1]}`, match[2].trim()])
);
const tokenValue = (name: string): string => {
  const found = TOKEN_VALUES.get(name);
  if (!found) {
    throw new Error(
      `_specimen: ${name} is not in src/styles/tokens.css. The specimen documents what the pipeline emits, so a row for a token that does not compile is a row that is not true.`
    );
  }
  return found;
};

