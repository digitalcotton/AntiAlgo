  { step: '500', context: 'Panel padding, and the gap between a heading and the prose under it.' },
  { step: '600', context: 'The panel gutter, and the space between panels in a section.' },
  { step: '700', context: 'Between sections of a page.' },
  { step: '800', context: 'Between the bands of a page, and the tail padding under the last one.' },
  { step: '900', context: 'The manifesto band gap, which is what puts its fold where it is.' },
  { step: '1000', context: 'The widest step on the ramp. Reserved for a full-bleed band.' }
] as const;

/** The four weights, one of which has no font behind it and is a trap. */
const WEIGHTS = [
  { step: 'light', context: 'Declared by the house ramp and unused here. N27 Light does not ship, and font-synthesis is off, so a request for it renders Regular.' },
  { step: 'regular', context: 'Body copy and long-form reading.' },
  { step: 'medium', context: 'Subheads, nav, labels, and chrome.' },
  { step: 'bold', context: 'Page titles and primary headings. On the mono this resolves to the SemiBold file, the heaviest cut that exists.' }
] as const;

const TRACKINGS = [
  { step: 'tight', context: 'Headings and the wordmark, where the house sets negative tracking.' },
  { step: 'normal', context: 'The default. Body copy and inline mono take no tracking at all.' },
  { step: 'snug', context: 'Small numeric and label chrome.' },
  { step: 'wide', context: 'Small controls that need opening up.' },
  { step: 'loose', context: 'Uppercase small caps: the kicker, the nav, every mono stamp.' }
] as const;

const LEADINGS = [
  { step: 'tight', context: 'Section headings, where the line box is the type size.' },
  { step: 'display', context: 'Multi-line display headings. A hair of air over tight.' },
  { step: 'snug', context: 'Captions and stacked cells.' },
  { step: 'normal', context: 'Body leading. N27 is display-leaning, so reading gets extra air.' }
] as const;

/**
 * The scalars that shape a box rather than a letter.
 *
 * Rendered as a value beside its context rather than as a drawing, except where
 * a drawing is the only honest demonstration: the two border widths and the
 * radius are drawn, because a number in a table cannot show a hairline.
 */
/**
 * The easing curve's own control points, read out of the token rather than
 * drawn by eye.
 *
 * A hand-drawn curve beside a printed cubic-bezier is two claims about one
 * value, and the picture is the one nobody checks. Parsing it means the plot
 * moves when the token moves, and a token that stops being a cubic-bezier fails
 * the build here rather than rendering a curve that is no longer the easing.
 * The y axis is flipped because SVG counts down from the top and an easing
 * curve is read from the bottom left.
 */
function easingPath(value: string): string {
  const found = /cubic-bezier\(([^)]+)\)/.exec(value);
  const points = found ? found[1].split(',').map((part) => Number(part.trim())) : [];
  if (points.length !== 4 || points.some((point) => !Number.isFinite(point))) {
    throw new Error(
      `_specimen: --motion-easing-standard is "${value}", which this page cannot plot. It draws the curve from the token's own control points, so an easing it cannot parse is one it must not draw.`
    );
  }
  const [x1, y1, x2, y2] = points;
  return `M 0 100 C ${x1 * 100} ${100 - y1 * 100}, ${x2 * 100} ${100 - y2 * 100}, 100 0`;
}

const EASING_PATH = easingPath(tokenValue('--motion-easing-standard'));

const STRUCTURE = [
  { token: '--layout-max', context: 'The page shell width. Every route sits inside it.' },
  { token: '--layout-measure', context: 'The reading measure on prose. Set on the paragraph, never on the container.' },
  { token: '--layout-table-min', context: 'Below this the index table scrolls rather than crushing its six columns.' },
  { token: '--table-columns', context: 'The index table tracks, resolved once by the column labels and every row.' },
  { token: '--record-columns', context: 'The Profile Record row tracks: id, title, dates, kind, chevron.' },
  { token: '--proposal-columns', context: 'The resume review checklist tracks: kind, title, dates, status, chevron.' },
  { token: '--provider-columns', context: 'The Settings provider row tracks: name, status, inline actions.' },
  { token: '--text-underline-offset', context: 'Every underlined link on the site.' },
  { token: '--breakpoint-phone', context: 'Rows become cards, tiles go two by two, bands stack.' },
  { token: '--breakpoint-lap', context: 'The six column grid gives way and the header nav wraps.' },
  { token: '--breakpoint-desk', context: 'The report figure sits two abreast at or above it.' },
  { token: '--breakpoint-card', context: 'The social card releases its fixed height below its own raster width.' },
  { token: '--breakpoint-shell', context: 'The shared header collapses to a menu button at or below it.' }
] as const;
---

<BaseLayout
  title="Token specimen"
  description="Every token, in every documented context, at real sizes. The surface the contrast audit measures."
  active="_specimen"
  noindex
>
  <div class="shell spec">
    <header class="spec-head">
      <h1>Token specimen</h1>
      <p class="spec-lede">
        Every token this system defines, rendered doing the job it is defined for. The colour pairings and the type
        roles come from the two approved canvases, at the size and weight they use them at; the ramps, the
        mechanics and the measures come from each token's own description in the token files. Switch the theme in
        the header to measure the other half. Nothing here is decorative: if a pairing is on this page the product
        uses it, and if the build compiled a token it is named on this page, which a check inside the conformance
        run asserts rather than trusts.
      </p>
      <p class="spec-meta mono">
        SWEPT {stats.swept_at_utc}
      </p>
    </header>

    <section class="spec-section" aria-labelledby="text-heading">
      <h2 id="text-heading" class="mono-label">Text on surface</h2>

      {
        PANELS.map((panel) => {
          const chrome = chromeFor(panel.bg);
          return (
            <div class="panel" data-bg={panel.bg} style={`background: var(--color-${panel.bg});`}>
              <div class="panel-head">
                <h3
                  class="mono-label"
                  data-token={chrome.fg}
                  data-bg={panel.bg}
                  data-role="text"
                  style={`color: var(--color-${chrome.fg});`}
                >
                  {panel.title}
                </h3>
                <p
                  class="panel-note"
                  data-token={chrome.muted}
                  data-bg={panel.bg}
                  data-role="text"
                  style={`color: var(--color-${chrome.muted});`}
                >
                  {panel.note}
                </p>
                <p
                  class="panel-bg mono"
                  data-token={chrome.quiet}
                  data-bg={panel.bg}
                  data-role="text"
                  style={`color: var(--color-${chrome.quiet});`}
                >
                  --color-{panel.bg}
                </p>
              </div>

              <ul class="rows">
                {panel.samples.map((s) => (
                  <li class="row">
                    <span
                      class:list={['spec-sample', s.voice === 'mono' && 'mono', s.caps && 'caps']}
                      data-token={s.token}
                      data-bg={panel.bg}
                      data-role={s.role}
                      data-truth={s.truth?.kind}
                      data-truth-metric={s.truth?.kind === 'tile' ? s.truth.metric : undefined}
                      data-truth-value={s.truth?.kind === 'tile' ? s.truth.value : undefined}
                      data-truth-job={s.truth?.kind === 'fit' ? s.truth.job : undefined}
                      data-truth-total={s.truth?.kind === 'fit' ? s.truth.total : undefined}
                      style={`color: var(--color-${s.token}); font-size: var(--size-${s.size}); font-weight: var(--weight-${s.weight});`}
                    >
                      {s.sample}
                    </span>
                    <span
                      class="row-meta mono" data-specimen="token"
                      data-token={chrome.muted}
                      data-bg={panel.bg}
                      data-role="text"
                      style={`color: var(--color-${chrome.muted});`}
                    >
                      --color-{s.token} / --size-{s.size} / --weight-{s.weight}
                    </span>
                    <span
                      class="row-context" data-specimen="token"
                      data-token={chrome.muted}
                      data-bg={panel.bg}
                      data-role="text"
                      style={`color: var(--color-${chrome.muted});`}
                    >
                      {s.context}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          );
        })
      }
    </section>

    <section class="spec-section" aria-labelledby="hatch-heading">
      <h2 id="hatch-heading" class="mono-label">The verbatim placeholder hatch</h2>
      <p class="spec-note">
        The hatch marks a slot the machine has not filled. It is two low-contrast stripes on purpose: an empty
        slot has to read as empty rather than as prose. Its label is measured against both stripes, because text
        sitting over a 45 degree gradient touches both.
      </p>
      <div class="hatch" data-bg="hatch-a" data-bg-secondary="hatch-b">
        <span class="hatch-label mono caps" data-token="muted" data-bg="hatch-b" data-role="text">
          SOURCE DESCRIPTION RENDERS HERE, VERBATIM FROM THE FEED · NEVER PARAPHRASED, NEVER SUMMARIZED
        </span>
      </div>
      {/* The two stripes named. The hatch is the only place either token is
          used, and until this line the page drew them without saying which
          they were, so a reader could see the texture and not name it. */}
      <p class="spec-note mono">--color-hatch-a on --color-hatch-b, at 45 degrees, inverting to their dark pair on ink.</p>
    </section>

    <section class="spec-section" aria-labelledby="graphic-heading">
      <h2 id="graphic-heading" class="mono-label">Non-text: lines, marks, disabled affordances</h2>
      <p class="spec-note">
        Judged at 3:1, not 4.5:1. These carry meaning without carrying words, so WCAG 1.4.11 is the threshold and
        the audit reports them in their own table.
      </p>

      {
        GRAPHIC_BGS.map((bg) => (
          <div class="panel" data-bg={bg} style={`background: var(--color-${bg});`}>
            <p class="panel-bg mono" data-token="muted" data-bg={bg} data-role="text">
              --color-{bg}
            </p>

            <ul class="rows">
              {LINES.map((line) => (
                <li class="row">
                  <span
                    class="swatch-line"
                    data-token={line.token}
                    data-bg={bg}
                    data-role="graphic"
                    style={`border-color: var(--color-${line.token});`}
                  />
                  <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg={bg} data-role="text">
                    --color-{line.token}
                  </span>
                  <span class="row-context" data-specimen="token" data-token="muted" data-bg={bg} data-role="text">
                    {line.context}
                  </span>
                </li>
              ))}

              {MARKS.map((m) => (
                <li class="row">
                  <span class="swatch-mark" data-token={m.token} data-bg={bg} data-role="graphic">
                    <Mark state={m.state} surface={MARK_SURFACE[bg]} />
                  </span>
                  <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg={bg} data-role="text">
                    --color-{m.token}
                  </span>
                  <span class="row-context" data-specimen="token" data-token="muted" data-bg={bg} data-role="text">
                    {m.context}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <section class="spec-section" aria-labelledby="legend-heading">
      <h2 id="legend-heading" class="mono-label">The legend, as it ships</h2>
      <p class="spec-note">
        Standing rule 5: a mark is never more than one viewport from its meaning. This is the component every page
        that renders a mark puts in its table footer, shown on each surface it can land on.
      </p>
      {
        GRAPHIC_BGS.map((bg) => (
          <div class="panel legend-panel" data-bg={bg} style={`background: var(--color-${bg});`}>
            <MarkLegend surface={MARK_SURFACE[bg]} />
            <p class="panel-bg mono" data-token="muted" data-bg={bg} data-role="text">
              --color-{bg}
            </p>
          </div>
        ))
      }
    </section>

    <section class="spec-section" aria-labelledby="roles-heading">
      <h2 id="roles-heading" class="mono-label">The type roles, at their measured sizes</h2>
      <p class="spec-note">
        Five roles, each rendered here at exactly what it computes to in the shipping build. These are not
        proposals: every value was measured off the live tokenstoagents.ai and ported, which is why this section
        exists at all. If a page sets a heading and it does not match the row below it, the page is wrong.
      </p>

      <div class="panel" data-bg="surface" style="background: var(--color-surface);">
        <ul class="rows">
          {
            TYPE_ROLES.map((role) => (
              <li class="row role-row">
                <span
                  class:list={['role-sample', role.className]}
                  data-token="foreground"
                  data-bg="surface"
                  data-role="text"
                >
                  {role.sample}
                </span>
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface" data-role="text">
                  {role.tokens}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface" data-role="text">
                  {role.context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="scale-heading">
      <h2 id="scale-heading" class="mono-label">The ramps</h2>
      <p class="spec-note">
        Both voices at every step of the house ramp, so the two faces can be compared at the same size. The mono
        is set at Regular because that is the machine voice's own weight; the sans has no 600 cut, so a mono
        element asking for bold gets the SemiBold file, which is the heaviest that exists.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            ['050', '075', '100', '150', '200', '300', '400', '500', '600', '700'].map((step) => (
              <li class="row ramp-row">
                <span
                  class="spec-sample"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="text"
                  style={`font-size: var(--size-${step});`}
                >
                  {/*
                    Two sweep counts read out of the fixture, not typed. Each one
                    is wrapped so gate 2 can resolve it against stats: the ramp
                    prints this line ten times, and ten undeclared copies of the
                    two headline counts is exactly the drift the coverage check
                    watches for. The wrappers carry no styling and no data-token,
                    so the audit still resolves both through closest().
                  */}
                  The Index verified{' '}
                  <span data-truth="tile" data-truth-metric="verified_live" data-truth-value={String(stats.verified_live)}>
                    {stats.verified_live}
                  </span>{' '}
                  of{' '}
                  <span data-truth="tile" data-truth-metric="pulled" data-truth-value={String(stats.pulled)}>
                    {stats.pulled}
                  </span>
                </span>
                <span
                  class="spec-sample mono"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="text"
                  style={`font-size: var(--size-${step});`}
                >
                  0123456789 02:14 UTC
                </span>
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --size-{step}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="space-heading">
      <h2 id="space-heading" class="mono-label">The space ramp</h2>
      <p class="spec-note">
        Ten steps, each drawn at its own width. Spacing is the token family a design system loses first, because a
        gap that is four pixels wrong looks like a judgment call rather than a defect, so the ramp is drawn here at
        size beside the job each step does.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            SPACE_STEPS.map(({ step, context }) => (
              <li class="row space-row">
                {/* The bar is the token doing its own job: its width is the step
                    itself, so the row cannot claim a value it is not drawing. */}
                <span
                  class="space-bar"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="graphic"
                  style={`width: var(--space-${step});`}
                />
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --space-{step} · {tokenValue(`--space-${step}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="primitive-heading">
      <h2 id="primitive-heading" class="mono-label">The primitives underneath</h2>
      <p class="spec-note">
        Every semantic colour above resolves to one of these, and the dark theme is that resolution done a second
        way. Two steps carry no semantic token at all and the rows say so: a primitive with nothing pointing at it
        is part of the ramp rather than part of the product, and pretending otherwise is how a palette grows tones
        nobody chose.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            GRAY_STEPS.map(({ step, semantic }) => (
              <li class="row swatch-row">
                <span
                  class="swatch-fill"
                  data-token={`gray-${step}`}
                  data-bg="surface-raised"
                  data-role="graphic"
                  style={`background: var(--gray-${step});`}
                />
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --gray-{step} · {tokenValue(`--gray-${step}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  Points at it: {semantic}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="spec-note">
        The two non-neutral pairs, and the whole of the break from the mothership, which states its own rule as no
        accent colour, emphasis by inversion only. The Index cannot hold that line honestly, because it has to say
        this was verified and this many died, so the ramp gains exactly two pairs and nothing else.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            STATUS_PRIMITIVES.map(({ token, semantic, note }) => (
              <li class="row swatch-row">
                <span
                  class="swatch-fill"
                  data-token={token}
                  data-bg="surface-raised"
                  data-role="graphic"
                  style={`background: var(--${token});`}
                />
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --{token} · {tokenValue(`--${token}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {semantic}. {note}
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="voices-heading">
      <h2 id="voices-heading" class="mono-label">The two voices, and the size they meet at</h2>
      <p class="spec-note">
        Standing rule 3: the humanist face carries editorial and interface, the mono carries machine assertions.
        The two are set at one size here so the third token can be seen doing its job, which is holding the mono to
        the sans it sits inside.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          <li class="row voice-row">
            <span class="voice-sample" data-token="foreground" data-bg="surface-raised" data-role="text">
              Verified at source, last night
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --font-family-sans
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              The human voice. Everything that is not a machine reading.
            </span>
          </li>
          <li class="row voice-row">
            <span class="voice-sample mono" data-token="foreground" data-bg="surface-raised" data-role="text">
              02:14 UTC · 685D · LOW
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --font-family-mono
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              Numbers, timestamps, statuses, scores, source names.
            </span>
          </li>
          <li class="row voice-row">
            <span class="voice-sample" data-token="foreground" data-bg="surface-raised" data-role="text">
              Open <span class="num">685</span> days, killed <span class="num">Aug 17</span>
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --font-scale-mono · {tokenValue('--font-scale-mono')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              A machine value inside a sentence takes the mono at this scale, not at the machine voice's own flat
              size. The faces share their cap and x-heights, so the step compensates for the mono's wider set.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="weight-heading">
      <h2 id="weight-heading" class="mono-label">Weight, tracking, leading, figures</h2>
      <p class="spec-note">
        The four families that shape a line rather than a box. Each row sets the same string at the step it names,
        because a weight or a tracking value written in a table is a number and set on a line it is a decision.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            WEIGHTS.map(({ step, context }) => (
              <li class="row mechanic-row">
                <span
                  class="mechanic-sample"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="text"
                  style={`font-weight: var(--weight-${step});`}
                >
                  Verified this sweep
                </span>
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --weight-{step} · {tokenValue(`--weight-${step}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            TRACKINGS.map(({ step, context }) => (
              <li class="row mechanic-row">
                <span
                  class="mechanic-sample caps"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="text"
                  style={`letter-spacing: var(--tracking-${step});`}
                >
                  Kill list
                </span>
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --tracking-{step} · {tokenValue(`--tracking-${step}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          {
            LEADINGS.map(({ step, context }) => (
              <li class="row leading-row">
                {/* Leading only exists across two lines, so the sample is set in
                    a narrow column and allowed to wrap rather than shown as a
                    single line that would look identical at every step. */}
                <span
                  class="leading-sample"
                  data-token="foreground"
                  data-bg="surface-raised"
                  data-role="text"
                  style={`line-height: var(--leading-${step});`}
                >
                  A posting the machine read at source and found still live
                </span>
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  --leading-{step} · {tokenValue(`--leading-${step}`)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          <li class="row figures-row">
            {/* Measured before it was written, and the measurement changed the
                row. Neither shipped face carries a tnum table at all: with the
                feature on and off, N27's 1 is 17.03px and its 8 is 24.06px at
                40px, unchanged either way. So the left column here is not the
                feature working, it is the mono's own fixed advance, and the
                right column is what the same numbers do in the sans. The token
                is declared and inert, which is a thing to say rather than a
                thing to demonstrate with two identical columns. */}
            <span class="figures-pair">
              <span class="figures-col mono tabular" data-token="foreground" data-bg="surface-raised" data-role="text">
                11.11<br />90.09<br />48.84
              </span>
              <span class="figures-col tabular" data-token="muted" data-bg="surface-raised" data-role="text">
                11.11<br />90.09<br />48.84
              </span>
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --feature-tabular · {tokenValue('--feature-tabular')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              The machine voice on the left, the sans on the right, both asking for tabular figures. Neither face
              ships the feature, so what holds the left column on one axis is the mono's own fixed advance, and the
              right column does not hold at all. The second token in this set that is declared and inert, beside
              weight.light, and it is why numerals in a column are mono here rather than merely asked to align.
            </span>
          </li>
        </ul>
      </div>
    </section>

    <section class="spec-section" aria-labelledby="structure-heading">
      <h2 id="structure-heading" class="mono-label">Boxes: borders, radius, marks, measures</h2>
      <p class="spec-note">
        The values that shape a box. The three drawn at the top cannot be shown as numbers: a hairline against a
        heavy rule is a comparison, and a two pixel corner is either there or it is not.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          <li class="row swatch-row">
            <span
              class="rule-sample rule-hairline"
              data-token="line"
              data-bg="surface-raised"
              data-role="graphic"
            />
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --border-hairline · {tokenValue('--border-hairline')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              Every rule inside a panel. Fifty-four of the fifty-six borders on the index canvas are this one.
            </span>
          </li>
          <li class="row swatch-row">
            <span
              class="rule-sample rule-heavy"
              data-token="foreground"
              data-bg="surface-raised"
              data-role="graphic"
            />
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --border-heavy · {tokenValue('--border-heavy')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              Two in the whole system, under the header and above the ecosystem band. They are what separates
              chrome from content.
            </span>
          </li>
          <li class="row swatch-row">
            <span class="radius-sample" data-token="line-strong" data-bg="surface-raised" data-role="graphic" />
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --radius · {tokenValue('--radius')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              Sharp by default. It reaches the button reset and the focus ring, and it will stop being invisible
              the first time a control takes a fill.
            </span>
          </li>
          <li class="row swatch-row">
            <span class="mark-size mark-size-inline" data-token="mark-live" data-bg="surface-raised" data-role="graphic">
              <Mark state="verified" surface="raised" />
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --mark-inline · {tokenValue('--mark-inline')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              A verification mark beside its text partner, in a row or a legend. A glyph box rather than a type
              size, which is why it is not a step on the ramp.
            </span>
          </li>
          <li class="row swatch-row">
            <span class="mark-size mark-size-brand" data-token="foreground" data-bg="surface-raised" data-role="graphic">
              <Mark state="verified" surface="raised" />
            </span>
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --mark-brand · {tokenValue('--mark-brand')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              The wordmark's mark in the header, and the only place the mark appears at this size.
            </span>
          </li>
          {
            STRUCTURE.map(({ token, context }) => (
              <li class="row measure-row">
                <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {token} · {tokenValue(token)}
                </span>
                <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
                  {context}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="spec-note">
        The five breakpoints are the one family in this system that a stylesheet cannot read as a token: a media
        query is evaluated before the cascade that gives a custom property a value, so the width is written
        literally in every query and the token above is the declared source it has to match. A check inside the
        token build fails on any query width that is not one of these five. The shell step is the marketing
        site's own value rather than this one's, because the header is shared and a seam would show at exactly
        one width if the two halves disagreed about where it folds.
      </p>
    </section>

    <section class="spec-section" aria-labelledby="motion-heading">
      <h2 id="motion-heading" class="mono-label">Motion, at rest</h2>
      <p class="spec-note">
        Two durations and one curve. Nothing on this page moves, and that is deliberate rather than an omission:
        the motion gate allows exactly one keyframe animation in the built site, the signature moment on the index,
        and a specimen that animated to demonstrate itself would be a second one. So the curve is drawn and the
        durations are printed.
      </p>

      <div class="panel" data-bg="surface-raised" style="background: var(--color-surface-raised);">
        <ul class="rows">
          <li class="row measure-row">
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --motion-duration-instant · {tokenValue('--motion-duration-instant')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              Colour and border transitions on hover, and the theme change. Every one of them is declared inside a
              reduced-motion query, so a reader who asks for stillness gets it.
            </span>
          </li>
          <li class="row measure-row">
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --motion-duration-signature · {tokenValue('--motion-duration-signature')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              The one signature moment, the verification rule drawing itself across the index table's assurance
              band. Standing rule 6 caps motion under 400ms and the gate reads that strictly, so 400 itself fails.
            </span>
          </li>
          <li class="row measure-row">
            <span class="row-meta mono" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              --motion-easing-standard · {tokenValue('--motion-easing-standard')}
            </span>
            <span class="row-context" data-specimen="token" data-token="muted" data-bg="surface-raised" data-role="text">
              One curve for everything. A second easing would be a second opinion about how this site moves.
            </span>
          </li>
        </ul>

        {/* The curve drawn from the token's own control points, so the picture
            cannot disagree with the value printed above it. Hidden from the
            accessibility tree: it is a restatement of the row beside it, and an
            image that repeats its own caption is noise to a screen reader. */}
        <div class="easing-frame">
          <svg class="easing-plot" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <path class="easing-line" d={EASING_PATH} />
          </svg>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .spec {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-600) var(--space-800);
  }

  /* The measure sits on the prose, not on the container. A reading measure is
     counted in the container's own body size, so leaving it here would clamp
     the page title, which is now four times that size, into a body-width
     column. */
  .spec-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  .spec-lede {
    font-size: var(--size-200);
    max-width: var(--layout-measure);
    color: var(--color-muted);
  }

  /* No size and no tracking: the .mono class is the machine voice and it owns
     both. Only the tone is this page's business. */
  .spec-meta {
    color: var(--color-muted);
  }

  .spec-section {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .spec-section > h2 {
    color: var(--color-foreground);
    border-bottom: var(--border-heavy) solid var(--color-foreground);
    padding-bottom: var(--space-200);
  }

  .spec-note {
    font-size: var(--size-200);
    color: var(--color-muted);
    max-width: var(--layout-measure);
  }

  .panel {
    border: var(--border-hairline) solid var(--color-line-strong);
    padding: var(--space-500) var(--space-600);
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .panel-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
  }

  /* Defaults for the panels whose background is never inverted. The text panels
     override these inline, because there the chrome token has to follow the
     surface. Stated here rather than inherited so no labelled node in this page
     renders a colour its data-token does not name. */
  .panel-note {
    font-size: var(--size-200);
    max-width: var(--layout-measure);
    color: var(--color-muted);
  }

  /* The little "--color-surface-raised" stamp under each panel heading. It was
     dim, so that the chrome naming a panel sat below the chrome describing it.
     Now both are muted and the size and the voice carry the step down: 10px mono
     and tracked, against 13px sans. */
  .panel-bg {
    font-size: var(--size-050);
    letter-spacing: var(--tracking-loose);
    color: var(--color-muted);
  }

  .rows {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  /* One row per pairing: the live sample, the token names that produced it, and
     the product context. Three columns so the samples align vertically and a
     32px numeral does not shove its neighbours out of line. */
  .row {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 18rem) minmax(0, 1fr);
    gap: var(--space-400);
    align-items: baseline;
    padding-block: var(--space-100);
    border-top: var(--border-hairline) solid var(--color-line);
  }

  .ramp-row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 12rem);
  }

  /* The roles section gets a wider first column and drops the baseline
     alignment, because a 76px sample and a 10px meta line have nothing useful
     to say to each other on one baseline. */
  .role-row {
    grid-template-columns: minmax(0, 1fr) minmax(0, 20rem) minmax(0, 16rem);
    align-items: start;
  }

  /* The ramp now reaches 4.75rem, where a ten digit mono string is 470px wide
     and contains nothing a browser is willing to break. Without this the whole
     page scrolls sideways on a phone to accommodate one sample. Breaking a
     numeral mid-run is fine here and nowhere else: this row exists to show the
     glyphs at a size, not to be read as a number. */
  .spec-sample {
    line-height: var(--leading-snug);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* ---------------------------------------------------------------------
     The five type roles, each stated once, in tokens only.

     These are duplicates of what global.css sets on h1, h2, body, .kicker and
     .mono, and that is deliberate: the specimen has to be able to render a role
     next to its own name without borrowing an element that carries other
     meaning. If one of these ever drifts from the shell, the row will say so,
     because the meta column names the tokens the row claims to be using.
     --------------------------------------------------------------------- */
  /* Grid children default to min-width:auto, which a 76px sample would use to
     push its own column past the track. */
  .role-sample {
    min-width: 0;
  }

  .role-title {
    font-size: var(--size-700);
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-bold);
  }

  .role-section {
    font-size: var(--size-500);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
    font-weight: var(--weight-bold);
  }

  .role-body {
    font-size: var(--size-200);
    line-height: var(--leading-normal);
    font-weight: var(--weight-regular);
  }

  .role-kicker {
    font-size: var(--size-100);
    line-height: var(--leading-normal);
    letter-spacing: var(--tracking-loose);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }

  .role-mono {
    font-family: var(--font-family-mono);
    font-size: var(--size-100);
    line-height: var(--leading-normal);
    font-weight: var(--weight-regular);
    font-synthesis: none;
  }

  .caps {
    text-transform: uppercase;
    letter-spacing: var(--tracking-loose);
  }

  .row-meta {
    font-size: var(--size-050);
    color: var(--color-muted);
  }

  .row-context {
    font-size: var(--size-075);
    color: var(--color-muted);
  }

  .swatch-line {
    display: block;
    width: 100%;
    height: 0;
    /* A 2px rule so the audit has a real edge to sample, drawn in the line token
       under test. Hairline tokens are 1px in product; doubling it here changes
       nothing about the colour being measured. */
    border-top: var(--border-heavy) solid;
  }

  .swatch-mark {
    display: inline-flex;
    align-items: center;
  }

  .legend-panel {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-500);
  }

  .hatch {
    height: 9.375rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-400);
    border: var(--border-hairline) solid var(--color-line);
    background: repeating-linear-gradient(
      45deg,
      var(--color-hatch-a),
      var(--color-hatch-a) 6px,
      var(--color-hatch-b) 6px,
      var(--color-hatch-b) 12px
    );
  }

  .hatch-label {
    font-size: var(--size-050);
    color: var(--color-muted);
    text-align: center;
    max-width: 32rem;
  }

  /* ---------------------------------------------------------------------
     The sections that render the rest of the system.

     Every sample below is the token doing its own job rather than a picture of
     it: a space step is a rule of that width, a weight is a line set at it, a
     tracking step is the same three words spaced by it. That is what makes this
     a specimen and not a table of values, and it is why none of these rules
     hardcodes a dimension the token could have supplied.
     --------------------------------------------------------------------- */

  .space-row,
  .swatch-row,
  .voice-row,
  .mechanic-row,
  .leading-row,
  .figures-row {
    grid-template-columns: minmax(0, 16rem) minmax(0, 16rem) minmax(0, 1fr);
    align-items: center;
  }

  .measure-row {
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    align-items: baseline;
  }

  /* The bar IS the step: its width is the token, so the row cannot state a
     value it is not drawing. The height is a hairline doubled, the same trick
     .swatch-line uses, so a 4px step still has something to see. */
  .space-bar {
    display: block;
    height: var(--space-200);
    background: currentColor;
    min-width: var(--border-hairline);
  }

  .swatch-fill {
    display: block;
    width: var(--space-800);
    height: var(--space-500);
    /* Bordered because the lightest steps are the page's own surface, and a
       swatch that disappears into its panel proves nothing. */
    border: var(--border-hairline) solid var(--color-line-strong);
  }

  .voice-sample,
  .mechanic-sample {
    font-size: var(--size-200);
    line-height: var(--leading-snug);
    min-width: 0;
    overflow-wrap: anywhere;
  }

  /* The inline machine value, at the scale token that exists for it. Same rule
     methodology sets on its own inline numerals, restated here because a
     specimen shows a role without borrowing an element that carries meaning. */
  .num {
    font-family: var(--font-family-mono);
    font-size: var(--font-scale-mono);
    font-variant-numeric: tabular-nums;
  }

  .leading-sample {
    display: block;
    font-size: var(--size-200);
    /* Narrow on purpose. Leading is a relationship between two lines and a
       single line shows nothing, so the sample is made to wrap. */
    max-width: 14rem;
  }

  .figures-pair {
    display: flex;
    gap: var(--space-500);
  }

  .figures-col {
    font-size: var(--size-150);
    line-height: var(--leading-snug);
    font-variant-numeric: normal;
  }

  .tabular {
    font-variant-numeric: tabular-nums;
    font-feature-settings: var(--feature-tabular);
  }

  .rule-sample {
    display: block;
    width: 100%;
    height: 0;
  }

  .rule-hairline {
    border-top: var(--border-hairline) solid var(--color-line);
  }

  .rule-heavy {
    border-top: var(--border-heavy) solid var(--color-foreground);
  }

  .radius-sample {
    display: block;
    width: var(--space-600);
    height: var(--space-600);
    border: var(--border-heavy) solid var(--color-line-strong);
    border-radius: var(--radius);
  }

  .mark-size {
    display: inline-flex;
    align-items: center;
  }

  /* The two mark sizes, set on the component's own box rather than described.
     Mark.astro draws at 1em, so the size token belongs on the element around
     it, which is exactly how the header and the row set it. */
  .mark-size-inline {
    font-size: var(--mark-inline);
  }

  .mark-size-brand {
    font-size: var(--mark-brand);
  }

  /* The two axes are drawn as borders rather than as strokes inside the plot,
     which is not a styling preference. The contrast audit judges an SVG shape at
     3:1 under WCAG 1.4.11, on the reasoning that a mark is the only thing saying
     a posting was checked, and reports a border edge without judging it, on the
     reasoning that a rule you could delete without losing information is rhythm.
     These axes are the second kind, so they are drawn as the second kind. */
  .easing-frame {
    width: var(--space-900);
    margin-top: var(--space-400);
    border-left: var(--border-hairline) solid var(--color-line);
    border-bottom: var(--border-hairline) solid var(--color-line);
  }

  .easing-plot {
    display: block;
    width: 100%;
    height: var(--space-900);
    overflow: visible;
  }

  .easing-line {
    fill: none;
    stroke: var(--color-foreground);
    stroke-width: 3;
    vector-effect: non-scaling-stroke;
  }

  @media (max-width: 60rem) { /* --breakpoint-lap */
    .row,
    .ramp-row,
    .role-row,
    .space-row,
    .swatch-row,
    .voice-row,
    .mechanic-row,
    .leading-row,
    .figures-row,
    .measure-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-100);
    }
  }
</style>
