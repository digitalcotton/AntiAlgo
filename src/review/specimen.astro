// rather than applying them, and the sheet is already linked by the layout.
import tokensCss from '../styles/tokens.css?raw';

/**
 * The specimen. A dev-only route, leading underscore so Astro does not build it
 * into a page, that renders every token in every context the product actually
 * uses it in, at the real size and the real weight, on the real background.
 *
 * This is the surface the contrast audit measures. That is why every sample
 * carries `data-token`, `data-bg` and `data-role`: the audit reads the computed
 * colour off the node and the computed background off the panel, and needs to
 * report which token names produced them. Without the attributes the script
 * would be matching hex values back to names by guesswork, and a guess in a
 * conformance report is worth nothing.
 *
 * Both themes: this page renders in whichever theme is active, and the audit
 * runs it twice, setting data-theme on the root between passes. That is the same
 * mechanism the real site uses, so the specimen measures the shipping code path
 * rather than a parallel copy of the dark remap that could drift from it.
 *
 * `data-role` picks the threshold. Text is judged at AA 4.5:1 (or 3:1 where the
 * computed size and weight qualify as large). Graphics, borders and disabled
 * affordances are judged at 3:1 per WCAG 1.4.11. BUILD.md ruling 2 resolved
 * `dim` from exactly this split, so the split has to be declared in the markup
 * rather than inferred by the script.
 *
 * WHAT HAPPENED TO `dim`. It is gone, and the contexts it used to paint are
 * still here, rendered in `muted`. The audit on 2026-08-17 measured gray.500 at
 * 3.07:1 on paper, 3.34:1 on a raised panel and 2.78:1 on a hovered row, at the
 * 10px to 14px sizes it carried, and then walked the ramp line one 8-bit step at
 * a time to find that gray.600 is the lightest tone clearing 4.5:1 on the worst
 * light ground, with the very next step failing at 4.48:1. There is no room on
 * this paper for a third readable tone. The rows below are what that costs: the
 * pairings that used to be two tones deep are now one tone and a weight, a size
 * or a voice apart. Read reports/contrast-audit.md for the measurements.
 *
 * Every sample string is either a description of its own context or a real
 * figure from src/data/stats.json. Nothing on this page is invented.
 *
 * AND THE ROW IT BORROWS IS READ, NEVER TYPED. The two fit-score samples used to
 * carry a hardcoded slug and a hardcoded 96. The slug was
 * figma-manager-design-systems-and-infrastructure, which was a real row when the
 * specimen was written and has not been in src/data/jobs.json since. Gate 2
 * caught it and said the right thing about it: a score for a row nobody swept is
 * an invented number, on the one page whose claim is that nothing here is
 * invented. Both samples now read the top-fit verified row out of the data, so
 * the specimen shows a real score for a real posting on every build and cannot
 * go stale again without the data going stale with it.
 */

/**
 * The row the fit samples borrow, and its real total.
 *
 * Top of the default sort, so it is the same row the index puts first and a
 * reader comparing the two sees one number. Null only where a build has no
 * verified rows at all, in which case the samples render their own context
 * string instead of a score, because a specimen has no business inventing one.
 */
const fitRow = sortJobs(verifiedJobs(), 'fit')[0] ?? null;
const fitScore = fitRow ? fitRow.fit.total : null;

interface Sample {
  /** Ink token, without the --color- prefix. */
  token: string;
  /** Size token, without the --size- prefix. */
  size: string;
  /** Weight token, without the --weight- prefix. */
  weight: string;
  voice: 'sans' | 'mono';
  /** 'text' is judged at AA contrast, 'graphic' at 3:1. */
  role: 'text' | 'graphic';
  /** Where in the product this exact pairing occurs. */
  context: string;
  /** What renders. Descriptions of themselves, or real sweep figures. */
  sample: string;
  /** Uppercase mono, as the canvases set every label and stamp. */
  caps?: boolean;
  /**
   * Present on every sample whose string carries a real sweep number, absent on
   * the ones that only describe themselves.
   *
   * The specimen shows type at product sizes, so the fastest way to show a stat
   * numeral at 76px is to render the actual stat. The moment it does that it is
   * publishing sweep data, and gate 2's markup contract applies to it exactly as
   * it applies to the index page: a number that means something declares what it
   * means, and the gate resolves the declaration against src/data/stats.json.
   * Without this the page would print a sweep count as an untyped string, which
   * is the one thing gate 2's reading check exists to hard-fail.
   *
   * `tile` names a metric in stats. `fit` names a job slug, and gate 2 then also
   * proves the total equals the sum of that job's rubric components.
   */
  truth?:
    | { kind: 'tile'; metric: string; value: string }
    | { kind: 'fit'; job: string; total: number };
}

interface Panel {
  /** Background token, without the --color- prefix. */
  bg: string;
  title: string;
  note: string;
  samples: Sample[];
}

