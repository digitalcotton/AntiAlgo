// The non-text pairings. Lines, marks and disabled affordances, measured apart
// from text because WCAG asks a different question about them: 1.4.11 at 3:1,
// not 1.4.3 at 4.5:1.
const GRAPHIC_BGS = ['surface', 'surface-raised', 'hover-surface'] as const;

/**
 * This list previously carried a third entry claiming `dim` was the border of
 * the disabled previous-page button. It is not, and the canvas is unambiguous:
 *
 *   <button disabled style="...border:1px solid #D8D5CE;color:#8F8C87;...">
 *
 * The border is `line`. `dim` was the button's label. That mattered more than a
 * mislabelled row, because BUILD.md ruling 2 resolves `dim` by splitting it into
 * a text group and a non-text group, and this entry was the entire non-text
 * group. With it corrected, `dim` had exactly one job (carrying words) and the
 * split the ruling anticipated had nothing to split. `tokens/README.md` had it
 * right all along: gray.500 "only ever appears as `color:`, 45 times".
 */
const LINES = [
  { token: 'line', context: 'Every hairline rule inside a panel, and the disabled previous-page button' },
  { token: 'line-strong', context: 'The heavy panel border the canvas names directly' }
] as const;

