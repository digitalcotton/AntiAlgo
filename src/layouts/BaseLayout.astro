---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';

/**
 * The shell every route renders inside: the pre-paint theme resolution, the
 * document head, the two faces, the skip target, and the chrome. Page-level
 * structure belongs to the page.
 *
 * `active` and `image`/`ogType` were added for the board pages copied in from
 * the Index, which pass them. `active` is accepted and defaulted but not
 * read here: AntiAlgo's SiteHeader highlights the current nav item by
 * comparing the request URL directly (see its own `isHere()`), not by a
 * PAGES/PageKey inventory the way the Index's shared header did, so there is
 * nothing in this repo's chrome for `active` to drive yet. It stays a typed,
 * accepted prop rather than an error, so a board page copied verbatim does
 * not have to be edited just to stop passing it.
 */
interface Props {
  title: string;
  description?: string;
  /** Which nav item is current. Accepted for the board pages that pass it;
      see the note above for why AntiAlgo's own chrome does not yet read it. */
  active?: string;
  /** A page-specific social image, base-included (nav.ts's path helpers
      already add it). Defaults to the site card. */
  image?: string;
  ogType?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  active,
  image = SITE.ogImage,
  ogType = 'website',
  noindex = false
} = Astro.props;
void active; // see the Props comment above: accepted, not yet consumed.

const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Theme, resolved before first paint: the stored choice wins, the OS
         preference seeds a first visit. Inline and first so no stylesheet can
         paint the wrong surface. -->
    <script is:inline>
      (() => {
        let theme;
        try {
          theme = localStorage.getItem('theme');
        } catch {}
        if (theme !== 'dark' && theme !== 'light') {
          theme = window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={robots} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Only the two faces above the fold on every route are preloaded. -->
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/n27-regular-latin.woff2" />
    <link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/n27-bold-latin.woff2" />

    <style is:global>
      /* Custom properties do not resolve inside @font-face, so the numeric
         weights here are literal by necessity. The six files are the index's
         own Latin subsets. */
      @font-face { font-family: 'N27'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/n27-regular-latin.woff2') format('woff2'); }
      @font-face { font-family: 'N27'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/n27-medium-latin.woff2') format('woff2'); }
      @font-face { font-family: 'N27'; font-style: normal; font-weight: 600 700; font-display: swap; src: url('/fonts/n27-bold-latin.woff2') format('woff2'); }
      @font-face { font-family: 'Basier Square Mono'; font-style: normal; font-weight: 400; font-display: swap; src: url('/fonts/basiersquaremono-regular-latin.woff2') format('woff2'); }
      @font-face { font-family: 'Basier Square Mono'; font-style: normal; font-weight: 500; font-display: swap; src: url('/fonts/basiersquaremono-medium-latin.woff2') format('woff2'); }
      @font-face { font-family: 'Basier Square Mono'; font-style: normal; font-weight: 600; font-display: swap; src: url('/fonts/basiersquaremono-semibold-latin.woff2') format('woff2'); }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      /**
       * Keep the reader's place across a same-page navigation. Many controls on
       * the site (board filters, sort, paging; settings/profile/desk forms) are a
       * GET form, a query-param link, or a POST that redirects back to the same
       * path, so acting on one is a full navigation and the browser would drop
       * the reader at the top of the fresh page. This saves the scroll position
       * on the way out and restores it on the way in, but only when the path is
       * unchanged (a selection on the same page), so arriving on a page from a
       * link elsewhere still starts at the top and the back button keeps the
       * browser's own restoration.
       */
      const KEY = 'aa:scroll';
      const here = location.pathname;

      const save = () => {
        try {
          sessionStorage.setItem(KEY, JSON.stringify({ p: here, y: window.scrollY }));
        } catch {
          /* private mode or quota: the control still works, it just won't persist. */
        }
      };
      window.addEventListener('pagehide', save);

      window.addEventListener('pageshow', (event) => {
        // A back/forward restore (bfcache) already has the browser's own scroll
        // position; only same-document GET navigations need us to step in.
        if (event.persisted) return;
        // A fragment link (e.g. Settings' #keys) has its own target; let the
        // browser's anchor scroll stand rather than overriding it.
        if (location.hash) return;
        try {
          const raw = sessionStorage.getItem(KEY);
          if (!raw) return;
          sessionStorage.removeItem(KEY);
          const saved = JSON.parse(raw);
          if (saved && saved.p === here && typeof saved.y === 'number') {
            window.scrollTo(0, saved.y);
          }
        } catch {
          /* nothing stored, or unreadable: leave the reader at the top. */
        }
      });
    </script>
  </body>
</html>
