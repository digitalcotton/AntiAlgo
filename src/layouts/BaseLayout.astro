---
import globalCss from '../styles/global.css?inline';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { SITE } from '../data/site';
import { sweptAt } from '../lib/data';
import { sweptStamp } from '../lib/stats';
import { FRESH_WINDOW_HOURS } from '../lib/data-contract';
import { publicAsset } from '../data/nav';

/** The Latin woff2 subsets in public/fonts, by a short key. A page names the
    faces it paints above the fold so they preload with the HTML rather than
    waiting on a stylesheet to be parsed first. */
type FontKey =
  | 'n27-regular'
  | 'n27-medium'
  | 'n27-bold'
  | 'mono-regular'
  | 'mono-medium'
  | 'mono-semibold';
const FONT_FILES: Record<FontKey, string> = {
  'n27-regular': 'n27-regular-latin.woff2',
  'n27-medium': 'n27-medium-latin.woff2',
  'n27-bold': 'n27-bold-latin.woff2',
  'mono-regular': 'basiersquaremono-regular-latin.woff2',
  'mono-medium': 'basiersquaremono-medium-latin.woff2',
  'mono-semibold': 'basiersquaremono-semibold-latin.woff2'
};

/** The six @font-face rules, built here so they can be emitted inline in the
    head (is:inline, below) rather than extracted into a linked stylesheet the
    browser reaches only after a round trip. Same families, weights, range and
    swap as before; publicAsset() writes the same src path in dev and build,
    which a plain .css file cannot do (see global.css's note). Custom
    properties do not resolve inside @font-face, so the weights are literal. */
const FONT_FACES: { family: string; weight: string; key: FontKey }[] = [
  { family: 'N27', weight: '400', key: 'n27-regular' },
  { family: 'N27', weight: '500', key: 'n27-medium' },
  { family: 'N27', weight: '600 700', key: 'n27-bold' },
  { family: 'Basier Square Mono', weight: '400', key: 'mono-regular' },
  { family: 'Basier Square Mono', weight: '500', key: 'mono-medium' },
  { family: 'Basier Square Mono', weight: '600', key: 'mono-semibold' }
];
const fontFaceCss = FONT_FACES.map(
  (f) =>
    `@font-face{font-family:'${f.family}';font-style:normal;font-weight:${f.weight};font-display:swap;src:url('${publicAsset(
      `/fonts/${FONT_FILES[f.key]}`
    )}') format('woff2');}`
).join('');

/**
 * The shell every route renders inside: the pre-paint theme resolution, the
 * document head, the two faces, the skip target, and the chrome. Page-level
 * structure belongs to the page.
 *
 * `active` and `image`/`ogType` were added for the board pages copied in from
 * the Index, which pass them. `active` is accepted and defaulted but not
 * read here: AntiAlgo's SiteHeader highlights the current nav item by
 * comparing the request URL directly (see its own `isHere()`), not by a
 * PAGES/PageKey inventory the way the Index's shared header did, so there is
 * nothing in this repo's chrome for `active` to drive yet. It stays a typed,
 * accepted prop rather than an error, so a board page copied verbatim does
 * not have to be edited just to stop passing it.
 */
interface Props {
  title: string;
  description?: string;
  /** Which nav item is current. Accepted for the board pages that pass it;
      see the note above for why AntiAlgo's own chrome does not yet read it. */
  active?: string;
  /** A page-specific social image, base-included (nav.ts's path helpers
      already add it). Defaults to the site card. */
  image?: string;
  ogType?: string;
  noindex?: boolean;
  /** The faces to preload for this route, above the fold. Defaults to the two
      N27 faces every route paints; a page with more (the board's mono labels
      and medium body) names them so they do not wait on a stylesheet. */
  fonts?: FontKey[];
  /** The instant THIS route's dated figures were actually read, when it is not
      the sweep's. See the age-disclosure note below: a route that renders the
      crawl's output passes the crawl's own load instant here, because the
      default is the sweep's and the two are hours apart. */
  dataAt?: string | null;
  /** Which of the machine's two populations `dataAt` belongs to. It travels
      with `dataAt` and never apart from it: the instant decides how old the
      band says the page is, and this decides what the band says the page IS.
      An instant with the wrong noun on it is the same defect as the wrong
      instant, printed more confidently. */
  dataPopulation?: 'sweep' | 'crawl';
}

const {
  title,
  description = SITE.description,
  active,
  image = SITE.ogImage,
  ogType = 'website',
  noindex = false,
  fonts = ['n27-regular', 'n27-bold'],
  dataAt = null,
  dataPopulation = 'sweep'
} = Astro.props;
void active; // see the Props comment above: accepted, not yet consumed.

const canonical = new URL(Astro.url.pathname, SITE.url).href.replace(/\/$/, '') || SITE.url;
const ogImage = new URL(image, SITE.url).href;
const fullTitle = title === SITE.name ? title : `${title} · ${SITE.name}`;
const robots = noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1';

/**
 * AGE DISCLOSURE, IN THE SHELL, SO A ROUTE GETS IT BY DEFAULT RATHER THAN BY
 * BEING REMEMBERED.
 *
 * The site already had the right mechanism and it was installed one page at a
 * time. / and /board carry a band that reports age instead of throwing, which
 * is why a stale number stopped taking the site down. /desk prints its own
 * swept stamp and /opportunities stamps every row. Three surfaces had nothing:
 * /jobs-data labelled tens of thousands of crawled rows "Verified live
 * tonight" over no instant at all, /prelist rendered rows with no stamp of any
 * kind, and the job detail page — the one with the Apply button on it — made a
 * freshness promise that was a hardcoded string.
 *
 * The common cause is that disclosure was a thing each page had to remember.
 * /prelist is what that costs: nobody forgot on purpose, there was simply
 * nowhere the obligation lived. So it lives here now. Every route renders
 * inside this shell (42 of them import it today), so every route gets a band
 * whose instant is real, and a NEW route gets one without its author doing
 * anything. scripts/gate-invariants.mjs check 7 enforces the rest: that the
 * band is still here, and that a route reading the crawl overrides the default
 * instead of inheriting the wrong clock.
 *
 * WHICH INSTANT. The default is the sweep's, read from the same stats.json the
 * <meta name="sweep-instant"> above is read from, because that is the instant
 * behind everything on the site that is not a crawled row. A route whose
 * figures come from the crawl — ~1,666 boards out of Postgres rather than 45
 * curated ones — passes `dataAt` and `dataPopulation="crawl"`, because the
 * crawl finishes hours after the sweep and printing the sweep's instant over
 * the crawl's rows overstates their freshness. That is not hypothetical: on
 * 2026-09-30 the board's own stamp did exactly this and claimed rows were four
 * minutes old when they had been loaded two days earlier.
 */
const ageAt = dataAt ?? sweptAt();
const agePopulation = dataAt ? dataPopulation : 'sweep';
/* What the band says the page IS, before the reader's clock says how old it
   is. Neither phrase contains "today", "tonight" or "this morning": those read
   as true on a page that has not been rebuilt for three days, which is exactly
   when a reader needs them to read as false. */
const ageLabel = agePopulation === 'crawl' ? 'Board last read' : 'Last swept';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <!-- Theme, resolved before first paint: the stored choice wins, the OS
         preference seeds a first visit. Inline and first so no stylesheet can
         paint the wrong surface.

         THE ONE THEME AUTHORITY (since 2026-09-20). This script is the only
         code on the site that writes data-theme or the stored choice. It
         exposes window.antialgoTheme: get() reads the root, set(next) writes
         the root and storage and fires "antialgo:themechange" on the document.
         Everything else (the header toggle, the Jobs Data app, page styles)
         reads the root or listens for the event and never writes. Two writers
         is how the site flipped between light and dark from page to page. It
         also follows the OS when no choice is stored, and follows another tab's
         choice through the storage event, so every open page agrees. -->
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const KEY = 'theme';
        const valid = (t) => t === 'dark' || t === 'light';
        const stored = () => {
          try {
            const t = localStorage.getItem(KEY);
            return valid(t) ? t : null;
          } catch {
            return null;
          }
        };
        const os = () =>
          window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        const apply = (theme) => {
          if (root.getAttribute('data-theme') === theme) return;
          root.setAttribute('data-theme', theme);
          document.dispatchEvent(new CustomEvent('antialgo:themechange', { detail: { theme } }));
        };
        window.antialgoTheme = {
          get: () => (valid(root.getAttribute('data-theme')) ? root.getAttribute('data-theme') : os()),
          set: (next) => {
            if (!valid(next)) return;
            try {
              localStorage.setItem(KEY, next);
            } catch {}
            apply(next);
          }
        };
        apply(stored() || os());
        // No stored choice: the site follows the OS as it changes.
        if (window.matchMedia) {
          matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
            if (!stored()) apply(os());
          });
        }
        // Another tab chose: this one follows.
        window.addEventListener('storage', (e) => {
          if (e.key === KEY && valid(e.newValue)) apply(e.newValue);
        });
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author.name} />
    <meta name="robots" content={robots} />

    {/* WHICH SWEEP THIS BUILD WAS MADE FROM. Machine-readable, on every page.
        The mini's nightly publish check asks the one question nothing else
        asks -- "is the site actually serving tonight's work?" -- by fetching
        the public URL and looking for the sweep instant verbatim. It used to
        find it in the board's data-swept attribute. On 2026-09-30 that
        attribute correctly became the CRAWL's instant instead (it labels the
        crawl's rows), and the sweep instant stopped appearing anywhere on the
        page in machine-readable form. The check would have raised a false
        alarm on the next run: the deploy was fine, its marker had moved.
        So the marker is explicit now rather than borrowed from whatever
        element happens to render a date. A design decision about an eyebrow
        must not be able to silently break the machine's proof of deploy.
        scripts/gate-invariants.mjs check 8 fails the build if it goes
        missing. */}
    <meta name="sweep-instant" content={sweptAt()} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/* The faces this route paints above the fold, preloaded so they start
        with the HTML instead of after a stylesheet is parsed. The default is
        the two N27 faces every route uses; the board adds its mono labels and
        medium body. publicAsset() writes the same paths in dev and build. */}
    {fonts.map((key) => (
      <link rel="preload" as="font" type="font/woff2" crossorigin href={publicAsset(`/fonts/${FONT_FILES[key]}`)} />
    ))}

    {/* The faces inline in the head, before every stylesheet link, so the
        browser knows them from the first bytes. is:inline keeps Astro from
        extracting this into a bundled sheet reached only after a round trip. */}
    <style is:inline set:html={fontFaceCss}></style>
    {/* The critical sheet (tokens, themes, global) inline right after, so the
        link colour, surface, body font and both theme token sets are known
        from the first HTML bytes and an early paint is styled, never the
        browser's blue-link default. ?inline resolves the two @imports and
        minifies in build; the component sheets stay linked and cached. */}
    <style is:inline set:html={globalCss}></style>

    {/* The age band's own styling. Scoped, which is the whole reason it can be
        trusted: this rule reaches the band because the band is authored in this
        file's template, and it reaches nothing a page authored itself. The band
        is real markup rather than something a script builds, precisely so the
        scoped rule can land on it — a scoped rule never reaches an element
        built by script. */}
    <style>
      /* Quiet by default. It is a provenance line, not a banner: on a page
         whose figures are current it should read as a footnote. */
      .age-disclosure {
        margin: 0;
        padding: var(--space-300) clamp(16px, 2.5vw, 36px);
        color: var(--color-muted);
        font-size: var(--size-100);
        text-align: center;
      }

      /* Amber, not red, past the window: this is a warning about our own
         freshness, never an accusation about an employer. Same token the
         board's band and the table's assurance line use, so the site has one
         colour for "we are late" rather than three. */
      .age-disclosure[data-stale] {
        color: var(--color-banner-stale);
      }
    </style>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>

    {/* The shell's own age band. See the age-disclosure note in the frontmatter
        for why it is here rather than on each page.

        IT SITS AFTER </main>, AND THE POSITION IS LOAD-BEARING. JobTable.astro's
        inline staleness script reads `document.querySelector('[data-swept]')` —
        the FIRST such element in the document, not all of them. / and /board
        each author their own band inside the board card, so those stay first and
        that script keeps finding exactly the element it has always found. Put
        this one above <main> and it would quietly steal that script's target on
        the site's two most important pages. The band below is handled by its own
        script, keyed on its own attribute, so the two never reach for the same
        element.

        It carries the same data-swept / data-fresh-hours / data-assurance-text
        trio the board's band carries, so the pair stays one convention rather
        than becoming two: anything that already knows how to read a stamp can
        read this one. */}
    <p class="age-disclosure mono" data-age-disclosure data-swept={ageAt} data-fresh-hours={FRESH_WINDOW_HOURS}>
      <span data-assurance-text>{ageLabel} {sweptStamp(ageAt)}</span>
    </p>

    <!--
      The reader's clock, not the build's.

      The band above is rendered from an instant the machine recorded, so it is
      true when it is sent. Whether it is still true is a question only the
      reader's device can answer, and the answer changes every hour without a
      request happening. This is the same reasoning — and deliberately the same
      sentence — as JobTable.astro's band script, for the same reason the
      threshold is read off the markup rather than typed here: two copies of a
      wording or a window is how a page ends up looking fresh while the alarm
      rings.

      It never claims fresh. It either downgrades the band or leaves it alone,
      so a reader with JavaScript off is left with a real instant and no
      arithmetic rather than with a promise.

      querySelectorAll, and only this attribute: there may be another band on
      the page (the board authors its own) and that one belongs to the script
      that has always owned it.
    -->
    <script is:inline>
      (function () {
        var bands = document.querySelectorAll('[data-age-disclosure]');
        for (var i = 0; i < bands.length; i++) {
          var band = bands[i];
          var text = band.querySelector('[data-assurance-text]');
          var swept = Date.parse(band.getAttribute('data-swept') || '');
          if (!text || isNaN(swept)) continue;

          // The window the server stamped on the band, which is
          // FRESH_WINDOW_HOURS. An unreadable attribute falls back to that
          // constant's value rather than to no check at all, because a band
          // that silently never warns is worse than one that warns on a
          // slightly wrong threshold. A clock skewed backwards reads negative,
          // which is not staleness and must not raise a warning on the
          // strength of a wrong device clock, so only positive ages count.
          var hours = parseFloat(band.getAttribute('data-fresh-hours'));
          if (!(hours > 0)) hours = 36;
          var age = (Date.now() - swept) / 3600000;
          if (!(age >= hours)) continue;

          var whole = Math.floor(age);
          var label = whole >= 48 ? Math.floor(whole / 24) + ' days' : whole + ' hours';
          band.setAttribute('data-stale', '');
          text.textContent =
            'Last verified ' +
            label +
            ' ago. These figures were true at the last sweep and have not been checked since.';
        }
      })();
    </script>

    <SiteFooter />

    <script>
      /**
       * Keep the reader's place across a same-page navigation. Many controls on
       * the site (board filters, sort, paging; settings/profile/desk forms) are a
       * GET form, a query-param link, or a POST that redirects back to the same
       * path, so acting on one is a full navigation and the browser would drop
       * the reader at the top of the fresh page. This saves the scroll position
       * on the way out and restores it on the way in, but only when the path is
       * unchanged (a selection on the same page), so arriving on a page from a
       * link elsewhere still starts at the top and the back button keeps the
       * browser's own restoration.
       */
      const KEY = 'aa:scroll';
      const here = location.pathname;

      const save = () => {
        try {
          sessionStorage.setItem(KEY, JSON.stringify({ p: here, y: window.scrollY }));
        } catch {
          /* private mode or quota: the control still works, it just won't persist. */
        }
      };
      window.addEventListener('pagehide', save);

      window.addEventListener('pageshow', (event) => {
        // A back/forward restore (bfcache) already has the browser's own scroll
        // position; only same-document GET navigations need us to step in.
        if (event.persisted) return;
        // A fragment link (e.g. Settings' #keys) has its own target; let the
        // browser's anchor scroll stand rather than overriding it.
        if (location.hash) return;
        try {
          const raw = sessionStorage.getItem(KEY);
          if (!raw) return;
          sessionStorage.removeItem(KEY);
          const saved = JSON.parse(raw);
          if (saved && saved.p === here && typeof saved.y === 'number') {
            window.scrollTo(0, saved.y);
          }
        } catch {
          /* nothing stored, or unreadable: leave the reader at the top. */
        }
      });
    </script>
  </body>
</html>
