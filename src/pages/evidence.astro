---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import KillCard from '../components/KillCard.astro';
import { INDEX, routeFor } from '../data/nav';
import { loadKills, killScaleMax } from '../lib/kills';
import { sweptStamp } from '../lib/stats';

/*
 * Evidence: the research behind the claims, and the kill record itself, live.
 * The kill card is the index's own design and token layer (src/components/
 * KillCard.astro), fed by the index's kill feed (lib/kills.ts reads
 * INDEX_KILLS_URL, the last two months of records, newest first). The company
 * is redacted on the way in, because this is the public marketing surface: the
 * evidence is the pattern, not the firm.
 *
 * Read per request, so a record that ages out of the two month window or a new
 * kill that lands is reflected the next time the page is served, with nothing
 * to touch here. When the feed cannot be read, the section states the absence
 * in the human voice and sends the reader to the kill list, which holds them all.
 */
Astro.response.headers.set('Cache-Control', 'public, s-maxage=300, stale-while-revalidate=900');

const feed = await loadKills();
const records = feed.records;
const featured = records[0] ?? null;
/* The list runs as long as the sweep was busy, and a night with two hundred
   kills turned this page into a wall nobody reads to the bottom of (owner,
   2026-09-24). Twenty rows is a list; two hundred is a log file. The count of
   what is not shown is printed below it rather than dropped silently, because
   a truncated list that does not say so reads as the whole record. */
const LIST_ROWS = 20;
/* Ten on arrival, the rest behind "Show more" (owner, 2026-09-29). The page
   still HOLDS twenty -- the cap above is unchanged and so is the reasoning for
   it -- but twenty rows of kill record is a lot to land on before you have
   decided you want them. The hidden ten are in the markup, not fetched on
   demand: it is ten list items, they are already on the page, and a reader
   without JavaScript or with it disabled gets the control working anyway
   (see the checkbox below). */
const OPEN_ROWS = 10;
const rest = records.slice(1, 1 + LIST_ROWS);
const notShown = Math.max(0, records.length - 1 - rest.length);
/* Only worth a control when it actually hides something. */
const hasMore = rest.length > OPEN_ROWS;
const scaleMax = killScaleMax(records);
const sweptLabel = feed.servedAt ? sweptStamp(feed.servedAt) : null;
const address = 'tokenstoagents.ai/jobs/kills';
// The whole-kill-list link is a signed-in affordance; a logged-out reader is
// sent to the kill list through the page's own copy, not this trailing link.
const signedIn = Boolean(Astro.locals.viewer);
---

<BaseLayout title="Evidence" description="The kill record itself, live from the sweep. One posting the machine caught, and the rule that caught it.">
  <div class="ev">
    <section class="hsec hero" aria-labelledby="ev-hero">
      <span class="kicker">Evidence</span>
      <h1 id="ev-hero" class="h1">The research, with its sources.</h1>
      <p class="lede">
        Every figure this site cites is somebody else's research, quoted with its source, or a number the machine measured
        last night. The report carries the measured numbers, the methodology carries the rules.
      </p>
    </section>

    <section class="hsec" aria-labelledby="evidence-title">
      <h2 id="evidence-title" class="h2">Evidence posts</h2>
      <p class="ev-sub">The kill record itself, live from the sweep, one card per posting the machine caught. The company is redacted here. New records come from the sweep, not from us.</p>

      {featured ? (
        <div class="ev-featured">
          <KillCard record={featured} scaleMax={scaleMax} address={address} sweptLabel={sweptLabel} />
        </div>
      ) : (
        <p class="ev-absence">
          The kill feed could not be read just now, or nothing has been killed in the last two months.
          <a class="ev-absence-link" href={INDEX.kills}>The kill list holds every record.</a>
        </p>
      )}

      {rest.length > 0 && (
        <Fragment>
          {/* A checkbox and its label, no script -- the same mechanism the site
              header's mobile menu uses, for the same reason: this works with
              JavaScript off, survives a failed hydration, and needs nothing
              from the dom-contracts gate. The checkbox is the control and is
              kept reachable by keyboard while off screen; the label is its
              visible text. It must precede the list so the ~ selectors below
              can reach it. */}
          {hasMore && (
            <input
              type="checkbox"
              id="ev-more-toggle"
              class="ev-more-toggle"
              aria-label={`Show all ${rest.length} recent kills`}
            />
          )}
          <ul class="ev-list" aria-label="The most recent kills in the last two months">
            {rest.map((r, i) => (
              /* The rows past the tenth are marked, not removed: they are in
                 the document and in the accessibility tree the moment the
                 control is opened, and a find-in-page still reaches them. */
              <li class="ev-list-row" data-beyond={i >= OPEN_ROWS ? '' : undefined}>
                <span class="ev-li-rule">{r.rule ?? 'killed'}</span>
                <span class="ev-li-role">{r.role}</span>
                <span class="ev-li-date">{r.killedOn ?? 'date not shown'}</span>
              </li>
            ))}
          </ul>
          {hasMore && (
            <label class="ev-showmore" for="ev-more-toggle">
              <span class="ev-showmore-open">Show {rest.length - OPEN_ROWS} more</span>
              <span class="ev-showmore-close">Show fewer</span>
            </label>
          )}
        </Fragment>
      )}

      {notShown > 0 && (
        <p class="ev-truncated">
          The {rest.length} most recent, of {records.length.toLocaleString()} killed in the same window.
        </p>
      )}

      {featured && signedIn && (
        <p class="ev-more"><a href={INDEX.kills}>Read the whole kill list</a></p>
      )}
    </section>
  </div>
</BaseLayout>

<style>
  /* The site's canvas scale, as local variables, the same set the home and
     how-it-works pages use, so this page sits in the same design. */
  .ev {
    --fs-10: 10px;
    --fs-11: 11px;
    --fs-12: 12px;
    --fs-13: 13.5px;
    --fs-15: 15px;
    --fs-17: 17.5px;
    --fs-20: 21px;
    --fs-26: 27px;
    --fs-h1: clamp(38px, 4.8vw, 58px);
    --fs-h2: clamp(24px, 2.6vw, 32px);
    --sp-1: 4px;
    --sp-2: 8px;
    --sp-3: 12px;
    --sp-4: 16px;
    --sp-5: 24px;
    --sp-6: 32px;
    --sp-7: 48px;
    --sp-8: 72px;
    --tc: 0.13em;
    --tt: -0.02em;

    --raise: var(--color-surface-raised);
    --ink: var(--color-foreground);
    --muted: var(--color-muted);
    --faint: var(--gray-500);
    --line: var(--color-line);
    --line-strong: var(--color-foreground);
    --signal: var(--color-signal);
    --human: var(--font-family-sans);
    --machine: var(--font-family-mono);

    /* The site's one frame (global.css .shell), since 2026-09-20. */
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: clamp(16px, 2.5vw, 36px);
  }

  .hsec {
    border-bottom: 1px solid var(--line);
    padding: var(--sp-7) 0;
  }
  .hsec.hero {
    padding: var(--sp-8) 0 var(--sp-6);
  }
  .hsec:last-child {
    border-bottom: none;
  }

  .kicker {
    font-family: var(--machine);
    font-weight: 500;
    font-size: var(--fs-11);
    letter-spacing: var(--tc);
    text-transform: uppercase;
    color: var(--muted);
  }
  .h1 {
    margin: var(--sp-4) 0 0;
    font-weight: 700;
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: var(--tt);
    /* 28ch, up from the design's 22ch, since the frame widened to 86rem on
       2026-09-20: the same hero measure as the home page. */
    max-width: 28ch;
    text-wrap: pretty;
  }
  .h2 {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-h2);
    letter-spacing: var(--tt);
    line-height: 1.1;
  }
  .lede {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-17);
    line-height: 1.55;
    color: var(--ink);
    /* 68ch, up from the design's 58ch, for the same widened frame: the same
       lede measure as the home page. */
    max-width: 68ch;
    text-wrap: pretty;
  }
  .links {
    margin-top: var(--sp-5);
    display: flex;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }
  .link-line {
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    line-height: 1.7;
  }
  .link-line:hover {
    color: var(--ink);
  }

  /* ---- evidence posts ---- */
  .ev-sub {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-17);
    line-height: 1.55;
    color: var(--muted);
    max-width: 64ch;
    text-wrap: pretty;
  }
  .ev-featured {
    margin-top: var(--sp-5);
    max-width: 60rem;
  }

  .ev-absence {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-15);
    line-height: 1.6;
    color: var(--muted);
    max-width: 60ch;
  }
  .ev-absence-link {
    margin-left: 6px;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
  }
  .ev-absence-link:hover {
    color: var(--muted);
  }

  .ev-list {
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .ev-list-row {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr) auto;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--line);
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--muted);
  }
  .ev-li-rule {
    text-transform: uppercase;
    letter-spacing: var(--tc);
    color: var(--signal);
  }
  .ev-li-role {
    color: var(--ink);
  }
  .ev-li-date {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  /* The truncation note. Same machine face and muted ink as the rows it
     closes, so it reads as the last line of the list rather than as copy. */
  /* --- the show-more control ------------------------------------------
     A checkbox and a label, no script, the same mechanism the site header's
     mobile menu uses. The checkbox carries the state; the label is the text a
     reader clicks. Sibling (~) selectors only reach forward, which is why the
     input sits before the list in the markup. */
  .ev-more-toggle {
    /* Off screen, NOT display:none -- a hidden input is not focusable, and
       this is the only control. Keyboard users tab to it and press space. */
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }
  /* Closed: everything past the tenth row is out of the document's flow AND
     out of the accessibility tree. display:none rather than a height clamp,
     so a screen reader is not read ten rows the page is hiding. */
  .ev-list-row[data-beyond] {
    display: none;
  }
  .ev-more-toggle:checked ~ .ev-list .ev-list-row[data-beyond] {
    display: grid;
  }
  .ev-showmore {
    display: inline-block;
    margin: var(--sp-4) 0 0;
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--muted);
    cursor: pointer;
    border-bottom: 1px solid var(--line);
    padding-bottom: 2px;
  }
  .ev-showmore:hover {
    color: var(--ink);
    border-bottom-color: var(--ink);
  }
  /* The focus ring belongs on the label, because the input it belongs to is
     the thing off screen. Without this the control is invisible to a keyboard. */
  .ev-more-toggle:focus-visible ~ .ev-showmore {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }
  /* One label, two words: which one shows is the checkbox's business, the same
     way ThemeToggle prints "Dark" and "Light" from one control. */
  .ev-showmore-close,
  .ev-more-toggle:checked ~ .ev-showmore .ev-showmore-open {
    display: none;
  }
  .ev-more-toggle:checked ~ .ev-showmore .ev-showmore-close {
    display: inline;
  }

  .ev-truncated {
    margin: var(--sp-3) 0 0;
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--muted);
  }

  .ev-more {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-15);
  }
  .ev-more a {
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .ev-more a:hover {
    color: var(--muted);
    border-bottom-color: var(--muted);
  }

  @media (max-width: 820px) {
    .ev-list-row {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
    .ev-li-date {
      text-align: left;
    }
  }
</style>
