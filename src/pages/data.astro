---
import BaseLayout from '../layouts/BaseLayout.astro';
import Reading from '../components/Reading.astro';
import { loadStats, sweptStamp } from '../lib/data';
import { routeFor } from '../data/nav';
import { SITE } from '../data/site';
import { withBase } from '../../site.config.mjs';

/**
 * /data: what the dataset is, in the terms MONETIZATION.md item 2 asks for.
 *
 * method, coverage, history length, the kill rules link, the free monthly
 * analysis, and two calls to action that collect interest rather than money
 * (RUN-MASTER phase 8, RUN-FINISH phase 8: MONETIZATION items 1 to 4, no
 * checkout, no new backend).
 *
 * THE ONE RULE THAT SHAPED THIS PAGE. src/lib/data.ts types
 * Stats._meta.postings_observed for exactly this reason: the site's whole
 * scope claim rests on a reader never mistaking the postings a sweep READ for
 * the postings a sweep PULLED. Those are two populations (45 boards, several
 * thousand postings sitting on them, a few dozen that passed this product's
 * own title and location filters and therefore reached a verdict), and
 * MASTER-SPEC names the failure mode of blurring them the "123 vs 65
 * mistake": one population per page, stated. This page states both, by name,
 * every time either appears.
 *
 * NO NUMBER HERE IS TYPED. Every count reads loadStats() through <Reading>
 * (src/lib/readings.ts, the registered sweep metrics) or, for
 * postings_observed, which readings.ts does not register, a
 * data-truth="machine" span reading straight off Stats._meta, the same
 * marker /methodology and /not-here use for a per-record machine value gate 2
 * checks on its own terms rather than against a fixed metric list. See
 * test/gates/truth.mjs's own header for the two markers and the difference.
 *
 * NO SUBTRACTION HAPPENS ON SCREEN. /report's header states the same rule for
 * the same reason: a computed difference is a derived statistic nobody
 * published, and the two counts speak for themselves side by side without
 * one.
 *
 * NO FACT FROM src/data/facts.json APPEARS HERE. None of the eight statistics
 * in that file is licensed to /data (checked against the file directly), so
 * this page cites none of them rather than calling fact() against a route it
 * holds no license for. Every claim below is either a sweep reading or a
 * description of the product's own mechanism, not outside research.
 *
 * THE HISTORY SECTION IS THE HONEST PROBLEM ON THIS PAGE. src/data/README.md
 * states it as the data contract's own premise: "the site is a static build
 * of one nightly sweep". /report's header states the consequence for its own
 * content: "there is no trend on this page, because a trend is a shape made
 * of several readings and we hold one sweep." This page says the same thing
 * to a reader plainly, rather than letting a page that exists to describe the
 * dataset imply a depth the archive does not hold.
 */

const stats = loadStats();
const stamp = `Swept ${sweptStamp()}`;

// Typed and optional on Stats._meta (src/lib/data.ts), because _meta is the
// machine's own note rather than part of the data contract the counts above
// are. A sweep that omitted it renders the truthful absence below rather than
// a guess: standing rule 2, a number renders only when its provenance can be
// shown.
const postingsObserved: number | null = stats._meta?.postings_observed ?? null;

const methodologyHref = routeFor('methodology');
const killRulesHref = `${methodologyHref}#kills`;
const reportHref = routeFor('report');
const covenantHref = withBase('/covenant');

const reportMailHref = `mailto:${SITE.contact}?subject=${encodeURIComponent('The Index: annual report waitlist')}`;
const feedMailHref = `mailto:${SITE.contact}?subject=${encodeURIComponent('The Index: data feed inquiry')}`;
---

<BaseLayout
  active="data"
  title="The dataset"
  description="What the dataset behind The Index is: how it is read, what one sweep covers and what it does not yet cover, the published kill rules, the free monthly analysis, and how to reach the annual report or the data feed before either exists as a product."
>
  <div class="shell dataset">
    <header class="head">
      <p class="stamp mono-label" data-truth="machine">{stamp}</p>
      <h1 class="head-title">What the dataset is.</h1>
      <p class="lede">
        Every number on this site comes from the same two files this page reads. This is the plain description of
        what those files hold today, what they do not hold yet, and the two ways to reach more of this before either
        is a product you can buy.
      </p>
    </header>

    <section class="section" id="method">
      <h2 class="section-title">How it is built</h2>

      <p class="prose">
        The machine reads each company's own applicant tracking system directly, every night: the same feed a
        candidate would meet by going to that company's own careers page. Nothing here is bought from an aggregator
        and nothing is copied from a board that copied someone else. A posting earns a row by surviving a published
        set of rules; one that fails a rule is killed the same night, dated, and kept rather than deleted. That is
        the shape of the pipeline. The detail, feed by feed and rule by rule, is on the methodology page.
      </p>

      <p class="prose">
        <a class="inline-link" href={methodologyHref}>Read the method in full</a>, including
        <a class="inline-link" href={killRulesHref}>the published kill rules</a> a posting is judged against before
        it is ever counted below.
      </p>
    </section>

    <section class="section" id="coverage">
      <h2 class="section-title">What this sweep covers</h2>

      <p class="prose">
        A sweep reads two different sizes of thing, and keeping them apart is this page's whole job. One count is
        everything sitting on the boards the machine reads. A smaller count is the postings that passed this
        product's own title and location filters and therefore reached a verdict: verified live, or killed. Every
        other number on this site, the row count on the index, the kill list, the report, describes that second,
        smaller population. This page states both, by name, so neither is mistaken for the other.
      </p>

      <dl class="coverage">
        <div class="coverage-row">
          <dt class="coverage-term">Boards read direct</dt>
          <dd class="coverage-value"><Reading metric="boards" mono={false} class="num" /></dd>
        </div>
        <div class="coverage-row">
          <dt class="coverage-term">Postings sitting on those boards</dt>
          <dd class="coverage-value">
            {
              postingsObserved !== null ? (
                <span class="num" data-truth="machine">{postingsObserved}</span>
              ) : (
                'not recorded this sweep'
              )
            }
          </dd>
        </div>
        <div class="coverage-row">
          <dt class="coverage-term">Reached a verdict (passed the title and location filters)</dt>
          <dd class="coverage-value"><Reading metric="pulled" mono={false} class="num" /></dd>
        </div>
        <div class="coverage-row">
          <dt class="coverage-term">Verified live</dt>
          <dd class="coverage-value"><Reading metric="verified_live" mono={false} class="num" /></dd>
        </div>
        <div class="coverage-row">
          <dt class="coverage-term">Killed this sweep</dt>
          <dd class="coverage-value"><Reading metric="killed" mono={false} class="num" /></dd>
        </div>
      </dl>

      <p class="prose prose-quiet">
        The gap between the first two rows and the last three is not loss and it is not an error: it is everything
        on those same boards that this product's own filters set aside without a verdict, still sitting on the
        board it came from, never claimed as measured by anything on this site.
      </p>
    </section>

    <section class="section" id="history">
      <h2 class="section-title">What one sweep means</h2>

      <p class="prose">
        This build carries one sweep: the one stamped at the top of this page. The archive holds this sweep and
        nothing else. There is no trend line here, no week-over-week change, no repost history, because none of
        those is a real measurement from a single night's read; a trend is a shape made of several readings, and a
        page that implied one from one would be implying a depth the archive does not hold.
      </p>

      <p class="prose">
        The machine that produces these files runs nightly, and every sweep replaces them wholesale rather than
        appending to them. The history this page could eventually state honestly, how long a posting really lives
        end to end, how often a role gets reposted, how the count of boards read has grown, is built one file at a
        time starting now. It is not built yet. This section states a number the day it is.
      </p>
    </section>

    <section class="section" id="analysis">
      <h2 class="section-title">The free monthly analysis</h2>

      <p class="prose">
        <a class="inline-link" href={reportHref}>The report</a> publishes what a sweep finds, the same night the
        data is: the arrival window, how long postings live, what died and under which rule. It runs from the same
        two files this page does, so nothing in it is stated twice with two different numbers. One issue exists
        today because one sweep exists behind it; the cadence becomes monthly the day there is a month of sweeps to
        write one from.
      </p>
    </section>

    <section class="section" id="next">
      <h2 class="section-title">Two ways in, before either is a product</h2>

      <p class="prose">
        Neither of the two things below is built. Both collect interest, never money and never payment details:
        mail an address, nothing else.
      </p>

      <div class="asks">
        <div class="ask">
          <h3 class="ask-title">The annual report</h3>
          <p class="ask-body">
            A full year of what got posted, how long it lived, and what reposted, read from verified feeds rather
            than a survey. It does not exist yet, because the sweep does not have a year behind it.
          </p>
          <p class="ask-contact">
            Mail <a class="inline-link" href={reportMailHref}>{SITE.contact}</a> and you hear about it first, by
            hand, because there is nowhere yet to put an address that would do it automatically.
          </p>
        </div>

        <div class="ask">
          <h3 class="ask-title">The feed</h3>
          <p class="ask-body">
            A verified, lifecycle-checked feed of this dataset, for a product whose own users need postings that do
            not still list a role six months after it closed. No key, no endpoint, no format decided yet.
          </p>
          <p class="ask-contact">
            Mail <a class="inline-link" href={feedMailHref}>{SITE.contact}</a> and say what you would need from it.
            That is the input the format gets built from.
          </p>
        </div>
      </div>
    </section>

    <footer class="coda">
      <p class="coda-links">
        <a class="coda-link" href={covenantHref}>What we will never do with any of this</a>
        <span class="coda-sep" aria-hidden="true">&middot;</span>
        <a class="coda-link" href={methodologyHref}>How the machine works</a>
      </p>
    </footer>
  </div>
</BaseLayout>

<style>
  .dataset {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-700) var(--space-900);
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .stamp {
    color: var(--color-muted);
  }

  .head-title {
    max-width: 20ch;
  }

  .lede {
    font-size: var(--size-300);
    line-height: var(--leading-snug);
    max-width: var(--layout-measure);
    color: var(--color-muted);
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
    max-width: var(--layout-measure);
  }

  .section-title {
    border-top: var(--border-hairline) solid var(--color-line);
    padding-top: var(--space-400);
  }

  .prose {
    text-wrap: pretty;
  }

  .prose-quiet {
    color: var(--color-muted);
  }

  .inline-link {
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
  }

  .inline-link:hover {
    color: var(--color-muted);
  }

  .num {
    font-family: var(--font-family-mono);
    font-size: var(--font-scale-mono);
    font-synthesis: none;
    font-variant-numeric: tabular-nums;
    font-feature-settings: var(--feature-tabular);
  }

  /* The two-population table. A definition list rather than the four-up hero
     tiles StatTiles.astro draws elsewhere: this page's job is the sentence
     naming which population each row belongs to, not a headline figure, and a
     row-by-row list keeps every label beside its number rather than asking a
     caption underneath to do that work. */
  .coverage {
    display: grid;
    gap: var(--space-300);
    margin: 0;
    padding: var(--space-400) var(--space-500);
    border: var(--border-hairline) solid var(--color-line);
    background: var(--color-surface-raised);
  }

  .coverage-row {
    display: grid;
    grid-template-columns: 1fr max-content;
    align-items: baseline;
    gap: var(--space-400);
    border-bottom: var(--border-hairline) solid var(--color-line);
    padding-bottom: var(--space-300);
  }

  .coverage-row:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .coverage-term {
    font-size: var(--size-200);
    color: var(--color-muted);
  }

  .coverage-value {
    margin: 0;
    text-align: right;
    font-weight: var(--weight-medium);
  }

  .asks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-500);
  }

  .ask {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    border: var(--border-hairline) solid var(--color-line);
    padding: var(--space-400);
  }

  .ask-title {
    margin: 0;
  }

  .ask-body {
    margin: 0;
    font-size: var(--size-200);
    line-height: var(--leading-normal);
    color: var(--color-muted);
  }

  .ask-contact {
    margin: 0;
    font-size: var(--size-200);
    line-height: var(--leading-normal);
  }

  .coda {
    border-top: var(--border-hairline) solid var(--color-line);
    padding-top: var(--space-400);
  }

  .coda-links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-300);
    align-items: center;
  }

  .coda-link {
    font-size: var(--size-200);
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
  }

  .coda-link:hover {
    color: var(--color-muted);
  }

  .coda-sep {
    color: var(--color-muted);
  }

  @media (prefers-reduced-motion: no-preference) {
    .inline-link,
    .coda-link {
      transition: color var(--motion-duration-instant) var(--motion-easing-standard);
    }
  }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    .dataset {
      gap: var(--space-600);
      padding-block: var(--space-600) var(--space-800);
    }

    .coverage-row {
      grid-template-columns: 1fr;
      gap: var(--space-100);
    }

    .coverage-value {
      text-align: left;
    }

    .asks {
      grid-template-columns: 1fr;
    }
  }
</style>
