  }

  .detail-back::before {
    /* Decorative, and inside the link's own box so it never wraps away from the
       words it belongs to. */
    content: '\2190\00a0';
  }

  .detail-back:hover {
    color: var(--color-foreground);
  }

  .detail-stamp {
    font-size: var(--size-075);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0;
  }

  /* -----------------------------------------------------------------------
     The closed announcement
     ----------------------------------------------------------------------- */

  .closed-banner {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    padding: var(--space-600);
    background: var(--color-surface-raised);
    border-bottom: var(--border-hairline) solid var(--color-line);
  }

  .closed-stamp {
    display: flex;
    align-items: center;
    gap: var(--space-200);
    margin: 0;
    font-size: var(--size-075);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* The section-heading step rather than the page-title step. The canvas sets
     this at 30px and the house ramp's nearest step is 36px; the display step at
     76px would make a two-word announcement the loudest thing on the site. */
  .closed-title {
    font-size: var(--size-500);
    line-height: var(--leading-snug);
  }

  .closed-lede {
    max-width: var(--layout-measure);
    font-size: var(--size-200);
    line-height: var(--leading-normal);
  }

  /* -----------------------------------------------------------------------
     The two columns
     ----------------------------------------------------------------------- */

  .detail-grid {
    display: grid;
    /* 1.55 to 1 is the canvas ratio. The minmax(0, ...) on the reading column
       is what stops a long unbroken title from pushing the aside off the grid:
       a grid track's default minimum is auto, which is the content's own width.
    */
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
  }

  /* The reading column is a card, the same card the aside's panels are.
     It was not, and the two columns read as different kinds of thing: the aside
     put its content inside bordered Panels sitting in a gutter, while this side
     painted the raised surface onto the gutter itself and drew no card at all.
     Same page, two grammars.

     So the gutter is now just a gutter, matching .detail-aside exactly, and the
     content sits in a card whose border, surface and padding are Panel's. The
     padding is space-400 because that is Panel's body padding, and a reading
     column that padded itself differently from the panels beside it is the
     mismatch that made the page feel assembled from two designs. */
  .detail-main {
    display: flex;
    flex-direction: column;
    padding: var(--space-600);
    border-right: var(--border-hairline) solid var(--color-line);
    min-width: 0;
  }

  .detail-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-600);
    padding: var(--space-400);
    background: var(--color-surface-raised);
    border: var(--border-hairline) solid var(--color-line);
    min-width: 0;
  }

  .detail-aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-500);
    padding: var(--space-600);
    min-width: 0;
  }

  /* -----------------------------------------------------------------------
     The role header
     ----------------------------------------------------------------------- */

  .role {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
  }

  .role-meta {
    display: flex;
    align-items: center;
    gap: var(--space-200);
    flex-wrap: wrap;
    margin: 0;
    font-size: var(--size-075);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* The live status stamp is the one place on this page that carries the mark
     colour in text. It is a machine state, it sits beside its own mark, and the
     legend at the foot of the page names it. */
  .role-status-live {
    color: var(--color-mark-live);
    font-weight: var(--weight-medium);
  }

  /* The separator is quieter than the segments it separates, so the line reads
     as three facts rather than five. */
  .role-dot {
    color: var(--color-line-strong);
  }

  /* The section-heading step, not the page-title step. A job title runs to 48
     characters in this data and the display step would set four words to the
     line on a laptop. */
  .role-title {
    font-size: var(--size-500);
    line-height: var(--leading-snug);
    max-width: var(--layout-measure);
  }

  /* A closed role is a record rather than an offer, so its title recedes to the
     secondary tone. The announcement above it is what the page is about. */
  .role-title-closed {
    color: var(--color-muted);
    font-weight: var(--weight-medium);
  }

  .role-summary {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--space-100);
    margin: 0;
    color: var(--color-muted);
  }

  /* FitBadge's row size is tuned to be the first thing read in a table row. In
     a summary line it is one fact among four, so it comes down to the line it
     sits on. Reaching in by class rather than forking the component keeps gate
     2's data-truth marker exactly where the gate expects it. */
  /* The label and its numeral are one fact, so they never break across lines. */
  .role-fit-pair {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-100);
    white-space: nowrap;
