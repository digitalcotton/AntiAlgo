  }

  /* -----------------------------------------------------------------------
     The aside
     ----------------------------------------------------------------------- */

  .odds {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }

  .odds-age {
    font-size: var(--size-100);
    line-height: var(--leading-snug);
    color: var(--color-muted);
  }

  /* InsightStrip is drawn as a full-bleed band on the index, where it spans the
     table. In a column it has to be a box, so it takes a border on all four
     sides and the panel gutter instead of the band gutter. :global because the
     element belongs to that component; the copy, the licence check and the
     dismissal all stay its business. */
  .odds :global(.insight-strip) {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-200);
    padding: var(--space-300) var(--space-400);
    border: var(--border-hairline) solid var(--color-line);
  }

  .odds :global(.insight-text) {
    font-size: var(--size-100);
  }

  /* Each fact holds together; the line breaks between them. */
  .ease-part {
    white-space: nowrap;
  }

  .ease-summary {
    display: none;
    font-size: var(--size-075);
    letter-spacing: var(--tracking-wide);
