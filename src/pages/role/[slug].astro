    color: var(--color-muted);
  }

  .source-link {
    font-size: var(--size-100);
    color: var(--color-muted);
    text-align: center;
  }

  /* The apply panel itself carries no border or background of its own:
     every child below owns its own spacing, and .apply-panel is only ever
     a vertical stack of whichever of them is not `hidden` at the moment.

     NO :global() ANYWHERE BELOW, UNLIKE THE PANEL THIS REPLACED. The old
     Save/Track panel built its forms and buttons at runtime with
     document.createElement(), which never receive Astro's per-component
     scope attribute, so its rules had to reach them with :global(). Every
     element below (apply-primary-form, apply-tracked, save-form, and the
     rest) is real markup this template renders directly; the enhancement
     script only toggles a `hidden` attribute on elements that already
     carry this page's own scope, so a plain scoped selector reaches them
     exactly as it reaches anything else in this file. */
  .apply-panel {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }

  /* Respect the hidden attribute, the same reason .apply-tracked does below.
     This form ships `hidden` and is revealed only for a signed-in reader by the
     enhancement script; a bare `display: flex` overrode the UA
     `[hidden] { display: none }` (author beats UA at equal specificity), so the
     open-and-track form rendered a SECOND "Apply on ..." button beside
     ApplyAction's own, on every signed-out and no-JS page. */
  .apply-primary-form:not([hidden]) {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }

  /* Matches ApplyAction.astro's own .apply-action as closely as a
     separate scoped stylesheet can: same tokens, same box, so swapping
     which of the two is visible never shifts the layout around it.
     ApplyAction.astro is outside this task's touchable files, so this is
     a second, independent declaration of the same visual values, not a
     shared rule; see this block's own comment further up for why that
     duplication is the actual constraint here, not an oversight. */
  .apply-primary-button {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-200);
    width: 100%;
    padding: var(--space-300) var(--space-400);
    border: var(--border-heavy) solid var(--color-foreground);
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
    font-weight: var(--weight-bold);
    font-size: var(--size-200);
    font-family: var(--font-family-sans);
    text-align: center;
    cursor: pointer;
  }

  .apply-primary-button:hover {
    background: var(--color-surface-raised);
    color: var(--color-foreground);
  }

  .apply-caption {
    color: var(--color-muted);
    text-align: center;
    line-height: var(--leading-snug);
  }

  /* The quiet secondary, "Apply without drafting": a plain link-weight
     control, deliberately lighter than .apply-primary-button and
     .save-submit alike, so nothing here competes with the primary for
     attention. Hidden until the enhancement script's own drafting-status
     check reveals it (see that script's own comment); guarded the same
     way .apply-tracked below is, so the bare rule here never overrides
     the hidden attribute before the script has decided anything. */
  .apply-secondary-form:not([hidden]) {
    display: flex;
    justify-content: center;
  }

  .apply-secondary-button {
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    font-family: var(--font-family-sans);
    font-size: var(--size-100);
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
  }

  .apply-secondary-button:hover {
    color: var(--color-foreground);
  }

  /* Respect the hidden attribute. The box ships `hidden` and is only revealed
     by the enhancement script after a click; a bare `.apply-tracked { display:
     flex }` overrides the UA `[hidden] { display: none }` (author beats UA at
     equal specificity), so the "Tracking on your Desk" state showed before any
     click, implying a posting was tracked when it was not. `:not([hidden])`
     keeps the box out of the flow until the script clears the attribute. */
  .apply-tracked:not([hidden]) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-200);
    padding: var(--space-300) var(--space-400);
    border: var(--border-hairline) solid var(--color-line-strong);
    font-size: var(--size-150);
    text-align: center;
    color: var(--color-foreground);
  }

  .apply-tracked a {
    font-weight: var(--weight-medium);
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
  }

  .track-invite {
    text-align: center;
