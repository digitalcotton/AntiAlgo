    border-top: var(--border-hairline) solid var(--color-line);
    padding-top: var(--space-400);
  }

  .facts-title,
  .fit-title {
    color: var(--color-muted);
  }

  /* KeyValueList sets its values in upper case because every other place it is
     used states a machine reading: a friction band, a status, a source system.
     Here the values are the employer's own strings, and "as posted" is the
     heading over them, so the case is theirs. Everything else the component
     decides stays: mono for a value, sans for an absence, which is the split
     that lets a reader tell a measurement from a gap without reading it. */
  .facts :global(.kv-value) {
    text-transform: none;
    letter-spacing: var(--tracking-normal);
    font-size: var(--size-100);
    color: var(--color-foreground);
  }

  .fit {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
