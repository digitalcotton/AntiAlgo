---
/**
 * /ledger: the old address of Jobs Data (renamed 2026-09-19). A permanent
 * redirect to /jobs-data, query string kept, so every saved link and every
 * external mention still lands on the page. The POST endpoints under
 * /ledger/watch and /ledger/prefs are the page's action layer and stay where
 * they are, the same way the Opportunities tracker keeps its /desk endpoints.
 */
import { routeFor } from '../data/nav';

export const prerender = false;

const search = Astro.url.search;
return Astro.redirect(`${routeFor('jobs-data')}${search}`, 301);
---
