---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import { isPaidViewer } from '../lib/ledger-access';
import { buildLedgerData } from '../lib/ledger-market';
import { routeFor } from '../data/nav';
import { withBase } from '../../site.config.mjs';

/**
 * /ledger: The Ledger, the data-scientist market page (v4). A paid, behind-login
 * surface. The whole interactive app is a client island: this page resolves the
 * viewer, and for a paid reader builds the DATA object server-side from the real
 * sweep (src/lib/ledger-market.ts) and injects it as one JSON script tag; the
 * client runtime (public/scripts/ledger-v4-app.js) reads it, and the view bundle
 * (ledger-v4-views.js) renders and re-cuts every view live. A reader who is not
 * paid gets a preview and an upsell, and no member data is built or shipped.
 *
 * GATED IN THIS PAGE, NOT BY MIDDLEWARE, so a non-paid reader still gets the
 * preview instead of a redirect. See src/lib/ledger-access.ts.
 *
 * The JSON payload is scrubbed of en/em dashes and curly quotes (real titles and
 * locations carry them) and its `<` is escaped, so the injected script is gate-3
 * clean and cannot break out of its own tag.
 */
export const prerender = false;

const viewer = Astro.locals.viewer ?? null;
const paid = isPaidViewer(viewer);

let dataJson = '';
if (paid) {
  const raw = JSON.stringify(buildLedgerData());
  // Char classes built from codes so this source holds no dash/curly byte itself.
  const cc = String.fromCharCode;
  const cls = (a: number, b: number) => new RegExp('[' + cc(a, b) + ']', 'g');
  dataJson = raw
    .replace(cls(0x2013, 0x2014), '-')
    .replace(cls(0x2018, 0x2019), "'")
    .replace(cls(0x201c, 0x201d), '"')
    .replace(/</g, '\\u003c');
}

const cssHref = withBase('/scripts/ledger-v4.css');
const appJs = withBase('/scripts/ledger-v4-app.js');
const viewsJs = withBase('/scripts/ledger-v4-views.js');
const accountHref = routeFor('account');
const signUpHref = routeFor('sign-up');
const boardHref = routeFor('board');
---

<BaseLayout title="The Ledger" description="Read the design job market like a data scientist: what pays, what is fresh, who recycles, and where roles are about to open, counted from last night's sweep.">
  <link rel="stylesheet" href={cssHref} />

  {paid ? (
    <>
      <div id="ledger-app" data-ledger-mount>
        <noscript>
          <div style="max-width:60ch;margin:48px auto;padding:0 24px;font-size:0.95rem;line-height:1.6;color:var(--color-muted);">
            The Ledger reads and re-cuts the market live in your browser, so it needs JavaScript on.
            The same numbers, uncut, are on the board and the drop.
          </div>
        </noscript>
      </div>
      <script id="ledger-data" type="application/json" is:inline set:html={dataJson}></script>
      <script src={appJs} is:inline defer></script>
      <script src={viewsJs} is:inline defer></script>
    </>
  ) : (
    <main class="shell ledger-preview">
      <header class="lp-head">
        <p class="lp-eyebrow mono-label">Tonight's read</p>
        <h1 class="lp-title">Read the design market like a data scientist.</h1>
        <p class="lp-lede">
          Every night the sweep reads company careers pages directly, verifies what is still there,
          and publishes what came down by rule. The Ledger is the structure underneath that: what
          pays, what is fresh, who recycles, and where roles are about to open. It re-cuts to the
          titles you watch. It is part of the paid account.
        </p>
      </header>
      <Panel title="What the account opens">
        <ul class="lp-list">
          <li>Every view re-cuts to the titles you watch, from pay ladders to the kill archive.</li>
          <li>The issuer table: every company as an issuer, with its record attached.</li>
          <li>Where roles are about to open, scored before they post.</li>
        </ul>
        <p class="lp-cta">
          {viewer
            ? (<a class="lp-button" href={accountHref}>See your account</a>)
            : (<a class="lp-button" href={signUpHref}>Save my spot</a>)}
          <a class="lp-link" href={boardHref}>Browse the free board</a>
        </p>
      </Panel>
    </main>
  )}
</BaseLayout>

<style>
  .ledger-preview {
    padding-block: var(--space-700, 2.5rem) var(--space-800, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-600, 2rem);
  }
  .lp-head { display: flex; flex-direction: column; gap: var(--space-200, 0.5rem); }
  .lp-eyebrow { margin: 0; color: var(--color-muted); }
  .lp-title { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; max-width: 24ch; }
  .lp-lede { margin: 0; color: var(--color-muted); max-width: 62ch; line-height: 1.55; }
  .lp-list { margin: 0; padding-left: 1.1rem; color: var(--color-muted); display: flex; flex-direction: column; gap: var(--space-100, 0.25rem); }
  .lp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-400, 1rem); margin: var(--space-400, 1rem) 0 0; }
  .lp-button {
    display: inline-block; padding: 0.6rem 1rem; border-radius: var(--radius, 2px);
    background: var(--color-surface-inverse); color: var(--color-foreground-inverse);
    font-family: var(--font-family-mono, monospace); font-size: var(--size-100, 0.85rem);
    text-decoration: none; white-space: nowrap;
  }
  .lp-link {
    color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--color-line-strong); font-size: var(--size-100, 0.85rem);
  }
</style>
