---
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../components/Board.astro';
import BoardTabs from '../components/BoardTabs.astro';
import { ageHistogramFromJobs, facetGroupsFromCounts, prospectRows } from '../lib/data';
import { isOn } from '../lib/flags';
import { boardHref, clampPage, parseBoardQuery } from '../lib/board-query';
import { listProspectsFiltered, type ProspectPage } from '../lib/prospect-board';
import { routeFor } from '../data/nav';
import { withBase } from '../../site.config.mjs';

/**
 * /prelist: the Pre-List, the "Newly funded" tab.
 *
 * ONE BOARD, TWO TABS. The member view renders through the very same
 * src/components/Board.astro the index does: the same tabs, strip, tiles,
 * filters, sort, insight, age plot, table and paging. The only difference is the
 * population, companies scored before they post a role rather than postings.
 * Both are Jobs, so the one component renders them without knowing which tab it
 * is on.
 *
 * GATED, WITH A REAL SHOP WINDOW. A signed-out or unverified reader sees what the
 * Pre-List is and the count on it, not the rows, the same wall /desk uses.
 * Astro.locals.verdict is set by middleware (src/lib/entitlement.ts) before this
 * runs. prerender = false because the wall is decided per request.
 *
 * ONE PAGE PER REQUEST (since 2026-09-19), for the same reason the board holds
 * one: this page used to hand Board.astro every prospect and let client mode
 * render all of them into the document, hiding the ones past the first page.
 * Measured, that was a 6.3 MB document of 25,623 elements, which crashed phones
 * and stalled desktops. The address now carries the page, the rows per page, the
 * search, the facets and the sort (src/lib/board-query.ts, the board's own
 * contract); src/lib/prospect-board.ts filters, counts, sorts and slices the
 * static list the way the job store does it in SQL for /board; and this page
 * never holds more than one page of rows. A page past the end answers with a
 * redirect to the last page, so the address a reader lands on names a page that
 * exists. The wall branch does none of this work.
 */
export const prerender = false;

const verdict = Astro.locals.verdict;
const allowed = verdict?.allow === true;
const reason = verdict?.reason ?? 'signed-out';

const prelistPaidLive = isOn('prelist_paid');

// The whole population, for the tab count and the wall's number. Never the page:
// "386 companies are on it" is a fact about the list, not about what is on screen.
const allProspects = prospectRows();
const prospectCount = allProspects.length;

const boardPath = routeFor('prelist');
const query = parseBoardQuery(Astro.url.searchParams);

// Only a reader past the wall gets a page computed; the walled branch renders no
// rows, so filtering and slicing for it would be work nobody sees.
let served: ProspectPage | null = null;
let paged = { page: query.page, pages: 1 };
if (allowed) {
  served = listProspectsFiltered(allProspects, query);
  paged = clampPage(query.page, served.total, query.per);
  if (paged.page !== query.page) {
    return Astro.redirect(boardHref(boardPath, query, { page: paged.page }), 302);
  }
}
const groups = served
  ? facetGroupsFromCounts(served.counts, {
      location: query.location,
      comp: query.comp,
      freshness: query.freshness
    })
  : [];
---

<BaseLayout
  title="Pre-List"
  active="prelist"
  description="Companies we have not seen post a role yet, scored by the same rubric as the board, tracked before anything is posted."
  noindex={allowed}
>
  <div class="shell prelist" data-prelist-paid-live={prelistPaidLive}>
    <header class="prelist-head">
      <h1 class="index-title">Companies before they post a role.</h1>
      <p class="index-lede">
        The same nightly pass that verifies every posting on the board also scores companies that have not posted a
        role yet: funded, in scope, and read by the same five weights. Nothing here is a job. Every row states the
        observation that put a company on this list, and no role name is ever written onto a row that has no posting.
      </p>
    </header>

    {
      allowed && served ? (
        <Board
          jobs={served.rows}
          mode="server"
          page={{ total: served.total, page: paged.page, pages: paged.pages, per: query.per }}
          query={query}
          groups={groups}
          ageHistogram={ageHistogramFromJobs(allProspects)}
          boardPath={boardPath}
          active="prelist"
          prospectCount={prospectCount}
          tiles={false}
          ariaLabel="Newly funded"
        />
      ) : (
        <section class="board" aria-label="Newly funded">
          <div class="board-head">
            <div class="board-tabs-row">
              <BoardTabs active="prelist" prospectCount={prospectCount} />
            </div>
          </div>
          <div class="prelist-wall">
            <h2 class="wall-title">What the Pre-List is</h2>
            <ol class="capabilities">
              <li class="capability">
                <h3 class="capability-title">Scored before a role exists</h3>
                <p class="capability-body">
                  Every company here is scored by the same rubric that scores a live posting: title and scope, remote
                  and location, published pay, freshness, and apply friction. There is no posting to read a title or a
                  pay range from, so those read the neutral case, and freshness reads a different clock: how recently
                  the company was funded, against a 12 month horizon.
                </p>
              </li>
              <li class="capability">
                <h3 class="capability-title">Every score shows its basis</h3>
                <p class="capability-body">
                  Each of the five components carries the sentence that produced it: which clock fired, what the team
                  size and open-role count said about scope, what the location field stated. Nothing is inferred
                  silently.
                </p>
              </li>
              <li class="capability">
                <h3 class="capability-title">Follow one, and it stays on your list</h3>
                <p class="capability-body">
                  An account lets you follow a company here, the same way a saved job works on the Desk. Signing in is
                  what this page asks for today, not a purchase.
                </p>
              </li>
            </ol>
            {reason === 'email-unverified' ? (
              <>
                <p class="wall-note">Confirm your email and this page opens.</p>
                <div class="wall-links">
                  <a class="text-link" href={withBase('/verify-email')}>Resend the link</a>
                </div>
              </>
            ) : (
              <>
                <p class="wall-note">
                  Sign in to see the list itself. The rows are walled; the fact that {prospectCount} companies are on
                  it is not, and the board says so too.
                </p>
                <div class="wall-links">
                  <a class="text-link" href={withBase('/sign-in')}>Sign in</a>
                  <a class="text-link" href={withBase('/sign-up')}>No account yet? Create one.</a>
                </div>
              </>
            )}
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .prelist {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-700) var(--space-800);
    /* The same frame as the board (board.astro .index): wider than the default
       75rem shell with tighter side padding, so the two tabs share one width. */
    max-width: 86rem;
    padding-inline: clamp(16px, 2.5vw, 36px);
  }

  .prelist-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .index-title {
    max-width: 24ch;
  }

  .index-lede {
    font-size: var(--size-300);
    max-width: var(--layout-measure);
    color: var(--color-muted);
  }

  /* The wall's own card, only for the signed-out branch. The member branch draws
     its whole card in Board.astro. */
  .board {
    display: flex;
    flex-direction: column;
  }

  .board-head {
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-line-strong);
    border-bottom: none;
  }

  .board-tabs-row {
    padding: var(--space-300) var(--space-600);
    background: var(--color-surface-raised);
    border-bottom: var(--border-hairline) solid var(--color-line);
  }

  .prelist-wall {
    display: flex;
    flex-direction: column;
    gap: var(--space-500);
    padding: var(--space-500) var(--space-600) var(--space-600);
    background: var(--color-surface);
    border: var(--border-hairline) solid var(--color-line-strong);
    border-top: none;
  }

  .wall-title {
    font-size: var(--size-300);
  }

  .capabilities {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .capability {
    display: flex;
    flex-direction: column;
    gap: var(--space-100);
    padding-block-start: var(--space-400);
    border-top: var(--border-hairline) solid var(--color-line);
  }

  .capability:first-child {
    border-top: none;
    padding-block-start: 0;
  }

  .capability-title {
    font-size: var(--size-200);
  }

  .capability-body {
    font-size: var(--size-150);
    line-height: var(--leading-normal);
    color: var(--color-muted);
    max-width: var(--layout-measure);
  }

  .wall-note {
    font-size: var(--size-150);
    color: var(--color-muted);
    max-width: var(--layout-measure);
  }

  .wall-links {
    display: flex;
    gap: var(--space-400);
    flex-wrap: wrap;
  }

  .text-link {
    font-size: var(--size-150);
    font-weight: var(--weight-medium);
    text-decoration: underline;
    text-underline-offset: var(--text-underline-offset);
  }

  .text-link:hover {
    color: var(--color-muted);
  }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    .prelist {
      gap: var(--space-600);
    }
  }
</style>
