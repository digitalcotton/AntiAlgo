---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import EmptyState from '../components/EmptyState.astro';
import SweepPanel from '../components/desk-home/SweepPanel.astro';
import WatchList from '../components/desk-home/WatchList.astro';
import RoleCard from '../components/desk-home/RoleCard.astro';
import DiedList from '../components/desk-home/DiedList.astro';
import PreviewRoles from '../components/desk-home/PreviewRoles.astro';
import CompactTracker from '../components/come-ready/CompactTracker.astro';
import '../components/come-ready/come-ready.css';
import { loadComeReady, type ComeReadyView } from '../lib/come-ready-store';
import { isOn } from '../lib/flags';
import { isPaidViewer } from '../lib/ledger-access';
import { isConfigured } from '../lib/db';
import { buildDeskHome, type DeskHomeData } from '../lib/desk-home';
import { touchLastSeen } from '../lib/ledger-prefs-store';
import { routeFor } from '../data/nav';
import { formatDate } from '../lib/data';

/**
 * /desk: The Desk, the titles-driven member home (2026-09-18, pixel-perfect pass
 * 2026-09-18). The member names the titles they want; the board learns every
 * alias those titles go by and narrows the whole sweep to the handful that are
 * theirs. This page is the nightly read of that: an executive summary and a real
 * sweep panel, the titles with live and alias counts, the roles new under them
 * since the reader last looked (with the arrival-curve HEAD START bar and fit),
 * and the ones that died on their list.
 *
 * GATED AT 'member' BY MIDDLEWARE (entitlement.ts '/desk'): signed-out is sent to
 * sign-in, a member reaches the page, and the PAID content gates in-page with
 * isPaidViewer (a non-paid member sees the upsell; no member data is built).
 *
 * REAL DATA ONLY. Every number is measured or a cited estimate: counts from the
 * sweep and the member's lane; the HEAD START bar from each role's age; the
 * "ahead of X%" line from the NBER arrival model. Nothing is invented: the ease
 * chip is the real ATS ("via Greenhouse"), the sweep panel carries real counts
 * with no fabricated per-second clock, and there is no Stretch requirement list
 * because measured fit components do not exist. The two role actions are real:
 * "Draft Resumé and Cover" (POST /desk/job-draft, resolves the crawl slug) and
 * "Track Opportunities" (POST /desk/application click intent). The watch list this
 * page edits is the same one that narrows /board.
 *
 * THE 'NEW SINCE' CLOCK. buildDeskHome reads last_seen_at to decide what is new;
 * this page advances it with touchLastSeen AFTER the build.
 */
export const prerender = false;

const viewer = Astro.locals.viewer ?? null;
const paid = isPaidViewer(viewer);

/* A non-paid member names titles too (Come ready's free flow ends there), so
   the home is built for any signed-in member now: the paid page below reads
   all of it, and the preview reads the first few core roles to show what the
   titles already found (owner, 2026-09-20). The clock is NOT advanced for a
   preview, only for the real page, so a look here does not mark roles seen. */
let data: DeskHomeData | null = null;
if (viewer && isConfigured()) {
  // Retry once. The home reads the whole live board in one pass, and a cold
  // serverless function can hit a transient connection error on the first try
  // that a second attempt clears; without the retry that blip falls through to
  // the "warming up" state, which reads as a page error. touchLastSeen is
  // separated so its own failure never discards a good build.
  for (let attempt = 0; attempt < 2 && data === null; attempt++) {
    try {
      data = await buildDeskHome(viewer.userId);
    } catch (error) {
      console.error(`desk: build attempt ${attempt + 1} failed.`, error);
    }
  }
  if (data && paid) {
    try {
      await touchLastSeen(viewer.userId);
    } catch (error) {
      console.error('desk: touchLastSeen failed (build kept).', error);
    }
  }
}

// Come ready's compact tracker (owner's design, frame 8): one row above the
// Desk until the first run is complete, then gone for good. Built beside the
// Desk's own data so the sweep is read once; a failure here hides the row
// and never takes the Desk with it.
let comeReady: ComeReadyView | null = null;
if (paid && viewer && data && isOn('onboarding')) {
  try {
    comeReady = await loadComeReady(viewer, null, { home: data });
  } catch (error) {
    console.error('desk: come-ready tracker failed (Desk kept).', error);
  }
}
const showTracker = comeReady !== null && !comeReady.model.complete;

const watchAction = routeFor('ledger-watch');
const prefsAction = routeFor('ledger-prefs');
const boardHref = routeFor('board');
const accountHref = routeFor('account');

const home = data;
/* The preview's five (owner, 2026-09-20): the same fit-ranked core lane the
   paid page opens with, cut to five. Real rows or none: with no titles named
   there is no lane of the reader's own, and the board's freshest five would
   be a list nobody asked for, so the panel below stands on its own instead. */
const PREVIEW_SHOW = 5;
const previewRoles = !paid && home?.hasTitles ? home.core.slice(0, PREVIEW_SHOW) : [];
const titleOptions = (data?.titleIndex ?? []).slice(0, 200);
const titleCount = home ? home.coreTitles.length + home.stretchTitles.length : 0;
const n = (v: number | null) => (typeof v === 'number' ? v.toLocaleString() : 'not counted');
---

<BaseLayout
  title="The Desk"
  active="desk"
  description="The Desk: name the titles you want and the board narrows to them. A nightly read of what is new and what died under the titles you watch, counted from last night's sweep."
  noindex
>
  {paid ? (
    <div class="shell desk-home">
      {home ? (
        <>
          {showTracker && comeReady && <CompactTracker model={comeReady.model} />}
          <header class="dh-daily">
            <p class="dh-eyebrow mono-label"><span class="dh-tick" aria-hidden="true"></span> Daily</p>
            <div class="dh-daily-right">
              <p class="dh-swept mono-label">{home.sweep.sweptAt ? `swept ${formatDate(home.sweep.sweptAt)}` : 'sweep pending'}</p>
            </div>
          </header>

          <section class="dh-summary">
            <div class="dh-summary-text">
              {home.hasTitles ? (
                <p class="dh-lede">
                  Last night the sweep read <span class="num">{n(home.sweep.postingsObserved)}</span> postings at
                  companies' own careers pages. <span class="num num-accent">{home.newCoreCount}</span> new roles came
                  through under your core titles, <span class="num">{home.newStretchCount}</span> under stretch, and
                  <span class="num">{home.diedCount}</span> came down by rule. <span class="num">{home.liveUnderTitles.toLocaleString()}</span>
                  {' '}are live right now under the {titleCount} titles you named.
                </p>
              ) : (
                <p class="dh-lede">
                  Last night the sweep read <span class="num">{n(home.sweep.postingsObserved)}</span> postings at
                  companies' own careers pages. Name the titles you want below, and this becomes your executive
                  summary: what is new under them, what pays, and what died.
                </p>
              )}
              <p class="dh-note">At anti algo you are the executive, so this is your executive summary. Every number in it carries the night it was read.</p>
            </div>
            <SweepPanel
              boardsSwept={home.sweep.boardsSwept}
              verifiedLive={home.sweep.verifiedLive}
              liveUnderTitles={home.liveUnderTitles}
              newCoreCount={home.newCoreCount}
              diedCount={home.diedCount}
              sweptAt={home.sweep.sweptAt}
              stages={home.sweep.stages}
            />
          </section>

          <WatchList
            coreTitles={home.coreTitles}
            stretchTitles={home.stretchTitles}
            uncovered={home.uncovered}
            prefs={home.prefs}
            titleOptions={titleOptions}
            watchAction={watchAction}
            prefsAction={prefsAction}
          />

          {home.hasTitles && (
            <>
              <section class="dh-lane" id="core" aria-labelledby="nc-h">
                <p class="dh-lane-index mono-label"><span>02</span> In core</p>
                <h2 id="nc-h" class="dh-lane-title">{home.coreLiveCount} {home.coreLiveCount === 1 ? 'role' : 'roles'} live under your core titles, seen in the last 14 days.</h2>
                <p class="dh-lane-note">Ranked by fit, each verified live at the company's own careers page. {home.newCoreCount > 0 ? `${home.newCoreCount} new since your last visit, tagged below.` : 'None new since your last visit.'} The clock is where the role sits on the arrival curve, not a countdown.</p>
                {home.core.length > 0 ? (
                  <>
                    <ol class="dh-cards">{home.core.map((r, i) => <RoleCard role={r} rank={i + 1} />)}</ol>
                    {home.coreLiveCount > home.core.length && (
                      <p class="dh-lane-more"><a href={boardHref}>See all {home.coreLiveCount} on the board</a>, narrowed to your titles.</p>
                    )}
                  </>
                ) : (
                  <div class="dh-slot" role="status">
                    <p class="dh-slot-line mono-label">{home.coreTitles.length === 0 ? 'Name a core title above and its live roles land here.' : 'No role under your core titles in the last 14 days.'}</p>
                  </div>
                )}
                {/* The two readings the clock rests on (design: the two-column
                    block under the core rows), copy verbatim from the design. */}
                <div class="dh-evidence">
                  <div>
                    <p class="dh-evidence-fact mono">45% of applications arrive within 48 hours of a posting going up, and 60% within 96 hours</p>
                    <p class="dh-evidence-source mono">NBER WP 32320, 125M applications</p>
                    <p class="dh-evidence-note">That curve is what the clock draws. The marker is the role's own published date against it.</p>
                  </div>
                  <div>
                    <p class="dh-evidence-fact mono">Median time to first fill runs 71 days for senior roles and 75 for technical</p>
                    <p class="dh-evidence-source mono">Ashby Talent Trends 2026, 54M apps</p>
                    <p class="dh-evidence-note">So a role past the curve is not a dead role. The clock reads your head start, never the posting's health.</p>
                  </div>
                </div>
              </section>

              <section class="dh-lane" id="stretch" aria-labelledby="ns-h">
                <p class="dh-lane-index mono-label"><span>03</span> In stretch</p>
                <h2 id="ns-h" class="dh-lane-title">{home.stretchLiveCount} {home.stretchLiveCount === 1 ? 'role' : 'roles'} you are working toward, seen in the last 14 days.</h2>
                <p class="dh-lane-note">A reach is a reach because the fit is lower, not because we scored your resumé against the posting line by line: we do not measure that yet, so we do not claim it.</p>
                {home.stretch.length > 0 ? (
                  <>
                    <ol class="dh-cards">{home.stretch.map((r, i) => <RoleCard role={r} rank={i + 1} />)}</ol>
                    {home.stretchLiveCount > home.stretch.length && (
                      <p class="dh-lane-more"><a href={boardHref}>See all {home.stretchLiveCount} on the board</a>, narrowed to your titles.</p>
                    )}
                  </>
                ) : (
                  <div class="dh-slot" role="status">
                    <p class="dh-slot-line mono-label">{home.stretchTitles.length === 0 ? 'No stretch titles yet. Add one above to track roles you are working toward.' : 'No role under your stretch titles in the last 14 days.'}</p>
                  </div>
                )}
              </section>

              <DiedList died={home.died} />
            </>
          )}

        </>
      ) : (
        <EmptyState
          title="The Desk is warming up"
          detail="We could not read the sweep just now. Reload in a moment; nothing you have saved is lost."
        />
      )}
    </div>
  ) : (
    <main class="shell desk-preview">
      <header class="dp-head">
        <p class="dp-eyebrow mono-label">The Desk</p>
        <h1 class="dp-title">Name the titles you want. See only those.</h1>
        <p class="dp-lede">
          The board reads company careers pages directly every night. The Desk is where you name the
          titles you are after; it learns what they are called everywhere else and narrows the whole
          sweep down to the handful that are yours, on the board and here. It is part of the paid account.
        </p>
      </header>
      {/* What the titles already found, above the panel that sells the rest. */}
      {previewRoles.length > 0 && home && (
        <PreviewRoles roles={previewRoles} coreLiveCount={home.coreLiveCount} sweptAt={home.sweep.sweptAt} boardHref={boardHref} />
      )}

      <Panel title="What the account opens">
        <ul class="dp-list">
          <li>Name your titles once; the board narrows to them everywhere.</li>
          <li>The live roles under your titles, ranked by fit, new arrivals tagged.</li>
          <li>What died on your list, so you do not chase a role that is already gone.</li>
        </ul>
        <p class="dp-cta">
          <a class="dp-button" href={accountHref}>Your account</a>
          <a class="dp-link" href={boardHref}>Browse the board</a>
        </p>
      </Panel>
    </main>
  )}
</BaseLayout>

<style>
  .desk-home {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-600) var(--space-800);
  }

  /* DAILY header row + swept stamp + in-page anchors. */
  .dh-daily { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-400); flex-wrap: wrap; padding-bottom: var(--space-400); border-bottom: var(--border-hairline) solid var(--color-line); }
  .dh-eyebrow { margin: 0; color: var(--color-muted); display: inline-flex; align-items: center; gap: var(--space-200); }
  .dh-tick { width: 8px; height: 8px; background: var(--color-stat-loss); display: inline-block; }
  .dh-daily-right { display: flex; align-items: baseline; gap: var(--space-500); flex-wrap: wrap; }
  .dh-anchors { display: inline-flex; gap: var(--space-400); }
  .dh-anchors a { color: var(--color-muted); text-decoration: none; }
  .dh-anchors a:hover { color: var(--color-foreground); }
  .dh-swept { color: var(--color-muted); }

  /* Executive summary + sweep panel, two columns. */
  .dh-summary { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-700); align-items: start; }
  .dh-summary-text { display: flex; flex-direction: column; gap: var(--space-400); }
  .dh-lede { margin: 0; font-family: var(--font-family-sans); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.28; letter-spacing: -0.015em; }
  .num { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-line-strong); font-weight: var(--weight-bold); }
  .num-accent { color: var(--color-stat-loss); text-decoration-color: var(--color-stat-loss); }
  .dh-note { margin: 0; color: var(--color-muted); font-size: 0.95rem; line-height: 1.55; max-width: 60ch; }

  .dh-lane { display: flex; flex-direction: column; gap: var(--space-300); border-top: var(--border-hairline) solid var(--color-line); padding-top: var(--space-600); }
  .dh-lane-index { margin: 0; color: var(--color-muted); }
  .dh-lane-index span { margin-right: var(--space-200); }
  .dh-lane-title { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .dh-lane-note { margin: 0 0 var(--space-300); color: var(--color-muted); font-size: var(--size-100); max-width: 68ch; }
  /* The role list is one white panel above the paper, per the canvas: a raised
     surface with the heavy panel border. The cards inside are separated by
     hairlines (set on .rc), not each their own box. */
  .dh-cards { list-style: none; margin: 0; padding: 0; background: var(--color-surface-raised); border: var(--border-hairline) solid var(--color-line-strong); }
  .dh-evidence { margin-top: 18px; display: grid; grid-template-columns: 1fr 1fr; gap: 16px 40px; }
  .dh-evidence-fact { margin: 0; font-size: 0.8rem; line-height: 1.55; }
  /* Muted, not the rule colour the design used: the source line is text and
     has to clear AA contrast on paper and on ink. */
  .dh-evidence-source { margin: 6px 0 0; font-size: 0.68rem; color: var(--color-muted); }
  .dh-evidence-note { margin: 6px 0 0; font-size: 0.88rem; line-height: 1.55; color: var(--color-muted); }
  @media (max-width: 44rem) { .dh-evidence { grid-template-columns: 1fr; } }
  /* An empty lane is the site's hatched slot (the same drawing as the job
     detail's withheld description and draft slot): an absence, never a fake row. */
  .dh-slot {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-1000);
    padding: var(--space-400);
    border: var(--border-hairline) solid var(--color-line);
    background: repeating-linear-gradient(
      45deg,
      var(--color-hatch-a),
      var(--color-hatch-a) var(--space-200),
      var(--color-hatch-b) var(--space-200),
      var(--color-hatch-b) var(--space-400)
    );
  }
  .dh-slot-line { margin: 0; max-width: var(--layout-measure); text-align: center; text-transform: none; letter-spacing: var(--tracking-wide); line-height: var(--leading-snug); color: var(--color-muted); }


  .dh-lane-more { margin: var(--space-300) 0 0; color: var(--color-muted); font-size: var(--size-100); }
  .dh-lane-more a { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-stat-loss); }

  @media (max-width: 52rem) {
    .dh-summary { grid-template-columns: 1fr; gap: var(--space-500); }
  }

  /* The preview / upsell for a signed-in member who has not paid. */
  .desk-preview { padding-block: var(--space-700) var(--space-800); display: flex; flex-direction: column; gap: var(--space-600); }
  .dp-head { display: flex; flex-direction: column; gap: var(--space-200); }
  .dp-eyebrow { margin: 0; color: var(--color-muted); }
  .dp-title { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; max-width: 22ch; }
  .dp-lede { margin: 0; color: var(--color-muted); max-width: 62ch; line-height: 1.55; }
  .dp-list { margin: 0; padding-left: 1.1rem; color: var(--color-muted); display: flex; flex-direction: column; gap: var(--space-100); }
  .dp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-400); margin: var(--space-400) 0 0; }
  .dp-button { display: inline-block; padding: 0.6rem 1rem; border-radius: var(--radius); background: var(--color-surface-inverse); color: var(--color-foreground-inverse); font-family: var(--font-family-mono); font-size: var(--size-100); text-decoration: none; white-space: nowrap; }
  .dp-link { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-line-strong); font-size: var(--size-100); }

</style>
