---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import EmptyState from '../components/EmptyState.astro';
import SweepPanel from '../components/desk-home/SweepPanel.astro';
import WatchList from '../components/desk-home/WatchList.astro';
import RoleCard from '../components/desk-home/RoleCard.astro';
import { isPaidViewer } from '../lib/ledger-access';
import { isConfigured } from '../lib/db';
import { buildDeskHome, type DeskHomeData } from '../lib/desk-home';
import { touchLastSeen } from '../lib/ledger-prefs-store';
import { routeFor } from '../data/nav';
import { formatDate } from '../lib/data';

/**
 * /desk: The Desk, the titles-driven member home (2026-09-18, pixel-perfect pass
 * 2026-09-18). The member names the titles they want; the board learns every
 * alias those titles go by and narrows the whole sweep to the handful that are
 * theirs. This page is the nightly read of that: an executive summary and a real
 * sweep panel, the titles with live and alias counts, the roles new under them
 * since the reader last looked (with the arrival-curve HEAD START bar and fit),
 * and the ones that died on their list.
 *
 * GATED AT 'member' BY MIDDLEWARE (entitlement.ts '/desk'): signed-out is sent to
 * sign-in, a member reaches the page, and the PAID content gates in-page with
 * isPaidViewer (a non-paid member sees the upsell; no member data is built).
 *
 * REAL DATA ONLY. Every number is measured or a cited estimate: counts from the
 * sweep and the member's lane; the HEAD START bar from each role's age; the
 * "ahead of X%" line from the NBER arrival model. Nothing is invented: the ease
 * chip is the real ATS ("via Greenhouse"), the sweep panel carries real counts
 * with no fabricated per-second clock, and there is no Stretch requirement list
 * because measured fit components do not exist. The two role actions are real:
 * "Draft this on your key" (POST /desk/job-draft, resolves the crawl slug) and
 * "Track on the Desk" (POST /desk/application click intent). The watch list this
 * page edits is the same one that narrows /board.
 *
 * THE 'NEW SINCE' CLOCK. buildDeskHome reads last_seen_at to decide what is new;
 * this page advances it with touchLastSeen AFTER the build.
 */
export const prerender = false;

const viewer = Astro.locals.viewer ?? null;
const paid = isPaidViewer(viewer);

let data: DeskHomeData | null = null;
if (paid && viewer && isConfigured()) {
  try {
    data = await buildDeskHome(viewer.userId);
    await touchLastSeen(viewer.userId);
  } catch (error) {
    console.error('desk: could not build the home; rendering the empty state.', error);
  }
}

const watchAction = routeFor('ledger-watch');
const prefsAction = routeFor('ledger-prefs');
const boardHref = routeFor('board');
const accountHref = routeFor('account');

const home = data;
const titleOptions = (data?.titleIndex ?? []).slice(0, 200);
const titleCount = home ? home.coreTitles.length + home.stretchTitles.length : 0;
const n = (v: number | null) => (typeof v === 'number' ? v.toLocaleString() : 'not counted');
---

<BaseLayout
  title="The Desk"
  active="desk"
  description="The Desk: name the titles you want and the board narrows to them. A nightly read of what is new and what died under the titles you watch, counted from last night's sweep."
  noindex
>
  {paid ? (
    <div class="shell desk-home">
      {home ? (
        <>
          <header class="dh-daily">
            <p class="dh-eyebrow mono-label"><span class="dh-tick" aria-hidden="true"></span> Daily</p>
            <div class="dh-daily-right">
              {home.hasTitles && (
                <nav class="dh-anchors mono-label" aria-label="On this page">
                  <a href="#watch-list">Watch list</a>
                  <a href="#new-core">Core</a>
                  <a href="#new-stretch">Stretch</a>
                  <a href="#died">What died</a>
                </nav>
              )}
              <p class="dh-swept mono-label">{home.sweep.sweptAt ? `swept ${formatDate(home.sweep.sweptAt)}` : 'sweep pending'}</p>
            </div>
          </header>

          <section class="dh-summary">
            <div class="dh-summary-text">
              {home.hasTitles ? (
                <p class="dh-lede">
                  Last night the sweep read <span class="num">{n(home.sweep.postingsObserved)}</span> postings at
                  companies' own careers pages. <span class="num num-accent">{home.newCoreCount}</span> new roles came
                  through under your core titles, <span class="num">{home.newStretchCount}</span> under stretch, and
                  <span class="num">{home.diedCount}</span> came down by rule. <span class="num">{home.liveUnderTitles.toLocaleString()}</span>
                  {' '}are live right now under the {titleCount} titles you named.
                </p>
              ) : (
                <p class="dh-lede">
                  Last night the sweep read <span class="num">{n(home.sweep.postingsObserved)}</span> postings at
                  companies' own careers pages. Name the titles you want below, and this becomes your executive
                  summary: what is new under them, what pays, and what died.
                </p>
              )}
              <p class="dh-note">At anti algo you are the executive, so this is your executive summary. Every number in it carries the night it was read.</p>
            </div>
            <SweepPanel
              boardsSwept={home.sweep.boardsSwept}
              verifiedLive={home.sweep.verifiedLive}
              liveUnderTitles={home.liveUnderTitles}
              newCoreCount={home.newCoreCount}
              diedCount={home.diedCount}
              sweptAt={home.sweep.sweptAt}
            />
          </section>

          <WatchList
            coreTitles={home.coreTitles}
            stretchTitles={home.stretchTitles}
            uncovered={home.uncovered}
            prefs={home.prefs}
            titleOptions={titleOptions}
            watchAction={watchAction}
            prefsAction={prefsAction}
          />

          {home.hasTitles && (
            <>
              <section class="dh-lane" id="new-core" aria-labelledby="nc-h">
                <p class="dh-lane-index mono-label"><span>02</span> New in core</p>
                <h2 id="nc-h" class="dh-lane-title">{home.newCoreCount} {home.newCoreCount === 1 ? 'role' : 'roles'} first seen since your last visit.</h2>
                <p class="dh-lane-note">Ranked by fit, each verified live at the company's own careers page last night. The clock is where the role sits on the arrival curve, not a countdown.</p>
                {home.newCore.length > 0 ? (
                  <ol class="dh-cards">{home.newCore.map((r, i) => <RoleCard role={r} rank={i + 1} />)}</ol>
                ) : (
                  <p class="dh-empty">Nothing new under your core titles since you last looked.</p>
                )}
                <p class="dh-cite mono-label">Arrival curve: NBER WP 32320, about 45% of applications in the first 48 hours.</p>
              </section>

              <section class="dh-lane" id="new-stretch" aria-labelledby="ns-h">
                <p class="dh-lane-index mono-label"><span>03</span> New in stretch</p>
                <h2 id="ns-h" class="dh-lane-title">{home.newStretchCount} {home.newStretchCount === 1 ? 'role' : 'roles'} you are working toward.</h2>
                <p class="dh-lane-note">A reach is a reach because the fit is lower, not because we scored your resume against the posting line by line: we do not measure that yet, so we do not claim it.</p>
                {home.newStretch.length > 0 ? (
                  <ol class="dh-cards">{home.newStretch.map((r, i) => <RoleCard role={r} rank={i + 1} />)}</ol>
                ) : (
                  <p class="dh-empty">Nothing new under your stretch titles since you last looked.</p>
                )}
              </section>

              <section class="dh-lane" id="died" aria-labelledby="dd-h">
                <p class="dh-lane-index mono-label"><span>04</span> Died on your list</p>
                <h2 id="dd-h" class="dh-lane-title">Do not spend your first hours on these.</h2>
                <p class="dh-lane-note">Company held on kill rows, as everywhere on a paid surface.</p>
                {home.died.length > 0 ? (
                  <ul class="dh-kills">
                    {home.died.map((k) => (
                      <li class="dh-kill">
                        <span class="dh-kill-title">{k.title}</span>
                        <span class="dh-kill-rule mono-label">{k.killRuleLabel}</span>
                        <span class="dh-kill-meta mono-label">
                          {k.stoodDays !== null && `stood ${k.stoodDays} days`}{k.killedOn && ` · ${k.killedOn}`}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <p class="dh-empty">Nothing under your titles has come down.</p>
                )}
              </section>
            </>
          )}

          <p class="dh-board-link"><a href={boardHref}>See these on the board</a>, narrowed to your titles.</p>
        </>
      ) : (
        <EmptyState
          title="The Desk is warming up"
          detail="We could not read the sweep just now. Reload in a moment; nothing you have saved is lost."
        />
      )}
    </div>
  ) : (
    <main class="shell desk-preview">
      <header class="dp-head">
        <p class="dp-eyebrow mono-label">The Desk</p>
        <h1 class="dp-title">Name the titles you want. See only those.</h1>
        <p class="dp-lede">
          The board reads company careers pages directly every night. The Desk is where you name the
          titles you are after; it learns what they are called everywhere else and narrows the whole
          sweep down to the handful that are yours, on the board and here. It is part of the paid account.
        </p>
      </header>
      <Panel title="What the account opens">
        <ul class="dp-list">
          <li>Name your titles once; the board narrows to them everywhere.</li>
          <li>What is new under your titles since you last looked, ranked by fit.</li>
          <li>What died on your list, so you do not chase a role that is already gone.</li>
        </ul>
        <p class="dp-cta">
          <a class="dp-button" href={accountHref}>Your account</a>
          <a class="dp-link" href={boardHref}>Browse the board</a>
        </p>
      </Panel>
    </main>
  )}
</BaseLayout>

<style>
  .desk-home {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-600) var(--space-800);
    max-width: 78rem;
  }

  /* DAILY header row + swept stamp + in-page anchors. */
  .dh-daily { display: flex; align-items: baseline; justify-content: space-between; gap: var(--space-400); flex-wrap: wrap; padding-bottom: var(--space-400); border-bottom: var(--border-hairline) solid var(--color-line); }
  .dh-eyebrow { margin: 0; color: var(--color-muted); display: inline-flex; align-items: center; gap: var(--space-200); }
  .dh-tick { width: 8px; height: 8px; background: var(--color-stat-loss); display: inline-block; }
  .dh-daily-right { display: flex; align-items: baseline; gap: var(--space-500); flex-wrap: wrap; }
  .dh-anchors { display: inline-flex; gap: var(--space-400); }
  .dh-anchors a { color: var(--color-muted); text-decoration: none; }
  .dh-anchors a:hover { color: var(--color-foreground); }
  .dh-swept { color: var(--color-muted); }

  /* Executive summary + sweep panel, two columns. */
  .dh-summary { display: grid; grid-template-columns: 1.5fr 1fr; gap: var(--space-700); align-items: start; }
  .dh-summary-text { display: flex; flex-direction: column; gap: var(--space-400); }
  .dh-lede { margin: 0; font-family: var(--font-family-sans); font-size: clamp(1.4rem, 2.6vw, 2rem); line-height: 1.28; letter-spacing: -0.015em; }
  .num { text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-line-strong); font-weight: var(--weight-bold); }
  .num-accent { color: var(--color-stat-loss); text-decoration-color: var(--color-stat-loss); }
  .dh-note { margin: 0; color: var(--color-muted); font-size: var(--size-100); max-width: 52ch; }

  .dh-lane { display: flex; flex-direction: column; gap: var(--space-300); border-top: var(--border-hairline) solid var(--color-line); padding-top: var(--space-600); }
  .dh-lane-index { margin: 0; color: var(--color-muted); }
  .dh-lane-index span { margin-right: var(--space-200); }
  .dh-lane-title { margin: 0; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.1; letter-spacing: -0.02em; }
  .dh-lane-note { margin: 0 0 var(--space-300); color: var(--color-muted); font-size: var(--size-100); max-width: 68ch; }
  .dh-cards { list-style: none; margin: 0; padding: 0; }
  .dh-cite { margin: var(--space-300) 0 0; color: var(--color-muted); }
  .dh-empty { margin: 0; color: var(--color-muted); font-size: var(--size-100); }

  .dh-kills { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .dh-kill { display: flex; flex-wrap: wrap; align-items: baseline; gap: var(--space-200) var(--space-300); padding: var(--space-300) 0; border-bottom: var(--border-hairline) solid var(--color-line); }
  .dh-kill:first-child { border-top: var(--border-hairline) solid var(--color-line); }
  .dh-kill-title { font-weight: var(--weight-medium); }
  .dh-kill-rule { color: var(--color-stat-loss); }
  .dh-kill-meta { color: var(--color-muted); margin-left: auto; }

  .dh-board-link { margin: 0; color: var(--color-muted); font-size: var(--size-100); }
  .dh-board-link a { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-stat-loss); }

  @media (max-width: 52rem) {
    .dh-summary { grid-template-columns: 1fr; gap: var(--space-500); }
  }

  /* The preview / upsell for a signed-in member who has not paid. */
  .desk-preview { padding-block: var(--space-700) var(--space-800); display: flex; flex-direction: column; gap: var(--space-600); }
  .dp-head { display: flex; flex-direction: column; gap: var(--space-200); }
  .dp-eyebrow { margin: 0; color: var(--color-muted); }
  .dp-title { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; max-width: 22ch; }
  .dp-lede { margin: 0; color: var(--color-muted); max-width: 62ch; line-height: 1.55; }
  .dp-list { margin: 0; padding-left: 1.1rem; color: var(--color-muted); display: flex; flex-direction: column; gap: var(--space-100); }
  .dp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-400); margin: var(--space-400) 0 0; }
  .dp-button { display: inline-block; padding: 0.6rem 1rem; border-radius: var(--radius); background: var(--color-surface-inverse); color: var(--color-foreground-inverse); font-family: var(--font-family-mono); font-size: var(--size-100); text-decoration: none; white-space: nowrap; }
  .dp-link { color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px; text-decoration-color: var(--color-line-strong); font-size: var(--size-100); }
</style>
