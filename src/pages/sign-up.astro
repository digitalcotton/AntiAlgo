---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { INDEX, routeFor } from '../data/nav';
import { sanitiseSource } from '../lib/auth';
import { isOn } from '../lib/flags';
import { count, dayStamp, waitlistEmailCount } from '../lib/stats';
import { LAUNCH_DATE, LAUNCH_LABEL_LONG } from '../../site.config.mjs';

/*
 * Create an account -- or, while the waitlist flag is on (flags.config.mjs),
 * save an email-only spot in line instead. Server rendered either way: the
 * waitlist branch reads the live waitlist count per request the same way the
 * home page does, and the account-creation branch calls Better Auth's
 * endpoint, a live JSON call.
 *
 * A reader who is already signed in is sent to /account, where the gate
 * decides: a member sees the account page and a waitlisted account is sent
 * to the waitlist page (src/pages/waitlist.astro -- a different page from
 * this one; that one is what an already-waitlisted account sees after
 * signing in, this one is where a stranger arrives to join the line). That
 * redirect runs regardless of the flag, same as before.
 *
 * The placement that sent someone here (?from=) is read once on the server,
 * sanitised, and carried in a cookie so the account-creation hook can record
 * which gate converted them. It is only consumed by the account-creation
 * form below (the hidden signup_source field); the waitlist branch does not
 * use it today, but setting the cookie is harmless either way and keeps the
 * two branches sharing one frontmatter instead of forking it.
 */
if (Astro.locals.viewer) return Astro.redirect(routeFor('account'), 302);

const waitlistOn = isOn('waitlist');

const signupSource = sanitiseSource(Astro.url.searchParams.get('from'));
Astro.cookies.set('signup_source', signupSource, {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure: import.meta.env.PROD,
  maxAge: 60 * 30
});

// Only the waitlist branch needs these; account creation doesn't touch the
// email-waitlist count or the launch date.
const inLine = waitlistOn ? await waitlistEmailCount() : 0;
const today = dayStamp(new Date());
/*
 * Whole days left, FLOORED -- deliberately not site.config's daysToLaunch(),
 * which ceils. The two answer different questions: daysToLaunch is "how many
 * calendar days until launch", which is what the home page wants, and this is
 * "how many whole days are left on the clock", which is what a running
 * countdown shows. On this page both appear in the same eyeful, the closer
 * headline beside the closer countdown, and a headline reading 99 next to a
 * clock reading 98 is the page contradicting itself. Same question, same
 * number. The client re-derives it every second from the same instant, so the
 * server's value is only the first paint.
 */
const days = Math.floor(Math.max(0, new Date(LAUNCH_DATE).getTime() - Date.now()) / 86400000);

/*
 * The line's rules, in the order they happen to a reader. This is the page's
 * content, not decoration: the order is the argument, so it lives here as data
 * rather than as seven hand-numbered blocks of markup that can be reordered
 * without their numbers following. The number printed beside each rule is
 * derived from its index below -- move a rule and its number moves with it.
 *
 * SEATS is the same table the client script reads to name a reader's door, and
 * the figures printed under doors 2, 3 and 4 are read from it rather than typed
 * twice. One edit here changes the copy and the confirmation together.
 */
const SEATS = [1000, 2000, 4000, 8000];
const seatsIn = (door: number) => SEATS[door - 1].toLocaleString('en-US');

const RULES = [
  {
    title: "Why there's a line",
    body: [
      'Doors are sized to how many people we can onboard well. That is the only reason for the cap. The board is free and public for everyone; the line is for the paid account.'
    ],
    figures: []
  },
  {
    title: 'Door 1',
    body: [
      `Opens ${LAUNCH_LABEL_LONG}, no matter how many people are in line. 800 seats go by line order, 200 to whole groups that joined together, earliest first.`
    ],
    figures: [
      { k: 'Seats', v: seatsIn(1) },
      { k: 'By order', v: '800' },
      { k: 'Groups', v: '200' }
    ]
  },
  {
    title: 'Your spot never slides back',
    body: [
      'We show you your door, never your number. Once you are in line, nothing moves you further from the front.'
    ],
    figures: []
  },
  {
    title: 'When your seat comes up',
    body: [
      'You have 7 days to start at $7.25 a month. Miss it and the seat passes to the next person; you keep your place at the front for the next door.'
    ],
    figures: [
      { k: 'To start', v: '7 days' },
      { k: 'A month', v: '$7.25' }
    ]
  },
  {
    title: 'Doors 2, 3 and 4',
    body: [
      'No dates. Each opens when the line holds enough people to fill it and every seat in the previous door is claimed. A live counter shows how many more it takes.'
    ],
    figures: [
      { k: 'Door 2', v: seatsIn(2) },
      { k: 'Door 3', v: seatsIn(3) },
      { k: 'Door 4', v: seatsIn(4) }
    ]
  },
  {
    title: 'Giving seats',
    body: [
      'A member who sends 3 applications through Anti Algo gets 2 seats to give. The person who gets one skips the line and has 7 days to start. Nobody can ask for a seat.'
    ],
    figures: []
  },
  {
    title: 'Sign-in',
    body: [
      `Turns on for everyone in line on ${LAUNCH_LABEL_LONG}. A free account gets the fit score, add any job by link, and a Jobs Data preview.`
    ],
    figures: []
  }
];
---

<BaseLayout title="Save my spot" description="Get in line for launch." noindex>
  {waitlistOn ? (
    <div class="wl" data-launch-label={LAUNCH_LABEL_LONG}>
      {/*
        The reference design carries its own wordmark row and its own footer.
        Both are dropped here on purpose: this page renders inside BaseLayout,
        which already owns the site header and footer, and a second nav band
        under the first is the seam this page was meant to remove.
      */}
      <section class="wl-hero" id="join" aria-labelledby="wl-title">
        <div class="wl-hero-main">
          <p class="wl-eyebrow">Door 1 opens {LAUNCH_LABEL_LONG} · {count(inLine)} in line</p>
          <h1 id="wl-title" class="wl-h1">
            <span class="wl-h1-line">Every employer has AI.</span>
            <span class="wl-h1-line">Get the one on your side.</span>
          </h1>
          <p class="wl-lede">Your resumé and cover letter, rewritten for every opening. One email holds your spot. No password, no card.</p>

          <form class="wl-form" data-wl-form method="POST" action={routeFor('waitlist-join')}>
            <div class="wl-row">
              <label class="wl-field">
                <span class="visually-hidden">Email address</span>
                <input class="wl-input" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />
              </label>
              <button class="wl-cta" type="submit">Save my spot</button>
            </div>
            <p class="wl-note">The board stays free and public either way. Your spot never slides back.</p>
          </form>
          <p class="wl-done" data-wl-done role="status" hidden></p>
          <p class="wl-error" data-wl-error role="alert" hidden></p>
        </div>

        <div class="wl-side">
          <p class="wl-eyebrow">Door 1 opens in</p>
          <div class="wl-countdown" data-countdown data-launch={LAUNCH_DATE} aria-label="Time until Door 1 opens">
            <div class="wl-ctile"><span class="wl-cnum" data-unit="days">00</span><span class="wl-clabel">Days</span></div>
            <div class="wl-ctile"><span class="wl-cnum" data-unit="hours">00</span><span class="wl-clabel">Hours</span></div>
            <div class="wl-ctile"><span class="wl-cnum" data-unit="minutes">00</span><span class="wl-clabel">Minutes</span></div>
            <div class="wl-ctile"><span class="wl-cnum" data-unit="seconds">00</span><span class="wl-clabel">Seconds</span></div>
          </div>
          <dl class="wl-facts">
            <div class="wl-fact"><dt class="wl-fact-k">Seats</dt><dd class="wl-fact-v">{seatsIn(1)}</dd></div>
            <div class="wl-fact"><dt class="wl-fact-k">A month</dt><dd class="wl-fact-v">$7.25</dd></div>
            <div class="wl-fact"><dt class="wl-fact-k">To decide</dt><dd class="wl-fact-v">7 days</dd></div>
          </dl>
          <p class="wl-note wl-side-note">Free account for everyone in line the same day. Paid seats in line order, 800 by order, 200 for groups.</p>
        </div>
      </section>

      <section class="wl-how" id="how" aria-labelledby="wl-how-title">
        <div class="wl-how-head">
          <p class="wl-eyebrow">How the line works</p>
          <h2 id="wl-how-title" class="wl-how-h2">All the rules, in the order they happen to you.</h2>
        </div>
        <ol class="wl-rules">
          {RULES.map((rule, i) => (
            <li class="wl-rule">
              <h3 class="wl-rule-h3">
                <span class="wl-rule-n">{String(i + 1).padStart(2, '0')}</span>
                <span>{rule.title}</span>
              </h3>
              <div class="wl-rule-body">
                {rule.body.map((line) => <p class="wl-rule-p">{line}</p>)}
                {rule.figures.length > 0 && (
                  <dl class="wl-figs">
                    {rule.figures.map((f) => (
                      <div class="wl-fig"><dt class="wl-fig-k">{f.k}</dt><dd class="wl-fig-v">{f.v}</dd></div>
                    ))}
                  </dl>
                )}
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="wl-closer" aria-label="Save your spot">
        <div class="wl-closer-main">
          <h2 class="wl-closer-h2">Door 1 opens in <span data-days-phrase>{days} {days === 1 ? 'day' : 'days'}</span>. Hold your place.</h2>
          <form class="wl-form" data-wl-form method="POST" action={routeFor('waitlist-join')}>
            <div class="wl-row">
              <label class="wl-field">
                <span class="visually-hidden">Email address</span>
                <input class="wl-input" name="email" type="email" placeholder="you@example.com" required autocomplete="email" />
              </label>
              <button class="wl-cta" type="submit">Save my spot</button>
            </div>
            <p class="wl-note">{count(inLine)} in line as of {today}. One email, nothing else.</p>
          </form>
          <p class="wl-done" data-wl-done role="status" hidden></p>
          <p class="wl-error" data-wl-error role="alert" hidden></p>
        </div>
        <div class="wl-countdown wl-countdown-big" data-countdown data-launch={LAUNCH_DATE} aria-hidden="true">
          <div class="wl-ctile"><span class="wl-cnum" data-unit="days">00</span><span class="wl-clabel">Days</span></div>
          <div class="wl-ctile"><span class="wl-cnum" data-unit="hours">00</span><span class="wl-clabel">Hours</span></div>
          <div class="wl-ctile"><span class="wl-cnum" data-unit="minutes">00</span><span class="wl-clabel">Minutes</span></div>
          <div class="wl-ctile"><span class="wl-cnum" data-unit="seconds">00</span><span class="wl-clabel">Seconds</span></div>
        </div>
      </section>
    </div>
  ) : (
    <section class="auth-page">
      <div class="shell auth-shell">
        <span class="kicker muted">Account</span>
        <h1>Save your spot</h1>
        <p class="lede">Free. An email and under a minute. The account goes on the list, and the board stays public either way.</p>

        <p id="auth-error" class="auth-error" role="alert" hidden>
          Something went wrong creating your account. Check your details and try again.
        </p>

        <form class="auth-form" method="POST" action="/auth/sign-up/email" data-next={routeFor('account')}>
          <input type="hidden" name="signup_source" value={signupSource} />
          <input class="field-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

          <div class="field">
            <label class="field-label" for="signup-first-name">First name</label>
            <input class="field-input" id="signup-first-name" type="text" name="first_name" required maxlength="120" autocomplete="given-name" />
          </div>
          <div class="field">
            <label class="field-label" for="signup-last-name">Last name</label>
            <input class="field-input" id="signup-last-name" type="text" name="last_name" required maxlength="120" autocomplete="family-name" />
          </div>
          <div class="field">
            <label class="field-label" for="signup-email">Email address</label>
            <input class="field-input" id="signup-email" type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
          </div>
          <div class="field">
            <label class="field-label" for="signup-password">Password</label>
            <input class="field-input" id="signup-password" type="password" name="password" required autocomplete="new-password" minlength="8" />
            <span class="field-hint">Eight characters or more.</span>
          </div>
          <button class="cta" type="submit">Save my spot</button>
        </form>

        <div class="auth-links">
          <a class="link-line" href={routeFor('sign-in')}>Already have an account? Sign in.</a>
          <a class="link-line" href={INDEX.board}>Or open the board. It is public.</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  // The countdowns, ticking every second from the launch instant carried in
  // data-launch. There are two on the page -- one beside the hero, one in the
  // closer -- and they are driven by one loop rather than two, because two
  // intervals started a few milliseconds apart visibly disagree on the seconds
  // digit. Guarded on finding any: this script loads on every sign-up render,
  // but the elements it drives only exist when the waitlist branch rendered,
  // so on the account-creation branch it is a no-op.
  const countdowns = [...document.querySelectorAll<HTMLElement>('[data-countdown]')];
  if (countdowns.length > 0) {
    const launch = new Date(countdowns[0].dataset.launch ?? '').getTime();
    const pad = (n: number) => String(Math.max(0, n)).padStart(2, '0');
    const dayPhrases = [...document.querySelectorAll<HTMLElement>('[data-days-phrase]')];
    const cells = countdowns.flatMap((el) =>
      (['days', 'hours', 'minutes', 'seconds'] as const).map((unit) => ({
        unit,
        el: el.querySelector<HTMLElement>(`[data-unit="${unit}"]`)
      }))
    );

    function tick() {
      const total = Math.floor(Math.max(0, launch - Date.now()) / 1000);
      const value = {
        // Days is unpadded in the design: "99", not "099", and "7", not "07".
        days: String(Math.floor(total / 86400)),
        hours: pad(Math.floor((total % 86400) / 3600)),
        minutes: pad(Math.floor((total % 3600) / 60)),
        seconds: pad(total % 60)
      };
      for (const cell of cells) {
        if (cell.el) cell.el.textContent = value[cell.unit];
      }
      // The closer headline names the same number the clock beside it shows,
      // so the two cannot drift apart across a midnight the reader sat through.
      const wholeDays = Number(value.days);
      for (const el of dayPhrases) {
        el.textContent = `${value.days} ${wholeDays === 1 ? 'day' : 'days'}`;
      }
    }
    tick();
    setInterval(tick, 1000);
  }

  // The seats behind each door, smallest first -- the same table the rules list
  // prints. A reader's door is the first one whose running total still has room
  // for their position, so door 1 covers 1 to 1,000, door 2 covers 1,001 to
  // 3,000, and so on.
  const DOOR_SEATS = [1000, 2000, 4000, 8000];

  function doorFor(position: number): number | null {
    let filled = 0;
    for (let i = 0; i < DOOR_SEATS.length; i += 1) {
      filled += DOOR_SEATS[i];
      if (position <= filled) return i + 1;
    }
    return null;
  }

  // The waitlist forms: a same-origin fetch POST to their own action
  // (/waitlist/join), JSON in, JSON out. Both forms on the page share this
  // handler, and a success in either one answers in both -- someone who fills
  // in the closer should not scroll back up to a form still asking for the
  // email they already gave.
  //
  // The endpoint still answers with a position. The page does not print it:
  // rule 03 is that we show a reader their door and never their number, so the
  // position is read only to work out which door that is. Nothing about what is
  // stored changed; this is what is said back.
  const wlForms = [...document.querySelectorAll<HTMLFormElement>('[data-wl-form]')];
  const wlDone = [...document.querySelectorAll<HTMLElement>('[data-wl-done]')];
  const wlErrors = [...document.querySelectorAll<HTMLElement>('[data-wl-error]')];

  function settle(message: string) {
    for (const form of wlForms) form.hidden = true;
    for (const el of wlDone) {
      el.textContent = message;
      el.hidden = false;
    }
  }

  function showError(message: string) {
    for (const el of wlErrors) {
      el.textContent = message;
      el.hidden = false;
    }
  }

  for (const form of wlForms) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      for (const el of wlErrors) el.hidden = true;

      const email = String(new FormData(form).get('email') ?? '').trim();
      const buttons = wlForms.flatMap((f) => [...f.querySelectorAll<HTMLButtonElement>('button[type="submit"]')]);
      for (const button of buttons) button.disabled = true;

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email })
        });
        const data = await response.json().catch(() => null);
        if (response.ok && data && data.ok) {
          const door = doorFor(Number(data.position));
          const launchLabel = form.closest<HTMLElement>('.wl')?.dataset.launchLabel ?? '';
          if (door === 1) {
            settle(`You're in line for Door 1. It opens ${launchLabel}.`);
          } else if (door) {
            settle(`You're in line for Door ${door}. It opens once the doors ahead of it are claimed.`);
          } else {
            settle("You're in line. Your door opens as the ones ahead of it fill.");
          }
          return;
        }
        showError((data && data.error) || 'Something went wrong. Try again.');
      } catch {
        showError('Something went wrong. Try again.');
      } finally {
        for (const button of buttons) button.disabled = false;
      }
    });
  }
</script>

<script>
  // Better Auth's endpoint wants JSON and answers with JSON, so the native
  // POST is intercepted. A filled honeypot stops the submit cold. On success
  // the account is already signed in (autoSignIn), so the reader goes to the
  // one landing and the gate decides what they see. Guarded on .auth-form
  // existing: a no-op on the waitlist branch, same reasoning as above.
  const authForm = document.querySelector<HTMLFormElement>('.auth-form');
  const authErrorEl = document.querySelector<HTMLElement>('#auth-error');

  authForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (authErrorEl) authErrorEl.hidden = true;

    const trap = authForm.querySelector<HTMLInputElement>('input[name="website"]');
    if (trap && trap.value) return;

    const data = Object.fromEntries(new FormData(authForm).entries());
    const first = String(data.first_name ?? '').trim();
    const last = String(data.last_name ?? '').trim();
    data.name = [first, last].filter(Boolean).join(' ');

    try {
      const response = await fetch(authForm.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        const next = authForm.dataset.next;
        window.location.href = next && next.startsWith('/') ? next : '/';
        return;
      }
    } catch {}
    if (authErrorEl) authErrorEl.hidden = false;
  });
</script>

<style>
  /*
   * The Get-in-line canvas, measured off the approved reference and mapped onto
   * the site's own colour and font tokens rather than the reference's private
   * ones: --paper is --color-surface, --ink is --color-foreground, --hair is
   * --color-line, --heavy is --color-line-strong. The hex values behind both
   * sets are already identical, so this is a rename, not a re-colour, and the
   * page inverts with the theme switch instead of pinning one of them.
   *
   * The reference sizes itself off its own width with container queries, not
   * the viewport, which is why the breakpoints below are 1100, 900 and 680 and
   * do not sit on the site's viewport breakpoint ramp: they are widths of this
   * canvas. Kept as written so the layout breaks where it was drawn to break.
   */
  .wl {
    container-type: inline-size;

    --hair: var(--color-line);
    --heavy: var(--color-line-strong);
    --muted: var(--color-muted);
    --signal: var(--color-signal);
    --machine: var(--font-family-mono);

    /* The site's one frame (global.css .shell), since 2026-09-20. */
    max-width: 86rem;
    margin-inline: auto;
    padding-inline: clamp(16px, 3vw, 36px);
  }

  /* The mono label that opens each band: eyebrow, section kicker, tile caption.
     One rule, because three different letter-spacings on the same label is how
     a page stops reading as one page. */
  .wl-eyebrow {
    margin: 0;
    font-family: var(--machine);
    font-size: 0.82rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---- hero ---- */

  .wl-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 0 clamp(24px, 5vw, 80px);
    padding: clamp(40px, 6vw, 72px) 0 clamp(40px, 5vw, 64px);
    border-bottom: 1px solid var(--hair);
  }

  .wl-h1 {
    margin: 18px 0 0;
    font-weight: 700;
    font-size: clamp(2.5rem, 5vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    text-wrap: pretty;
  }

  /* Two lines by construction, not by luck: the break between the problem and
     the offer is the sentence, and letting it fall wherever the measure lands
     puts "AI. Get" on one line. */
  .wl-h1-line {
    display: block;
  }

  .wl-lede {
    margin: 22px 0 0;
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 34ch;
    text-wrap: pretty;
  }

  .wl-side {
    padding-left: clamp(0px, 3vw, 40px);
    border-left: 1px solid var(--hair);
  }

  /* ---- the form, in both bands ---- */

  .wl-form {
    margin-top: 30px;
    max-width: 34rem;
  }

  .wl-closer .wl-form {
    margin-top: 26px;
  }

  .wl-form[hidden] {
    display: none;
  }

  .wl-row {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .wl-field {
    flex: 1 1 220px;
    min-width: 0;
  }

  .wl-input {
    width: 100%;
    min-height: 52px;
    padding: 10px 14px;
    background: var(--color-surface-raised);
    color: var(--color-foreground);
    border: 1px solid var(--heavy);
    border-radius: 2px;
    font: inherit;
  }

  .wl-input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .wl-input:focus {
    outline: none;
    border-color: var(--color-foreground);
    box-shadow: inset 0 0 0 1px var(--color-foreground);
  }

  .wl-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    white-space: nowrap;
    min-height: 52px;
    padding: 12px 28px;
    border: 0;
    border-radius: 2px;
    background: var(--signal);
    /* Signal orange is the same value in both themes, so its text is pinned to
       cool ink rather than to the theme's foreground, which would go white on
       orange in dark mode. */
    color: var(--gray-950);
    font-family: var(--machine);
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .wl-cta:hover,
  .wl-cta:focus-visible {
    filter: brightness(0.94);
  }

  .wl-cta:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .wl-note {
    margin: 12px 0 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
    max-width: 52ch;
    text-wrap: pretty;
  }

  .wl-side-note {
    margin-top: 16px;
    line-height: 1.55;
  }

  /* The handler sets hidden on the forms and clears it here, so the reader has
     exactly one thing to read once they are in line. */
  .wl-done {
    margin: 30px 0 0;
    font-size: 1.25rem;
    line-height: 1.5;
    max-width: 34ch;
    text-wrap: pretty;
  }

  .wl-done[hidden],
  .wl-error[hidden] {
    display: none;
  }

  .wl-error {
    margin: 12px 0 0;
    padding: 8px 12px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-stat-loss);
    border: 1px solid currentColor;
    border-radius: 2px;
    max-width: 34rem;
  }

  /* ---- the countdown ---- */

  .wl-countdown {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border: 1px solid var(--heavy);
  }

  .wl-ctile {
    padding: 18px 6px 14px;
