---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { INDEX, routeFor } from '../data/nav';
import { sanitiseSource } from '../lib/auth';

/*
 * Create an account. Server rendered because Better Auth's endpoint is a live
 * JSON call. A reader who is already signed in is sent to /account, where the
 * gate decides: a member sees the account page and a waitlisted account is
 * sent to the waitlist page. There is one landing, and the gate owns it.
 *
 * The placement that sent someone here (?from=) is read once on the server,
 * sanitised, and carried in a hidden field and a short-lived cookie so the
 * account-creation hook can record which gate converted them.
 */
if (Astro.locals.viewer) return Astro.redirect(routeFor('account'), 302);

const signupSource = sanitiseSource(Astro.url.searchParams.get('from'));
Astro.cookies.set('signup_source', signupSource, {
  path: '/',
  httpOnly: true,
  sameSite: 'lax',
  secure: import.meta.env.PROD,
  maxAge: 60 * 30
});
---

<BaseLayout title="Create your account" description="Create an account on The Index." noindex>
  <section class="auth-page">
    <div class="shell auth-shell">
      <span class="kicker muted">Account</span>
      <h1>Save your spot</h1>
      <p class="lede">Free. An email and under a minute. The account goes on the list, and the board stays public either way.</p>

      <p id="auth-error" class="auth-error" role="alert" hidden>
        Something went wrong creating your account. Check your details and try again.
      </p>

      <form class="auth-form" method="POST" action="/auth/sign-up/email" data-next={routeFor('account')}>
        <input type="hidden" name="signup_source" value={signupSource} />
        <input class="field-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <div class="field">
          <label class="field-label" for="signup-first-name">First name</label>
          <input class="field-input" id="signup-first-name" type="text" name="first_name" required maxlength="120" autocomplete="given-name" />
        </div>
        <div class="field">
          <label class="field-label" for="signup-last-name">Last name</label>
          <input class="field-input" id="signup-last-name" type="text" name="last_name" required maxlength="120" autocomplete="family-name" />
        </div>
        <div class="field">
          <label class="field-label" for="signup-email">Email address</label>
          <input class="field-input" id="signup-email" type="email" name="email" required autocomplete="email" placeholder="you@company.com" />
        </div>
        <div class="field">
          <label class="field-label" for="signup-password">Password</label>
          <input class="field-input" id="signup-password" type="password" name="password" required autocomplete="new-password" minlength="8" />
          <span class="field-hint">Eight characters or more.</span>
        </div>
        <button class="cta" type="submit">Save my spot</button>
      </form>

      <div class="auth-links">
        <a class="link-line" href={routeFor('sign-in')}>Already have an account? Sign in.</a>
        <a class="link-line" href={INDEX.board}>Or open the board. It is public.</a>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Better Auth's endpoint wants JSON and answers with JSON, so the native
  // POST is intercepted. A filled honeypot stops the submit cold. On success
  // the account is already signed in (autoSignIn), so the reader goes to the
  // one landing and the gate decides what they see.
  const form = document.querySelector<HTMLFormElement>('.auth-form');
  const errorEl = document.querySelector<HTMLElement>('#auth-error');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorEl) errorEl.hidden = true;

    const trap = form.querySelector<HTMLInputElement>('input[name="website"]');
    if (trap && trap.value) return;

    const data = Object.fromEntries(new FormData(form).entries());
    const first = String(data.first_name ?? '').trim();
    const last = String(data.last_name ?? '').trim();
    data.name = [first, last].filter(Boolean).join(' ');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (response.ok) {
        const next = form.dataset.next;
        window.location.href = next && next.startsWith('/') ? next : '/';
        return;
      }
    } catch {}
    if (errorEl) errorEl.hidden = false;
  });
</script>

<style>
  .auth-shell {
    padding-block: var(--space-800) var(--space-1000);
    max-width: 44ch;
  }
  .muted {
    color: var(--color-muted);
  }
  h1 {
    margin: var(--space-300) 0 var(--space-400);
    font-size: var(--size-600);
    line-height: var(--leading-display);
  }
  .lede {
    margin: 0 0 var(--space-600);
    color: var(--color-muted);
  }
  .auth-error {
    margin: 0 0 var(--space-500);
    padding: var(--space-300) var(--space-400);
    border: var(--border-hairline) solid var(--color-line-strong);
    font-family: var(--font-family-mono);
    font-size: var(--size-100);
    line-height: var(--leading-normal);
  }
  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-500);
    align-items: flex-start;
  }
  .auth-form .cta {
    margin-top: var(--space-200);
  }
  .field-trap {
    display: none;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
    width: 100%;
  }
  .field-label {
    font-weight: var(--weight-medium);
    font-size: var(--size-075);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .field-hint {
    font-size: var(--size-100);
    color: var(--color-muted);
  }
  .auth-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    margin-top: var(--space-600);
    align-items: flex-start;
  }
</style>
