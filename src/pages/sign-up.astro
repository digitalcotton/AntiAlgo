  .wl-closer-h2 {
    margin: 0;
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    max-width: 18ch;
    text-wrap: balance;
  }

  /* ---- the canvas's own breakpoints, in its own width ---- */

  @container (max-width: 1100px) {
    /* The rules stop being a two-column reference table and become a list. */
    .wl-how {
      grid-template-columns: 1fr;
    }
  }

  @container (max-width: 900px) {
    .wl-hero,
    .wl-closer {
      grid-template-columns: 1fr;
    }
    /* The sidebar's left rule becomes a top rule once it is no longer a side. */
    .wl-side {
      border-left: 0;
      padding-left: 0;
      border-top: 1px solid var(--hair);
      padding-top: 26px;
      margin-top: 26px;
