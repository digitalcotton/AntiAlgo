    font-size: 0.78rem;
    font-weight: 500;
    color: var(--muted);
    flex-shrink: 0;
  }

  .wl-rule-body {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .wl-rule-p {
    margin: 0;
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 56ch;
    text-wrap: pretty;
  }

  .wl-figs {
    margin: 4px 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
  }

  .wl-fig {
    display: flex;
    gap: 8px;
    align-items: baseline;
    white-space: nowrap;
  }

  .wl-fig-k {
    font-family: var(--machine);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
  }

  .wl-fig-v {
    margin: 0;
    font-weight: 700;
    font-size: 1.0625rem;
  }

  /* ---- closer ---- */

  .wl-closer {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 28px clamp(24px, 5vw, 80px);
    align-items: end;
    padding: clamp(40px, 5vw, 64px) 0 clamp(48px, 6vw, 80px);
    border-top: 2px solid var(--heavy);
