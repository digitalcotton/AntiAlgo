  .wl-clabel {
    display: block;
    margin-top: 8px;
    font-family: var(--machine);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* The closer's copy of the same band, drawn one step larger: it is the last
     thing on the page and has a column to itself rather than a sidebar. */
  .wl-countdown-big {
    margin-top: 0;
  }

  .wl-countdown-big .wl-ctile {
    padding: 22px 6px 16px;
  }

  .wl-countdown-big .wl-cnum {
    font-size: clamp(2rem, 3.2vw, 3rem);
  }

  .wl-countdown-big .wl-clabel {
    margin-top: 10px;
  }

  /* ---- the three figures under the hero countdown ---- */

  .wl-facts {
    margin: 22px 0 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 16px;
    border-top: 2px solid var(--heavy);
  }

  .wl-fact {
    padding: 12px 0;
    border-bottom: 1px solid var(--hair);
  }

  .wl-fact-k {
    font-family: var(--machine);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .wl-fact-v {
    margin: 4px 0 0;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  /* ---- how the line works ---- */

  .wl-how {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr);
    gap: 20px clamp(24px, 4vw, 64px);
    align-items: start;
    padding: clamp(40px, 5vw, 64px) 0;
  }

  .wl-how-h2 {
    margin: 14px 0 0;
    font-weight: 700;
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    max-width: 16ch;
    text-wrap: pretty;
  }

  .wl-rules {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 2px solid var(--heavy);
  }

  .wl-rule {
    display: grid;
    grid-template-columns: minmax(200px, 1fr) minmax(0, 1.8fr);
