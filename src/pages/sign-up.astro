    .wl-row {
      flex-direction: column;
      align-items: stretch;
    }
    /* The field's flex-basis is a WIDTH while the row is a row, and becomes a
       HEIGHT the moment the row turns into a column -- which printed a 220px
       empty box between the input and the button on a phone. Released here so
       the field is as tall as the input inside it. */
    .wl-field {
      flex: 0 0 auto;
    }
    .wl-rule {
      grid-template-columns: 1fr;
    }
    /* Two by two rather than four across, so the numerals keep their size. */
    .wl-countdown {
      grid-template-columns: repeat(2, minmax(0, 1fr));
