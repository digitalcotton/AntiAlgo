---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { routeFor } from '../data/nav';
import { viewerFrom } from '../lib/viewer';

/*
 * /login — one card, two modes. A single auth surface that flips in place
 * between "Sign in" and "Create account" without a page load, the pattern most
 * SaaS sign-in screens use: one destination, a clear toggle, the two flows kept
 * visually separate so nobody is unsure which form they are filling. Built for
 * the owner today; shaped so it can front the product for customers later.
 *
 * It is intentionally open (never calls isOn('signin')) and registered in no
 * nav/flag/entitlement map, so it renders during the waitlist phase and is
 * linked from nowhere. It is noindex. Accounts made here start at the waitlisted
 * tier and see nothing until elevated, so the page exposes no back-end surface.
 *
 * Both modes post JSON to Better Auth's own /auth endpoints, exactly as
 * sign-in.astro and sign-up.astro do; there is no client SDK. Field and button
 * styling comes from the site's global .field-input / .cta (one 2px radius, one
 * hairline border, everywhere), so this page matches the rest of the site.
 */
function safeNext(raw: string | null): string {
  const value = raw ?? '';
  if (!value.startsWith('/') || value.startsWith('//') || /[\\\p{Cc}]/u.test(value)) return routeFor('desk');
  return value;
}
const next = safeNext(Astro.url.searchParams.get('next'));

// Default to sign-in; ?mode=signup opens on the create-account panel, so a
// no-JS visitor and a shared link both land on the right one.
const mode = Astro.url.searchParams.get('mode') === 'signup' ? 'signup' : 'signin';

// Owner-only affordance: the back-end links show only to a signed-in internal
// account. A customer (or anyone signed out) never sees them, so the page is
// safe to hand to customers as-is later.
const viewer = await viewerFrom(Astro).catch(() => null);
const showBackend = viewer?.tier === 'internal';
const BACKEND = [
  { href: '/account', label: 'Account' },
  { href: '/profile', label: 'Profile' },
  { href: '/settings', label: 'Settings' },
  { href: '/desk', label: 'Desk' },
  { href: '/prelist', label: 'Prelist' },
  { href: '/internal', label: 'Internal' }
];
---

<BaseLayout title="Log in" description="Sign in or create your account." noindex>
  <section class="auth-page">
    <div class="shell auth-shell" data-mode={mode}>
      <span class="kicker muted">Account</span>

      <div class="seg" role="tablist" aria-label="Sign in or create an account">
        <button
          id="tab-signin" class="seg-btn" type="button" role="tab"
          aria-controls="panel-signin" aria-selected={mode === 'signin' ? 'true' : 'false'}
        >Sign in</button>
        <button
          id="tab-signup" class="seg-btn" type="button" role="tab"
          aria-controls="panel-signup" aria-selected={mode === 'signup' ? 'true' : 'false'}
        >Create account</button>
      </div>

      <p id="auth-error" class="auth-error" role="alert" hidden></p>

      <!-- Sign in -->
      <div id="panel-signin" class="panel" role="tabpanel" aria-labelledby="tab-signin" hidden={mode !== 'signin'}>
        <form id="signin-form" class="auth-form" method="POST" action="/auth/sign-in/email" data-next={next}>
          <label class="field">
            <span class="field-label">Email address</span>
            <input class="field-input" type="email" name="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span class="field-label">Password</span>
            <input class="field-input" type="password" name="password" required autocomplete="current-password" />
          </label>
          <button class="cta" type="submit">Sign in</button>
        </form>
        <p class="flip muted">New here? <button type="button" class="flip-link" data-to="signup">Create an account</button></p>
      </div>

      <!-- Create account -->
      <div id="panel-signup" class="panel" role="tabpanel" aria-labelledby="tab-signup" hidden={mode !== 'signup'}>
        <form id="signup-form" class="auth-form" method="POST" action="/auth/sign-up/email" data-next={routeFor('desk')}>
          <input class="field-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <label class="field">
            <span class="field-label">First name</span>
            <input class="field-input" type="text" name="first_name" required maxlength="120" autocomplete="given-name" />
          </label>
          <label class="field">
            <span class="field-label">Last name</span>
            <input class="field-input" type="text" name="last_name" required maxlength="120" autocomplete="family-name" />
          </label>
          <label class="field">
            <span class="field-label">Email address</span>
            <input class="field-input" type="email" name="email" required autocomplete="email" />
          </label>
          <label class="field">
            <span class="field-label">Password</span>
            <input class="field-input" type="password" name="password" required autocomplete="new-password" minlength="8" />
            <span class="field-hint muted">Eight characters or more.</span>
          </label>
          <button class="cta" type="submit">Create account</button>
        </form>
        <p class="flip muted">Already have an account? <button type="button" class="flip-link" data-to="signin">Sign in</button></p>
      </div>

      {showBackend && (
        <nav class="backend" aria-label="Back-end pages">
          <span class="field-label">Back end</span>
          <ul>{BACKEND.map((p) => <li><a href={p.href}>{p.label}</a></li>)}</ul>
        </nav>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  const shell = document.querySelector<HTMLElement>('.auth-shell');
  const tabs = {
    signin: document.getElementById('tab-signin'),
    signup: document.getElementById('tab-signup')
  };
  const panels = {
    signin: document.getElementById('panel-signin'),
    signup: document.getElementById('panel-signup')
  };
  const errorEl = document.getElementById('auth-error');

  function firstInput(mode: 'signin' | 'signup'): HTMLInputElement | null {
    return panels[mode]?.querySelector<HTMLInputElement>('input:not([type="hidden"]):not([tabindex="-1"])') ?? null;
  }

  // Flip in place: swap the visible panel, keep the two flows separate, carry a
  // typed email across so a mis-tap does not cost the reader their address, and
  // reflect the mode in the URL without a reload so a refresh stays put.
  function setMode(mode: 'signin' | 'signup', focus = true) {
    const other = mode === 'signin' ? 'signup' : 'signin';
    const carry = firstEmail(other);
    (['signin', 'signup'] as const).forEach((m) => {
      tabs[m]?.setAttribute('aria-selected', String(m === mode));
      if (panels[m]) panels[m]!.hidden = m !== mode;
    });
    shell?.setAttribute('data-mode', mode);
    if (errorEl) errorEl.hidden = true;
    if (carry) { const to = firstEmail(mode); if (to && !to.value) to.value = carry; }
    const url = new URL(window.location.href);
    if (mode === 'signup') url.searchParams.set('mode', 'signup'); else url.searchParams.delete('mode');
    history.replaceState(null, '', url);
    if (focus) firstInput(mode)?.focus();
  }

  function firstEmail(mode: 'signin' | 'signup'): HTMLInputElement | null {
    return panels[mode]?.querySelector<HTMLInputElement>('input[type="email"]') ?? null;
  }

  tabs.signin?.addEventListener('click', () => setMode('signin'));
  tabs.signup?.addEventListener('click', () => setMode('signup'));
  document.querySelectorAll<HTMLButtonElement>('.flip-link').forEach((b) =>
    b.addEventListener('click', () => setMode(b.dataset.to === 'signup' ? 'signup' : 'signin'))
  );
  // Left/right arrows move between the two tabs, the expected tablist behaviour.
  Object.values(tabs).forEach((t) =>
    t?.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') { e.preventDefault(); setMode(t === tabs.signin ? 'signup' : 'signin'); }
    })
  );

  // Better Auth wants JSON and answers JSON, so the native POST is intercepted.
  // Sign-up synthesizes a single `name` and honours the honeypot. Success on
  // either lands on data-next (sign-up is auto-signed-in).
  function wire(formId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.hidden = true;

      const trap = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (trap && trap.value) return;

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if ('first_name' in data || 'last_name' in data) {
        const first = String(data.first_name ?? '').trim();
        const last = String(data.last_name ?? '').trim();
        data.name = [first, last].filter(Boolean).join(' ');
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (response.ok) {
          const dest = form.dataset.next;
          window.location.href = dest && dest.startsWith('/') ? dest : '/';
          return;
        }
      } catch {}
      if (errorEl) {
        errorEl.textContent = form.id === 'signup-form'
          ? 'Something went wrong creating the account. Check the details and try again.'
          : 'That email and password did not match an account.';
        errorEl.hidden = false;
      }
    });
  }
  wire('signin-form');
  wire('signup-form');
</script>

<style>
  /* Layout mirrors sign-in.astro; fields and the primary button come from the
     site's global .field-input / .cta, so the radius and borders match. */
  .auth-shell {
    padding-block: var(--space-800) var(--space-1000);
    max-width: 40ch;
    margin-inline: auto;
  }

  /* The mode toggle: two segments, one hairline box, sharp corners, the signal
     on the active one — the same visual language as the rest of the site. */
  .seg {
    display: grid;
    grid-template-columns: 1fr 1fr;
    margin-block: var(--space-500) var(--space-600);
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .seg-btn {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-100);
    padding: var(--space-300) var(--space-400);
    background: transparent;
    color: var(--color-muted);
    border: none;
    cursor: pointer;
  }
  .seg-btn + .seg-btn { border-inline-start: var(--border-hairline) solid var(--color-line-strong); }
  .seg-btn[aria-selected='true'] {
    background: var(--color-signal);
    color: var(--gray-950);
    font-weight: var(--weight-bold);
  }
  .seg-btn:focus-visible { outline: 2px solid var(--color-focus, var(--color-signal)); outline-offset: -2px; }

  .auth-form { display: flex; flex-direction: column; gap: var(--space-500); align-items: stretch; }
  .auth-form .cta { margin-top: var(--space-200); align-self: flex-start; }
  .field { display: flex; flex-direction: column; gap: var(--space-200); width: 100%; }
  .field-label {
    font-weight: var(--weight-medium);
    font-size: var(--size-075);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .field-hint { font-size: var(--size-075); }
  .field-trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }

  .auth-error {
    font-size: var(--size-100);
    padding: var(--space-300) var(--space-400);
    border: var(--border-hairline) solid var(--color-line-strong);
    border-radius: var(--radius);
    margin-bottom: var(--space-400);
  }

  .flip { margin-top: var(--space-500); font-size: var(--size-100); }
  .flip-link {
    background: none;
    border: none;
    padding: 0;
    color: var(--color-foreground);
    font: inherit;
    text-decoration: underline;
    cursor: pointer;
  }

  .backend { margin-top: var(--space-800); padding-top: var(--space-500); border-top: var(--border-hairline) solid var(--color-line); }
  .backend ul { list-style: none; padding: 0; margin: var(--space-200) 0 0; display: flex; flex-wrap: wrap; gap: var(--space-200) var(--space-500); }
  .backend a { color: var(--color-foreground); font-size: var(--size-100); }
</style>
