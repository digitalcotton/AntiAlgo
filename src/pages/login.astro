---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { routeFor } from '../data/nav';

/*
 * /login — a private utility page for the owner to exercise the whole auth
 * flow and reach the back end while the public sign-in is held closed for the
 * waitlist. It is deliberately NOT gated: it does not call isOn('signin') (the
 * check that redirects /sign-in to the waitlist), and it is registered in no
 * nav, flag, or entitlement map, so it renders for whoever loads it. It is
 * noindex and linked from nowhere. Accounts created here default to the
 * waitlisted tier and see nothing until an owner tier write elevates them, so
 * the page exposes no back-end surface by existing.
 *
 * Both forms post JSON to Better Auth's own endpoints under /auth, the same
 * way sign-in.astro and sign-up.astro do; there is no client library.
 */
function safeNext(raw: string | null): string {
  const value = raw ?? '';
  if (!value.startsWith('/') || value.startsWith('//') || /[\\\p{Cc}]/u.test(value)) return routeFor('account');
  return value;
}
const next = safeNext(Astro.url.searchParams.get('next'));

// The back-end pages the owner checks after logging in. Plain links: the
// middleware still enforces the tier on each, so listing them exposes nothing.
const BACKEND = [
  { href: '/account', label: 'Account' },
  { href: '/profile', label: 'Profile' },
  { href: '/settings', label: 'Settings' },
  { href: '/desk', label: 'Desk' },
  { href: '/prelist', label: 'Prelist' },
  { href: '/internal', label: 'Internal (top tier)' }
];
---

<BaseLayout title="Log in" description="Private access." noindex>
  <section class="login-page">
    <div class="shell login-shell">
      <span class="kicker muted">Private</span>
      <h1>Log in</h1>
      <p class="lede muted">Owner access, for checking the back end. Not linked anywhere.</p>

      <div class="login-cols">
        <!-- Sign in -->
        <div class="login-col">
          <h2 class="col-title">Sign in</h2>
          <p id="signin-error" class="auth-error" role="alert" hidden>
            That email and password did not match an account.
          </p>
          <form id="signin-form" class="login-form" method="POST" action="/auth/sign-in/email" data-next={next}>
            <label class="field">
              <span class="field-label">Email address</span>
              <input class="field-input" type="email" name="email" required autocomplete="email" />
            </label>
            <label class="field">
              <span class="field-label">Password</span>
              <input class="field-input" type="password" name="password" required autocomplete="current-password" />
            </label>
            <button class="btn" type="submit">Sign in</button>
          </form>
        </div>

        <!-- Create account -->
        <div class="login-col">
          <h2 class="col-title">Create account</h2>
          <p id="signup-error" class="auth-error" role="alert" hidden>
            Something went wrong creating the account. Check the details and try again.
          </p>
          <form id="signup-form" class="login-form" method="POST" action="/auth/sign-up/email" data-next={routeFor('account')}>
            <input class="field-trap" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <label class="field">
              <span class="field-label">First name</span>
              <input class="field-input" type="text" name="first_name" required maxlength="120" autocomplete="given-name" />
            </label>
            <label class="field">
              <span class="field-label">Last name</span>
              <input class="field-input" type="text" name="last_name" required maxlength="120" autocomplete="family-name" />
            </label>
            <label class="field">
              <span class="field-label">Email address</span>
              <input class="field-input" type="email" name="email" required autocomplete="email" />
            </label>
            <label class="field">
              <span class="field-label">Password</span>
              <input class="field-input" type="password" name="password" required autocomplete="new-password" minlength="8" />
              <span class="field-hint muted">Eight characters or more.</span>
            </label>
            <button class="btn" type="submit">Create account</button>
          </form>
        </div>
      </div>

      <nav class="backend-links" aria-label="Back-end pages">
        <span class="field-label">Back end</span>
        <ul>
          {BACKEND.map((p) => <li><a href={p.href}>{p.label}</a></li>)}
        </ul>
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  // Both endpoints want JSON and answer with JSON, so native POST is
  // intercepted. Sign-up synthesizes a single `name` (Better Auth requires it)
  // and honours the honeypot. On success the reader is already signed in
  // (autoSignIn on sign-up), so both go to their `data-next`.
  function wire(formId: string, errorId: string) {
    const form = document.getElementById(formId) as HTMLFormElement | null;
    const errorEl = document.getElementById(errorId);
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (errorEl) errorEl.hidden = true;

      const trap = form.querySelector<HTMLInputElement>('input[name="website"]');
      if (trap && trap.value) return; // honeypot: a bot filled it

      const data = Object.fromEntries(new FormData(form).entries()) as Record<string, string>;
      if ('first_name' in data || 'last_name' in data) {
        const first = String(data.first_name ?? '').trim();
        const last = String(data.last_name ?? '').trim();
        data.name = [first, last].filter(Boolean).join(' ');
      }

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        if (response.ok) {
          const next = form.dataset.next;
          window.location.href = next && next.startsWith('/') ? next : '/';
          return;
        }
      } catch {}
      if (errorEl) errorEl.hidden = false;
    });
  }

  wire('signin-form', 'signin-error');
  wire('signup-form', 'signup-error');
</script>

<style>
  .login-shell {
    padding-block: var(--space-800, 3rem) var(--space-1000, 5rem);
    max-width: 64ch;
    margin-inline: auto;
  }
  .kicker {
    font-size: var(--fs-12, 0.75rem);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .lede { margin-bottom: var(--space-600, 2rem); }
  .login-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-700, 2.5rem);
  }
  @media (max-width: 640px) {
    .login-cols { grid-template-columns: 1fr; }
  }
  .col-title {
    font-size: var(--fs-16, 1rem);
    margin-bottom: var(--space-400, 1rem);
  }
  .login-form { display: flex; flex-direction: column; gap: var(--space-400, 1rem); }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field-label {
    font-size: var(--fs-12, 0.75rem);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted, #666);
  }
  .field-input {
    font: inherit;
    padding: 0.6rem 0.7rem;
    border: 1px solid var(--rule, #ccc);
    border-radius: 6px;
    background: var(--surface, #fff);
    color: var(--ink, #111);
  }
  .field-hint { font-size: var(--fs-12, 0.75rem); }
  .field-trap { position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0; }
  .btn {
    font: inherit;
    font-weight: 600;
    padding: 0.65rem 1rem;
    border: none;
    border-radius: 6px;
    background: var(--signal, #ff5a1f);
    color: #fff;
    cursor: pointer;
  }
  .btn:hover { filter: brightness(0.95); }
  .auth-error {
    font-size: var(--fs-14, 0.875rem);
    color: var(--danger, #b00020);
    margin-bottom: var(--space-300, 0.75rem);
  }
  .backend-links { margin-top: var(--space-800, 3rem); }
  .backend-links ul {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
  }
  .backend-links a { color: var(--ink, #111); }
</style>
