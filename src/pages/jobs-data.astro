---
import BaseLayout from '../layouts/BaseLayout.astro';
import Panel from '../components/Panel.astro';
import { isPaidViewer } from '../lib/ledger-access';
import { buildLedgerData } from '../lib/ledger-market';
import { getBoardStats } from '../lib/job-store';
import { isConfigured } from '../lib/db';
import { prospectRows } from '../lib/data';
import { routeFor } from '../data/nav';
import { withBase } from '../../site.config.mjs';

/**
 * /jobs-data: Jobs Data (The Ledger until 2026-09-19; /ledger now redirects
 * here), the data-scientist market page (v4). A paid, behind-login
 * surface. The whole interactive app is a client island: this page resolves the
 * viewer, and for a paid reader builds the DATA object server-side from the real
 * sweep (src/lib/ledger-market.ts) and injects it as one JSON script tag; the
 * client runtime (public/scripts/ledger-v4-app.js) reads it, and the view bundle
 * (ledger-v4-views.js) renders and re-cuts every view live. A reader who is not
 * paid gets a preview and an upsell, and no member data is built or shipped.
 *
 * GATED IN THIS PAGE, NOT BY MIDDLEWARE, so a non-paid reader still gets the
 * preview instead of a redirect. See src/lib/ledger-access.ts.
 *
 * The JSON payload is scrubbed of en/em dashes and curly quotes (real titles and
 * locations carry them) and its `<` is escaped, so the injected script is gate-3
 * clean and cannot break out of its own tag.
 */
export const prerender = false;

const viewer = Astro.locals.viewer ?? null;
const paid = isPaidViewer(viewer);

let dataJson = '';
if (paid) {
  const raw = JSON.stringify(await buildLedgerData());
  // Char classes built from codes so this source holds no dash/curly byte itself.
  const cc = String.fromCharCode;
  const cls = (a: number, b: number) => new RegExp('[' + cc(a, b) + ']', 'g');
  dataJson = raw
    .replace(cls(0x2013, 0x2014), '-')
    .replace(cls(0x2018, 0x2019), "'")
    .replace(cls(0x201c, 0x201d), '"')
    .replace(/</g, '\\u003c');
}

/* THE TEASE (owner, 2026-09-21). The tiers matrix has always promised a free
   account a preview of this page, and the page gave it a description instead.
   Every tile carries its real title, because the structure is the thing worth
   seeing; three carry a real number and three carry the site's hatch.

   THE THREE NUMBERS ARE ALREADY PUBLIC. They come from board_stats and the
   prospect list, the same two sources the signed-out board prints over its own
   table, in one cheap query rather than buildLedgerData(), which assembles
   every live row, kill and issuer and is the paid payload. No member data is
   built or shipped for a reader who is not paid.

   THE HATCH IS THE SITE'S OWN DRAWING for a withheld thing (the job detail's
   verbatim description, the Desk's empty lane): an absence, never a blurred or
   invented row. Nothing here is a sample. */
let tease: { boards: number; verified: number; killed: number; prospects: number } | null = null;
if (!paid) {
  try {
    const stats = isConfigured() ? await getBoardStats() : null;
    if (stats) {
      tease = {
        boards: stats.boards_swept ?? 0,
        verified: stats.verified_live ?? 0,
        killed: stats.killed_by_rule ?? 0,
        prospects: prospectRows().length
      };
    }
  } catch (error) {
    console.error('jobs-data: the tease counts could not be read (the panel still renders).', error);
  }
}
const n = (v: number) => v.toLocaleString();

const cssHref = withBase('/scripts/ledger-v4.css');
const appJs = withBase('/scripts/ledger-v4-app.js');
const viewsJs = withBase('/scripts/ledger-v4-views.js');
const accountHref = routeFor('account');
const signUpHref = routeFor('sign-up');
const boardHref = routeFor('board');
---

<BaseLayout title="Jobs Data" description="Read the design job market like a data scientist: what pays, what is fresh, who recycles, and where roles are about to open, counted from last night's sweep.">
  <link rel="stylesheet" href={cssHref} />

  {paid ? (
    <>
      <div id="ledger-app" data-ledger-mount>
        <noscript>
          <div style="max-width:60ch;margin:48px auto;padding:0 24px;font-size:0.95rem;line-height:1.6;color:var(--color-muted);">
            The Ledger reads and re-cuts the market live in your browser, so it needs JavaScript on.
            The same numbers, uncut, are on the board and the drop.
          </div>
        </noscript>
      </div>
      <script id="ledger-data" type="application/json" is:inline set:html={dataJson}></script>
      {/* The cut bar (ledger-v4-views.js #watch) sticks under the site's own
          sticky header, whose height varies with the viewport, so the offset
          is measured from the header itself. */}
      <script is:inline>
        (function () {
          var hdr = document.querySelector('header.hdr');
          if (!hdr) return;
          var root = document.documentElement;
          var tick = function () {
            root.style.setProperty('--sticky-top', hdr.getBoundingClientRect().height + 'px');
          };
          tick();
          window.addEventListener('resize', tick);
        })();
      </script>
      <script src={appJs} is:inline defer></script>
      <script src={viewsJs} is:inline defer></script>
    </>
  ) : (
    <main class="shell ledger-preview">
      <header class="lp-head">
        <p class="lp-eyebrow mono-label">Tonight's read</p>
        <h1 class="lp-title">Read the market in your sector like a data scientist.</h1>
        <p class="lp-lede">
          Every night the sweep reads company careers pages directly, verifies what is still there,
          and publishes what came down by rule. The Ledger is the structure underneath that: what
          pays, what is fresh, who recycles, and where roles are about to open. It re-cuts to the
          titles you watch. It is part of the paid account.
        </p>
      </header>

      {tease && (
        <section class="lp-grid" aria-label="Tonight's read, in part">
          <div class="lp-tile">
            <p class="lp-tile-title mono-label">Verified live tonight</p>
            <p class="lp-tile-figure">{n(tease.verified)}</p>
            <p class="lp-tile-note">Read at {n(tease.boards)} company careers pages, not a job board.</p>
          </div>
          <div class="lp-tile">
            <p class="lp-tile-title mono-label">Came down by rule</p>
            <p class="lp-tile-figure">{n(tease.killed)}</p>
            <p class="lp-tile-note">Each one with the rule it tripped on its record.</p>
          </div>
          <div class="lp-tile">
            <p class="lp-tile-title mono-label">About to open</p>
            <p class="lp-tile-figure">{n(tease.prospects)}</p>
            <p class="lp-tile-note">Companies funded and in scope with no role posted yet.</p>
          </div>

          <div class="lp-tile">
            <p class="lp-tile-title mono-label">What pays</p>
            <div class="lp-hatch" role="presentation"></div>
            <p class="lp-tile-note">Pay ladders by title and level, re-cut to the titles you watch.</p>
          </div>
          <div class="lp-tile">
            <p class="lp-tile-title mono-label">Who recycles</p>
            <div class="lp-hatch" role="presentation"></div>
            <p class="lp-tile-note">Which companies repost the same role, and how often.</p>
          </div>
          <div class="lp-tile">
            <p class="lp-tile-title mono-label">The issuer table</p>
            <div class="lp-hatch" role="presentation"></div>
            <p class="lp-tile-note">Every company as an issuer, with its whole record attached.</p>
          </div>
        </section>
      )}

      <Panel title="What the account opens">
        <ul class="lp-list">
          <li>Every view re-cuts to the titles you watch, from pay ladders to the kill archive.</li>
          <li>The issuer table: every company as an issuer, with its record attached.</li>
          <li>Where roles are about to open, scored before they post.</li>
        </ul>
        <p class="lp-cta">
          {viewer
            ? (<a class="lp-button" href={accountHref}>See your account</a>)
            : (<a class="lp-button" href={signUpHref}>Save my spot</a>)}
          <a class="lp-link" href={boardHref}>Browse the free board</a>
        </p>
      </Panel>
    </main>
  )}
</BaseLayout>

<style>
  .ledger-preview {
    padding-block: var(--space-700, 2.5rem) var(--space-800, 4rem);
    display: flex;
    flex-direction: column;
    gap: var(--space-600, 2rem);
  }
  .lp-head { display: flex; flex-direction: column; gap: var(--space-200, 0.5rem); }
  .lp-eyebrow { margin: 0; color: var(--color-muted); }
  .lp-title { margin: 0; font-size: clamp(1.9rem, 4vw, 3rem); line-height: 1.05; letter-spacing: -0.03em; max-width: 24ch; }
  .lp-lede { margin: 0; color: var(--color-muted); max-width: 62ch; line-height: 1.55; }
  .lp-list { margin: 0; padding-left: 1.1rem; color: var(--color-muted); display: flex; flex-direction: column; gap: var(--space-100, 0.25rem); }
  .lp-cta { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-400, 1rem); margin: var(--space-400, 1rem) 0 0; }
  .lp-button {
    display: inline-block; padding: 0.6rem 1rem; border-radius: var(--radius, 2px);
    background: var(--color-surface-inverse); color: var(--color-foreground-inverse);
    font-family: var(--font-family-mono, monospace); font-size: var(--size-100, 0.85rem);
    text-decoration: none; white-space: nowrap;
  }
  .lp-link {
    color: var(--color-foreground); text-decoration: underline; text-underline-offset: 3px;
    text-decoration-color: var(--color-line-strong); font-size: var(--size-100, 0.85rem);
  }

  /* The tease: six tiles on the raised surface, three counted and three
     withheld, so the page shows its structure before it asks for anything. */
  .lp-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--border-hairline) 0;
    background: var(--color-line);
    border: var(--border-hairline) solid var(--color-line-strong);
  }
  .lp-tile {
    background: var(--color-surface-raised);
    padding: var(--space-500) var(--space-500) var(--space-400);
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
    border-left: var(--border-hairline) solid var(--color-line);
  }
  .lp-tile:nth-child(3n + 1) { border-left: 0; }
  .lp-tile-title { margin: 0; color: var(--color-muted); }
  .lp-tile-figure {
    margin: 0;
    font-family: var(--font-family-sans);
    font-weight: var(--weight-bold);
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .lp-tile-note { margin: 0; color: var(--color-muted); font-size: 0.82rem; line-height: 1.5; }
  /* The same hatch the job detail draws over a withheld description: it marks
     an empty slot and never pretends to be a row. Its height matches the
     figure beside it so a counted tile and a withheld one sit on one line. */
  .lp-hatch {
    height: clamp(1.9rem, 3.4vw, 2.6rem);
    border: var(--border-hairline) solid var(--color-line);
    background: repeating-linear-gradient(
      45deg,
      var(--color-hatch-a),
      var(--color-hatch-a) var(--space-200),
      var(--color-hatch-b) var(--space-200),
      var(--color-hatch-b) var(--space-400)
    );
  }
  @media (max-width: 60rem) {
    .lp-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .lp-tile:nth-child(3n + 1) { border-left: var(--border-hairline) solid var(--color-line); }
    .lp-tile:nth-child(2n + 1) { border-left: 0; }
  }
  @media (max-width: 38rem) {
    .lp-grid { grid-template-columns: minmax(0, 1fr); }
    .lp-tile { border-left: 0; }
  }
</style>
