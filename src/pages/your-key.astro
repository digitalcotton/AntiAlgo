---
import BaseLayout from '../layouts/BaseLayout.astro';
import { INDEX, routeFor } from '../data/nav';

/*
 * Your key (BYOK), built to the Anti Algo Your Key canvas: a hero, the console
 * table (Pick a console), the flow (Then, in that console) with a screenshot
 * slot, the password note, and a closer. The four providers are The Index's own
 * (PROVIDER_REGISTRY: anthropic, openai, kimi, deepseek); the registry carries
 * no console URL, so the keyUrl values are the providers' key pages, the one
 * place to change if a provider moves its console.
 */

// The four providers The Index supports, as identity plus a direct link to the
// console where the key lives. Order matches the tailor's own default order.
const PROVIDERS = [
  { name: 'Anthropic', note: 'Where we started.', keyUrl: 'https://console.anthropic.com/settings/keys', keyHost: 'console.anthropic.com', prefix: 'sk-ant-' },
  { name: 'OpenAI', note: 'Strong writing. Most people already have the account.', keyUrl: 'https://platform.openai.com/api-keys', keyHost: 'platform.openai.com', prefix: 'sk-' },
  { name: 'Kimi', note: 'Strong writing at low cost.', keyUrl: 'https://platform.moonshot.ai/console/api-keys', keyHost: 'platform.moonshot.ai', prefix: 'sk-' },
  { name: 'DeepSeek', note: 'The lowest cost of any provider here.', keyUrl: 'https://platform.deepseek.com/api_keys', keyHost: 'platform.deepseek.com', prefix: 'sk-' }
];

// The flow, once, in whichever console you picked.
const STEPS = [
  'Sign in, or make the account.',
  'Open the API keys page.',
  'Create a key.',
  'Set a monthly spend cap.',
  'Paste it into Settings.'
];
---

<BaseLayout title="BYOK" description="Bring your own AI key. Pick a console, follow the flow, paste the key into Settings. It never touches our server.">
  <div class="yk">
    <section class="hsec hero" aria-labelledby="yk-hero">
      <span class="kicker">BYOK, bring your own key</span>
      <h1 id="yk-hero" class="h1">The key means the AI answers to you.</h1>
      <p class="lede">
        You bring your own model key. We never see it, never store it server-side, never pay for your usage. A couple of
        minutes from here, you own the thing that reads your resumé.
      </p>
      <p class="hero-how">Two steps, about two minutes: pick a console below, create a key in it, and paste it into Settings.</p>
      <div class="links">
        <a class="link-line" href={routeFor('how-it-works')}>How it works</a>
        <a class="link-line" href={INDEX.methodology}>Methodology</a>
      </div>
    </section>

    <section class="hsec" aria-labelledby="console-title">
      <p class="step-eyebrow"><span class="step-n">Step 1</span> Pick a console</p>
      <h2 id="console-title" class="h2">Open one provider's console</h2>
      <p class="sub">You only need one. Any of the four works the same on The Index. Open its site in a new tab, then come back for step 2.</p>
      <ul class="provtable">
        {PROVIDERS.map((p) => (
          <li class="provrow">
            <span class="provrow-name">
              {p.name}
              <span class="provrow-prefix">{p.prefix}&hellip;</span>
            </span>
            <span class="provrow-note">{p.note}</span>
            <a class="provrow-link" href={p.keyUrl} target="_blank" rel="noopener noreferrer">{p.keyHost}</a>
          </li>
        ))}
      </ul>
    </section>

    <section class="hsec" aria-labelledby="flow-title">
      <p class="step-eyebrow"><span class="step-n">Step 2</span> In that console</p>
      <h2 id="flow-title" class="h2">Create the key and paste it in</h2>
      <p class="sub">The same five steps, whichever console you opened. Two minutes, start to finish.</p>
      <div class="keyflow">
        <ol class="flow-steps">
          {STEPS.map((s) => <li>{s}</li>)}
        </ol>
        <div class="flow-illo" aria-hidden="true">
          <svg class="illo" viewBox="0 0 320 210" role="img">
            <rect class="illo-win" x="8" y="8" width="304" height="194" rx="2" />
            <line class="illo-line" x1="8" y1="42" x2="312" y2="42" />
            <circle class="illo-dot" cx="24" cy="25" r="3.2" />
            <circle class="illo-dot" cx="36" cy="25" r="3.2" />
            <circle class="illo-dot" cx="48" cy="25" r="3.2" />
            <text class="illo-host" x="68" y="29">your provider's console</text>
            <text class="illo-label" x="24" y="70">API KEYS</text>
            <rect class="illo-row" x="24" y="82" width="272" height="34" rx="1" />
            <text class="illo-key" x="36" y="103">sk-&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;&bull;</text>
            <rect class="illo-btn" x="24" y="140" width="120" height="34" rx="1" />
            <text class="illo-btn-t" x="84" y="161">Create key</text>
          </svg>
        </div>
      </div>
      <p class="key-note">Treat the key like a password. Delete it in Settings anytime, or revoke it at the provider if you lose track of it.</p>
    </section>

    <section class="hsec closer" aria-label="Save your spot">
      <p class="closer-line">One key, pasted once. Everything the account writes for you runs in your browser, on your terms.</p>
      <div class="act">
        <a class="cta" href={`${routeFor('sign-up')}?from=your-key`}>Save my spot</a>
        <a class="closer-link" href={routeFor('how-it-works')}>How it works</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* The site's canvas scale, the same local set the home, how-it-works and
     evidence pages use, so this page sits in the same design. */
  .yk {
    --fs-10: 10px;
    --fs-11: 11px;
    --fs-12: 12px;
    --fs-13: 13.5px;
    --fs-15: 15px;
    --fs-17: 17.5px;
    --fs-20: 21px;
    --fs-26: 27px;
    --fs-h1: clamp(38px, 4.8vw, 58px);
    --fs-h2: clamp(24px, 2.6vw, 32px);
    --sp-1: 4px;
    --sp-2: 8px;
    --sp-3: 12px;
    --sp-4: 16px;
    --sp-5: 24px;
    --sp-6: 32px;
    --sp-7: 48px;
    --sp-8: 72px;
    --tc: 0.13em;
    --tt: -0.02em;

    --raise: var(--color-surface-raised);
    --ink: var(--color-foreground);
    --muted: var(--color-muted);
    --faint: var(--gray-500);
    --line: var(--color-line);
    --line-strong: var(--color-foreground);
    --signal: var(--color-signal);
    --human: var(--font-family-sans);
    --machine: var(--font-family-mono);

    max-width: 75rem;
    margin-inline: auto;
    padding-inline: clamp(20px, 4vw, 56px);
  }

  .hsec {
    border-bottom: 1px solid var(--line);
    padding: var(--sp-7) 0;
  }
  .hsec.hero {
    padding: var(--sp-8) 0 var(--sp-6);
  }
  .hsec.closer {
    padding: var(--sp-7) 0 var(--sp-6);
    border-bottom: none;
  }

  .kicker {
    font-family: var(--machine);
    font-weight: 500;
    font-size: var(--fs-11);
    letter-spacing: var(--tc);
    text-transform: uppercase;
    color: var(--muted);
  }
  .h1 {
    margin: var(--sp-4) 0 0;
    font-weight: 700;
    font-size: var(--fs-h1);
    line-height: 1.04;
    letter-spacing: var(--tt);
    max-width: 22ch;
    text-wrap: pretty;
  }
  .h2 {
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-h2);
    letter-spacing: var(--tt);
    line-height: 1.1;
  }
  .lede {
    margin: var(--sp-5) 0 0;
    font-size: var(--fs-17);
    line-height: 1.55;
    color: var(--ink);
    max-width: 60ch;
    text-wrap: pretty;
  }
  .hero-how {
    margin: var(--sp-4) 0 0;
    font-family: var(--machine);
    font-size: var(--fs-13);
    line-height: 1.6;
    color: var(--muted);
    max-width: 62ch;
  }
  .step-eyebrow {
    margin: 0 0 var(--sp-3);
    font-family: var(--machine);
    font-weight: 500;
    font-size: var(--fs-11);
    letter-spacing: var(--tc);
    text-transform: uppercase;
    color: var(--muted);
  }
  .step-n {
    color: var(--signal);
    margin-right: 8px;
  }
  .sub {
    margin: var(--sp-3) 0 0;
    font-size: var(--fs-17);
    line-height: 1.55;
    color: var(--muted);
    max-width: 58ch;
    text-wrap: pretty;
  }
  .links {
    margin-top: var(--sp-5);
    display: flex;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }
  .link-line {
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--muted);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    line-height: 1.7;
  }
  .link-line:hover {
    color: var(--ink);
  }

  /* ---- pick a console ---- */
  .provtable {
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  .provrow {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: var(--sp-4);
    align-items: baseline;
    padding: var(--sp-4) 0;
    border-bottom: 1px solid var(--line);
  }
  .provrow-name {
    display: flex;
    align-items: baseline;
    gap: var(--sp-2);
    flex-wrap: wrap;
    font-weight: 700;
    font-size: var(--fs-15);
  }
  .provrow-prefix {
    font-family: var(--machine);
    font-weight: 400;
    font-size: var(--fs-11);
    letter-spacing: var(--tc);
    color: var(--faint);
  }
  .provrow-note {
    font-size: var(--fs-15);
    line-height: 1.5;
    color: var(--muted);
    text-wrap: pretty;
  }
  .provrow-link {
    justify-self: start;
    font-family: var(--machine);
    font-size: var(--fs-12);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--signal);
    padding-bottom: 3px;
    white-space: nowrap;
  }
  .provrow-link:hover {
    color: var(--muted);
    border-bottom-color: var(--muted);
  }

  /* ---- then, in that console ---- */
  .keyflow {
    margin-top: var(--sp-5);
    border: 1px solid var(--line-strong);
    background: var(--raise);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  }
  .flow-steps {
    margin: 0;
    padding: var(--sp-6);
    border-right: 1px solid var(--line);
    min-width: 0;
    list-style: none;
    counter-reset: step;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }
  .flow-steps li {
    counter-increment: step;
    position: relative;
    padding-left: 30px;
    font-size: var(--fs-15);
    line-height: 1.5;
    text-wrap: pretty;
  }
  .flow-steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 1px;
    font-family: var(--machine);
    font-size: var(--fs-11);
    color: var(--signal);
  }
  /* The console illustration: a small mock of a provider's API keys page, the
     masked key and the Create key button, so the step list has the thing it is
     describing beside it. */
  .flow-illo {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--sp-6);
    background: var(--color-surface);
  }
  .illo {
    width: 100%;
    height: auto;
    max-width: 340px;
  }
  .illo-win {
    fill: var(--raise);
    stroke: var(--line-strong);
    stroke-width: 1;
  }
  .illo-line {
    stroke: var(--line);
    stroke-width: 1;
  }
  .illo-dot {
    fill: var(--faint);
  }
  .illo-host {
    fill: var(--muted);
    font-family: var(--machine);
    font-size: 11px;
  }
  .illo-label {
    fill: var(--faint);
    font-family: var(--machine);
    font-size: 10px;
    letter-spacing: 1.4px;
  }
  .illo-row {
    fill: var(--color-surface);
    stroke: var(--line);
    stroke-width: 1;
  }
  .illo-key {
    fill: var(--ink);
    font-family: var(--machine);
    font-size: 13px;
    letter-spacing: 1px;
  }
  .illo-btn {
    fill: var(--signal);
  }
  .illo-btn-t {
    fill: var(--gray-950);
    font-family: var(--human);
    font-weight: 600;
    font-size: 12px;
    text-anchor: middle;
  }
  .key-note {
    margin: var(--sp-5) 0 0;
    font-family: var(--machine);
    font-size: var(--fs-12);
    line-height: 1.6;
    color: var(--muted);
    max-width: 70ch;
  }

  /* ---- closer ---- */
  .closer-line {
    margin: 0;
    font-weight: 600;
    font-size: var(--fs-26);
    line-height: 1.3;
    letter-spacing: var(--tt);
    max-width: 40ch;
    text-wrap: pretty;
  }
  .act {
    margin-top: var(--sp-5);
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    flex-wrap: wrap;
  }
  .cta {
    background: var(--signal);
    color: var(--gray-950);
    text-decoration: none;
    font-family: var(--human);
    font-weight: 600;
    font-size: var(--fs-17);
    padding: 16px 30px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--signal);
  }
  .cta:hover,
  .cta:focus-visible {
    color: var(--gray-950);
    filter: brightness(1.05);
  }
  .closer-link {
    font-size: var(--fs-15);
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }
  .closer-link:hover {
    color: var(--muted);
    border-bottom-color: var(--muted);
  }

  @media (max-width: 820px) {
    .keyflow {
      grid-template-columns: 1fr;
    }
    .flow-steps {
      border-right: none;
      border-bottom: 1px solid var(--line);
    }
    .provrow {
      grid-template-columns: 1fr;
      gap: var(--sp-1);
    }
  }
</style>
