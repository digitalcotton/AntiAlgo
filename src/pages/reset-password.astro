---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../../site.config.mjs';

// One page, two stages, told apart by whether a token is on the URL. Arrive
// with no token: request a link. Arrive with one, from the email: set a new
// password. Server rendered so the token can be read from the request before
// anything is sent to the browser.
//
// Endpoint paths confirmed against src/lib/auth.ts's own rateLimit.customRules,
// which names Better Auth's real route as /forget-password (mounted under
// /auth). Verified against the running server: /request-password-reset. redirectTo tells
// Better Auth where the emailed link's ?token= should land: this page.
const token = Astro.url.searchParams.get('token');
const redirectTo = new URL(withBase('/reset-password'), Astro.url.origin).href;
---

<BaseLayout title="Reset password" description="Reset the password on your tokens-to-agents account." noindex>
  <section class="auth-page">
    <div class="shell auth-shell">
      <span class="kicker">Account</span>

      {
        token ? (
          <Fragment>
            <h1>Set a new password</h1>
            <p class="muted">Choose a new password for your account.</p>

            <p id="auth-error" class="auth-error" role="alert" hidden>
              That link didn't work. It may have expired.
            </p>
            <p id="auth-success" class="auth-success" role="status" hidden>
              Your password is set. Sign in with it now.
            </p>

            <form class="auth-form" data-mode="confirm" method="POST" action={withBase('/auth/reset-password')}>
              <input type="hidden" name="token" value={token} />
              <div class="field">
                <label class="field-label" for="reset-password-new">New password</label>
                <input
                  class="field-input"
                  id="reset-password-new"
                  type="password"
                  name="newPassword"
                  required
                  autocomplete="new-password"
                  minlength="8"
                />
              </div>
              <button class="field-submit" type="submit">Set password</button>
            </form>

            <div class="auth-links">
              <a class="auth-link" href={withBase('/sign-in')}>Sign in</a>
            </div>
          </Fragment>
        ) : (
          <Fragment>
            <h1>Reset your password</h1>
            <p class="muted">Enter your email and we'll send a link to reset it.</p>

            <p id="auth-sent" class="auth-success" role="status" hidden>
              If that address has an account, we sent a link.
            </p>
            <p id="auth-error" class="auth-error" role="alert" hidden>
              Something went wrong. Try again.
            </p>

            <form class="auth-form" data-mode="request" method="POST" action={withBase('/auth/request-password-reset')}>
              <input type="hidden" name="redirectTo" value={redirectTo} />
              <div class="field">
                <label class="field-label" for="reset-password-email">Email address</label>
                <input
                  class="field-input"
                  id="reset-password-email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="you@company.com"
                />
              </div>
              <button class="field-submit" type="submit">Send reset link</button>
            </form>

            <div class="auth-links">
              <a class="auth-link" href={withBase('/sign-in')}>Back to sign in</a>
            </div>
          </Fragment>
        )
      }
    </div>
  </section>
</BaseLayout>

<script>
  // Both stages need the same fetch-instead-of-native-POST swap as sign-in
  // and sign-up, since Better Auth's endpoints read JSON. The request stage
  // shows the same "if that address has an account" line whether or not the
  // request actually succeeded server-side (an exception is the one
  // exception to that: a real network failure gets its own generic message,
  // since that is a connectivity fact, not an account fact).
  const form = document.querySelector<HTMLFormElement>('.auth-form');
  const mode = form?.dataset.mode;
  const errorEl = document.querySelector<HTMLElement>('#auth-error');
  const successEl = document.querySelector<HTMLElement>(mode === 'request' ? '#auth-sent' : '#auth-success');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (errorEl) errorEl.hidden = true;
    if (successEl) successEl.hidden = true;

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (mode === 'request') {
        // Never branches on response.ok here: the line is the same whether
        // or not the address has an account, so the network call succeeding
        // is all that is checked.
        if (successEl) successEl.hidden = false;
        return;
      }
      if (response.ok) {
        form.hidden = true;
        if (successEl) successEl.hidden = false;
        return;
      }
    } catch {
      // Falls through to the error message below for both stages.
    }
    if (errorEl) errorEl.hidden = false;
  });
</script>

<style>
  .auth-page .auth-shell {
    padding-block: var(--space-800) var(--space-1000);
    max-width: 40ch;
  }
  .kicker {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-075);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h1 {
    margin: var(--space-300) 0 var(--space-400);
    font-size: var(--size-600);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-display);
  }
  .muted {
    margin: 0 0 var(--space-600);
    color: var(--color-muted);
    font-size: var(--size-200);
    line-height: var(--leading-normal);
  }

  .auth-error {
    margin: 0 0 var(--space-500);
    padding: var(--space-300) var(--space-400);
    border: 1px solid var(--color-line-strong);
    font-family: var(--font-family-mono);
    font-size: var(--size-100);
    line-height: var(--leading-normal);
    color: var(--color-foreground);
  }
  .auth-success {
    margin: 0 0 var(--space-500);
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
    padding: var(--space-400) var(--space-500);
    font-size: var(--size-200);
    line-height: var(--leading-normal);
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-500);
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-200);
  }
  .field-label {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-075);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .field-submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface-inverse);
    color: var(--color-foreground-inverse);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
    padding: var(--space-300) var(--space-500);
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-100);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    transition: transform 160ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .field-submit:hover,
  .field-submit:focus-visible {
    transform: translateX(4px);
  }
  @media (prefers-reduced-motion: reduce) {
    .field-submit {
      transition: none;
    }
    .field-submit:hover,
    .field-submit:focus-visible {
      transform: none;
    }
  }

  .auth-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-300);
    margin-top: var(--space-600);
  }
  .auth-link {
    align-self: flex-start;
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-100);
    color: var(--color-foreground);
    border-bottom: 1px solid var(--color-foreground);
    padding-bottom: 2px;
    transition: opacity 140ms;
  }
  .auth-link:hover {
    opacity: 0.6;
  }
</style>
