---
import AccountCta from '../components/AccountCta.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Board from '../components/Board.astro';
import { EMPTY_AGE_HISTOGRAM, facetGroupsFromCounts, loadStats, prospectRows, sweepDate, sweptAt, type AgeHistogram, type Job } from '../lib/data';
import { sweptStamp as stampOf } from '../lib/stats';
import { isConfigured } from '../lib/db';
import { boardRowsLoadedAt, getBoardStats, listBoardAgeHistogram, listBoardFiltered, type BoardFilteredResult, type FacetCounts } from '../lib/job-store';
import { getLexicon, type BoardLexicon } from '../lib/search-lexicon';
import { NO_LEXICON, boardFilterFromQuery, canonicalSearchTarget, chipRemoveHrefs, chipsForQuery, suggestBaseParams } from '../lib/search-suggest';
import { boardRowToJob } from '../lib/board-jobs';
import { listWatches } from '../lib/ledger-watch-store';
import { isPaidViewer } from '../lib/ledger-access';
import { boardHref, clampPage, parseBoardQuery } from '../lib/board-query';
import { FRESH_WINDOW_HOURS } from '../lib/data-contract';
import { isOn } from '../lib/flags';
import { routeFor } from '../data/nav';
import { withBase } from '../../site.config.mjs';

/**
 * /board: the board, the site's main surface.
 *
 * IT LIVES HERE, NOT AT /, FOR A DEPLOYMENT REASON. The board is server
 * rendered (its rows come from the job store), and with the site's /jobs base
 * path the Astro Vercel adapter cannot route to a server-rendered index (it
 * compiles the index to an unreachable route). Every server-rendered sub-route
 * works, so the board lives at /board and / redirects here. The intended home
 * is the bare /jobs; moving it back is a base-config change tracked separately.
 *
 * The board itself (tabs, strip, tiles, filters, sort, age plot, table, paging)
 * is one component, src/components/Board.astro, shared with the Pre-List so the
 * two tabs are the same surface. This page composes it with the header above
 * and the account call below, and hands it one page of rows. The graveyard
 * section and the Pre-List line that followed the board were removed on
 * 2026-09-12 at the owner's ask; the kill list has its own page and the
 * Pre-List its own tab. The live truth check's board_rows marker moved to
 * the Verified live tile (StatTiles liveMetric).
 *
 * ONE PAGE PER REQUEST (since 2026-09-11). The address carries the page, the
 * rows per page, the search, the three facets and the sort
 * (src/lib/board-query.ts); the store filters, counts, sorts and slices in SQL
 * (job-store.ts listBoardFiltered) and this page never holds more than one
 * page of rows. A page past the end answers with a redirect to the last page,
 * so the address a reader lands on always names a page that exists. The YC
 * roles that used to be merged here from static data now arrive through the
 * crawl like every other board (the mini reads Work at a Startup nightly), so
 * every row on this table came through the same store.
 */
export const prerender = false;

const stats = loadStats();
const boardPath = routeFor('board');
const parsed = parseBoardQuery(Astro.url.searchParams);

// THE FIT SCORE IS A SIGNED-IN READING. A signed-out reader gets the board
// without the Fit column, its why panels or the Fit sort, unless fit_public
// is lit (flags.config.mjs). The address contract still defaults to `fit`,
// so a reader who cannot see fit is served the age order instead: the sort
// the control shows is the sort the rows are in, and the URL stays clean.
// /board is public, so the middleware writes no verdict here; it resolves a
// viewer only when the request carries a session cookie (src/middleware.ts,
// SESSION_IF_COOKIE), which is the one fact this page needs.
// A FIELD NAME TYPED INTO THE BOX IS JUST WORDS (2026-10-02). This page used to
// answer a search that was exactly the label of a field ("Healthcare & Medicine")
// with a silent 302 to the Field filter, which the reader could not tell had
// happened. The search is words now, matched against titles, companies and
// departments (job-store.ts buildSearchQuery), so a field name finds the postings
// that say it, and the Field control is the strip's own.
//
// THE ONE REDIRECT THIS PAGE MAKES FOR A SEARCH IS THE VISIBLE PARSE. Text that
// states facts ("designer london remote 150k") is not shown at that address:
// the reader is sent to the address that holds the facts as parameters, where the
// box draws them as chips, with the words that are left in `q` and none of them
// dropped (search-suggest.ts canonicalSearchTarget). It is what pressing Enter
// does without script, and what the typeahead's own rows already point at. It
// cannot loop: the address it sends to parses to no chips. A place or company
// that is also a title word ("phoenix", "oracle") is never converted; it is
// searched as the word it is, and offered as a chip by the box.
//
// THE TEXT IS PARSED UNCAPPED, the parser's own 200 characters, and NOT the 120
// the board keeps of `q` (parsed.q): a pay or a place at character 150 is a fact
// the reader typed. The vocabulary is the live board's (search-lexicon.ts, built
// once per crawl); when it cannot be read the parse still turns `150k`, `remote`
// and `this week` into chips, which need no vocabulary, and nothing else.
const rawQ = (Astro.url.searchParams.get('q') ?? '').trim();
// The stats row is read here, and not alongside the rows below, only when this
// request needs the vocabulary: the lexicon is keyed by the crawl instant that row
// holds, and a place chip needs it to be named. A bare board asks for neither.
let boardStats: Awaited<ReturnType<typeof getBoardStats>> = null;
let statsRead = false;
let lexicon: BoardLexicon | null = null;
if (isConfigured() && (rawQ !== '' || parsed.place !== null)) {
  try {
    boardStats = await getBoardStats();
    statsRead = true;
    lexicon = await getLexicon(boardRowsLoadedAt(boardStats));
  } catch (error) {
    console.error('board: the search vocabulary could not be read; parsing without it.', error);
  }
}
if (rawQ !== '') {
  const parsedTarget = canonicalSearchTarget(rawQ, parsed, lexicon ?? NO_LEXICON, boardPath);
  if (parsedTarget !== null) return Astro.redirect(parsedTarget, 302);
}

const viewer = Astro.locals.viewer;
const signedIn = Boolean(viewer && viewer.emailVerified);
/* The Board / Newly funded switch advertises the Pre-List, which is paid, so
   only a paid reader is offered it (owner, 2026-09-20). Anyone else was being
   shown a tab and a count for a wall they would land on. */
const paidViewer = isPaidViewer(viewer);
const showFit = signedIn || isOn('fit_public');
const query = parsed;
// The address keeps its default (`fit`, unwritten) so every link stays bare;
// only the store is handed the order the reader can actually see. Board.astro
// underlines the same substitution on the sort control.
const servedSort = !showFit && query.sort === 'fit' ? ('age' as const) : query.sort;
// THE SAME FACT DECIDES WHAT BREAKS A TIE IN A SEARCH. Best match orders by the
// text and then, for a reader who can see it, by Deets. A reader with no Deets
// column and no why panel (showFit false) must not be ordered by a number they
// cannot read, so the store is told, and its best-match tail is age and id for
// them (job-store.ts BEST_ORDER). Board.astro says the order in one line above
// the rows for the same reader, from the same flag (its `fit` prop).
const deetsVisible = showFit;

// THE BOARD IS NEVER PRE-FILTERED (owner decision, 2026-09-19). A member's
// Desk titles no longer narrow it by default; every reader gets the full sweep.
// Instead the search cell offers those titles as a checkbox list (Filters.astro
// title menu), and only a title the member actually holds is honoured from the
// address: `title=` values that are not on their Desk are dropped.
let titleChoices: { core: string[]; stretch: string[] } | undefined;
let pickedTitles: string[] = [];
if (signedIn && isConfigured()) {
  try {
    const watches = await listWatches(viewer!.userId);
    if (watches.length > 0) {
      titleChoices = {
        core: watches.filter((w) => w.shelf === 'core').map((w) => w.title),
        stretch: watches.filter((w) => w.shelf === 'stretch').map((w) => w.title)
      };
      const held = new Set(watches.map((w) => w.title));
      pickedTitles = query.titles.filter((title) => held.has(title));
    }
  } catch (error) {
    console.error('board: could not read the Desk titles; showing the board without the title menu.', error);
  }
}

const EMPTY_COUNTS: FacetCounts = {
  total: 0,
  location: {},
  comp: {},
  freshness: {},
  family: {},
  remote: {},
  pay: { any: 0, notListed: 0, floors: {} },
  place: { countries: {}, notStated: 0 }
};
const EMPTY_PAGE: BoardFilteredResult = { rows: [], total: 0, counts: EMPTY_COUNTS, fuzzy: false };
// The age plot is a fact about the whole set, never about one page: the store
// returns its distribution (one row per age), not the rows themselves. Its
// read starts here, ahead of the rows/stats read below, and its degrade is
// attached at creation so the unresolved promise can be handed to a body
// component (Board -> AgePlot) without ever rejecting unhandled: the head can
// stream before this settles.
// THE STRIP IS DRAWN OVER THE READER'S BOARD, not over the whole sweep
// (2026-09-28). It took only the sweep date, so "Showing 36,457 of 36,457
// roles" sat above a Field dropdown counting 1,463 and a table showing 59 —
// three denominators on one screen, none of them saying so. It gets the same
// narrowing the rows and the counts get; the age RANGE is the one thing it
// does not take, because the strip is the control that sets it.
const ageHistogramP: Promise<AgeHistogram> = isConfigured()
  ? listBoardAgeHistogram({
      q: query.q,
      location: query.location,
      comp: query.comp,
      freshness: query.freshness,
      remote: query.remote,
      payMin: query.payMin,
      compNotListed: query.compNotListed,
      place: query.place,
      company: query.company,
      sweepDate: sweepDate(),
      titles: pickedTitles.length > 0 ? pickedTitles : undefined,
      families: query.families.length > 0 ? [...query.families] : undefined
    }).catch((error) => {
      console.error('board: the age plot could not read the store; rendering without it.', error);
      return EMPTY_AGE_HISTOGRAM;
    })
  : Promise.resolve(EMPTY_AGE_HISTOGRAM);

// A store that will not answer is an empty board with the error in the log,
// never a 500 on the site's main surface: the header and the tiles still
// render, and the table says nothing matched. The rows and the board's own
// stats row are independent reads, so they run concurrently.
let served = EMPTY_PAGE;
if (isConfigured()) {
  [served, boardStats] = await Promise.all([
    // The store's filter is built by the one function the typeahead's counts
    // also use (search-suggest.ts), so a count printed in the box and the total
    // under it cannot come from two readings of the same address. The one thing
    // added here is whether the reader can see Deets, which only an ordering reads.
    listBoardFiltered({ ...boardFilterFromQuery(query, { sweepDate: sweepDate(), sort: servedSort, titles: pickedTitles }), deetsVisible }).catch((error) => {
      console.error('board: the job store did not answer; rendering an empty board.', error);
      return EMPTY_PAGE;
    }),
    // Already read, above, when the search needed the vocabulary.
    statsRead
      ? Promise.resolve(boardStats)
      : getBoardStats().catch((error) => {
          console.error('board: the stats row could not be read.', error);
          return null;
        })
  ]);
}

const { page, pages } = clampPage(query.page, served.total, query.per);
if (page !== query.page) {
  return Astro.redirect(boardHref(boardPath, query, { page }), 302);
}

const jobs = served.rows.map(boardRowToJob);
const groups = facetGroupsFromCounts(served.counts, { ...query, fam: query.families[0] ?? 'all' });

// The board's own counts, from the sweep. verified-live is the table's real
// size, so it always matches what a reader can count.
const verifiedCount = boardStats?.verified_live ?? served.total;

// THE STALENESS LINE LIVES IN THE HEADER NOW. The table's assurance band is
// gone (2026-09-11), but the reader-facing half of the staleness pair is not:
// this eyebrow carries an instant and the window, and JobTable's inline script
// turns it amber and rewrites it ("Last verified N hours ago") when the number
// goes past FRESH_WINDOW_HOURS on the reader's own clock.
//
// WHICH INSTANT: the one belonging to what the eyebrow sits above. Board.astro
// puts this stamp directly over StatTiles and the table, and both of those are
// the crawl's output — ~1,666 boards and ~37,000 rows out of Postgres, not the
// 45 boards and 77 postings of stats.json. So it reads the crawl's load
// instant. It said sweptAt() for part of 2026-09-30 and that was a claim the
// page could not support: four minutes old, over rows loaded two days earlier.
//
// Both pages name this local boardRowsAt, and check 7 in
// scripts/gate-invariants.mjs holds every data-swept stamp to that one
// expression. The fallback is the sweep instant, used only when the board_stats
// row cannot be read at all: a stamp that is absent silently disables the
// staleness warning, which is worse than a degraded one that is visibly there.
const boardRowsAt = boardRowsLoadedAt(boardStats) ?? sweptAt();
const prospectCount = prospectRows().length;

// WHAT THE SEARCH BOX IS HANDED (Board.astro hands it to Filters.astro, which
// hands it to SearchBox.astro). The chips are the facts the address holds, named
// with the vocabulary's labels ("London, United Kingdom"), each with the address
// that removes that one chip; `suggestPath` is the registry's path to the
// typeahead; `sweepV` is the same crawl instant the endpoint reads for itself, so
// a new crawl is a new cache key; `baseParams` is the address's other settings,
// one value a name, which is how the box sends them and how the endpoint reads
// them back (suggestBaseParams). Only the titles the member holds are sent: a
// title in an address that is not theirs narrows nothing on this page and must
// not narrow a count.
const searchChips = chipsForQuery(query, lexicon);
const searchChipRemoveHrefs = chipRemoveHrefs(query, searchChips, boardPath);
const suggestPath = routeFor('board-suggest');
const sweepV = boardRowsLoadedAt(boardStats) ?? '';
const baseParams = suggestBaseParams({ ...query, titles: pickedTitles });
---

<BaseLayout title="The Index" active="index" fonts={['n27-regular', 'n27-medium', 'n27-bold', 'mono-regular', 'mono-medium']}>
  <div class="shell index">
    <header class="index-head">
      <h1 class="index-title">Every open role, verified last night.</h1>
      <p class="index-lede">
        A machine reads{' '}
        <span>{(boardStats?.boards_swept ?? stats.boards).toLocaleString()}</span>{' '}
        companies' job feeds direct from the source every night. It checks that every posting it
        already knows about is still there, flags the ones that have sat too long, and drops the ones
        that vanish. Every number on this site is an observation with a timestamp on it.
      </p>
    </header>

    <Board
      jobs={jobs}
      mode="server"
      page={{ total: served.total, page, pages, per: query.per }}
      query={query}
      groups={groups}
      ageHistogram={ageHistogramP}
      boardPath={boardPath}
      titleChoices={titleChoices}
      active="board"
      prospectCount={prospectCount}
      boards={boardStats?.boards_swept}
      verifiedLive={boardStats ? verifiedCount : undefined}
      hrefFor={(job: Job) => withBase(`/board/${job.slug}`)}
      fit={showFit}
      tabs={paidViewer || isOn('prelist_tab_public')}
      ariaLabel="This sweep"
      chips={searchChips}
      chipRemoveHrefs={searchChipRemoveHrefs}
      suggestPath={suggestPath}
      sweepV={sweepV}
      baseParams={baseParams}
      fuzzy={served.fuzzy}
    >
      {/* The sweep stamp sits right of the board tabs (Board.astro's stamp
          slot). It is still the reader-facing half of the staleness pair:
          data-swept and data-assurance-text are what the table's inline script
          read, wherever the element sits. This used to name a second reader,
          scripts/prove-staleness-pair.mjs, which has never existed in this repository. */}
      <p slot="stamp" class="index-eyebrow mono" data-swept={boardRowsAt} data-fresh-hours={FRESH_WINDOW_HOURS}>
        <span data-assurance-text>Verified this sweep · {stampOf(boardRowsAt)}</span>
      </p>
    </Board>

    {!signedIn && <AccountCta source="index" />}
  </div>
</BaseLayout>

<style>
  .index {
    display: flex;
    flex-direction: column;
    gap: var(--space-700);
    padding-block: var(--space-700) var(--space-800);
    /* Wider than the default 75rem shell, with tighter side padding, so the full
       board table fits without a sideways scroll — spending the margin a 75rem
       shell leaves empty on wide screens. The header title/lede are width-capped
       internally, so a wider frame does not stretch them. Below this width the
       table collapses to cards (JobTable's container query), never scrolling. */
    max-width: 86rem;
    padding-inline: clamp(16px, 2.5vw, 36px);
  }

  .index-head {
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
  }

  .index-eyebrow {
    margin: 0;
    color: var(--color-muted);
  }

  /* Amber, not red, past the window: a warning about our own freshness. */
  .index-eyebrow[data-stale] {
    color: var(--color-banner-stale);
  }

  .index-title {
    max-width: 24ch;
  }

  .index-lede {
    font-size: var(--size-300);
    max-width: var(--layout-measure);
    color: var(--color-muted);
  }

  @media (max-width: 48rem) { /* --breakpoint-phone */
    .index {
      gap: var(--space-600);
    }
  }
</style>
