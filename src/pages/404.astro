---
import BaseLayout from '../layouts/BaseLayout.astro';
import { routeFor } from '../data/nav';
---

<BaseLayout title="Not found" noindex>
  <section class="shell page">
    <span class="kicker muted">404</span>
    <h1>Nothing at this address.</h1>
    <p><a class="link-line" href={routeFor('start')}>Back to the start</a></p>
  </section>
</BaseLayout>

<style>
  .page {
    padding-block: var(--space-800) var(--space-1000);
    display: flex;
    flex-direction: column;
    gap: var(--space-400);
    align-items: flex-start;
  }
  .muted {
    color: var(--color-muted);
  }
</style>
