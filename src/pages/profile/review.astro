---
/**
 * /profile/review: the no-JS wait for an uploaded resume. profile/import/
 * parse.ts 303s here for a reader without the profile page's script. Owner-only
 * and per-request (prerender=false): this page reads only Astro.locals.viewer's
 * own parse row.
 *
 * ONE STATE. A finished read lands in the Profile Record on its own
 * (src/lib/resume-parse-apply.ts), so there is nothing to review: while the
 * read is still running this page shows the wait and polls itself with a meta
 * refresh; the moment it is ready the read is landed and the reader is sent
 * to the profile, where the record shows the rows. Arriving with no read in
 * flight goes to the profile too.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import LoadingState from '../../components/LoadingState.astro';
import { landReadyParse } from '../../lib/resume-parse-apply';
import { getParse } from '../../lib/resume-parse-store';
import { routeFor } from '../../data/nav';

export const prerender = false;

/** The same plain 404 the draft room and /u/[handle] return for "not yours or
    not here", so this site has one house answer for it, not a second. */
function notFound(): Response {
  return new Response('Not found.', { status: 404, headers: { 'Content-Type': 'text/plain; charset=utf-8' } });
}

const viewer = Astro.locals.viewer;
if (!viewer) {
  return notFound();
}

const profilePath = routeFor('profile');

// Land a finished read first; only a read still in flight keeps the reader
// here.
const landed = await landReadyParse(viewer.userId);
const parse = landed ? null : await getParse(viewer.userId);
if (parse?.status !== 'pending') {
  return Astro.redirect(profilePath);
}
---

<BaseLayout
  title="Reading your resume"
  description="Your uploaded resume is being read into your Profile Record."
  noindex
>
  <section class="review-page">
    <div class="shell review-shell">
      <span class="kicker">Profile</span>
      <h1>Reading your resume</h1>

      <meta http-equiv="refresh" content="2" />
      <LoadingState label="Reading your resume and pulling out your roles, links, and name" />

      <div class="review-back">
        <a class="review-link" href={profilePath}>Back to your profile</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .review-page .review-shell {
    padding-block: var(--space-800) var(--space-1000);
    /* No max-width: fills the shell to the same width as the Account (profile)
       page, so the record surfaces read as one width. Prose caps its own
       measure per block, the way profile does. */
    display: flex;
    flex-direction: column;
    gap: var(--space-500);
  }
  .kicker {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-075);
    letter-spacing: var(--tracking-loose);
    text-transform: uppercase;
    color: var(--color-muted);
  }
  h1 {
    margin: var(--space-300) 0 0;
    font-size: var(--size-600);
    font-weight: var(--weight-bold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-display);
  }
  .review-link {
    font-family: var(--font-family-sans);
    font-weight: var(--weight-medium);
    font-size: var(--size-100);
    color: var(--color-foreground);
    border-bottom: 1px solid var(--color-foreground);
    padding-bottom: 2px;
  }
  .review-back {
    display: flex;
    gap: var(--space-400);
    margin-top: var(--space-300);
  }
</style>
