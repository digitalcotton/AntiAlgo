<script>
  // The record's expander. Rows past the fifth ship hidden; this shows them
  // and offers the way back. With no script the <noscript> rule shows every
  // row and hides this control, so the button never promises something it
  // cannot do.
  const toggle = document.querySelector<HTMLButtonElement>('[data-record-toggle]');
  const rest = Array.from(document.querySelectorAll<HTMLElement>('tr[data-record-rest]'));
  if (toggle && rest.length > 0) {
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      for (const row of rest) row.hidden = expanded;
      toggle.setAttribute('aria-expanded', expanded ? 'false' : 'true');
      toggle.textContent = expanded ? 'Show all records' : 'Show the first five';
    });
  }
</script>
