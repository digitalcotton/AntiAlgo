# Copy to .env.local for local development. On Vercel, set these as environment variables.
DATABASE_URL=postgres://user@host:5432/dbname
DATABASE_URL_UNPOOLED=postgres://user@host:5432/dbname
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=https://your-domain.example
SITE_ORIGIN=https://your-domain.example

# Stripe billing (src/lib/billing.ts), for the $7.25/month membership.
# UNUSED WHILE THE `stripe` FLAG IN flags.config.mjs IS OFF (both editions,
# today) — /upgrade and everything under /billing 404 via FLAGGED_ROUTES
# before these are ever read. Set real values only after connecting a real
# Stripe account and before flipping that flag on.
# Secret key for server-side API calls (Stripe Dashboard > Developers > API keys).
STRIPE_SECRET_KEY=sk_test_your_secret_key
# Signing secret for one webhook endpoint (Stripe Dashboard > Developers > Webhooks),
# used to verify a request to /billing/webhook actually came from Stripe.
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
# The Price object id for the $7.25/month recurring price (Stripe Dashboard > Product catalog).
STRIPE_PRICE_ID=price_your_price_id
